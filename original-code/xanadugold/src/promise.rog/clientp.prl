$special{"IntValue::import"} = "omit";
$extra{"IntValue"} =
"
	public: /* create */

		static XuBooleanValueP true ();
		static XuBooleanValueP false ();
		static XuIntValueP zero () {
			return false ();
		}

		/* make a new promise which can be sent to the server */
		static XuIntValueP signedMake (XuIntVar value);
    		static XuIntValueP unsignedMake (XuUIntVar value);

		/* make a new promise which can be sent to the server */
		/* makes a copy of the bytes representing the humber */
		static XuIntValueP humberMake (XuBufferVar value);

	public: /* accessing */

/*		XuIntVar precision (); thingToDo: omit or rename? */

		XuIntVar asInt ();

		XuUIntVar asUInt ();

		XuBooleanVar asBoolean ();

		/* if it is too big to fit in XuIntVar */
		XuBooleanVar isTooBig ();

		/* how many bytes it takes to store the humber */
		XuIntVar sizeofHumber ();

		/* put the bytes representing the humber into a buffer */
		void toBuffer (XuBufferVar humber, XuIntVar size);

	public: /* derived arithmetic */

		XuIntValueP negated ();

		XuBooleanValueP notEquals (XuIntValueP other);

		XuBooleanValueP isLT (XuIntValueP other);

		XuBooleanValueP isGT (XuIntValueP other);

		XuBooleanValueP isLE (XuIntValueP other);

		XuIntValueP rightShift (XuIntValueP other);

		XuIntValueP bitwiseComplement ();

		XuBooleanValueP logicalNot ();

		XuBooleanValueP logicalAnd (XuBooleanValueP other);

		XuBooleanValueP logicalOr (XuBooleanValueP other);
		

	/* ------ INTERNAL ------ */

	private: /* special accessing */

		friend class XuConnection;

		void setFromInt (XuIntVar value);

		void setValue (XuIntVar value) ;
		void setTooBig (XuBooleanVar tooBig);
		void setHumber (XuBufferVar humber);

		static XuIntValueP make (XuIntVar sequence,
				XuIntVar value,
				XuBooleanVar isTooBig,
				XuBufferVar humber);

	public: /* create */

		virtual ~ XuIntValue ();

	private: /* special create */

		XuIntValue (XuIntVar sequence,
				XuIntVar value,
				XuBooleanVar isTooBig,
				XuBufferVar humber);

	private: /* variables */

		XuIntVar myValue; /* if isFullfilled() && ! isTooBig () */
		XuBooleanVar myIsTooBig; /* if value doesn't fit in XuIntVar */
		XuBufferVar XU_OR_NULL myHumber; /* NULL until response comes back */

		static XuIntValueP True;
		static XuIntValueP False;
";

