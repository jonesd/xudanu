class XuDetectorHook : public XuCounted {

		XU_PROLOGUE(XuDetectorHook)

	public: /* delete */
		~XuDetectorHook ();

	protected: /* create */
		XuDetectorHook ();

	private: /* special accessing */
		friend class XuServer;
		friend class XuWork;
		friend class XuRangeElement;
		friend class XuEdition;

		void setDetector (XuPromiseP detector);

	private: /* variables */
		XuPromiseP myDetector;
		XuIntVar mySequence; 
};
		
";

