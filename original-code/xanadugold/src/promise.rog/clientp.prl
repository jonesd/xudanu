$before{"CXX"} =
"
#include <stream.h>
#include <string.h>
#include <stdlib.h>

#include \"xanadu.hxx\"
#include \"xanadup.hxx\"
#include \"xanadu.ixx\"

ostream& operator<< (ostream& oo, XuCountedP obj)
{
    if (obj == XU_NULL) {
	oo << \"XU_NULL\";
    } else {
	obj->printOn (oo);
    }
    return oo;
}

";

$before{"Promise"} = "

ostream& operator << (ostream& oo, XuCountedP obj);
";

$extra{"Promise"} = "
	public: /* printing */

		virtual void printOn (ostream& oo);

	public: /* status */

		XuBooleanVar isReady ();
		/* TRUE if it's ready and broken, otherwise FALSE */
		XuBooleanVar isBroken ();
		/* isReady() && ! isBroken() */
		XuBooleanVar isFulfilled ();

		/* zero if (!isBroken()) */
		XuIntVar problem ();

		/* for reporting back to customer support - the source of the problem */
		XuIntVar source ();

		/* NULL unless problem () returns XuBroken_PROMISE */
		XuPromiseP XU_OR_NULL excuse ();

	public: /* comm */

		/* this will be isReady () afterwards */
		void force (); /* thingToDo: name? */

		/* all existing promises will be isReady() afterwards */
		static void forceAll (); /* thingToDo: name, location? */

	/* ------ INTERNAL ------ */

	public: /* storage */

		virtual void destroy ();


	public: /* internal comm */

		/* cause an error if not fulfilled */
		void mustBeFulfilled ();

		/* force this promise if it is not in an XuTry block */
		void forceIfNeeded ();

		/* remember the sequence->Promise mapping until the next force */
		void rememberNumber ();

		XuIntVar sequence ();

	protected: /* types */

	/* thingToDo: move to private file as global functions? */

		static XuPromiseP actualCast (XuPromiseSpecP spec, XuPromiseP obj);
		static XuBooleanValueP actualIsTypeOf (XuPromiseSpecP spec, XuPromiseP obj);

	private: /* accessing */

		friend class XuConnection;

		void beBroken (XuIntVar problem, XuIntVar source);
		void beExcused (XuPromiseP excuse);

	protected: /* accessing */

		friend class XuConnection;
		friend class XuPromiseSpec;
		friend class XuDetectorHook;

	private: /* instance variables */

		XuIntVar mySequence; /* sequence number */
		XuIntVar myProblem; /* if broken, then the problem number; else 0 */
		XuIntVar mySource; /* if broken, then a reference number for support; else 0 */
		XuPromiseP myExcuse; /* if myProblem = XuBroken_PROMISE, then the excuse; else XU_NULL */
";

