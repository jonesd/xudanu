$before{"TableStepper"} =
"
extern XuIntVar XuEmptyStepperProblems[];

#define XuFor(ValueClass,valueVar,stepper) {					\\
	XuStepperP xuStepper = (stepper); 					\\
	XuBooleanVar xuAtEnd = FALSE; 						\\
	for (;; xuKludgeStep (xuStepper)) { 					\\
		XU_CAT(ValueClass,P) valueVar; 					\\
		XuTry(XuEmptyStepperProblems) { 				\\
			valueVar = ValueClass::cast (xuStepper->get ()); 	\\
		} XuCatch(xuProblem) { 						\\
			xuAtEnd = TRUE; 					\\
		} XuEndTry 							\\
		if (xuAtEnd) { 							\\
			break; 							\\
		} 								\\
		{

#define XuEndFor } } }

#define XuForPairs(PosClass,posVar,ValueClass,valueVar,stepper) {		\\
	XuTableStepperP xuStepper = (stepper); 					\\
	XuBooleanVar xuAtEnd = FALSE; 						\\
	XuVoidP xuTemp;								\\
	for (;; xuKludgeStep (xuStepper)) { 					\\
		XU_CAT(ValueClass,P) valueVar; 					\\
		XU_CAT(PosClass,P) posVar; 					\\
		XuTry(XuEmptyStepperProblems) { 				\\
			posVar = PosClass::cast (xuStepper->position ()); 	\\
			valueVar = ValueClass::cast (xuStepper->get ()); 	\\
		} XuCatch(xuProblem) { 						\\
			xuAtEnd = TRUE; 					\\
		} XuEndTry 							\\
		if (xuAtEnd) { 							\\
			break; 							\\
		} 								\\
		{

#define XuEndForPairs } } }

";
	
$extra{"HXX"} =
"
/*////////////////////////// FLUIDS //////////////////////////////// */

XU_DECLARE_FLUID_TYPE(XuID)
XU_DECLARE_FLUID_TYPE(XuKeyMaster)

XU_DECLARE_FLUID(XuKeyMaster,XuCurrentKeyMaster)
XU_DECLARE_FLUID(XuID,XuCurrentAuthor)
XU_DECLARE_FLUID(XuID,XuInitialOwner)
XU_DECLARE_FLUID(XuID,XuInitialReadClub)
XU_DECLARE_FLUID(XuID,XuInitialEditClub)
XU_DECLARE_FLUID(XuID,XuInitialSponsor)

#define XuBind(VarName,value) 						\\
	{ 								\\
		XU_CAT(VarName,Restorer) XU_CAT3(xu,VarName,Restorer) (&VarName,xuTCS); \\
		VarName.set (value);

#define XuEndBind	 						\\
	}

/*/////////////////////// DELAY / TRY / CATCH ////////////////////// */

#define XuTry(ProblemList) 						\\
	{	XuErrorStepperP xuErrors;				\\
		{	XuErrorCollector xuCollector (ProblemList,xuTCS);\\
			{

#define XuCatch(Decl) 							\\
			} 						\\
			XuPromise::forceAll (); 			\\
			xuErrors = xuCollector.errors ();	 	\\
		} 							\\
		for (; ! xuErrors->atEnd (); xuErrors->step ()) { 	\\
			XuPromiseP Decl = xuErrors->get ();		\\
			{

#define XuEndTry 							\\
			} 						\\
		} 							\\
	}

#define XU_ALL_BUT	-1
extern XuIntVar XuNoProblems[];
extern XuIntVar XuAllProblems[];

#define XuDelay							\\
	{	XuErrorCollector xuCollector (XuAllProblems,xuTCS);\\
		{

#define	XuEndDelay						\\
		} 						\\
		XuPromise::forceAll (); 			\\
	}


#define XuIf(expr) 					\\
	{ XuBooleanValueP xuInternalP;			\\
	  XuDelay {					\\
		xuInternalP = (expr); 			\\
	  } XuEndDelay					\\
          if (!xuInternalP->isBroken() 			\\
	      && xuInternalP->asBoolean())

#define XuElse 						\\
          else if (!xuInternalP->isBroken() 		\\
	      && !xuInternalP->asBoolean())

#define XuBroken 					\\
          else if (xuInternalP->isBroken())

#define XuEndIf 					\\
	}

#define XuSwitch(expr) 					\\
	{ XuIntValueP xuInternalP;			\\
	  XuDelay {					\\
		xuInternalP = (expr); 			\\
	  } XuEndDelay					\\
          if (!xuInternalP->isBroken()) 		\\
	     switch(xuInternalP->asInt())

#define XuEndSwitch 					\\
	}



