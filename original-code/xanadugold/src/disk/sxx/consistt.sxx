/* ====== Object Migrator for Scavenging of TrackCBlocks ====== */

void TrackCBlocks::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((TrackCBlocks*)origin)->myBootPlan,
				       (Heaper**)&myBootPlan);
	} else {
		myBootPlan.forwardTo (Heaplet::forward (myBootPlan));
	}
}

/*----------------------- END TrackCBlocks -----------------------*/

