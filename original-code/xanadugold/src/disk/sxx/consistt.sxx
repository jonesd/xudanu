/*----------------------- BEGIN CBlockTracker -----------------------*/
DEFINE_CLASS_CATEGORY(CBlockTracker,Heaper)
DEFINE_OPAQUE_TYPE(CBlockTracker);

void CBlockTracker::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "CBlockTracker" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of CBlockTracker ====== */

void CBlockTracker::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((CBlockTracker*)origin)->myDirtyInfos,
				       (Heaper**)&myDirtyInfos);
		Heaplet::forwardToOld ((Heaper**)&((CBlockTracker*)origin)->myOuterTracker,
				       (Heaper**)&myOuterTracker);
	} else {
		myDirtyInfos.forwardTo (Heaplet::forward (myDirtyInfos));
		myOuterTracker.forwardTo (Heaplet::forward (myOuterTracker));
	}
}

/*----------------------- END CBlockTracker -----------------------*/


/*----------------------- BEGIN CBlockTrackingPacker -----------------------*/
DEFINE_CLASS_CATEGORY(CBlockTrackingPacker,DiskManager)
DEFINE_OPAQUE_TYPE(CBlockTrackingPacker);

void CBlockTrackingPacker::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "CBlockTrackingPacker" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of CBlockTrackingPacker ====== */

void CBlockTrackingPacker::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->DiskManager::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((CBlockTrackingPacker*)origin)->myPacker,
				       (Heaper**)&myPacker);
		Heaplet::forwardToOld ((Heaper**)&((CBlockTrackingPacker*)origin)->myTracker,
				       (Heaper**)&myTracker);
	} else {
		myPacker.forwardTo (Heaplet::forward (myPacker));
		myTracker.forwardTo (Heaplet::forward (myTracker));
	}
}

/*----------------------- END CBlockTrackingPacker -----------------------*/


