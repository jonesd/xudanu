/*----------------------- BEGIN TrackCBlocks -----------------------*/
DEFINE_CLASS_CATEGORY(TrackCBlocks,BootPlan)

void TrackCBlocks::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "TrackCBlocks" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void TrackCBlocks::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myBootPlan);
}

TrackCBlocks::TrackCBlocks (APTR(Rcvr) receiver, TCSJ)
{
    myBootPlan = CAST(BootPlan, receiver->receiveHeaper());
}


void parseInto_TrackCBlocks (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) TrackCBlocks (rcvr, tcsj);
}

extern Recipe * BootCuisine;
ActualCopyRecipe TrackCBlocks_recipe(cat_TrackCBlocks, &BootCuisine, parseInto_TrackCBlocks);


/* #endif */ /* WITH_RPC */


