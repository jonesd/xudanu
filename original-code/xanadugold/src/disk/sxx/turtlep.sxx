/* ===== mayBecome support between stub and concrete Shepherd ===== */

extern Category * cat_TurtleStub;
DEFINE_MAY_BECOME(SimpleTurtle,TurtleStub)
DEFINE_MAY_BECOME(TurtleStub,SimpleTurtle)

/* ====== Object Migrator for Scavenging of SimpleTurtle ====== */

void SimpleTurtle::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Turtle::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SimpleTurtle*)origin)->myCounter,
				       (Heaper**)&myCounter);
		Heaplet::forwardToOld ((Heaper**)&((SimpleTurtle*)origin)->myBootHeaper,
				       (Heaper**)&myBootHeaper);
		Heaplet::forwardToOld ((Heaper**)&((SimpleTurtle*)origin)->myProtocol,
				       (Heaper**)&myProtocol);
		Heaplet::forwardToOld ((Heaper**)&((SimpleTurtle*)origin)->myCookbook,
				       (Heaper**)&myCookbook);
		Heaplet::forwardToOld ((Heaper**)&((SimpleTurtle*)origin)->myAgenda,
				       (Heaper**)&myAgenda);
	} else {
		myCounter.forwardTo (Heaplet::forward (myCounter));
		myBootHeaper.forwardTo (Heaplet::forward (myBootHeaper));
		myProtocol.forwardTo (Heaplet::forward (myProtocol));
		myCookbook.forwardTo (Heaplet::forward (myCookbook));
		myAgenda.forwardTo (Heaplet::forward (myAgenda));
	}
}

/*----------------------- END SimpleTurtle -----------------------*/

