/* ====== Copy Class "SimpleTurtle" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void SimpleTurtle::sendSelfTo (APTR(Xmtr) xmtr)
{
    Turtle::sendSelfTo (xmtr);
    xmtr->sendHeaper(myCounter);
    xmtr->sendHeaper(myBootHeaper);
    xmtr->sendHeaper(myBootCategory);
    xmtr->sendHeaper(myAgenda);
}

SimpleTurtle::SimpleTurtle (APTR(Rcvr) receiver, TCSJ)
  : Turtle (receiver, tcsj) {
    myCounter = CAST(Counter, receiver->receiveHeaper());
    myBootHeaper = CAST(Heaper, receiver->receiveHeaper());
    myBootCategory = CAST(Category, receiver->receiveHeaper());
    myAgenda = CAST(Agenda, receiver->receiveHeaper());
    this->restartSimpleTurtle(receiver);
}


void parseInto_SimpleTurtle (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) SimpleTurtle (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe SimpleTurtle_recipe(cat_SimpleTurtle, &DiskCuisine, parseInto_SimpleTurtle);


/* #endif */ /* WITH_RPC */


