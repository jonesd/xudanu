/* ====== Shepherd Patriarch Class "MultiCounter" ======= */

#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Shepherd Stub Class "MultiCounterStub" ======= */


#ifndef DISKMANX_HXX
#include "diskmanx.hxx" 
#define DISKMANX_HXX
#endif /* DISKMANX_HXX */

extern Category * cat_MultiCounterStub;

CLASS(MultiCounterStub,MultiCounter) {
	CONCRETE(MultiCounterStub)
	MANUAL_GC(MultiCounterStub)
	NOT_A_TYPE(MultiCounterStub)
  public:
	inline MultiCounterStub(ShepFlag, UInt32 aHash, APTR(FlockInfo) info) 
          :  MultiCounter(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

    void decrementBoth() {
    (this)->getReal()->decrementBoth();
    }

    IntegerVar decrementFirst() {
    return (this)->getReal()->decrementFirst();
    }

    IntegerVar decrementSecond() {
    return (this)->getReal()->decrementSecond();
    }

    IntegerVar firstCount() {
    return (this)->getReal()->firstCount();
    }

    void incrementBoth() {
    (this)->getReal()->incrementBoth();
    }

    IntegerVar incrementFirst() {
    return (this)->getReal()->incrementFirst();
    }

    IntegerVar incrementSecond() {
    return (this)->getReal()->incrementSecond();
    }

    IntegerVar secondCount() {
    return (this)->getReal()->secondCount();
    }

    UInt32 contentsHash() {
    return (this)->getReal()->contentsHash();
    }

    void dismantle() {
    ((this)->getReal());
    this->dismantle();
    }

    void diskUpdate() {
    ((this)->getReal());
    this->diskUpdate();
    }

    void destroy() {
    (this)->getReal()->destroy();
    }

    BooleanVar isPurgeable() {
    return (this)->getReal()->isPurgeable();
    }

    BooleanVar isUnlocked() {
    return (this)->getReal()->isUnlocked();
    }

    void restartAbraham(WSP2_Rcvr arg1) {
    (this)->getReal()->restartAbraham(arg1);
    }

    UInt32 hashForEqual() {
    return (this)->getReal()->hashForEqual();
    }

    void printContentsOn(ostream& arg1) {
    (this)->getReal()->printContentsOn(arg1);
    }

    void changeClassToThatOf(WSP2_Heaper arg1) {
    (this)->getReal()->changeClassToThatOf(arg1);
    }

    void sendSelfTo(WSP2_Xmtr arg1) {
    (this)->getReal()->sendSelfTo(arg1);
    }


    private:
      MultiCounter *	getReal();  // just * in case not a type

	// Stripped-down COPY(MultiCounterStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * MultiCounter::getShepherdStubCategory () CONST
{
        return cat_MultiCounterStub;
}

void MultiCounter::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) MultiCounterStub (shepFlag, hash, info);
}

/* ===== MultiCounterStub Implementations ==== */

void MultiCounterStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

MultiCounter * MultiCounterStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar MultiCounterStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_MultiCounterStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_MultiCounter)) {
		return ((MultiCounterStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(MultiCounterStub,MultiCounter)

void MultiCounterStub::deferredHack () { /* intentionally blank */ }

/* #ifdef WITH_RPC */
/* ====== Stub Recipe for MultiCounter ====== */

#ifndef STUBRCPX_HXX
#include "stubrcpx.hxx"
#define STUBRCPX_HXX
#endif /* STUBRCPX_HXX */

RPTR(Heaper) parseStub_MultiCounter (APTR(Rcvr) /*rcvr*/, UInt32 hash) {
	RETURN_CONSTRUCT(MultiCounterStub, (shepFlag, hash, NULL));
}

extern Recipe * DiskCuisine;
ActualStubRecipe MultiCounterStub_recipe(cat_MultiCounterStub, &DiskCuisine, parseStub_MultiCounter);

/* #endif */ /* WITH_RPC */

/* ===== mayBecome support between stub and concrete Shepherd Prototype ===== */

DEFINE_MAY_BECOME(MultiCounter,MultiCounterStub)
DEFINE_MAY_BECOME(MultiCounterStub,MultiCounter)

/* ====== Object Migrator for Scavenging of MultiCounter ====== */

void MultiCounter::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((MultiCounter*)origin)->myFirst,
				       (Heaper**)&myFirst);
		Heaplet::forwardToOld ((Heaper**)&((MultiCounter*)origin)->mySecond,
				       (Heaper**)&mySecond);
	} else {
		myFirst.forwardTo (Heaplet::forward (myFirst));
		mySecond.forwardTo (Heaplet::forward (mySecond));
	}
}

/*----------------------- END MultiCounter -----------------------*/

