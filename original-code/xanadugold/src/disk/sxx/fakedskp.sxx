/* ===== mayBecome support between stub and concrete Shepherd ===== */

extern Category * cat_TurtleStub;
DEFINE_MAY_BECOME(MockTurtle,TurtleStub)
DEFINE_MAY_BECOME(TurtleStub,MockTurtle)

/* ====== Object Migrator for Scavenging of MockTurtle ====== */

void MockTurtle::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Turtle::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((MockTurtle*)origin)->myAgenda,
				       (Heaper**)&myAgenda);
	} else {
		myAgenda.forwardTo (Heaplet::forward (myAgenda));
	}
}

/*----------------------- END MockTurtle -----------------------*/

