/*----------------------- BEGIN FakePacker -----------------------*/
DEFINE_CLASS_CATEGORY(FakePacker,DiskManager)
DEFINE_OPAQUE_TYPE(FakePacker);

void FakePacker::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "FakePacker" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of FakePacker ====== */

void FakePacker::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->DiskManager::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FakePacker*)origin)->myTurtle,
				       (Heaper**)&myTurtle);
	} else {
		myTurtle.forwardTo (Heaplet::forward (myTurtle));
	}
}

/*----------------------- END FakePacker -----------------------*/


/*----------------------- BEGIN MockTurtle -----------------------*/
DEFINE_CLASS_CATEGORY(MockTurtle,Turtle)
DEFINE_OPAQUE_TYPE(MockTurtle);

void MockTurtle::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "MockTurtle" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void MockTurtle::sendSelfTo (APTR(Xmtr) xmtr)
{
    Turtle::sendSelfTo (xmtr);
    xmtr->sendHeaper(myAgenda);
    xmtr->sendHeaper(myBootCategory);
}

MockTurtle::MockTurtle (APTR(Rcvr) receiver, TCSJ)
  : Turtle (receiver, tcsj) {
    myAgenda = CAST(Agenda, receiver->receiveHeaper());
    myBootCategory = CAST(Category, receiver->receiveHeaper());
}


void parseInto_MockTurtle (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) MockTurtle (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe MockTurtle_recipe(cat_MockTurtle, &DiskCuisine, parseInto_MockTurtle);


/* #endif */ /* WITH_RPC */


