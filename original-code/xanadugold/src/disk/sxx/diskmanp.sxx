/* ====== Object Migrator for Scavenging of DiskConnection ====== */

void DiskConnection::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((DiskConnection*)origin)->myHeaper,
				       (Heaper**)&myHeaper);
	} else {
		myHeaper.forwardTo (Heaplet::forward (myHeaper));
	}
}

