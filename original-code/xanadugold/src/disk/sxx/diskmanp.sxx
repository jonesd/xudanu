void FromDiskPlan::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "FromDiskPlan" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void FromDiskPlan::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myCategory);
    xmtr->sendString(myFilename);
}

FromDiskPlan::FromDiskPlan (APTR(Rcvr) receiver, TCSJ)
{
    myCategory = CAST(Category, receiver->receiveHeaper());
    myFilename = receiver->receiveString();
}


void parseInto_FromDiskPlan (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) FromDiskPlan (rcvr, tcsj);
}

extern Recipe * BootCuisine;
ActualCopyRecipe FromDiskPlan_recipe(cat_FromDiskPlan, &BootCuisine, parseInto_FromDiskPlan);


/* #endif */ /* WITH_RPC */


