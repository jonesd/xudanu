/* ====== Object Migrator for Scavenging of Cattleman ====== */

void Cattleman::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Cattleman*)origin)->myPasture,
				       (Heaper**)&myPasture);
	} else {
		myPasture.forwardTo (Heaplet::forward (myPasture));
	}
}

/*----------------------- END Cattleman -----------------------*/


