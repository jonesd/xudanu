/* ====== Object Migrator for Scavenging of DiskManager ====== */

void DiskManager::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((DiskManager*)origin)->myFlockInfoTable,
				       (Heaper**)&myFlockInfoTable);
		Heaplet::forwardToOld ((Heaper**)&((DiskManager*)origin)->myFlockTable,
				       (Heaper**)&myFlockTable);
	} else {
		myFlockInfoTable.forwardTo (Heaplet::forward (myFlockInfoTable));
		myFlockTable.forwardTo (Heaplet::forward (myFlockTable));
	}
}

/*----------------------- END DiskManager -----------------------*/


