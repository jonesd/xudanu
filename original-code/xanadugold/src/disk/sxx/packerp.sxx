/*----------------------- BEGIN DiskSpecialist -----------------------*/
DEFINE_CLASS_CATEGORY(DiskSpecialist,TransferSpecialist)

void DiskSpecialist::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "DiskSpecialist" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of DiskSpecialist ====== */

void DiskSpecialist::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->TransferSpecialist::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((DiskSpecialist*)origin)->myPacker,
				       (Heaper**)&myPacker);
	} else {
		myPacker.forwardTo (Heaplet::forward (myPacker));
	}
}

/*----------------------- END DiskSpecialist -----------------------*/


