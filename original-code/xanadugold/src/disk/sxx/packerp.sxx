void DiskIniter::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myCategory);
    xmtr->sendString(myFilename);
}

DiskIniter::DiskIniter (APTR(Rcvr) receiver, TCSJ)
{
    myCategory = CAST(Category, receiver->receiveHeaper());
    myFilename = receiver->receiveString();
}


