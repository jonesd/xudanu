#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void SpareStageSpace::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendInt32(myCruftedSnarfCount);
    xmtr->sendInt32(myFlocksPerSnarf);
}

SpareStageSpace::SpareStageSpace (APTR(Rcvr) receiver, TCSJ)
{
    myCruftedSnarfCount = receiver->receiveInt32();
    myFlocksPerSnarf = receiver->receiveInt32();
}


void parseInto_SpareStageSpace (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) SpareStageSpace (rcvr, tcsj);
}

