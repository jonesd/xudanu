DEFINE_CLASS_CATEGORY(SnarfRecord,Heaper)
DEFINE_OPAQUE_TYPE(SnarfRecord);

void SnarfRecord::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "SnarfRecord" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */


BooleanVar SnarfRecord::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 SnarfRecord::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of SnarfRecord ====== */

void SnarfRecord::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SnarfRecord*)origin)->myPacker,
				       (Heaper**)&myPacker);
		Heaplet::forwardToOld ((Heaper**)&((SnarfRecord*)origin)->myOccupied,
				       (Heaper**)&myOccupied);
		Heaplet::forwardToOld ((Heaper**)&((SnarfRecord*)origin)->myChangedFlocks,
				       (Heaper**)&myChangedFlocks);
	} else {
		myPacker.forwardTo (Heaplet::forward (myPacker));
		myOccupied.forwardTo (Heaplet::forward (myOccupied));
		myChangedFlocks.forwardTo (Heaplet::forward (myChangedFlocks));
	}
}

/*----------------------- END SnarfRecord -----------------------*/


