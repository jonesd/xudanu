/* ====== Object Migrator for Scavenging of PairFlock ====== */

void PairFlock::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((PairFlock*)origin)->myLeft,
				       (Heaper**)&myLeft);
		Heaplet::forwardToOld ((Heaper**)&((PairFlock*)origin)->myRight,
				       (Heaper**)&myRight);
	} else {
		myLeft.forwardTo (Heaplet::forward (myLeft));
		myRight.forwardTo (Heaplet::forward (myRight));
	}
}

/*----------------------- END PairFlock -----------------------*/


