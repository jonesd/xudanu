DEFINE_CLASS_CATEGORY(TestPacker,DiskManager)
DEFINE_OPAQUE_TYPE(TestPacker);

void TestPacker::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "TestPacker" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of TestPacker ====== */

void TestPacker::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->DiskManager::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((TestPacker*)origin)->myInitialFlock,
				       (Heaper**)&myInitialFlock);
		Heaplet::forwardToOld ((Heaper**)&((TestPacker*)origin)->myFlocks,
				       (Heaper**)&myFlocks);
		Heaplet::forwardToOld ((Heaper**)&((TestPacker*)origin)->myChangedFlocks,
				       (Heaper**)&myChangedFlocks);
		Heaplet::forwardToOld ((Heaper**)&((TestPacker*)origin)->myDestroyedFlocks,
				       (Heaper**)&myDestroyedFlocks);
		Heaplet::forwardToOld ((Heaper**)&((TestPacker*)origin)->myAlmostNewFlocks,
				       (Heaper**)&myAlmostNewFlocks);
		Heaplet::forwardToOld ((Heaper**)&((TestPacker*)origin)->myNewFlocks,
				       (Heaper**)&myNewFlocks);
		Heaplet::forwardToOld ((Heaper**)&((TestPacker*)origin)->myXcvrMaker,
				       (Heaper**)&myXcvrMaker);
		Heaplet::forwardToOld ((Heaper**)&((TestPacker*)origin)->myDisk,
				       (Heaper**)&myDisk);
		Heaplet::forwardToOld ((Heaper**)&((TestPacker*)origin)->myBook,
				       (Heaper**)&myBook);
	} else {
		myInitialFlock.forwardTo (Heaplet::forward (myInitialFlock));
		myFlocks.forwardTo (Heaplet::forward (myFlocks));
		myChangedFlocks.forwardTo (Heaplet::forward (myChangedFlocks));
		myDestroyedFlocks.forwardTo (Heaplet::forward (myDestroyedFlocks));
		myAlmostNewFlocks.forwardTo (Heaplet::forward (myAlmostNewFlocks));
		myNewFlocks.forwardTo (Heaplet::forward (myNewFlocks));
		myXcvrMaker.forwardTo (Heaplet::forward (myXcvrMaker));
		myDisk.forwardTo (Heaplet::forward (myDisk));
		myBook.forwardTo (Heaplet::forward (myBook));
	}
}

/*----------------------- END TestPacker -----------------------*/

