#ifndef DISKMANX_HXX
#include "diskmanx.hxx" 
#define DISKMANX_HXX
#endif /* DISKMANX_HXX */

extern Category * cat_DoublingFlockStub;

CLASS(DoublingFlockStub,DoublingFlock) {
	CONCRETE(DoublingFlockStub)
	MANUAL_GC(DoublingFlockStub)
	NOT_A_TYPE(DoublingFlockStub)
  public:
	inline DoublingFlockStub(ShepFlag, UInt32 aHash, APTR(FlockInfo) info) 
          :  DoublingFlock(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

    Int32 count() {
    return (this)->getReal()->count();
    }

    void doDouble() {
    (this)->getReal()->doDouble();
    }

    void receiveTestFlock(WSP2_Rcvr arg1) {
    (this)->getReal()->receiveTestFlock(arg1);
    }

    void sendTestFlock(WSP2_Xmtr arg1) {
    (this)->getReal()->sendTestFlock(arg1);
    }

    UInt32 contentsHash() {
    return (this)->getReal()->contentsHash();
    }

    void dismantle() {
    ((this)->getReal());
    this->dismantle();
    }

    void diskUpdate() {
    ((this)->getReal());
    this->diskUpdate();
    }

    void destroy() {
    (this)->getReal()->destroy();
    }

    BooleanVar isPurgeable() {
    return (this)->getReal()->isPurgeable();
    }

    BooleanVar isUnlocked() {
    return (this)->getReal()->isUnlocked();
    }

    void restartAbraham(WSP2_Rcvr arg1) {
    (this)->getReal()->restartAbraham(arg1);
    }

    UInt32 hashForEqual() {
    return (this)->getReal()->hashForEqual();
    }

    void printContentsOn(ostream& arg1) {
    (this)->getReal()->printContentsOn(arg1);
    }

    void changeClassToThatOf(WSP2_Heaper arg1) {
    (this)->getReal()->changeClassToThatOf(arg1);
    }

    void sendSelfTo(WSP2_Xmtr arg1) {
    (this)->getReal()->sendSelfTo(arg1);
    }


    private:
      DoublingFlock *	getReal();  // just * in case not a type

	// Stripped-down COPY(DoublingFlockStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * DoublingFlock::getShepherdStubCategory () CONST
{
        return cat_DoublingFlockStub;
}

void DoublingFlock::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) DoublingFlockStub (shepFlag, hash, info);
}

/* ===== DoublingFlockStub Implementations ==== */

void DoublingFlockStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

DoublingFlock * DoublingFlockStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar DoublingFlockStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_DoublingFlockStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_DoublingFlock)) {
		return ((DoublingFlockStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(DoublingFlockStub,DoublingFlock)

