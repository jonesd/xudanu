DEFINE_CLASS_CATEGORY(DoublingFlock,Abraham)
DEFINE_OPAQUE_TYPE(DoublingFlock);

void DoublingFlock::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "DoublingFlock" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void DoublingFlock::sendSelfTo (APTR(Xmtr) xmtr)
{
    Abraham::sendSelfTo (xmtr);
    xmtr->sendInt32(myCount);
    this->sendTestFlock(xmtr);
}

DoublingFlock::DoublingFlock (APTR(Rcvr) receiver, TCSJ)
  : Abraham (receiver, tcsj) {
    myCount = receiver->receiveInt32();
    this->receiveTestFlock(receiver);
}


void parseInto_DoublingFlock (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) DoublingFlock (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe DoublingFlock_recipe(cat_DoublingFlock, &DiskCuisine, parseInto_DoublingFlock);


