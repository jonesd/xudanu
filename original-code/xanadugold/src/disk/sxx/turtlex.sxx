void Sequencer::sendSelfTo (APTR(Xmtr) xmtr)
{
    AgendaItem::sendSelfTo (xmtr);
    xmtr->sendHeaper(myFirst);
    xmtr->sendHeaper(myRest);
}

Sequencer::Sequencer (APTR(Rcvr) receiver, TCSJ)
  : AgendaItem (receiver, tcsj) {
    myFirst = CAST(AgendaItem, receiver->receiveHeaper());
    myRest = CAST(AgendaItem, receiver->receiveHeaper());
}


void parseInto_Sequencer (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) Sequencer (rcvr, tcsj);
