DEFINE_MAY_BECOME(Agenda,AgendaStub)
DEFINE_MAY_BECOME(AgendaStub,Agenda)

/* ====== Object Migrator for Scavenging of Agenda ====== */

void Agenda::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->AgendaItem::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Agenda*)origin)->myToDoList,
				       (Heaper**)&myToDoList);
	} else {
		myToDoList.forwardTo (Heaplet::forward (myToDoList));
	}
}

/*----------------------- END Agenda -----------------------*/


