DEFINE_MAY_BECOME(Sequencer,SequencerStub)
DEFINE_MAY_BECOME(SequencerStub,Sequencer)

/* ====== Object Migrator for Scavenging of Sequencer ====== */

void Sequencer::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->AgendaItem::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Sequencer*)origin)->myFirst,
				       (Heaper**)&myFirst);
		Heaplet::forwardToOld ((Heaper**)&((Sequencer*)origin)->myRest,
				       (Heaper**)&myRest);
	} else {
		myFirst.forwardTo (Heaplet::forward (myFirst));
		myRest.forwardTo (Heaplet::forward (myRest));
	}
}

