    private:
      Turtle *	getReal();  // just * in case not a type

	// Stripped-down COPY(TurtleStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * Turtle::getShepherdStubCategory () CONST
{
        return cat_TurtleStub;
}

void Turtle::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) TurtleStub (shepFlag, hash, info);
}

/* ===== TurtleStub Implementations ==== */

void TurtleStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

Turtle * TurtleStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar TurtleStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_TurtleStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_Turtle)) {
		return ((TurtleStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(TurtleStub,Turtle)

void TurtleStub::deferredHack () { /* intentionally blank */ }

