void Agenda::sendSelfTo (APTR(Xmtr) xmtr)
{
    AgendaItem::sendSelfTo (xmtr);
    xmtr->sendHeaper(myToDoList);
}

Agenda::Agenda (APTR(Rcvr) receiver, TCSJ)
  : AgendaItem (receiver, tcsj) {
    myToDoList = CAST(MuSet, receiver->receiveHeaper());
}


