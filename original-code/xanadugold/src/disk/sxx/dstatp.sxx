/* ====== Object Migrator for Scavenging of SnarfStatistics ====== */

void SnarfStatistics::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SnarfStatistics*)origin)->myCookbook,
				       (Heaper**)&myCookbook);
		Heaplet::forwardToOld ((Heaper**)&((SnarfStatistics*)origin)->myProtocol,
				       (Heaper**)&myProtocol);
	} else {
		myCookbook.forwardTo (Heaplet::forward (myCookbook));
		myProtocol.forwardTo (Heaplet::forward (myProtocol));
	}
}

/*----------------------- END SnarfStatistics -----------------------*/


