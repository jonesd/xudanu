#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void SnarfStatistics::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendString(myFilename);
}

SnarfStatistics::SnarfStatistics (APTR(Rcvr) receiver, TCSJ)
{
    myFilename = receiver->receiveString();
}


void parseInto_SnarfStatistics (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) SnarfStatistics (rcvr, tcsj);
}

extern Recipe * BootCuisine;
ActualCopyRecipe SnarfStatistics_recipe(cat_SnarfStatistics, &BootCuisine, parseInto_SnarfStatistics);


/* #endif */ /* WITH_RPC */


