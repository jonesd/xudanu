/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of SnarfInfoHandler ====== */

void SnarfInfoHandler::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SnarfInfoHandler*)origin)->mySnarfs,
				       (Heaper**)&mySnarfs);
	} else {
		mySnarfs.forwardTo (Heaplet::forward (mySnarfs));
	}
}

/*----------------------- END SnarfInfoHandler -----------------------*/

