/*----------------------- BEGIN LiberalPurgeror -----------------------*/
DEFINE_CLASS_CATEGORY(LiberalPurgeror,RepairEngineer)
DEFINE_OPAQUE_TYPE(LiberalPurgeror);

void LiberalPurgeror::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "LiberalPurgeror" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of LiberalPurgeror ====== */

void LiberalPurgeror::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->RepairEngineer::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((LiberalPurgeror*)origin)->myPacker,
				       (Heaper**)&myPacker);
	} else {
		myPacker.forwardTo (Heaplet::forward (myPacker));
	}
}

/*----------------------- END LiberalPurgeror -----------------------*/


