/* ====== Object Migrator for Scavenging of SnarfPacker ====== */

void SnarfPacker::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->DiskManager::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SnarfPacker*)origin)->mySnarfInfo,
				       (Heaper**)&mySnarfInfo);
		Heaplet::forwardToOld ((Heaper**)&((SnarfPacker*)origin)->myTurtle,
				       (Heaper**)&myTurtle);
		Heaplet::forwardToOld ((Heaper**)&((SnarfPacker*)origin)->mySnarfMap,
				       (Heaper**)&mySnarfMap);
		Heaplet::forwardToOld ((Heaper**)&((SnarfPacker*)origin)->myFlockdown
s,
				       (Heaper**)&myFlocks);
		Heaplet::forwardToOld ((Heaper**)&((SnarfPacker*)origin)->myNewFlocks,
				       (Heaper**)&myNewFlocks);
		Heaplet::forwardToOld ((Heaper**)&((SnarfPacker*)origin)->myDestroyedFlocks,
				       (Heaper**)&myDestroyedFlocks);
		Heaplet::forwardToOld ((Heaper**)&((SnarfPacker*)origin)->myXcvrMaker,
				       (Heaper**)&myXcvrMaker);
		Heaplet::forwardToOld ((Heaper**)&((SnarfPacker*)origin)->myBook,
				       (Heaper**)&myBook);
		Heaplet::forwardToOld ((Heaper**)&((SnarfPacker*)origin)->myNextHash,
				       (Heaper**)&myNextHash);
		Heaplet::forwardToOld ((Heaper**)&((SnarfPacker*)origin)->myPurgeror,
				       (Heaper**)&myPurgeror);
		Heaplet::forwardToOld ((Heaper**)&((SnarfPacker*)origin)->myRepairer,
				       (Heaper**)&myRepairer);
	} else {
		mySnarfInfo.forwardTo (Heaplet::forward (mySnarfInfo));
		myTurtle.forwardTo (Heaplet::forward (myTurtle));
		mySnarfMap.forwardTo (Heaplet::forward (mySnarfMap));
		myFlocks.forwardTo (Heaplet::forward (myFlocks));
		myNewFlocks.forwardTo (Heaplet::forward (myNewFlocks));
		myDestroyedFlocks.forwardTo (Heaplet::forward (myDestroyedFlocks));
		myXcvrMaker.forwardTo (Heaplet::forward (myXcvrMaker));
		myBook.forwardTo (Heaplet::forward (myBook));
		myNextHash.forwardTo (Heaplet::forward (myNextHash));
		myPurgeror.forwardTo (Heaplet::forward (myPurgeror));
		myRepairer.forwardTo (Heaplet::forward (myRepairer));
	}
}

