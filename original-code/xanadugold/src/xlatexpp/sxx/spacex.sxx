/*----------------------- BEGIN CoordinateSpace -----------------------*/
DEFINE_CLASS_CATEGORY(CoordinateSpace,Heaper)
DEFINE_OPAQUE_TYPE(CoordinateSpace);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of CoordinateSpace ====== */

void CoordinateSpace::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((CoordinateSpace*)origin)->myEmptyRegion,
				       (Heaper**)&myEmptyRegion);
		Heaplet::forwardToOld ((Heaper**)&((CoordinateSpace*)origin)->myFullRegion,
				       (Heaper**)&myFullRegion);
		Heaplet::forwardToOld ((Heaper**)&((CoordinateSpace*)origin)->myIdentityDsp,
				       (Heaper**)&myIdentityDsp);
		Heaplet::forwardToOld ((Heaper**)&((CoordinateSpace*)origin)->myAscending,
				       (Heaper**)&myAscending);
		Heaplet::forwardToOld ((Heaper**)&((CoordinateSpace*)origin)->myDescending,
				       (Heaper**)&myDescending);
	} else {
		myEmptyRegion.forwardTo (Heaplet::forward (myEmptyRegion));
		myFullRegion.forwardTo (Heaplet::forward (myFullRegion));
		myIdentityDsp.forwardTo (Heaplet::forward (myIdentityDsp));
		myAscending.forwardTo (Heaplet::forward (myAscending));
		myDescending.forwardTo (Heaplet::forward (myDescending));
	}
}

/*----------------------- END CoordinateSpace -----------------------*/


