void SwitchLogger::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendString(myLoggerName);
    xmtr->sendString(myDirective);
}

SwitchLogger::SwitchLogger (APTR(Rcvr) receiver, TCSJ)
{
    myLoggerName = receiver->receiveString();
    myDirective = receiver->receiveString();
}


void parseInto_SwitchLogger (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) SwitchLogger (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe SwitchLogger_recipe(cat_SwitchLogger, &XppCuisine, parseInto_SwitchLogger);


