#define SETTABX_SXX

/*----------------------- BEGIN SetTable -----------------------*/
DEFINE_CLASS_CATEGORY(SetTable,Heaper)
DEFINE_OPAQUE_TYPE(SetTable);

void SetTable::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "SetTable" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void SetTable::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myHashEntries);
    xmtr->sendInt32(myTally);
    xmtr->sendHeaper(myCoordinateSpace);
}

SetTable::SetTable (APTR(Rcvr) receiver, TCSJ)
{
    myHashEntries = CAST(SharedPtrArray, receiver->receiveHeaper());
    myTally = receiver->receiveInt32();
    myCoordinateSpace = CAST(CoordinateSpace, receiver->receiveHeaper());
}


void parseInto_SetTable (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) SetTable (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe SetTable_recipe(cat_SetTable, &XppCuisine, parseInto_SetTable);


/* #endif */ /* WITH_RPC */



BooleanVar SetTable::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 SetTable::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of SetTable ====== */

void SetTable::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SetTable*)origin)->myHashEntries,
				       (Heaper**)&myHashEntries);
		Heaplet::forwardToOld ((Heaper**)&((SetTable*)origin)->myCoordinateSpace,
				       (Heaper**)&myCoordinateSpace);
	} else {
		myHashEntries.forwardTo (Heaplet::forward (myHashEntries));
		myCoordinateSpace.forwardTo (Heaplet::forward (myCoordinateSpace));
	}
}

/*----------------------- END SetTable -----------------------*/

