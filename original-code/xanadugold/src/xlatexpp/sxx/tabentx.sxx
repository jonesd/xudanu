#define TABENTX_SXX

/*----------------------- BEGIN TableEntry -----------------------*/
DEFINE_CLASS_CATEGORY(TableEntry,Heaper)
DEFINE_OPAQUE_TYPE(TableEntry);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "TableEntry" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void TableEntry::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myNext);
    xmtr->sendHeaper(myValue);
}

TableEntry::TableEntry (APTR(Rcvr) receiver, TCSJ)
{
    myNext = CAST(TableEntry, receiver->receiveHeaper());
    myValue = CAST(Heaper, receiver->receiveHeaper());
}


/* #endif */ /* WITH_RPC */



BooleanVar TableEntry::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 TableEntry::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of TableEntry ====== */

void TableEntry::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((TableEntry*)origin)->myNext,
				       (Heaper**)&myNext);
		Heaplet::forwardToOld ((Heaper**)&((TableEntry*)origin)->myValue,
				       (Heaper**)&myValue);
	} else {
		myNext.forwardTo (Heaplet::forward (myNext));
		myValue.forwardTo (Heaplet::forward (myValue));
	}
}

/*----------------------- END TableEntry -----------------------*/

