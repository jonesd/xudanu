/*----------------------- BEGIN IEEE32Pos -----------------------*/
DEFINE_CLASS_CATEGORY(IEEE32Pos,RealPos)
DEFINE_OPAQUE_TYPE(IEEE32Pos);

void IEEE32Pos::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "IEEE32Pos" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void IEEE32Pos::sendSelfTo (APTR(Xmtr) xmtr)
{
    RealPos::sendSelfTo (xmtr);
    xmtr->sendIEEEDoubleVar(myValue);
}

IEEE32Pos::IEEE32Pos (APTR(Rcvr) receiver, TCSJ)
  : RealPos (receiver, tcsj) {
    myValue = receiver->receiveIEEEDoubleVar();
}


void parseInto_IEEE32Pos (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) IEEE32Pos (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe IEEE32Pos_recipe(cat_IEEE32Pos, &XppCuisine, parseInto_IEEE32Pos);


/* #endif */ /* WITH_RPC */




/*----------------------- END IEEE32Pos -----------------------*/


