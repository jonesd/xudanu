/*----------------------- BEGIN RealEdge -----------------------*/
DEFINE_CLASS_CATEGORY(RealEdge,TransitionEdge)
DEFINE_OPAQUE_TYPE(RealEdge);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "RealEdge" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void RealEdge::sendSelfTo (APTR(Xmtr) xmtr)
{
    TransitionEdge::sendSelfTo (xmtr);
    xmtr->sendHeaper(myPos);
}

RealEdge::RealEdge (APTR(Rcvr) receiver, TCSJ)
  : TransitionEdge (receiver, tcsj) {
    myPos = CAST(RealPos, receiver->receiveHeaper());
}


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of RealEdge ====== */

void RealEdge::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((RealEdge*)origin)->myPos,
				       (Heaper**)&myPos);
	} else {
		myPos.forwardTo (Heaplet::forward (myPos));
	}
}

/*----------------------- END RealEdge -----------------------*/


