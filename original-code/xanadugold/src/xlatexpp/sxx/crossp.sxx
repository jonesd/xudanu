/*----------------------- BEGIN ActualTuple -----------------------*/
DEFINE_CLASS_CATEGORY(ActualTuple,Tuple)
DEFINE_OPAQUE_TYPE(ActualTuple);

void ActualTuple::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "ActualTuple" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void ActualTuple::sendSelfTo (APTR(Xmtr) xmtr)
{
    Tuple::sendSelfTo (xmtr);
    xmtr->sendHeaper(myCoordinates);
}

ActualTuple::ActualTuple (APTR(Rcvr) receiver, TCSJ)
  : Tuple (receiver, tcsj) {
    myCoordinates = CAST(PtrArray, receiver->receiveHeaper());
}


void parseInto_ActualTuple (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) ActualTuple (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe ActualTuple_recipe(cat_ActualTuple, &XppCuisine, parseInto_ActualTuple);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of ActualTuple ====== */

void ActualTuple::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ActualTuple*)origin)->myCoordinates,
				       (Heaper**)&myCoordinates);
	} else {
		myCoordinates.forwardTo (Heaplet::forward (myCoordinates));
	}
}

/*----------------------- END ActualTuple -----------------------*/


/*----------------------- BEGIN BoxAccumulator -----------------------*/
DEFINE_CLASS_CATEGORY(BoxAccumulator,Accumulator)
DEFINE_OPAQUE_TYPE(BoxAccumulator);

void BoxAccumulator::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of BoxAccumulator ====== */

void BoxAccumulator::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BoxAccumulator*)origin)->mySpace,
				       (Heaper**)&mySpace);
		Heaplet::forwardToOld ((Heaper**)&((BoxAccumulator*)origin)->myRegions,
				       (Heaper**)&myRegions);
	} else {
		mySpace.forwardTo (Heaplet::forward (mySpace));
		myRegions.forwardTo (Heaplet::forward (myRegions));
	}
}

/*----------------------- END BoxAccumulator -----------------------*/


