/*----------------------- BEGIN TupleStepper -----------------------*/
DEFINE_CLASS_CATEGORY(TupleStepper,Stepper)
DEFINE_OPAQUE_TYPE(TupleStepper);

void TupleStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "TupleStepper" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void TupleStepper::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(mySpace);
    xmtr->sendHeaper(myVirginSteppers);
    xmtr->sendHeaper(mySteppers);
    xmtr->sendHeaper(myLexOrder);
    xmtr->sendHeaper(myValue);
}

TupleStepper::TupleStepper (APTR(Rcvr) receiver, TCSJ)
{
    mySpace = CAST(CrossSpace, receiver->receiveHeaper());
    myVirginSteppers = CAST(PtrArray, receiver->receiveHeaper());
    mySteppers = CAST(PtrArray, receiver->receiveHeaper());
    myLexOrder = CAST(PrimIntArray, receiver->receiveHeaper());
    myValue = CAST(Tuple, receiver->receiveHeaper());
}


void parseInto_TupleStepper (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) TupleStepper (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe TupleStepper_recipe(cat_TupleStepper, &XppCuisine, parseInto_TupleStepper);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of TupleStepper ====== */

void TupleStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((TupleStepper*)origin)->mySpace,
				       (Heaper**)&mySpace);
		Heaplet::forwardToOld ((Heaper**)&((TupleStepper*)origin)->myVirginSteppers,
				       (Heaper**)&myVirginSteppers);
		Heaplet::forwardToOld ((Heaper**)&((TupleStepper*)origin)->mySteppers,
				       (Heaper**)&mySteppers);
		Heaplet::forwardToOld ((Heaper**)&((TupleStepper*)origin)->myLexOrder,
				       (Heaper**)&myLexOrder);
		Heaplet::forwardToOld ((Heaper**)&((TupleStepper*)origin)->myValue,
				       (Heaper**)&myValue);
	} else {
		mySpace.forwardTo (Heaplet::forward (mySpace));
		myVirginSteppers.forwardTo (Heaplet::forward (myVirginSteppers));
		mySteppers.forwardTo (Heaplet::forward (mySteppers));
		myLexOrder.forwardTo (Heaplet::forward (myLexOrder));
		myValue.forwardTo (Heaplet::forward (myValue));
	}
}

/*----------------------- END TupleStepper -----------------------*/

