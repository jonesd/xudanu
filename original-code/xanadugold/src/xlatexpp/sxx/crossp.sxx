void GenericCrossSimpleRegionStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar GenericCrossSimpleRegionStepper::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 GenericCrossSimpleRegionStepper::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of GenericCrossSimpleRegionStepper ====== */

void GenericCrossSimpleRegionStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((GenericCrossSimpleRegionStepper*)origin)->mySpace,
				       (Heaper**)&mySpace);
		Heaplet::forwardToOld ((Heaper**)&((GenericCrossSimpleRegionStepper*)origin)->myBoxes,
				       (Heaper**)&myBoxes);
		Heaplet::forwardToOld ((Heaper**)&((GenericCrossSimpleRegionStepper*)origin)->mySimples,
				       (Heaper**)&mySimples);
	} else {
		mySpace.forwardTo (Heaplet::forward (mySpace));
		myBoxes.forwardTo (Heaplet::forward (myBoxes));
		mySimples.forwardTo (Heaplet::forward (mySimples));
	}
}

/*----------------------- END GenericCrossSimpleRegionStepper -----------------------*/


