/*----------------------- BEGIN AndFilter -----------------------*/
DEFINE_CLASS_CATEGORY(AndFilter,Filter)

void AndFilter::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "AndFilter" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void AndFilter::sendSelfTo (APTR(Xmtr) xmtr)
{
    Filter::sendSelfTo (xmtr);
    xmtr->sendHeaper(mySubFilters);
}

AndFilter::AndFilter (APTR(Rcvr) receiver, TCSJ)
  : Filter (receiver, tcsj) {
    mySubFilters = CAST(ImmuSet, receiver->receiveHeaper());
}


void parseInto_AndFilter (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) AndFilter (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe AndFilter_recipe(cat_AndFilter, &XppCuisine, parseInto_AndFilter);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of AndFilter ====== */

void AndFilter::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Filter::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((AndFilter*)origin)->mySubFilters,
				       (Heaper**)&mySubFilters);
	} else {
		mySubFilters.forwardTo (Heaplet::forward (mySubFilters));
	}
}

/*----------------------- END AndFilter -----------------------*/


