#define PRIMTABX_SXX

/*----------------------- BEGIN PrimIndexTable -----------------------*/
DEFINE_CLASS_CATEGORY(PrimIndexTable,Heaper)
DEFINE_OPAQUE_TYPE(PrimIndexTable);

void PrimIndexTable::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of PrimIndexTable ====== */

void PrimIndexTable::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((PrimIndexTable*)origin)->myPtrs,
				       (Heaper**)&myPtrs);
		Heaplet::forwardToOld ((Heaper**)&((PrimIndexTable*)origin)->myIndices,
				       (Heaper**)&myIndices);
	} else {
		myPtrs.forwardTo (Heaplet::forward (myPtrs));
		myIndices.forwardTo (Heaplet::forward (myIndices));
	}
}

/*----------------------- END PrimIndexTable -----------------------*/


