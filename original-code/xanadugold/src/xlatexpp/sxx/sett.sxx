#define SETT_SXX

/*----------------------- BEGIN ScruSetTester -----------------------*/
DEFINE_CLASS_CATEGORY(ScruSetTester,Tester)
DEFINE_OPAQUE_TYPE(ScruSetTester);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "ScruSetTester" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void ScruSetTester::sendSelfTo (APTR(Xmtr) xmtr)
{
}

ScruSetTester::ScruSetTester (APTR(Rcvr) receiver, TCSJ)
{
    this->restartScruSetTester(receiver);
}


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of ScruSetTester ====== */

void ScruSetTester::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ScruSetTester*)origin)->myTestSets,
				       (Heaper**)&myTestSets);
	} else {
		myTestSets.forwardTo (Heaplet::forward (myTestSets));
	}
}

/*----------------------- END ScruSetTester -----------------------*/


