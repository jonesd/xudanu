/* ====== Object Migrator for Scavenging of SHTO ====== */

void SHTO::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SHTO*)origin)->myStringValue,
				       (Heaper**)&myStringValue);
