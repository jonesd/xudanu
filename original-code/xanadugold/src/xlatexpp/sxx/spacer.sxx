/*----------------------- BEGIN ExplicitArrangement -----------------------*/
DEFINE_CLASS_CATEGORY(ExplicitArrangement,Arrangement)

void ExplicitArrangement::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "ExplicitArrangement" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void ExplicitArrangement::sendSelfTo (APTR(Xmtr) xmtr)
{
    Arrangement::sendSelfTo (xmtr);
    xmtr->sendHeaper(myPositions);
}

ExplicitArrangement::ExplicitArrangement (APTR(Rcvr) receiver, TCSJ)
  : Arrangement (receiver, tcsj) {
    myPositions = CAST(PtrArray, receiver->receiveHeaper());
}


void parseInto_ExplicitArrangement (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) ExplicitArrangement (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe ExplicitArrangement_recipe(cat_ExplicitArrangement, &XppCuisine, parseInto_ExplicitArrangement);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of ExplicitArrangement ====== */

void ExplicitArrangement::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ExplicitArrangement*)origin)->myPositions,
				       (Heaper**)&myPositions);
	} else {
		myPositions.forwardTo (Heaplet::forward (myPositions));
	}
}

/*----------------------- END ExplicitArrangement -----------------------*/


