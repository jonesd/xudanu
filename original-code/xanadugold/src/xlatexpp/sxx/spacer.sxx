/*----------------------- BEGIN MergeStepper -----------------------*/
DEFINE_CLASS_CATEGORY(MergeStepper,Stepper)

void MergeStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "MergeStepper" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void MergeStepper::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myA);
    xmtr->sendHeaper(myB);
    xmtr->sendHeaper(myOrder);
    xmtr->sendHeaper(myValue);
}

MergeStepper::MergeStepper (APTR(Rcvr) receiver, TCSJ)
{
    myA = CAST(Stepper, receiver->receiveHeaper());
    myB = CAST(Stepper, receiver->receiveHeaper());
    myOrder = CAST(OrderSpec, receiver->receiveHeaper());
    myValue = CAST(Position, receiver->receiveHeaper());
}


void parseInto_MergeStepper (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) MergeStepper (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe MergeStepper_recipe(cat_MergeStepper, &XppCuisine, parseInto_MergeStepper);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of MergeStepper ====== */

void MergeStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((MergeStepper*)origin)->myA,
				       (Heaper**)&myA);
		Heaplet::forwardToOld ((Heaper**)&((MergeStepper*)origin)->myB,
				       (Heaper**)&myB);
		Heaplet::forwardToOld ((Heaper**)&((MergeStepper*)origin)->myOrder,
				       (Heaper**)&myOrder);
		Heaplet::forwardToOld ((Heaper**)&((MergeStepper*)origin)->myValue,
				       (Heaper**)&myValue);
	} else {
		myA.forwardTo (Heaplet::forward (myA));
		myB.forwardTo (Heaplet::forward (myB));
		myOrder.forwardTo (Heaplet::forward (myOrder));
		myValue.forwardTo (Heaplet::forward (myValue));
	}
}

/*----------------------- END MergeStepper -----------------------*/

