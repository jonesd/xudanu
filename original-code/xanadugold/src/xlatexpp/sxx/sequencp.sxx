#define SEQUENCP_SXX

/*----------------------- BEGIN SequenceEdge -----------------------*/
DEFINE_CLASS_CATEGORY(SequenceEdge,TransitionEdge)
DEFINE_OPAQUE_TYPE(SequenceEdge);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "SequenceEdge" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void SequenceEdge::sendSelfTo (APTR(Xmtr) xmtr)
{
    TransitionEdge::sendSelfTo (xmtr);
    xmtr->sendHeaper(mySequence);
}

SequenceEdge::SequenceEdge (APTR(Rcvr) receiver, TCSJ)
  : TransitionEdge (receiver, tcsj) {
    mySequence = CAST(Sequence, receiver->receiveHeaper());
}


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of SequenceEdge ====== */

void SequenceEdge::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SequenceEdge*)origin)->mySequence,
				       (Heaper**)&mySequence);
	} else {
		mySequence.forwardTo (Heaplet::forward (mySequence));
	}
}

/*----------------------- END SequenceEdge -----------------------*/


