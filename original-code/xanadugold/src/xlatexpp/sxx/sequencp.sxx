DEFINE_CLASS_CATEGORY(BeforeSequencePrefix,SequenceEdge)

void BeforeSequencePrefix::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "BeforeSequencePrefix" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void BeforeSequencePrefix::sendSelfTo (APTR(Xmtr) xmtr)
{
    SequenceEdge::sendSelfTo (xmtr);
    xmtr->sendIntegerVar(myLimit);
}

BeforeSequencePrefix::BeforeSequencePrefix (APTR(Rcvr) receiver, TCSJ)
  : SequenceEdge (receiver, tcsj) {
    myLimit = receiver->receiveIntegerVar();
}


void parseInto_BeforeSequencePrefix (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) BeforeSequencePrefix (rcvr, tcsj);
}

extern Recipe * XppCuisine;
