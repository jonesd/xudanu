/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of SequenceStepper ====== */

void SequenceStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SequenceStepper*)origin)->myTransitions,
				       (Heaper**)&myTransitions);
	} else {
		myTransitions.forwardTo (Heaplet::forward (myTransitions));
	}
}

/*----------------------- END SequenceStepper -----------------------*/


