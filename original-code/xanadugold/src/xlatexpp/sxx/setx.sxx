/*----------------------- BEGIN MuSet -----------------------*/
DEFINE_CLASS_CATEGORY(MuSet,ScruSet)
DEFINE_OPAQUE_TYPE(MuSet);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar MuSet::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 MuSet::actualHashForEqual ()
{
    return Heaper::takeOop ();
}



/*----------------------- END MuSet -----------------------*/


/*----------------------- BEGIN SetAccumulator -----------------------*/
DEFINE_CLASS_CATEGORY(SetAccumulator,Accumulator)
DEFINE_OPAQUE_TYPE(SetAccumulator);

void SetAccumulator::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "SetAccumulator" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void SetAccumulator::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(muSet);
}

SetAccumulator::SetAccumulator (APTR(Rcvr) receiver, TCSJ)
{
    muSet = CAST(MuSet, receiver->receiveHeaper());
}


void parseInto_SetAccumulator (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) SetAccumulator (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe SetAccumulator_recipe(cat_SetAccumulator, &XppCuisine, parseInto_SetAccumulator);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of SetAccumulator ====== */

void SetAccumulator::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SetAccumulator*)origin)->muSet,
				       (Heaper**)&muSet);
	} else {
		muSet.forwardTo (Heaplet::forward (muSet));
	}
}

/*----------------------- END SetAccumulator -----------------------*/


