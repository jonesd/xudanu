/*----------------------- BEGIN ItemStepper -----------------------*/
DEFINE_CLASS_CATEGORY(ItemStepper,Stepper)

void ItemStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of ItemStepper ====== */

void ItemStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ItemStepper*)origin)->myItem,
				       (Heaper**)&myItem);
	} else {
		myItem.forwardTo (Heaplet::forward (myItem));
	}
}

/*----------------------- END ItemStepper -----------------------*/


