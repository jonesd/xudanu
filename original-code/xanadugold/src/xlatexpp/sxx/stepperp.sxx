/*----------------------- BEGIN PtrArrayStepper -----------------------*/
DEFINE_CLASS_CATEGORY(PtrArrayStepper,TableStepper)
DEFINE_OPAQUE_TYPE(PtrArrayStepper);

void PtrArrayStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "PtrArrayStepper" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void PtrArrayStepper::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myArray);
    xmtr->sendInt32(myIndex);
    xmtr->sendInt32(myPastEnd);
    xmtr->sendInt32(myStep);
}

PtrArrayStepper::PtrArrayStepper (APTR(Rcvr) receiver, TCSJ)
{
    myArray = CAST(PtrArray, receiver->receiveHeaper());
    myIndex = receiver->receiveInt32();
    myPastEnd = receiver->receiveInt32();
    myStep = receiver->receiveInt32();
}


void parseInto_PtrArrayStepper (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) PtrArrayStepper (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe PtrArrayStepper_recipe(cat_PtrArrayStepper, &XppCuisine, parseInto_PtrArrayStepper);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of PtrArrayStepper ====== */

void PtrArrayStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((PtrArrayStepper*)origin)->myArray,
				       (Heaper**)&myArray);
	} else {
		myArray.forwardTo (Heaplet::forward (myArray));
	}
}

/*----------------------- END PtrArrayStepper -----------------------*/

