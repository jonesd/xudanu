/*----------------------- BEGIN SequenceRegion -----------------------*/
DEFINE_CLASS_CATEGORY(SequenceRegion,XnRegion)
DEFINE_OPAQUE_TYPE(SequenceRegion);

void SequenceRegion::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "SequenceRegion" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void SequenceRegion::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendBooleanVar(myStartsInside);
    xmtr->sendInt32(myTransitionsCount);
    this->sendSequenceRegion(xmtr);
}

SequenceRegion::SequenceRegion (APTR(Rcvr) receiver, TCSJ)
{
    myStartsInside = receiver->receiveBooleanVar();
    myTransitionsCount = receiver->receiveInt32();
    this->receiveSequenceRegion(receiver);
}


void parseInto_SequenceRegion (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) SequenceRegion (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe SequenceRegion_recipe(cat_SequenceRegion, &XppCuisine, parseInto_SequenceRegion);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of SequenceRegion ====== */

void SequenceRegion::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SequenceRegion*)origin)->myTransitions,
				       (Heaper**)&myTransitions);
	} else {
		myTransitions.forwardTo (Heaplet::forward (myTransitions));
	}
}

/*----------------------- END SequenceRegion -----------------------*/


