#define SEQUENCX_SXX

/*----------------------- BEGIN Sequence -----------------------*/
DEFINE_CLASS_CATEGORY(Sequence,Position)
DEFINE_OPAQUE_TYPE(Sequence);

void Sequence::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "Sequence" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void Sequence::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendIntegerVar(myShift);
    xmtr->sendHeaper(myNumbers);
}

Sequence::Sequence (APTR(Rcvr) receiver, TCSJ)
{
    myShift = receiver->receiveIntegerVar();
    myNumbers = CAST(PrimIntegerArray, receiver->receiveHeaper());
}


void parseInto_Sequence (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) Sequence (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe Sequence_recipe(cat_Sequence, &XppCuisine, parseInto_Sequence);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of Sequence ====== */

void Sequence::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Sequence*)origin)->myNumbers,
				       (Heaper**)&myNumbers);
	} else {
		myNumbers.forwardTo (Heaplet::forward (myNumbers));
	}
}

/*----------------------- END Sequence -----------------------*/


