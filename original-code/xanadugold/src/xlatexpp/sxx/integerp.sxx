/*----------------------- BEGIN IntegerArrangement -----------------------*/
DEFINE_CLASS_CATEGORY(IntegerArrangement,Arrangement)
DEFINE_OPAQUE_TYPE(IntegerArrangement);

void IntegerArrangement::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "IntegerArrangement" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void IntegerArrangement::sendSelfTo (APTR(Xmtr) xmtr)
{
    Arrangement::sendSelfTo (xmtr);
    xmtr->sendHeaper(myOrdering);
    xmtr->sendHeaper(myRegion);
}

IntegerArrangement::IntegerArrangement (APTR(Rcvr) receiver, TCSJ)
  : Arrangement (receiver, tcsj) {
    myOrdering = CAST(OrderSpec, receiver->receiveHeaper());
    myRegion = CAST(IntegerRegion, receiver->receiveHeaper());
}


void parseInto_IntegerArrangement (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) IntegerArrangement (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe IntegerArrangement_recipe(cat_IntegerArrangement, &XppCuisine, parseInto_IntegerArrangement);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of IntegerArrangement ====== */

void IntegerArrangement::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((IntegerArrangement*)origin)->myOrdering,
				       (Heaper**)&myOrdering);
		Heaplet::forwardToOld ((Heaper**)&((IntegerArrangement*)origin)->myRegion,
				       (Heaper**)&myRegion);
	} else {
		myOrdering.forwardTo (Heaplet::forward (myOrdering));
		myRegion.forwardTo (Heaplet::forward (myRegion));
	}
}

/*----------------------- END IntegerArrangement -----------------------*/


