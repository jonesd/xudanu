/*----------------------- BEGIN AscendingIntegerStepper -----------------------*/
DEFINE_CLASS_CATEGORY(AscendingIntegerStepper,Stepper)

void AscendingIntegerStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of AscendingIntegerStepper ====== */

void AscendingIntegerStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((AscendingIntegerStepper*)origin)->myEdges,
				       (Heaper**)&myEdges);
	} else {
		myEdges.forwardTo (Heaplet::forward (myEdges));
	}
}

/*----------------------- END AscendingIntegerStepper -----------------------*/


