/*----------------------- BEGIN IntegerSimpleRegionStepper -----------------------*/
DEFINE_CLASS_CATEGORY(IntegerSimpleRegionStepper,Stepper)

void IntegerSimpleRegionStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of IntegerSimpleRegionStepper ====== */

void IntegerSimpleRegionStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((IntegerSimpleRegionStepper*)origin)->myEdges,
				       (Heaper**)&myEdges);
		Heaplet::forwardToOld ((Heaper**)&((IntegerSimpleRegionStepper*)origin)->mySimple,
				       (Heaper**)&mySimple);
	} else {
		myEdges.forwardTo (Heaplet::forward (myEdges));
		mySimple.forwardTo (Heaplet::forward (mySimple));
	}
}

/*----------------------- END IntegerSimpleRegionStepper -----------------------*/


