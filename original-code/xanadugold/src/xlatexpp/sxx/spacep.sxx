/*----------------------- BEGIN CompositeMapping -----------------------*/
DEFINE_CLASS_CATEGORY(CompositeMapping,Mapping)

void CompositeMapping::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "CompositeMapping" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void CompositeMapping::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myCS);
    xmtr->sendHeaper(myRS);
    xmtr->sendHeaper(myMappings);
}

CompositeMapping::CompositeMapping (APTR(Rcvr) receiver, TCSJ)
{
    myCS = CAST(CoordinateSpace, receiver->receiveHeaper());
    myRS = CAST(CoordinateSpace, receiver->receiveHeaper());
    myMappings = CAST(ImmuSet, receiver->receiveHeaper());
}


void parseInto_CompositeMapping (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) CompositeMapping (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe CompositeMapping_recipe(cat_CompositeMapping, &XppCuisine, parseInto_CompositeMapping);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of CompositeMapping ====== */

void CompositeMapping::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((CompositeMapping*)origin)->myCS,
				       (Heaper**)&myCS);
		Heaplet::forwardToOld ((Heaper**)&((CompositeMapping*)origin)->myRS,
				       (Heaper**)&myRS);
		Heaplet::forwardToOld ((Heaper**)&((CompositeMapping*)origin)->myMappings,
				       (Heaper**)&myMappings);
	} else {
		myCS.forwardTo (Heaplet::forward (myCS));
		myRS.forwardTo (Heaplet::forward (myRS));
		myMappings.forwardTo (Heaplet::forward (myMappings));
	}
}

/*----------------------- END CompositeMapping -----------------------*/


