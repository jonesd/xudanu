DEFINE_CLASS_CATEGORY(ConstantMapping,Mapping)

void ConstantMapping::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "ConstantMapping" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void ConstantMapping::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myCoordinateSpace);
    xmtr->sendHeaper(myValues);
}

ConstantMapping::ConstantMapping (APTR(Rcvr) receiver, TCSJ)
{
    myCoordinateSpace = CAST(CoordinateSpace, receiver->receiveHeaper());
    myValues = CAST(XnRegion, receiver->receiveHeaper());
}


void parseInto_ConstantMapping (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) ConstantMapping (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe ConstantMapping_recipe(cat_ConstantMapping, &XppCuisine, parseInto_ConstantMapping);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of ConstantMapping ====== */

void ConstantMapping::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ConstantMapping*)origin)->myCoordinateSpace,
				       (Heaper**)&myCoordinateSpace);
		Heaplet::forwardToOld ((Heaper**)&((ConstantMapping*)origin)->myValues,
				       (Heaper**)&myValues);
	} else {
		myCoordinateSpace.forwardTo (Heaplet::forward (myCoordinateSpace));
		myValues.forwardTo (Heaplet::forward (myValues));
	}
}

/*----------------------- END ConstantMapping -----------------------*/


/*----------------------- BEGIN DisjointRegionStepper -----------------------*/
DEFINE_CLASS_CATEGORY(DisjointRegionStepper,Stepper)

void DisjointRegionStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of DisjointRegionStepper ====== */

void DisjointRegionStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((DisjointRegionStepper*)origin)->myValue,
				       (Heaper**)&myValue);
		Heaplet::forwardToOld ((Heaper**)&((DisjointRegionStepper*)origin)->myRegion,
				       (Heaper**)&myRegion);
		Heaplet::forwardToOld ((Heaper**)&((DisjointRegionStepper*)origin)->myOrder,
				       (Heaper**)&myOrder);
	} else {
		myValue.forwardTo (Heaplet::forward (myValue));
		myRegion.forwardTo (Heaplet::forward (myRegion));
		myOrder.forwardTo (Heaplet::forward (myOrder));
	}
}

/*----------------------- END DisjointRegionStepper -----------------------*/


