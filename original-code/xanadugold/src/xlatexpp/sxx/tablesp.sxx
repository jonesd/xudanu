/*----------------------- BEGIN ImmuTableOnMu -----------------------*/
DEFINE_CLASS_CATEGORY(ImmuTableOnMu,ImmuTable)

void ImmuTableOnMu::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "ImmuTableOnMu" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void ImmuTableOnMu::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myMuTable);
}

ImmuTableOnMu::ImmuTableOnMu (APTR(Rcvr) receiver, TCSJ)
{
    myMuTable = CAST(MuTable, receiver->receiveHeaper());
}


void parseInto_ImmuTableOnMu (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) ImmuTableOnMu (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe ImmuTableOnMu_recipe(cat_ImmuTableOnMu, &XppCuisine, parseInto_ImmuTableOnMu);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of ImmuTableOnMu ====== */

void ImmuTableOnMu::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ImmuTableOnMu*)origin)->myMuTable,
				       (Heaper**)&myMuTable);
	} else {
		myMuTable.forwardTo (Heaplet::forward (myMuTable));
	}
}

/*----------------------- END ImmuTableOnMu -----------------------*/


