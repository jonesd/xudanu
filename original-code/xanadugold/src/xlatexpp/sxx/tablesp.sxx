/*----------------------- BEGIN OffsetImmuTable -----------------------*/
DEFINE_CLASS_CATEGORY(OffsetImmuTable,ImmuTable)

void OffsetImmuTable::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of OffsetImmuTable ====== */

void OffsetImmuTable::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((OffsetImmuTable*)origin)->myTable,
				       (Heaper**)&myTable);
		Heaplet::forwardToOld ((Heaper**)&((OffsetImmuTable*)origin)->myDsp,
				       (Heaper**)&myDsp);
	} else {
		myTable.forwardTo (Heaplet::forward (myTable));
		myDsp.forwardTo (Heaplet::forward (myDsp));
	}
}

/*----------------------- END OffsetImmuTable -----------------------*/


