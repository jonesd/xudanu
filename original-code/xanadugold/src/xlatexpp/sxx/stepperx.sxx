#define STEPPERX_SXX

/*----------------------- BEGIN Accumulator -----------------------*/
DEFINE_CLASS_CATEGORY(Accumulator,Heaper)
DEFINE_OPAQUE_TYPE(Accumulator);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar Accumulator::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 Accumulator::actualHashForEqual ()
{
    return Heaper::takeOop ();
}



/*----------------------- END Accumulator -----------------------*/


