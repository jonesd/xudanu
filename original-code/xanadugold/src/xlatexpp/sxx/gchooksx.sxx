/*----------------------- BEGIN RepairEngineer -----------------------*/
DEFINE_CLASS_CATEGORY(RepairEngineer,Heaper)
DEFINE_OPAQUE_TYPE(RepairEngineer);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar RepairEngineer::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 RepairEngineer::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of RepairEngineer ====== */

void RepairEngineer::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((RepairEngineer*)origin)->myNext,
				       (Heaper**)&myNext);
	} else {
		myNext.forwardTo (Heaplet::forward (myNext));
	}
}

/*----------------------- END RepairEngineer -----------------------*/


