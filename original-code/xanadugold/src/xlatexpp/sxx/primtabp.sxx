#define PRIMTABP_SXX

/*----------------------- BEGIN PrimPtrTableExecutor -----------------------*/
DEFINE_CLASS_CATEGORY(PrimPtrTableExecutor,XnExecutor)
DEFINE_OPAQUE_TYPE(PrimPtrTableExecutor);

void PrimPtrTableExecutor::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of PrimPtrTableExecutor ====== */

void PrimPtrTableExecutor::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((PrimPtrTableExecutor*)origin)->myTable,
				       (Heaper**)&myTable);
		Heaplet::forwardToOld ((Heaper**)&((PrimPtrTableExecutor*)origin)->myFollower,
				       (Heaper**)&myFollower);
	} else {
		myTable.forwardTo (Heaplet::forward (myTable));
		myFollower.forwardTo (Heaplet::forward (myFollower));
	}
}

/*----------------------- END PrimPtrTableExecutor -----------------------*/


/*----------------------- BEGIN PrimRemovedObject -----------------------*/
DEFINE_CLASS_CATEGORY(PrimRemovedObject,Heaper)

void PrimRemovedObject::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar PrimRemovedObject::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 PrimRemovedObject::actualHashForEqual ()
{
    return Heaper::takeOop ();
}



/*----------------------- END PrimRemovedObject -----------------------*/


