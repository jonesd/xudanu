/*----------------------- BEGIN IntegerPos -----------------------*/
DEFINE_CLASS_CATEGORY(IntegerPos,Position)
DEFINE_OPAQUE_TYPE(IntegerPos);

void IntegerPos::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "IntegerPos" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void IntegerPos::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendIntegerVar(myValue);
}

IntegerPos::IntegerPos (APTR(Rcvr) receiver, TCSJ)
{
    myValue = receiver->receiveIntegerVar();
}


void parseInto_IntegerPos (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) IntegerPos (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe IntegerPos_recipe(cat_IntegerPos, &XppCuisine, parseInto_IntegerPos);


/* #endif */ /* WITH_RPC */




/*----------------------- END IntegerPos -----------------------*/


/*----------------------- BEGIN IntegerRegion -----------------------*/
DEFINE_CLASS_CATEGORY(IntegerRegion,XnRegion)
DEFINE_OPAQUE_TYPE(IntegerRegion);

void IntegerRegion::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "IntegerRegion" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void IntegerRegion::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendBooleanVar(myStartsInside);
    xmtr->sendUInt32(myTransitionCount);
    xmtr->sendHeaper(myTransitions);
}

IntegerRegion::IntegerRegion (APTR(Rcvr) receiver, TCSJ)
{
    myStartsInside = receiver->receiveBooleanVar();
    myTransitionCount = receiver->receiveUInt32();
    myTransitions = CAST(IntegerVarArray, receiver->receiveHeaper());
}


void parseInto_IntegerRegion (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) IntegerRegion (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe IntegerRegion_recipe(cat_IntegerRegion, &XppCuisine, parseInto_IntegerRegion);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of IntegerRegion ====== */

void IntegerRegion::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((IntegerRegion*)origin)->myTransitions,
				       (Heaper**)&myTransitions);
	} else {
		myTransitions.forwardTo (Heaplet::forward (myTransitions));
	}
}

/*----------------------- END IntegerRegion -----------------------*/


