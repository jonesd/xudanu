/*----------------------- BEGIN Chameleon -----------------------*/
DEFINE_CLASS_CATEGORY(Chameleon,Heaper)
DEFINE_OPAQUE_TYPE(Chameleon);

void Chameleon::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "Chameleon" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void Chameleon::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendIntegerVar(myA);
    xmtr->sendHeaper(myB);
    xmtr->sendBooleanVar(myC);
}

Chameleon::Chameleon (APTR(Rcvr) receiver, TCSJ)
{
    myA = receiver->receiveIntegerVar();
    myB = CAST(Heaper, receiver->receiveHeaper());
    myC = receiver->receiveBooleanVar();
}


void parseInto_Chameleon (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) Chameleon (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe Chameleon_recipe(cat_Chameleon, &XppCuisine, parseInto_Chameleon);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of Chameleon ====== */

void Chameleon::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Chameleon*)origin)->myB,
				       (Heaper**)&myB);
	} else {
		myB.forwardTo (Heaplet::forward (myB));
	}
}

/*----------------------- END Chameleon -----------------------*/


