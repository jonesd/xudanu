#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void Butterfly::sendSelfTo (APTR(Xmtr) xmtr)
{
    Chameleon::sendSelfTo (xmtr);
    xmtr->sendIntegerVar(myE);
    xmtr->sendHeaper(myF);
}

Butterfly::Butterfly (APTR(Rcvr) receiver, TCSJ)
  : Chameleon (receiver, tcsj) {
    myE = receiver->receiveIntegerVar();
    myF = CAST(Heaper, receiver->receiveHeaper());
}


void parseInto_Butterfly (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) Butterfly (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe Butterfly_recipe(cat_Butterfly, &XppCuisine, parseInto_Butterfly);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of Butterfly ====== */

void Butterfly::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Chameleon::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Butterfly*)origin)->myF,
				       (Heaper**)&myF);
	} else {
		myF.forwardTo (Heaplet::forward (myF));
	}
}

/*----------------------- END Butterfly -----------------------*/


