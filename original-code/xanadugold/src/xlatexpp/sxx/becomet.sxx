/*----------------------- BEGIN DeadButterfly -----------------------*/
DEFINE_CLASS_CATEGORY(DeadButterfly,Chameleon)
DEFINE_OPAQUE_TYPE(DeadButterfly);

void DeadButterfly::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "DeadButterfly" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void DeadButterfly::sendSelfTo (APTR(Xmtr) xmtr)
{
    Chameleon::sendSelfTo (xmtr);
    xmtr->sendIntegerVar(myJ);
    xmtr->sendHeaper(myK);
    xmtr->sendHeaper(myL);
    xmtr->sendHeaper(myM);
}

DeadButterfly::DeadButterfly (APTR(Rcvr) receiver, TCSJ)
  : Chameleon (receiver, tcsj) {
    myJ = receiver->receiveIntegerVar();
    myK = CAST(Heaper, receiver->receiveHeaper());
    myL = CAST(Heaper, receiver->receiveHeaper());
    myM = CAST(Heaper, receiver->receiveHeaper());
}


void parseInto_DeadButterfly (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) DeadButterfly (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe DeadButterfly_recipe(cat_DeadButterfly, &XppCuisine, parseInto_DeadButterfly);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of DeadButterfly ====== */

void DeadButterfly::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Chameleon::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((DeadButterfly*)origin)->myK,
				       (Heaper**)&myK);
		Heaplet::forwardToOld ((Heaper**)&((DeadButterfly*)origin)->myL,
				       (Heaper**)&myL);
		Heaplet::forwardToOld ((Heaper**)&((DeadButterfly*)origin)->myM,
				       (Heaper**)&myM);
	} else {
		myK.forwardTo (Heaplet::forward (myK));
		myL.forwardTo (Heaplet::forward (myL));
		myM.forwardTo (Heaplet::forward (myM));
	}
}

/*----------------------- END DeadButterfly -----------------------*/


