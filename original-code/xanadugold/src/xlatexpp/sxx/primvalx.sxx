/*----------------------- BEGIN PrimFloatSpec -----------------------*/
DEFINE_CLASS_CATEGORY(PrimFloatSpec,PrimSpec)
DEFINE_OPAQUE_TYPE(PrimFloatSpec);

void PrimFloatSpec::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "PrimFloatSpec" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void PrimFloatSpec::sendSelfTo (APTR(Xmtr) xmtr)
{
    PrimSpec::sendSelfTo (xmtr);
    xmtr->sendInt32(myBitCount);
}

PrimFloatSpec::PrimFloatSpec (APTR(Rcvr) receiver, TCSJ)
  : PrimSpec (receiver, tcsj) {
    myBitCount = receiver->receiveInt32();
}


void parseInto_PrimFloatSpec (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) PrimFloatSpec (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe PrimFloatSpec_recipe(cat_PrimFloatSpec, &XppCuisine, parseInto_PrimFloatSpec);


/* #endif */ /* WITH_RPC */




/*----------------------- END PrimFloatSpec -----------------------*/


/*----------------------- BEGIN PrimIntegerSpec -----------------------*/
DEFINE_CLASS_CATEGORY(PrimIntegerSpec,PrimSpec)
DEFINE_OPAQUE_TYPE(PrimIntegerSpec);

void PrimIntegerSpec::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "PrimIntegerSpec" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void PrimIntegerSpec::sendSelfTo (APTR(Xmtr) xmtr)
{
    PrimSpec::sendSelfTo (xmtr);
    xmtr->sendInt32(myBitCount);
    xmtr->sendBooleanVar(amSigned);
    xmtr->sendInt32(myMin);
    xmtr->sendInt32(myMax);
}

PrimIntegerSpec::PrimIntegerSpec (APTR(Rcvr) receiver, TCSJ)
  : PrimSpec (receiver, tcsj) {
    myBitCount = receiver->receiveInt32();
    amSigned = receiver->receiveBooleanVar();
    myMin = receiver->receiveInt32();
    myMax = receiver->receiveInt32();
}


void parseInto_PrimIntegerSpec (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) PrimIntegerSpec (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe PrimIntegerSpec_recipe(cat_PrimIntegerSpec, &XppCuisine, parseInto_PrimIntegerSpec);


/* #endif */ /* WITH_RPC */




/*----------------------- END PrimIntegerSpec -----------------------*/


