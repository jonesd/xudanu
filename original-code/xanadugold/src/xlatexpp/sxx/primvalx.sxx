#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void PrimSpec::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myClass);
}

PrimSpec::PrimSpec (APTR(Rcvr) receiver, TCSJ)
{
    myClass = CAST(Category, receiver->receiveHeaper());
}


/* #endif */ /* WITH_RPC */


