#define TABENTP_SXX

/*----------------------- BEGIN BucketArrayStepper -----------------------*/
DEFINE_CLASS_CATEGORY(BucketArrayStepper,TableStepper)

void BucketArrayStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of BucketArrayStepper ====== */

void BucketArrayStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BucketArrayStepper*)origin)->myEntry,
				       (Heaper**)&myEntry);
		Heaplet::forwardToOld ((Heaper**)&((BucketArrayStepper*)origin)->myEntries,
				       (Heaper**)&myEntries);
	} else {
		myEntry.forwardTo (Heaplet::forward (myEntry));
		myEntries.forwardTo (Heaplet::forward (myEntries));
	}
}

/*----------------------- END BucketArrayStepper -----------------------*/


