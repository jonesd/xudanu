/*----------------------- BEGIN IndexEntry -----------------------*/
DEFINE_CLASS_CATEGORY(IndexEntry,TableEntry)

void IndexEntry::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "IndexEntry" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void IndexEntry::sendSelfTo (APTR(Xmtr) xmtr)
{
    TableEntry::sendSelfTo (xmtr);
    xmtr->sendIntegerVar(myIndex);
}

IndexEntry::IndexEntry (APTR(Rcvr) receiver, TCSJ)
  : TableEntry (receiver, tcsj) {
    myIndex = receiver->receiveIntegerVar();
}


void parseInto_IndexEntry (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) IndexEntry (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe IndexEntry_recipe(cat_IndexEntry, &XppCuisine, parseInto_IndexEntry);


/* #endif */ /* WITH_RPC */




/*----------------------- END IndexEntry -----------------------*/


/*----------------------- BEGIN PositionEntry -----------------------*/
DEFINE_CLASS_CATEGORY(PositionEntry,TableEntry)

void PositionEntry::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "PositionEntry" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void PositionEntry::sendSelfTo (APTR(Xmtr) xmtr)
{
    TableEntry::sendSelfTo (xmtr);
    xmtr->sendHeaper(myKey);
}

PositionEntry::PositionEntry (APTR(Rcvr) receiver, TCSJ)
  : TableEntry (receiver, tcsj) {
    myKey = CAST(Position, receiver->receiveHeaper());
}


void parseInto_PositionEntry (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) PositionEntry (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe PositionEntry_recipe(cat_PositionEntry, &XppCuisine, parseInto_PositionEntry);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of PositionEntry ====== */

void PositionEntry::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->TableEntry::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((PositionEntry*)origin)->myKey,
				       (Heaper**)&myKey);
	} else {
		myKey.forwardTo (Heaplet::forward (myKey));
	}
}

/*----------------------- END PositionEntry -----------------------*/

