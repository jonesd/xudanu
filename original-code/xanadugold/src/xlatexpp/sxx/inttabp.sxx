/*----------------------- BEGIN OberIntegerTable -----------------------*/
DEFINE_CLASS_CATEGORY(OberIntegerTable,IntegerTable)
DEFINE_OPAQUE_TYPE(OberIntegerTable);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of OberIntegerTable ====== */

void OberIntegerTable::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((OberIntegerTable*)origin)->myNextCOW,
				       (Heaper**)&myNextCOW);
	} else {
		myNextCOW.forwardTo (Heaplet::forward (myNextCOW));
	}
}

/*----------------------- END OberIntegerTable -----------------------*/


/*----------------------- BEGIN ActualIntegerTable -----------------------*/
DEFINE_CLASS_CATEGORY(ActualIntegerTable,OberIntegerTable)
DEFINE_OPAQUE_TYPE(ActualIntegerTable);

void ActualIntegerTable::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "ActualIntegerTable" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void ActualIntegerTable::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(elements);
    xmtr->sendIntegerVar(start);
    xmtr->sendUInt32(elemCount);
    xmtr->sendUInt32(firstElem);
    xmtr->sendUInt32(lastElem);
    xmtr->sendUInt32(tally);
    xmtr->sendBooleanVar(domainIsSimple);
}

ActualIntegerTable::ActualIntegerTable (APTR(Rcvr) receiver, TCSJ)
{
    elements = CAST(PtrArray, receiver->receiveHeaper());
    start = receiver->receiveIntegerVar();
    elemCount = receiver->receiveUInt32();
    firstElem = receiver->receiveUInt32();
    lastElem = receiver->receiveUInt32();
    tally = receiver->receiveUInt32();
    domainIsSimple = receiver->receiveBooleanVar();
}


void parseInto_ActualIntegerTable (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) ActualIntegerTable (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe ActualIntegerTable_recipe(cat_ActualIntegerTable, &XppCuisine, parseInto_ActualIntegerTable);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of ActualIntegerTable ====== */

void ActualIntegerTable::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->OberIntegerTable::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ActualIntegerTable*)origin)->elements,
				       (Heaper**)&elements);
	} else {
		elements.forwardTo (Heaplet::forward (elements));
	}
}

/*----------------------- END ActualIntegerTable -----------------------*/


/*----------------------- BEGIN COWIntegerTable -----------------------*/
DEFINE_MAY_BECOME(COWIntegerTable,ActualIntegerTable)
DEFINE_CLASS_CATEGORY(COWIntegerTable,OberIntegerTable)
DEFINE_OPAQUE_TYPE(COWIntegerTable);

void COWIntegerTable::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "COWIntegerTable" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void COWIntegerTable::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myTable);
}

COWIntegerTable::COWIntegerTable (APTR(Rcvr) receiver, TCSJ)
{
    myTable = CAST(OberIntegerTable, receiver->receiveHeaper());
}


void parseInto_COWIntegerTable (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) COWIntegerTable (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe COWIntegerTable_recipe(cat_COWIntegerTable, &XppCuisine, parseInto_COWIntegerTable);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of COWIntegerTable ====== */

void COWIntegerTable::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->OberIntegerTable::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((COWIntegerTable*)origin)->myPrev,
				       (Heaper**)&myPrev);
		Heaplet::forwardToOld ((Heaper**)&((COWIntegerTable*)origin)->myTable,
				       (Heaper**)&myTable);
	} else {
		myPrev.forwardTo (Heaplet::forward (myPrev));
		myTable.forwardTo (Heaplet::forward (myTable));
	}
}

/*----------------------- END COWIntegerTable -----------------------*/

