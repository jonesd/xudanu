/*----------------------- BEGIN ITAscendingStepper -----------------------*/
DEFINE_CLASS_CATEGORY(ITAscendingStepper,IntegerTableStepper)

void ITAscendingStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of ITAscendingStepper ====== */

void ITAscendingStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ITAscendingStepper*)origin)->arrayInternal,
				       (Heaper**)&arrayInternal);
	} else {
		arrayInternal.forwardTo (Heaplet::forward (arrayInternal));
	}
}

/*----------------------- END ITAscendingStepper -----------------------*/


