#define HASHTABP_SXX

/*----------------------- BEGIN ActualHashTable -----------------------*/
DEFINE_CLASS_CATEGORY(ActualHashTable,HashTable)
DEFINE_OPAQUE_TYPE(ActualHashTable);

void ActualHashTable::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "ActualHashTable" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void ActualHashTable::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendInt32(myTally);
    xmtr->sendHeaper(myCoordinateSpace);
    this->sendHashTable(xmtr);
}

ActualHashTable::ActualHashTable (APTR(Rcvr) receiver, TCSJ)
{
    myTally = receiver->receiveInt32();
    myCoordinateSpace = CAST(CoordinateSpace, receiver->receiveHeaper());
    this->receiveHashTable(receiver);
}


void parseInto_ActualHashTable (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) ActualHashTable (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe ActualHashTable_recipe(cat_ActualHashTable, &XppCuisine, parseInto_ActualHashTable);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of ActualHashTable ====== */

void ActualHashTable::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ActualHashTable*)origin)->myHashEntries,
				       (Heaper**)&myHashEntries);
		Heaplet::forwardToOld ((Heaper**)&((ActualHashTable*)origin)->myCoordinateSpace,
				       (Heaper**)&myCoordinateSpace);
	} else {
		myHashEntries.forwardTo (Heaplet::forward (myHashEntries));
		myCoordinateSpace.forwardTo (Heaplet::forward (myCoordinateSpace));
	}
}

/*----------------------- END ActualHashTable -----------------------*/

