/*----------------------- BEGIN RealRegion -----------------------*/
DEFINE_CLASS_CATEGORY(RealRegion,XnRegion)
DEFINE_OPAQUE_TYPE(RealRegion);

void RealRegion::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "RealRegion" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void RealRegion::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendBooleanVar(myStartsInside);
    xmtr->sendHeaper(myTransitionVals);
    xmtr->sendHeaper(myTransitionFlags);
}

RealRegion::RealRegion (APTR(Rcvr) receiver, TCSJ)
{
    myStartsInside = receiver->receiveBooleanVar();
    myTransitionVals = CAST(PrimFloatArray, receiver->receiveHeaper());
    myTransitionFlags = CAST(PrimIntegerArray, receiver->receiveHeaper());
}


void parseInto_RealRegion (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) RealRegion (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe RealRegion_recipe(cat_RealRegion, &XppCuisine, parseInto_RealRegion);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of RealRegion ====== */

void RealRegion::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((RealRegion*)origin)->myTransitionVals,
				       (Heaper**)&myTransitionVals);
		Heaplet::forwardToOld ((Heaper**)&((RealRegion*)origin)->myTransitionFlags,
				       (Heaper**)&myTransitionFlags);
	} else {
		myTransitionVals.forwardTo (Heaplet::forward (myTransitionVals));
		myTransitionFlags.forwardTo (Heaplet::forward (myTransitionFlags));
	}
}

/*----------------------- END RealRegion -----------------------*/


