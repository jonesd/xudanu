DEFINE_CLASS_CATEGORY(Thunk,Heaper)
DEFINE_OPAQUE_TYPE(Thunk);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar Thunk::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 Thunk::actualHashForEqual ()
{
    return Heaper::takeOop ();
}



