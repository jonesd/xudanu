void CommentThunk::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendString(message);
}

CommentThunk::CommentThunk (APTR(Rcvr) receiver, TCSJ)
{
    message = receiver->receiveString();
}


