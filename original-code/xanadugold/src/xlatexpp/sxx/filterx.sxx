#define FILTERX_SXX

/*----------------------- BEGIN Filter -----------------------*/
DEFINE_CLASS_CATEGORY(Filter,XnRegion)
DEFINE_OPAQUE_TYPE(Filter);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "Filter" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void Filter::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myCS);
}

Filter::Filter (APTR(Rcvr) receiver, TCSJ)
{
    myCS = CAST(FilterSpace, receiver->receiveHeaper());
}


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of Filter ====== */

void Filter::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Filter*)origin)->myCS,
				       (Heaper**)&myCS);
	} else {
		myCS.forwardTo (Heaplet::forward (myCS));
	}
}

/*----------------------- END Filter -----------------------*/


