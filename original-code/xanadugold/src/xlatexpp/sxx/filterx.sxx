void RegionDelta::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "RegionDelta" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void RegionDelta::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myBefore);
    xmtr->sendHeaper(myAfter);
}

RegionDelta::RegionDelta (APTR(Rcvr) receiver, TCSJ)
{
    myBefore = CAST(XnRegion, receiver->receiveHeaper());
    myAfter = CAST(XnRegion, receiver->receiveHeaper());
}


void parseInto_RegionDelta (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) RegionDelta (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe RegionDelta_recipe(cat_RegionDelta, &XppCuisine, parseInto_RegionDelta);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of RegionDelta ====== */

void RegionDelta::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((RegionDelta*)origin)->myBefore,
				       (Heaper**)&myBefore);
		Heaplet::forwardToOld ((Heaper**)&((RegionDelta*)origin)->myAfter,
				       (Heaper**)&myAfter);
	} else {
		myBefore.forwardTo (Heaplet::forward (myBefore));
		myAfter.forwardTo (Heaplet::forward (myAfter));
	}
}

/*----------------------- END RegionDelta -----------------------*/

