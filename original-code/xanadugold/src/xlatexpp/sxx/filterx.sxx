/*----------------------- BEGIN FilterSpace -----------------------*/
DEFINE_CLASS_CATEGORY(FilterSpace,CoordinateSpace)
DEFINE_OPAQUE_TYPE(FilterSpace);

void FilterSpace::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "FilterSpace" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void FilterSpace::sendSelfTo (APTR(Xmtr) xmtr)
{
    this->sendFilterSpaceTo(xmtr);
}

extern Recipe * XppCuisine;
PseudoCopyRecipe FilterSpace_recipe(cat_FilterSpace, &XppCuisine, FilterSpace::make);


/* ====== Object Migrator for Scavenging of FilterSpace ====== */

void FilterSpace::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->CoordinateSpace::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FilterSpace*)origin)->myBaseSpace,
				       (Heaper**)&myBaseSpace);
	} else {
		myBaseSpace.forwardTo (Heaplet::forward (myBaseSpace));
	}
}

/*----------------------- END FilterSpace -----------------------*/


/*----------------------- BEGIN Joint -----------------------*/
DEFINE_CLASS_CATEGORY(Joint,Heaper)
DEFINE_OPAQUE_TYPE(Joint);

void Joint::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "Joint" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void Joint::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myUnioned);
    xmtr->sendHeaper(myIntersected);
}

Joint::Joint (APTR(Rcvr) receiver, TCSJ)
{
    myUnioned = CAST(XnRegion, receiver->receiveHeaper());
    myIntersected = CAST(XnRegion, receiver->receiveHeaper());
}


void parseInto_Joint (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) Joint (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe Joint_recipe(cat_Joint, &XppCuisine, parseInto_Joint);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of Joint ====== */

void Joint::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Joint*)origin)->myUnioned,
				       (Heaper**)&myUnioned);
		Heaplet::forwardToOld ((Heaper**)&((Joint*)origin)->myIntersected,
				       (Heaper**)&myIntersected);
	} else {
		myUnioned.forwardTo (Heaplet::forward (myUnioned));
		myIntersected.forwardTo (Heaplet::forward (myIntersected));
	}
}

/*----------------------- END Joint -----------------------*/


