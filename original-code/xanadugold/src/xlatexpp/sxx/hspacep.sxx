  : SetRegion (receiver, tcsj) {
}


void parseInto_HeaperRegion (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) HeaperRegion (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe HeaperRegion_recipe(cat_HeaperRegion, &XppCuisine, parseInto_HeaperRegion);


