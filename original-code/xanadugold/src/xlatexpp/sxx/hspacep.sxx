/*----------------------- BEGIN SetRegion -----------------------*/
DEFINE_CLASS_CATEGORY(SetRegion,XnRegion)
DEFINE_OPAQUE_TYPE(SetRegion);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "SetRegion" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void SetRegion::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myPositions);
    xmtr->sendBooleanVar(myIsComplement);
}

SetRegion::SetRegion (APTR(Rcvr) receiver, TCSJ)
{
    myPositions = CAST(ImmuSet, receiver->receiveHeaper());
    myIsComplement = receiver->receiveBooleanVar();
}


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of SetRegion ====== */

void SetRegion::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SetRegion*)origin)->myPositions,
				       (Heaper**)&myPositions);
	} else {
		myPositions.forwardTo (Heaplet::forward (myPositions));
	}
}

/*----------------------- END SetRegion -----------------------*/


