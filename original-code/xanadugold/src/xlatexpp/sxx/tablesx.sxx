/*----------------------- BEGIN Pair -----------------------*/
DEFINE_CLASS_CATEGORY(Pair,Heaper)
DEFINE_OPAQUE_TYPE(Pair);

void Pair::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "Pair" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void Pair::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(leftPart);
    xmtr->sendHeaper(rightPart);
}

Pair::Pair (APTR(Rcvr) receiver, TCSJ)
{
    leftPart = CAST(Heaper, receiver->receiveHeaper());
    rightPart = CAST(Heaper, receiver->receiveHeaper());
}


void parseInto_Pair (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) Pair (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe Pair_recipe(cat_Pair, &XppCuisine, parseInto_Pair);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of Pair ====== */

void Pair::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Pair*)origin)->leftPart,
				       (Heaper**)&leftPart);
		Heaplet::forwardToOld ((Heaper**)&((Pair*)origin)->rightPart,
				       (Heaper**)&rightPart);
	} else {
		leftPart.forwardTo (Heaplet::forward (leftPart));
		rightPart.forwardTo (Heaplet::forward (rightPart));
	}
}

/*----------------------- END Pair -----------------------*/


