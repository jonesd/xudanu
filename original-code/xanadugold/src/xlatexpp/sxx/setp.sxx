/*----------------------- BEGIN ActualHashSet -----------------------*/
DEFINE_CLASS_CATEGORY(ActualHashSet,HashSet)
DEFINE_OPAQUE_TYPE(ActualHashSet);

void ActualHashSet::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "ActualHashSet" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void ActualHashSet::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendInt32(myTally);
    this->sendHashSet(xmtr);
}

ActualHashSet::ActualHashSet (APTR(Rcvr) receiver, TCSJ)
{
    myTally = receiver->receiveInt32();
    this->receiveHashSet(receiver);
}


void parseInto_ActualHashSet (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) ActualHashSet (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe ActualHashSet_recipe(cat_ActualHashSet, &XppCuisine, parseInto_ActualHashSet);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of ActualHashSet ====== */

void ActualHashSet::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ActualHashSet*)origin)->myHashValues,
				       (Heaper**)&myHashValues);
		Heaplet::forwardToOld ((Heaper**)&((ActualHashSet*)origin)->myHashEntries,
				       (Heaper**)&myHashEntries);
	} else {
		myHashValues.forwardTo (Heaplet::forward (myHashValues));
		myHashEntries.forwardTo (Heaplet::forward (myHashEntries));
	}
}

/*----------------------- END ActualHashSet -----------------------*/


