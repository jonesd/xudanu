#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void ImmuSetOnMu::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(setInternal);
}

ImmuSetOnMu::ImmuSetOnMu (APTR(Rcvr) receiver, TCSJ)
{
    setInternal = CAST(MuSet, receiver->receiveHeaper());
}


void parseInto_ImmuSetOnMu (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) ImmuSetOnMu (rcvr, tcsj);
}

