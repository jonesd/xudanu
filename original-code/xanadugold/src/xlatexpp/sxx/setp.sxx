void ImmuSetOnMu::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ImmuSetOnMu*)origin)->setInternal,
				       (Heaper**)&setInternal);
	} else {
		setInternal.forwardTo (Heaplet::forward (setInternal));
	}
}

/*----------------------- END ImmuSetOnMu -----------------------*/


