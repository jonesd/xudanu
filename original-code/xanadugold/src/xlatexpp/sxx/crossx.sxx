/*----------------------- BEGIN CrossOrderSpec -----------------------*/
DEFINE_CLASS_CATEGORY(CrossOrderSpec,OrderSpec)
DEFINE_OPAQUE_TYPE(CrossOrderSpec);

void CrossOrderSpec::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "CrossOrderSpec" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void CrossOrderSpec::sendSelfTo (APTR(Xmtr) xmtr)
{
    OrderSpec::sendSelfTo (xmtr);
    xmtr->sendHeaper(mySpace);
    xmtr->sendHeaper(mySubOrders);
    xmtr->sendHeaper(myLexOrder);
}

CrossOrderSpec::CrossOrderSpec (APTR(Rcvr) receiver, TCSJ)
  : OrderSpec (receiver, tcsj) {
    mySpace = CAST(CrossSpace, receiver->receiveHeaper());
    mySubOrders = CAST(PtrArray, receiver->receiveHeaper());
    myLexOrder = CAST(PrimIntArray, receiver->receiveHeaper());
}


void parseInto_CrossOrderSpec (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) CrossOrderSpec (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe CrossOrderSpec_recipe(cat_CrossOrderSpec, &XppCuisine, parseInto_CrossOrderSpec);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of CrossOrderSpec ====== */

void CrossOrderSpec::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((CrossOrderSpec*)origin)->mySpace,
				       (Heaper**)&mySpace);
		Heaplet::forwardToOld ((Heaper**)&((CrossOrderSpec*)origin)->mySubOrders,
				       (Heaper**)&mySubOrders);
		Heaplet::forwardToOld ((Heaper**)&((CrossOrderSpec*)origin)->myLexOrder,
				       (Heaper**)&myLexOrder);
	} else {
		mySpace.forwardTo (Heaplet::forward (mySpace));
		mySubOrders.forwardTo (Heaplet::forward (mySubOrders));
		myLexOrder.forwardTo (Heaplet::forward (myLexOrder));
	}
}

/*----------------------- END CrossOrderSpec -----------------------*/


