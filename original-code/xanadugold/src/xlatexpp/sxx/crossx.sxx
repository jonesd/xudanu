/*----------------------- BEGIN CrossSpace -----------------------*/
DEFINE_CLASS_CATEGORY(CrossSpace,CoordinateSpace)
DEFINE_OPAQUE_TYPE(CrossSpace);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of CrossSpace ====== */

void CrossSpace::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->CoordinateSpace::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((CrossSpace*)origin)->mySubSpaces,
				       (Heaper**)&mySubSpaces);
	} else {
		mySubSpaces.forwardTo (Heaplet::forward (mySubSpaces));
	}
}

/*----------------------- END CrossSpace -----------------------*/


