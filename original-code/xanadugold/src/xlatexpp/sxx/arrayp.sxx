#define ARRAYP_SXX

/*----------------------- BEGIN ActualArray -----------------------*/
DEFINE_CLASS_CATEGORY(ActualArray,MuArray)
DEFINE_OPAQUE_TYPE(ActualArray);

void ActualArray::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "ActualArray" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void ActualArray::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(elements);
    xmtr->sendUInt32(tally);
}

ActualArray::ActualArray (APTR(Rcvr) receiver, TCSJ)
{
    elements = CAST(PtrArray, receiver->receiveHeaper());
    tally = receiver->receiveUInt32();
}


void parseInto_ActualArray (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) ActualArray (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe ActualArray_recipe(cat_ActualArray, &XppCuisine, parseInto_ActualArray);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of ActualArray ====== */

void ActualArray::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ActualArray*)origin)->elements,
				       (Heaper**)&elements);
	} else {
		elements.forwardTo (Heaplet::forward (elements));
	}
}

/*----------------------- END ActualArray -----------------------*/


