/*----------------------- BEGIN OffsetArrayStepper -----------------------*/
DEFINE_CLASS_CATEGORY(OffsetArrayStepper,TableStepper)

void OffsetArrayStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of OffsetArrayStepper ====== */

void OffsetArrayStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((OffsetArrayStepper*)origin)->myArrayStepper,
				       (Heaper**)&myArrayStepper);
		Heaplet::forwardToOld ((Heaper**)&((OffsetArrayStepper*)origin)->myDsp,
				       (Heaper**)&myDsp);
	} else {
		myArrayStepper.forwardTo (Heaplet::forward (myArrayStepper));
		myDsp.forwardTo (Heaplet::forward (myDsp));
	}
}

/*----------------------- END OffsetArrayStepper -----------------------*/


/*----------------------- BEGIN OffsetScruArray -----------------------*/
DEFINE_CLASS_CATEGORY(OffsetScruArray,ScruTable)

void OffsetScruArray::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "OffsetScruArray" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void OffsetScruArray::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myArray);
    xmtr->sendHeaper(myDsp);
}

OffsetScruArray::OffsetScruArray (APTR(Rcvr) receiver, TCSJ)
{
    myArray = CAST(MuArray, receiver->receiveHeaper());
    myDsp = CAST(Dsp, receiver->receiveHeaper());
}


void parseInto_OffsetScruArray (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) OffsetScruArray (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe OffsetScruArray_recipe(cat_OffsetScruArray, &XppCuisine, parseInto_OffsetScruArray);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of OffsetScruArray ====== */

void OffsetScruArray::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((OffsetScruArray*)origin)->myArray,
				       (Heaper**)&myArray);
		Heaplet::forwardToOld ((Heaper**)&((OffsetScruArray*)origin)->myDsp,
				       (Heaper**)&myDsp);
	} else {
		myArray.forwardTo (Heaplet::forward (myArray));
		myDsp.forwardTo (Heaplet::forward (myDsp));
	}
}

/*----------------------- END OffsetScruArray -----------------------*/

