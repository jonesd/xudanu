/* ************************************************************************ *
 * 
 *                    Class ScruSetTester 
 *
 * ************************************************************************ */




	/* NO CLASS COMMENT */

class ScruSetTester : public Tester {

/* Attributes for class ScruSetTester */
	DEFERRED(ScruSetTester)
	COPY(ScruSetTester,BootCuisine)
	AUTO_GC(ScruSetTester)
  public: /* creation */

	
	ScruSetTester ();
	
  public: /* testing */

	
	virtual void allTestsOn (ostream& ARG(oo));
	
  public: /* tests */

	
	virtual void testContentsEqual (ostream& ARG(oo));
	
	
	virtual void testhasMember (ostream& ARG(oo));
	
	
	virtual void testIntersects (ostream& ARG(oo));
	
	
	virtual void testIsEmpty (ostream& ARG(oo));
	
	
	virtual void testIsSubsetOf (ostream& ARG(oo));
	
	
	virtual void unaryCheck (APTR(ScruSet) ARG(a));
	
  public: /* hooks: */

	
	virtual RECEIVE_HOOK void restartScruSetTester (APTR(Rcvr) ARG(rcvr));
	
  public: /* deferred: initialization */

	
	virtual RPTR(ScruSet) generateSet () DEFERRED_FUNC;
	
	
	virtual RPTR(ScruSet) generateSetContaining (APTR(Stepper) ARG(stuff)) DEFERRED_FUNC;
	
  protected: /* protected: accessing */

	
	virtual RPTR(ScruSet) getScruSet (IntegerVar ARG(number));
	
	
	virtual void setTestSets (APTR(ScruTable) OF1(ScruSet) ARG(table));
	
	
	virtual RPTR(ScruTable) OF1(ScruSet) testScruSets ();
	
  private: /* private: scruset generation */

	/* generateScruSets must generate a table of sets in the 
	following order:
		  1) an empty set
		  2) a set containing one element
		  3) a set containing one element which is different from 
	that in set 2
		  4) a set containing at least two elements, one equal to 
	the element in set 2
		  5) a set containing at least two elements, different from 
	all previous elements
		  6) a set with the same contents as set 2 not generated by copy()
		  7) a set with the same contents as set 5 not generated by copy()
		  8) a set generated by set 2 copy
		  9) a set generated by set 5 copy
		  other sets are optional and will only be tested with 
	general tests (check).
		   */
	
	virtual RPTR(ScruTable) OF1(ScruSet) generateScruSets ();
	
  private:
	NOCOPY CHKPTR(ScruTable) OF1(ScruSet) myTestSets;
};  /* end class ScruSetTester */



