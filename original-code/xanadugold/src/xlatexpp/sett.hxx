/* ************************************************************************ *
 * 
 *                    Class SHTO 
 *
 * ************************************************************************ */




	/* SHTO (SpecialHashTestObject) is used for testing hash 
	sets.  It stores an identifying string, along with the hash 
	that it is to return.  This allows a) system independent 
	testing - as the hash will be the same in all test output 
	files, and b) provides for testing complex hash value 
	interactions with spending years looking for the right 
	objects to generate critical hash values. */

class SHTO : public Heaper {

/* Attributes for class SHTO */
	CONCRETE(SHTO)
	AUTO_GC(SHTO)
  public: /* make */

	
	static RPTR(SHTO) make (char* ARG(aString), UInt32 ARG(aHashVal));
	
  public: /* tests */

	
	virtual UInt32 actualHashForEqual ();
	
	
	virtual BooleanVar isEqual (APTR(Heaper) ARG(other));
	
  public: /* creation */

	
	SHTO (APTR(Sequence) ARG(onString), UInt32 ARG(onHash));
	
  public: /* printing */

	
	virtual void printOn (ostream& ARG(oo));
	
  private: /* private: accessing */

	
	virtual RPTR(Sequence) stringValue ();
	
  private:
	UInt4 myHashValue;
	CHKPTR(Sequence) myStringValue;
};  /* end class SHTO */



