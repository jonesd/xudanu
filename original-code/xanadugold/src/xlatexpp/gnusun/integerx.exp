	this->edge((	( IntegerPos  *) (Heaper*) checkCast (	  cat_IntegerPos     	, ( someObj )	, "../integerx.cxx"	, 2549	)	) ->asIntegerVar());
}


  RSP2_Heaper       IntegerEdgeAccumulator::value (){
	  WSP2_Heaper       	returnValue;
	returnValue = this->region();
	return returnValue;
}
 


void IntegerEdgeAccumulator::printOn (ostream& oo){
	oo << this->getCategory()->name() << "(" << this->region() << ")";
}
 


void IntegerEdgeAccumulator::edge (IntegerVar x){
	 

	
	if (havePending) {
		if (myPending == x) {
			havePending = 0 ;
		} else {
			myEdges->storeIntegerVar(myIndex, myPending);
			myIndex += 1;
			myPending = x;
		}
	} else {
		havePending = 1 ;
		myPending = x;
	}
}


void IntegerEdgeAccumulator::edges (  WSP2_IntegerEdgeStepper       stepper){
	 

	
	if (stepper->hasValue()) {
		this->edge(stepper->edge());
		stepper->step();
		if (stepper->hasValue()) {
			if (!havePending) {
				myPending = stepper->edge();
				havePending = 1 ;
				stepper->step();
			}
			while (stepper->hasValue()) {
				myEdges->storeIntegerVar(myIndex, myPending);
				myIndex += 1;
				myPending = stepper->edge();
				stepper->step();
			}
		}
	}
}


  RSP2_IntegerRegion       IntegerEdgeAccumulator::region (){
	 
	
	if (havePending) {
		myEdges->storeIntegerVar(myIndex, myPending);
		return new (xcsj,   cat_IntegerRegion     )  IntegerRegion   (myStartsInside, myIndex + 1, myEdges)  ;
	} else {
		if (myIndex == ((Int32) 0) ) {
			if (myStartsInside) {
				  WSP2_IntegerRegion       	returnValue;
				returnValue = IntegerRegion::allIntegers();
				return returnValue;
			} else {
				  WSP2_IntegerRegion       	returnValue;
				returnValue = IntegerRegion::make ();
				return returnValue;
			}
		} else {
			return new (xcsj,   cat_IntegerRegion     )  IntegerRegion   (myStartsInside, myIndex, myEdges)  ;
		}
	}
}



 







 

