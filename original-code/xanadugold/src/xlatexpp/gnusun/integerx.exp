  RSP2_IntegerRegion       IntegerRegion::simpleRegionAtIndex (UInt32 i){
	 
	
	if ( ! (i < myTransitionCount) ) {
		{	Problem problemInstance(	"Assertion_failed" ,  1 , "../integerx.cxx", 1875);	blast(&problemInstance);	}  ;
	}
	if ((i & 1) == ((Int32) 0)  == myStartsInside) {
