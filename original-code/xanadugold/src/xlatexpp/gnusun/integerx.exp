	  WSP2_Position       	returnValue;
	returnValue = IntegerPos::make ((	( IntegerRegion  *) (Heaper*) checkCast (	  cat_IntegerRegion     	, ( region )	, "../integerx.cxx"	, 2950	)	) ->start());
	return returnValue;
}


