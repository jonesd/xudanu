        CheckedPtrVar&	aLeft
    ,   CheckedPtrVar&	aRight
) {
	return aLeft.fetch() == aRight.fetch();
}

inline BooleanVar operator!= (
        CheckedPtrVar&	aLeft
    ,   CheckedPtrVar&	aRight
) {
	return aLeft.fetch() != aRight.fetch();
}

