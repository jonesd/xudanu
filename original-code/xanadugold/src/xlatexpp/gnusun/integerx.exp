			result = IntegerEdgeAccumulator::make (myStartsInside && !other->isBoundedBelow(), myTransitionCount + other->transitionCount());
			for (;;) {	BooleanVar crutch_Flag;
				 
				
				crutch_Flag = mine->hasValue();
				if(crutch_Flag) {
					crutch_Flag = others->hasValue();
