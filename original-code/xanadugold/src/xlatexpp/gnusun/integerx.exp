  RSP2_XnRegion       IntegerRegion::withInt (IntegerVar pos){
	  SP2_IntegerEdgeStepper       mine;
	IntegerVar me;
	  SP2_IntegerEdgeAccumulator       result;
	  SP2_XnRegion       resultReg;
	
	if (this->isEmpty()) {
		  WSP2_XnRegion       	returnValue;
		returnValue = IntegerRegion::make (pos);
		return returnValue;
	}
	{	BooleanVar crutch_Flag;
		 
		
		crutch_Flag = this->isBoundedAbove();
		if(crutch_Flag) {
			crutch_Flag = pos == this->stop();
		}
		if (crutch_Flag) {
			  SP2_IntegerVarArray       newTransitions;
			
			newTransitions = (	( IntegerVarArray  *) (Heaper*) checkCast (	  cat_IntegerVarArray     	, ( myTransitions->copy() )	, "../integerx.cxx"	, 1711	)	) ;
			newTransitions->storeIntegerVar(myTransitionCount - 1, pos + 1);
			return new (xcsj,   cat_IntegerRegion     )  IntegerRegion   (myStartsInside, myTransitionCount, newTransitions)  ;
		}
	}
	mine = this->edgeStepper();
	result = IntegerEdgeAccumulator::make (myStartsInside, myTransitionCount + 2);
	for (;;) {	BooleanVar crutch_Flag;
		 
		
		crutch_Flag = mine->hasValue();
		if(crutch_Flag) {
			crutch_Flag = (me = mine->edge()) < pos;
		}
		if (crutch_Flag) {
			result->edge(me);
			mine->step();
		} else {
			break;
		}
	}
	if (mine->isEntering()) {
		result->edge(pos);
		if (me == pos) {
			mine->step();
		} else {
			result->edge(pos + 1);
		}
	} else {
		if (me == pos) {
			mine->step();
			result->edge(pos + 1);
		}
	}
	if (mine->hasValue()) {
		result->edges(mine);
	}
	{mine->destroy();  mine = 0   ;}
	resultReg = result->region();
	{result->destroy();  result = 0   ;}
	  WSP2_XnRegion       	returnValue;
	returnValue = resultReg;
	return returnValue;
}
 


IntegerVar IntegerRegion::count (){
	IntegerVar result;
	
	if (!this->isFinite()) {
		{	Problem problemInstance(	"InvalidRequest" ,  1 , "../integerx.cxx", 1762);	blast(&problemInstance);	}  ;
	}
	result = IntegerVar(0) ;
	{
		UInt32 LoopFinal = myTransitionCount;
		UInt32 i = ((Int32) 0) ;
		for (;;) {
			if (i >= LoopFinal){
				break;
			}
			{
				result = result + myTransitions->integerVarAt(i + 1) - myTransitions->integerVarAt(i);
			}
			i += 2;
		}
	}
	return result;
}


BooleanVar IntegerRegion::isEnumerable (  WSP2_OrderSpec       order ){
	 



	
	{	BooleanVar crutch_Flag;
		 
		
		crutch_Flag = order == 0 ;
		if(!crutch_Flag) {
			crutch_Flag = order->followsInt(1, IntegerVar(0) );
		}
		if (crutch_Flag) {
			return this->isBoundedBelow();
		} else {
			return this->isBoundedAbove();
		}
	}
}
 


