void IntegerArrangement::copyElements (
		  WSP2_PrimArray       toArray, 
		  WSP2_Dsp       toDsp, 
		  WSP2_PrimArray       fromArray, 
		  WSP2_Arrangement       fromArrange, 
		  WSP2_XnRegion       fromRegion)
{
	  SP2_IntegerArrangement       other;
	Int32 start;
	Int32 stop;
	Int32 toStart;
	
	other = (	( IntegerArrangement  *) (Heaper*) checkCast (	  cat_IntegerArrangement     	, ( fromArrange )	, "../integerx.cxx"	, 2299	)	) ;
	if (!myOrdering->isEqual(other->ordering())) {
		{	Problem problemInstance(	"NOT_YET_IMPLEMENTED" ,  1 , "../integerx.cxx", 2301);	blast(&problemInstance);	}  ;
	}
	{	BooleanVar crutch_Flag;
		 
		
		crutch_Flag = myRegion->isSimple();
		if(crutch_Flag) {
			crutch_Flag = other->region()->isSimple();
			if(crutch_Flag) {
				crutch_Flag = fromRegion->isSimple();
			}
		}
		if (!crutch_Flag) {
			{	Problem problemInstance(	"NOT_YET_IMPLEMENTED" ,  1 , "../integerx.cxx", 2314);	blast(&problemInstance);	}  ;
		}
	}
	 
	
	 
	start = fromArrange->indexOf(fromRegion->chooseOne(myOrdering)).asLong();
	stop = fromArrange->indexOf(fromRegion->chooseOne(myOrdering->reversed())).asLong();
	toStart = this->indexOf(toDsp->of(fromRegion->chooseOne(myOrdering))).asLong();
	 

	toArray->storeMany(toStart, fromArray, stop + 1 - start, start);
}


IntegerVar IntegerArrangement::indexOf (  WSP2_Position       position){
	 

	
	IntegerVar sum;
	IntegerVar intPos;
	
	sum = IntegerVar(0) ;
	intPos = (	( IntegerPos  *) (Heaper*) checkCast (	  cat_IntegerPos     	, ( position )	, "../integerx.cxx"	, 2337	)	) ->asIntegerVar();
	{	  SP2_Stepper         loop_Stepper = ( (myRegion->simpleRegions(myOrdering)) );	  SP2_IntegerRegion         region ;	while (( region  = (	(  IntegerRegion   *) (Heaper*) checkCast (	  cat_IntegerRegion      	, ( loop_Stepper->fetch() )	, "../integerx.cxx"	, 2338	)	) ) != 0  ) {  {
		if (region->hasIntMember(intPos)) {
			return sum + abs(intPos - (	( IntegerPos  *) (Heaper*) checkCast (	  cat_IntegerPos     	, ( region->chooseOne(myOrdering) )	, "../integerx.cxx"	, 2340	)	) ->asIntegerVar());
		} else {
			sum += region->count();
		}
	} loop_Stepper->step();	}	loop_Stepper->destroy();	} ;
	{	Problem problemInstance(	"NotInTable" ,  1 , "../integerx.cxx", 2345);	blast(&problemInstance);	}  ;
	 
	return -1;
}


