			crutch_Flag = myTransitionCount == 1;
		}
		if (crutch_Flag) {
			  WSP2_ScruSet         	returnValue;
			returnValue = ImmuSet::make ()->with(this);
			return returnValue;
		}
	}
	{	 intReg  = new (xcsj,   cat_IntegerRegion     )  IntegerRegion   (myStartsInside, 1, myTransitions) ;	} ;
	  WSP2_ScruSet         	returnValue;
	returnValue = ImmuSet::make ()->with(intReg)->with(IntegerRegion::before(this->stop()));
	return returnValue;
}


  RSP2_Stepper       IntegerRegion::simpleRegions (  WSP2_OrderSpec       order ){
	 





	
	{	BooleanVar crutch_Flag;
		 
		
		crutch_Flag = order == 0 ;
		if(!crutch_Flag) {
			crutch_Flag = order->followsInt(1, ((Int32) 0) );
		}
		if (!crutch_Flag) {
			{	Problem problemInstance(	"NOT_YET_IMPLEMENTED" ,  1 , "../integerx.cxx", 1852);	blast(&problemInstance);	}  ;
