  RSP2_XnRegion       IntegerMapping::inverseOfAll (  WSP2_XnRegion       reg){
	  SP2_IntegerRegion       region;
	  SP2_IntegerEdgeAccumulator       result;
	  SP2_IntegerEdgeStepper       edges;
	  SP2_XnRegion       resultReg;
	
	if (this == IntegerMapping::TheIdentityIntegerMapping) {
		  WSP2_XnRegion       	returnValue;
		returnValue = reg;
		return returnValue;
	} else {
		region = (	( IntegerRegion  *) (Heaper*) checkCast (	  cat_IntegerRegion     	, ( reg )	, "../integerx.cxx"	, 183	)	) ;
		 
		result = IntegerEdgeAccumulator::make (!region->isBoundedBelow(), region->transitionCount());
		edges = region->edgeStepper();
		while (edges->hasValue()) {
			result->edge(this->inverseOfInt(edges->edge()));
			edges->step();
		}
		{edges->destroy();  edges = 0   ;}
		resultReg = result->region();
		{result->destroy();  result = 0   ;}
		  WSP2_XnRegion       	returnValue;
		returnValue = resultReg;
		return returnValue;
	}
}


IntegerVar IntegerMapping::inverseOfInt (IntegerVar pos){
	if (this == IntegerMapping::TheIdentityIntegerMapping) {
		return pos;
	}
	return pos - myTranslation;
}


