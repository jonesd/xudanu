class Arrangement : public Heaper {

 
	public:	 Arrangement (VTBL VTBL_HACK);	public:	virtual Category * getCategory ()  ;	protected: virtual void deferredHack ()   = 0 ; private:	friend class    ArrangementJig    ; 
	protected:  Arrangement  (Rcvr * trans, TCSJ);	friend void   parseInto_Arrangement      (  WSP2_Rcvr       rcvr,   void * storage);	friend class    ArrangementRecipe    ; public:	virtual void sendSelfTo (  WSP2_Xmtr       xmtr) ;	private: 
	 
  public:  

	 



	
	virtual void copyElements (
			  WSP2_PrimArray        , 
			  WSP2_Dsp        , 
			  WSP2_PrimArray        , 
			  WSP2_Arrangement        , 
			  WSP2_XnRegion        )
	;
	
	 

	
	virtual IntegerVar indexOf (  WSP2_Position        ) = 0 ;
	
	 

	
	virtual   RSP2_IntegerRegion       indicesOf (  WSP2_XnRegion        ) = 0 ;
	
	 
	
	virtual   RSP2_XnRegion       keysOf (Int32  , Int32  ) = 0 ;
	
	 
	
	virtual   RSP2_XnRegion       region () = 0 ;
	
  public:  

	
	virtual UInt32 actualHashForEqual ();
	

	 
  public:
	Arrangement();

};   



 








	 





























class CoordinateSpace : public Heaper {

 
	public:	 CoordinateSpace (VTBL VTBL_HACK);	public:	virtual Category * getCategory ()  ;	protected: virtual void deferredHack ()   = 0 ; private:	friend class    CoordinateSpaceJig    ; 
	 
	public:	virtual void migrate (void * origin,	BooleanVar destinationIsOld);	private: 
  public:  

	
	virtual UInt32 actualHashForEqual ();
	
	 
	
	inline      RSP2_OrderSpec       ascending ();
	
	 


	
	inline      RSP2_Mapping       completeMapping (  WSP2_XnRegion        );
	
	 

	
	inline      RSP2_OrderSpec       descending ();
	
	 
	
	inline      RSP2_XnRegion       emptyRegion ();
	
	 
	
	inline    RSP2_OrderSpec         fetchAscending ();
	
	 

	
	inline    RSP2_OrderSpec         fetchDescending ();
	
	 
	
	inline      RSP2_XnRegion       fullRegion ();
	
	 
	
	virtual   RSP2_OrderSpec       getAscending ();
	
	 

	
	virtual   RSP2_OrderSpec       getDescending ();
	
	 

	
	inline    RSP2_Dsp       identityDsp ();
	
	 

	
	inline      RSP2_Mapping       identityMapping ();
	
	
	virtual BooleanVar isEqual (  WSP2_Heaper        ) = 0 ;
	
	 

	
	virtual BooleanVar verify (  WSP2_Heaper        );
	
  protected:  

	
	virtual void finishCreate (
			  WSP2_XnRegion        , 
			  WSP2_XnRegion        , 
			  WSP2_Dsp        , 
			  WSP2_OrderSpec         = 0 , 
			  WSP2_OrderSpec         = 0 )
	;
	
  public:  

	
	CoordinateSpace ();
	
	
	CoordinateSpace (
			  WSP2_XnRegion        , 
			  WSP2_XnRegion        , 
			  WSP2_Dsp        , 
			  WSP2_OrderSpec         = 0 , 
			  WSP2_OrderSpec         = 0 )
	;
	
  private:
	  CP2_XnRegion         myEmptyRegion;
	  CP2_XnRegion         myFullRegion;
	  CP2_Dsp         myIdentityDsp;
	  CP2_OrderSpec           myAscending;
	  CP2_OrderSpec           myDescending;
};   



 








	 




















