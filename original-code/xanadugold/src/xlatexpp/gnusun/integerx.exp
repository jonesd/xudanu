  protected:

     
    static UInt32 takeOop ();

  public:
     
    virtual BooleanVar isEqual (  WSP2_Heaper       other)	 ;

     
    UInt32 hashForEqual ();

  protected:
     

    virtual UInt32 actualHashForEqual ()		 ;

  public:
     




     

     



    virtual void printOn (ostream& oo);

     
    virtual void printContentsOn (ostream& oo);

     

  public:

     

    void * operator new (size_t s);

     
    void * operator new (size_t  , void * storage);

     

    void * operator new (size_t s, 
			 XCSJ xcsj,   
			 Category * cat);

     
    void * operator new (size_t  , void * storage, Category * cat);

     
    void * operator new (size_t s, 
			 AllocType,
			 XCSJ xcsj,   
			 Category * cat);

  public:

     


    void   operator delete (void *);

     
    virtual void destroy (); 

  protected:

       
       
       
       
       
    virtual void destruct ();

       
    friend class InstanceCache;

       
    inline  Heaper ();

       
       
       
       
       
    inline  virtual ~Heaper ();

  private:
     
     
    Heaper& operator= (Heaper&);
     

     
    friend class   HeaperRecipe    ;
     

  public:  
    inline  void changeClassToThatOf (  WSP2_Heaper       anInstance);

  private:  

    static UInt32 TheOopCounter;

    UInt32 myOop;
};

 



 

 

class  Category  : public  Heaper   {
    public:	 Category (VTBL VTBL_HACK);	public:	virtual Category * getCategory ()  ;	protected: virtual void deferredHack ()    ; private:	friend class    CategoryJig    ; 
     
     
  public:
    virtual  BooleanVar isEqual (  WSP2_Heaper       other);

     







    virtual  UInt32 actualHashForEqual ();
    virtual  UInt32 hashedName ();

    virtual  char * name ();
    inline  BooleanVar isEqualOrSubclassOf (Category * aCategory);
    virtual  Category * fetchSuperCategory();
    virtual  Category * getSuperCategory();

    inline  Int32 preorderNumber ();
    virtual  Int32 preorderMax ();

  public:    

       

    virtual  void mayBecome (Category * cat);

       
    virtual  void mayBecomeAnySubclassOf (Category * cat);

       
    virtual  BooleanVar canYouBecome (Category * cat);

       
       
    virtual  size_t objectSize ();
		
  protected: 	 
    friend class CategoryRecipe;
  public:
    virtual void sendSelfTo (  WSP2_Xmtr       xmtr) ;

  private:	 

    virtual  BooleanVar calculateObjectSize ();
    virtual  void checkSuperObjectSize ();

  private:

    size_t myObjectSize;  
    CategoryList * myMayBecomes;


  protected:  

     
    virtual  Category * fetchNextPreOrder ();

  public:
     

    inline  size_t totalSize ();

  private:
    size_t myTotalSize;

  private:     
    virtual  void registerWithParent ();
    virtual  Category * registerChild (Category * cat);
    virtual  UInt32 preorder (UInt32 mine);
    friend BooleanVar Tofu::isKindOf (Category *)  ;

  public:  
    static void registerAllBecomes ();
    static void preorderCategories ();
    static void calculateObjectSizes ();

  public:
     
    virtual  void printInsideOn (ostream& oo);
    virtual void printNodeOn (ostream& oo, UInt32 indentation = 0);
    virtual  void printTreeOn (ostream& oo, UInt32 indentation = 0);





    Category (char *name, size_t selfSize, Category * superCategory);

  private:
    char *	nameOfCategory;
    Category *	baseCategory;
    Category * 	myFirstChild;
    Category * 	myNextSibling;
    UInt32	myPreorderNumber;
    UInt32	myDescendantsMax;
    UInt32	hashOfCategoryName;
    Category *	nextHashed;

