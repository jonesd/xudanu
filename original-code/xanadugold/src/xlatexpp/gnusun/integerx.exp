#define SHIELD_VOID
#define SHIELD_BREAK		if (&VAL) { break; }
#define SHIELD_CONTINUE		if (&VAL) { continue; }

 
 
 
 
 
 
 
 
 
 
 
 

#define 	BOOBY_TRAP(LTAG,GRIPE,ACTION)	BOOBY_TRAP_BEGIN(LTAG,GRIPE) {	ACTION;	} BOOBY_TRAP_END()




#define 	BOOBY_TRAP_BEGIN(LTAG,GRIPE)	for (;;) {	SHIELD_UP(BOOBY_TRAPPING,LTAG,{	 		SHIELD_BREAK;	});





#define 	BOOBY_TRAP_END()	BLAST(GRIPE);	}



 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 

