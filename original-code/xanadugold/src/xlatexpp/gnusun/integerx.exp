#define DEFINE_CLASS_CATEGORY_INTERNAL(derived,base)	Category * CAT(cat_,derived) = &CAT(secret_,derived);	derived::derived(VTBL VTBL_HACK) : base (VTBL_HACK) {   }	Category * derived::getCategory () CONST { return CAT(cat_,derived); }











#define 	DEFINE_CLASS_CATEGORY(derived,base)	static Category CAT(secret_,derived)	= Category (STR(derived), sizeof(derived), CAT(cat_,base));	DEFINE_CLASS_CATEGORY_INTERNAL(derived,base)





 

class Heaper : public Tofu {
