BooleanVar IntegerUpOrder::follows (  WSP2_Position       x,   WSP2_Position       y){
	return (	( IntegerPos  *) (Heaper*) checkCast (	  cat_IntegerPos     	, ( x )	, "../integerx.cxx"	, 2887	)	) ->asIntegerVar() >= (	( IntegerPos  *) (Heaper*) checkCast (	  cat_IntegerPos     	, ( y )	, "../integerx.cxx"	, 2887	)	) ->asIntegerVar();
}


BooleanVar IntegerUpOrder::followsInt (IntegerVar x, IntegerVar y){
	 

	
	return x >= y;
}


BooleanVar IntegerUpOrder::isEqual (  WSP2_Heaper       other){
	return other->isKindOf(cat_IntegerUpOrder);
}


BooleanVar IntegerUpOrder::isFullOrder (  WSP2_XnRegion         ){
	return 1 ;
}


BooleanVar IntegerUpOrder::preceeds (  WSP2_XnRegion       before,   WSP2_XnRegion       after){
	 

	
	  SP2_IntegerRegion       first;
	  SP2_IntegerRegion       second;
	
	first = (	( IntegerRegion  *) (Heaper*) checkCast (	  cat_IntegerRegion     	, ( before )	, "../integerx.cxx"	, 2916	)	) ;
	second = (	( IntegerRegion  *) (Heaper*) checkCast (	  cat_IntegerRegion     	, ( after )	, "../integerx.cxx"	, 2917	)	) ;
	if (!first->isBoundedBelow()) {
		return 1 ;
	}
	if (!second->isBoundedBelow()) {
		return 0 ;
	}
	return first->start() <= second->start();
}
 


  RSP2_Arrangement       IntegerUpOrder::arrange (  WSP2_XnRegion       region){
