//	Added SP2_, WP2_ CP2_s for the visible classes.
//	(!!!! Needs to be brought into conformity with the "right way")
//	 - michael Jul  5 1991

#ifndef URDIX_OXX
#define URDIX_OXX

/* $Id: urdix.oxx,v 1.5 1992/11/25 23:19:21 eric Exp $ */

//	The following are commented out because:
//
//	 - The Urdi, UrdiView, and SnarfHandle classes are not types.
//	   (They should only be held by WPTR()s.)
//
//	 - The SnarfCache class is supposed to be private (but it ends up
//	   being visible to make the other class declarations happy.)

// OPAQUE_TYPE_2(Urdi,Heaper);
// OPAQUE_TYPE_2(UrdiView,Heaper);
// OPAQUE_TYPE_2(SnarfHandle,Heaper);

// OPAQUE_TYPE_2(SnarfCache,Heaper);

//	We need an opaque declaration of UrdiView
//	to make the Urdi class declaration compile.
//
//	Other visible classes are declared on the off chance some module
//	only imports the .oxx file
//
//	Added Category object externs
//		- ech Nov 25 1991
//

class	Urdi;
class	UrdiView;
class	SnarfHandle;

extern Category * cat_Urdi;
extern Category * cat_UrdiView;
extern Category * cat_SnarfHandle;

typedef	Urdi *		SP2_Urdi;
typedef	UrdiView *	SP2_UrdiView;
typedef	SnarfHandle *	SP2_SnarfHandle;

typedef	Urdi *		RSP2_Urdi;
typedef	UrdiView *	RSP2_UrdiView;
typedef	SnarfHandle *	RSP2_SnarfHandle;

typedef	Urdi *		GP2_Urdi;
typedef	UrdiView *	GP2_UrdiView;
typedef	SnarfHandle *	GP2_SnarfHandle;

typedef	Urdi *		WP2_Urdi;
typedef	UrdiView *	WP2_UrdiView;
typedef	SnarfHandle *	WP2_SnarfHandle;

typedef	Urdi *		WSP2_Urdi;
typedef	UrdiView *	WSP2_UrdiView;
typedef	SnarfHandle *	WSP2_SnarfHandle;

typedef	Urdi *		CP2_Urdi;
typedef	UrdiView *	CP2_UrdiView;
typedef	SnarfHandle *	CP2_SnarfHandle;

#endif /* URDIX_OXX */
