void BuildUrdiFile::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendString(myFilename);
    xmtr->sendInt32(mySnarfSize);
    xmtr->sendInt32(mySnarfCount);
    xmtr->sendInt32(myStageCount);
}

BuildUrdiFile::BuildUrdiFile (APTR(Rcvr) receiver, TCSJ)
{
    myFilename = receiver->receiveString();
    mySnarfSize = receiver->receiveInt32();
    mySnarfCount = receiver->receiveInt32();
    myStageCount = receiver->receiveInt32();
}


void parseInto_BuildUrdiFile (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) BuildUrdiFile (rcvr, tcsj);
}

extern Recipe * BootCuisine;
ActualCopyRecipe BuildUrdiFile_recipe(cat_BuildUrdiFile, &BootCuisine, parseInto_BuildUrdiFile);


