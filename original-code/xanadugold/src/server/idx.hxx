			BooleanVar ARG(includesRest))
	;
	
  public: /* accessing */

	
	virtual RPTR(XnRegion) asSimpleRegion ();
	
	
	virtual RPTR(CoordinateSpace) coordinateSpace ();
	
	/* Essential. Export the IDRegion in a form that can be used 
