/* ************************************************************************ *
 * 
 *                    Class IDSpace 
 *
 * ************************************************************************ */




	/* A space of IDs, which can generate globally unique IDs.
	
	Implementation note:
		myBackend - the identifier of the Server which generated 
	this space. If NULL, then it was generated by the current 
	Server (unless mySpaceNumber is -1, in which case it is the 
	single global IDSpace shared by all Servers.
		mySpaceNumber - identifies which space this is. If -1, then 
	it is the global ID space, and myBackend must be NULL. */

class IDSpace : public CoordinateSpace {

/* Attributes for class IDSpace */
	CONCRETE(IDSpace)
	PSEUDO_COPY(IDSpace,DiskCuisine)
	ON_CLIENT(IDSpace)
	AUTO_GC(IDSpace)
  public: /* creation */

	/* Return the global ID space. */
	
	static CLIENT RPTR(IDSpace) global ();
	
	/* Essential. Take some information describing an IDSpace and 
	create the IDSpace it was exported from. */
	
	static CLIENT RPTR(IDSpace) import (APTR(PrimIntArray) ARG(data));
	
	/* Essential. Create a new globally unique space of IDs */
	
	static CLIENT RPTR(IDSpace) unique ();
	
  private: /* private: pseudo constructors */

	
	static RPTR(IDSpace) make (APTR(Sequence) OR(NULL) ARG(identifier), IntegerVar ARG(number));
	
	
	static RPTR(IDSpace) make (
			APTR(Sequence) OR(NULL) ARG(identifier), 
			IntegerVar ARG(number), 
			APTR(Counter) ARG(counter))
	;
	
  public: /* rcvr pseudo constructors */

	
	static RPTR(Heaper) make (APTR(Rcvr) ARG(rcvr));
	
  public: /* making */

	/* Essential. The Region of IDs in this space which might be 
	genrated by the given Server */
	
	virtual CLIENT RPTR(IDRegion) iDsFromServer (APTR(Sequence) ARG(identifier));
	
	/* Essential. A new ID guaranteed to be different from every 
	other newID generated by this IDSpace or any IDSpace isEqual 
	to it, on any Server. (Although of course IDs generated using 
	this->oldID () may conflict if the right numbers happen to 
	have been supplied.) */
	
	virtual CLIENT RPTR(ID) newID ();
	
	/* A region containing a finite number of globally unique 
	IDs. See newID for uniqueness guarantees. */
	
	virtual CLIENT RPTR(IDRegion) newIDs (IntegerVar ARG(count));
	
  private: /* private: for friends */

	/* Essential. The Server which created this IDSpace */
	
	virtual RPTR(Sequence) backend ();
	
	
	virtual RPTR(Sequence) OR(NULL) fetchBackend ();
	
	/* NULL if this is the global IDSpace, self otherwise */
	
	virtual RPTR(IDSpace) OR(NULL) fetchIDSpace ();
	
	/* Recreate a region of IDs from information that was stored 
	outside the Server */
	
	virtual RPTR(IDRegion) oldIDs (APTR(Sequence) ARG(backend), APTR(IntegerRegion) ARG(numbers));
	
	/* Essential. Identifies this particular space among all 
	those generated by the same Server. */
	
	virtual IntegerVar spaceNumber ();
	
  private: /* private: create */

	
	IDSpace (
			APTR(Sequence) OR(NULL) ARG(backend), 
			IntegerVar ARG(number), 
			APTR(Counter) ARG(counter))
	;
	
	
	virtual void finishCreation ();
	
  public: /* testing */

	
	virtual UInt32 actualHashForEqual ();
	
	
	virtual BooleanVar isEqual (APTR(Heaper) ARG(other));
	
  public: /* printing */

	
	virtual void printOn (ostream& ARG(oo));
	
  public: /* accessing */

	/* Essential. Produce an array which can be handed to 
	Server::importIDSpace on any Server to get back the same IDSpace */
	
	virtual CLIENT RPTR(UInt8Array) export ();
	
  public: /* obsolete: */

	/* A Sequence uniquely identifying this IDSpace, so that
			FeServer::current ()->oldIDSpace (this->identifier ())
				->isEqual (this) */
	
	virtual RPTR(Sequence) identifier ();
	
  public: /* hooks: */

	
	virtual SEND_HOOK void sendIDSpaceTo (APTR(Xmtr) ARG(xmtr));
	
  private:
	CHKPTR(Sequence) OR(NULL) myBackend;
	IntegerVar mySpaceNumber;
	CHKPTR(Counter) myNewIDCounter;
/* Friends for class IDSpace */
friend IDSimpleStepper;
friend class BeGrandMap;
friend class IDTester;
friend class ID;
friend class IDRegion;


};  /* end class IDSpace */



