/* ************************************************************************ *
 * 
 *                    Class ID 
 *
 * ************************************************************************ */




	/* Implementation note:
	
	An ID exists within a particular IDSpace, and is generated by 
	a particular Server. It holds onto the space and the Server 
	which created it, along with a number identifying the ID 
	uniquely. If mySpace is NULL, then the ID is in the global 
	IDSpace. If myBackend is NULL, then this ID was generated by 
	the current Server (unless myNumber is negative, in which 
	case it is considered to have been generated by the "global" 
	backend). If myBackend is non-NULL, then myNumber must be 
	non-negative. */

class ID : public Position {

/* Attributes for class ID */
	CONCRETE(ID)
	ON_CLIENT(ID)
	COPY(ID,DiskCuisine)
	AUTO_GC(ID)
  public: /* module private create */

	
	static RPTR(ID) make (
			APTR(IDSpace) OR(NULL) ARG(space), 
			APTR(Sequence) OR(NULL) ARG(backend), 
			IntegerVar ARG(number))
	;
	
  private: /* private: pseudo constructors */

	/* Special for IDStepper - checks whether it should make 
	backend be NULL */
	
	static RPTR(ID) usingx (
			APTR(IDSpace) OR(NULL) ARG(space), 
			APTR(Sequence) OR(NULL) ARG(backend), 
			IntegerVar ARG(number))
	;
	
  public: /* creation */

	/* Essential. Take some information describing an ID and 
	create the ID it was exported from. */
	
	static CLIENT RPTR(ID) import (APTR(PrimIntArray) ARG(data));
	
  private: /* private: export/import for friends */

	/* Write a IntegerRegion onto a stream */
	
	static void exportIntegerRegion (APTR(SpecialistXmtr) ARG(xmtr), APTR(IntegerRegion) ARG(integers));
	
	/* Write a Sequence onto a stream */
	
	static void exportSequence (APTR(SpecialistXmtr) ARG(xmtr), APTR(Sequence) ARG(sequence));
	
	/* Read a IntegerRegion from a stream */
	
	static RPTR(IntegerRegion) importIntegerRegion (APTR(SpecialistRcvr) ARG(rcvr));
	
	/* Read a Sequence from a stream */
	
	static RPTR(Sequence) importSequence (APTR(SpecialistRcvr) ARG(rcvr));
	
  public: /* accessing */

	
	virtual RPTR(XnRegion) asRegion ();
	
	
	virtual RPTR(CoordinateSpace) coordinateSpace ();
	
	/* Essential. Export this iD in a form which can be handed to 
	Server::importID on any Server to generate the same ID */
	
	virtual CLIENT RPTR(UInt8Array) export ();
	
  public: /* comparing */

	
	virtual UInt32 actualHashForEqual ();
	
	
	virtual BooleanVar isEqual (APTR(Heaper) ARG(heaper));
	
  protected: /* protected: create */

	
	ID (
			APTR(IDSpace) OR(NULL) ARG(space), 
			APTR(Sequence) OR(NULL) ARG(backend), 
			IntegerVar ARG(number))
	;
	
  public: /* printing */

	
	virtual void printOn (ostream& ARG(oo));
	
  private: /* private: */

	/* Essential. A Sequence identifying the server on which this 
	was created */
	
	virtual RPTR(Sequence) backend ();
	
	
	virtual RPTR(Sequence) OR(NULL) fetchBackend ();
	
	
	virtual RPTR(IDSpace) OR(NULL) fetchSpace ();
	
	/* Essential. The number identifying this ID from all others 
	generated by the same Server in the same IDSpace. */
	
	virtual IntegerVar number ();
	
  public: /* obsolete: */

	/* A sequence of numbers which uniquely identify this ID 
	within its space */
	
	virtual RPTR(Sequence) identifier ();
	
  private:
	CHKPTR(IDSpace) OR(NULL) mySpace;
	CHKPTR(Sequence) OR(NULL) myBackend;
	IntegerVar myNumber;
/* Friends for class ID */
friend class IDRegion;
friend class IDStepper;
friend class IDUpOrder;
friend class IDTester;
friend class IDSpace;



};  /* end class ID */



