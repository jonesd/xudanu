/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "FeVirtualDataHolder" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of FeVirtualDataHolder ====== */

void FeVirtualDataHolder::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FeVirtualDataHolder*)origin)->myValue,
				       (Heaper**)&myValue);
		Heaplet::forwardToOld ((Heaper**)&((FeVirtualDataHolder*)origin)->myKey,
				       (Heaper**)&myKey);
		Heaplet::forwardToOld ((Heaper**)&((FeVirtualDataHolder*)origin)->myEdition,
				       (Heaper**)&myEdition);
	} else {
		myValue.forwardTo (Heaplet::forward (myValue));
		myKey.forwardTo (Heaplet::forward (myKey));
		myEdition.forwardTo (Heaplet::forward (myEdition));
	}
}

/*----------------------- END FeVirtualDataHolder -----------------------*/


