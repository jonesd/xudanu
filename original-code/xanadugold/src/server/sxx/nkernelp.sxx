/*----------------------- BEGIN EditionStepper -----------------------*/
DEFINE_CLASS_CATEGORY(EditionStepper,TableStepper)

void EditionStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "EditionStepper" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of EditionStepper ====== */

void EditionStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((EditionStepper*)origin)->myKeys,
				       (Heaper**)&myKeys);
		Heaplet::forwardToOld ((Heaper**)&((EditionStepper*)origin)->myEdition,
				       (Heaper**)&myEdition);
	} else {
		myKeys.forwardTo (Heaplet::forward (myKeys));
		myEdition.forwardTo (Heaplet::forward (myEdition));
	}
}

/*----------------------- END EditionStepper -----------------------*/


