/*----------------------- BEGIN FeWrapper -----------------------*/
DEFINE_CLASS_CATEGORY(FeWrapper,Heaper)
DEFINE_OPAQUE_TYPE(FeWrapper);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "FeWrapper" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */


BooleanVar FeWrapper::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 FeWrapper::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of FeWrapper ====== */

void FeWrapper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FeWrapper*)origin)->myEdition,
				       (Heaper**)&myEdition);
		Heaplet::forwardToOld ((Heaper**)&((FeWrapper*)origin)->myInner,
				       (Heaper**)&myInner);
		Heaplet::forwardToOld ((Heaper**)&((FeWrapper*)origin)->mySpec,
				       (Heaper**)&mySpec);
	} else {
		myEdition.forwardTo (Heaplet::forward (myEdition));
		myInner.forwardTo (Heaplet::forward (myInner));
		mySpec.forwardTo (Heaplet::forward (mySpec));
	}
}

/*----------------------- END FeWrapper -----------------------*/


