/*----------------------- BEGIN FeWrapperSpec -----------------------*/
DEFINE_CLASS_CATEGORY(FeWrapperSpec,Heaper)
DEFINE_OPAQUE_TYPE(FeWrapperSpec);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "FeWrapperSpec" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */


BooleanVar FeWrapperSpec::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 FeWrapperSpec::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of FeWrapperSpec ====== */

void FeWrapperSpec::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FeWrapperSpec*)origin)->myDef,
				       (Heaper**)&myDef);
		Heaplet::forwardToOld ((Heaper**)&((FeWrapperSpec*)origin)->myEndorsements,
				       (Heaper**)&myEndorsements);
		Heaplet::forwardToOld ((Heaper**)&((FeWrapperSpec*)origin)->myFilter,
				       (Heaper**)&myFilter);
		Heaplet::forwardToOld ((Heaper**)&((FeWrapperSpec*)origin)->mySuperSpec,
				       (Heaper**)&mySuperSpec);
	} else {
		myDef.forwardTo (Heaplet::forward (myDef));
		myEndorsements.forwardTo (Heaplet::forward (myEndorsements));
		myFilter.forwardTo (Heaplet::forward (myFilter));
		mySuperSpec.forwardTo (Heaplet::forward (mySuperSpec));
	}
}

/*----------------------- END FeWrapperSpec -----------------------*/

