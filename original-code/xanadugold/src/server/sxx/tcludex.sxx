/* ====== Shepherd Stub Class "TrailBlazerStub" ======= */


#ifndef DISKMANX_HXX
#include "diskmanx.hxx" 
#define DISKMANX_HXX
#endif /* DISKMANX_HXX */

extern Category * cat_TrailBlazerStub;

CLASS(TrailBlazerStub,TrailBlazer) {
	CONCRETE(TrailBlazerStub)
	MANUAL_GC(TrailBlazerStub)
	NOT_A_TYPE(TrailBlazerStub)
  public:
	inline TrailBlazerStub(ShepFlag, UInt32 aHash, APTR(FlockInfo) info) 
          :  TrailBlazer(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

    void setEdition(WSP2_BeEdition arg1) {
    ((this)->getReal());
    this->setEdition(arg1);
    }

    BooleanVar isAlive() {
    return (this)->getReal()->isAlive();
    }

    void record(WSP2_BeRangeElement arg1) {
    (this)->getReal()->record(arg1);
    }

    void addReference(WSP2_Abraham arg1) {
    (this)->getReal()->addReference(arg1);
    }

    void removeReference(WSP2_Abraham arg1) {
    (this)->getReal()->removeReference(arg1);
    }

    void dismantle() {
    ((this)->getReal());
    this->dismantle();
    }

    void diskUpdate() {
    ((this)->getReal());
    this->diskUpdate();
    }

    void destroy() {
    (this)->getReal()->destroy();
    }

    UInt32 contentsHash() {
    return (this)->getReal()->contentsHash();
    }

    BooleanVar isPurgeable() {
    return (this)->getReal()->isPurgeable();
    }

    BooleanVar isUnlocked() {
    return (this)->getReal()->isUnlocked();
    }

    void restartAbraham(WSP2_Rcvr arg1) {
    (this)->getReal()->restartAbraham(arg1);
    }

    UInt32 hashForEqual() {
    return (this)->getReal()->hashForEqual();
    }

    void printContentsOn(ostream& arg1) {
    (this)->getReal()->printContentsOn(arg1);
    }

    void changeClassToThatOf(WSP2_Heaper arg1) {
    (this)->getReal()->changeClassToThatOf(arg1);
    }

    void sendSelfTo(WSP2_Xmtr arg1) {
    (this)->getReal()->sendSelfTo(arg1);
    }


    private:
      TrailBlazer *	getReal();  // just * in case not a type

	// Stripped-down COPY(TrailBlazerStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * TrailBlazer::getShepherdStubCategory () CONST
{
        return cat_TrailBlazerStub;
}

void TrailBlazer::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) TrailBlazerStub (shepFlag, hash, info);
}

/* ===== TrailBlazerStub Implementations ==== */

void TrailBlazerStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

TrailBlazer * TrailBlazerStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar TrailBlazerStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_TrailBlazerStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_TrailBlazer)) {
		return ((TrailBlazerStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(TrailBlazerStub,TrailBlazer)

void TrailBlazerStub::deferredHack () { /* intentionally blank */ }

