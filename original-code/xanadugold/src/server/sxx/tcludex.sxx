/*----------------------- BEGIN HashSetCache -----------------------*/
DEFINE_CLASS_CATEGORY(HashSetCache,Heaper)
DEFINE_OPAQUE_TYPE(HashSetCache);

void HashSetCache::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "HashSetCache" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void HashSetCache::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendUInt32(mySize);
    xmtr->sendHeaper(myElements);
}

HashSetCache::HashSetCache (APTR(Rcvr) receiver, TCSJ)
{
    mySize = receiver->receiveUInt32();
    myElements = CAST(PtrArray, receiver->receiveHeaper());
}


void parseInto_HashSetCache (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) HashSetCache (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe HashSetCache_recipe(cat_HashSetCache, &DiskCuisine, parseInto_HashSetCache);


/* #endif */ /* WITH_RPC */


#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "HashSetCache" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */


BooleanVar HashSetCache::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 HashSetCache::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of HashSetCache ====== */

void HashSetCache::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((HashSetCache*)origin)->myElements,
				       (Heaper**)&myElements);
	} else {
		myElements.forwardTo (Heaplet::forward (myElements));
	}
}

/*----------------------- END HashSetCache -----------------------*/


