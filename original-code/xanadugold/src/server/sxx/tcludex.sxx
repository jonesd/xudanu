    xmtr->sendHeaper(myTrail);
    xmtr->sendHeaper(myRecorded);
    xmtr->sendIntegerVar(myRefCount);
}

TrailBlazer::TrailBlazer (APTR(Rcvr) receiver, TCSJ)
  : Abraham (receiver, tcsj) {
    myTrail = CAST(BeEdition, receiver->receiveHeaper());
    myRecorded = CAST(HashSetCache, receiver->receiveHeaper());
    myRefCount = receiver->receiveIntegerVar();
}


void parseInto_TrailBlazer (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) TrailBlazer (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe TrailBlazer_recipe(cat_TrailBlazer, &DiskCuisine, parseInto_TrailBlazer);


