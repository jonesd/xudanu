void Matcher::sendSelfTo (APTR(Xmtr) xmtr)
{
    AgendaItem::sendSelfTo (xmtr);
    xmtr->sendHeaper(myOrglRoot);
    xmtr->sendHeaper(myFinder);
    xmtr->sendHeaper(myFossil);
}

Matcher::Matcher (APTR(Rcvr) receiver, TCSJ)
  : AgendaItem (receiver, tcsj) {
    myOrglRoot = CAST(OrglRoot, receiver->receiveHeaper());
    myFinder = CAST(PropFinder, receiver->receiveHeaper());
    myFossil = CAST(RecorderFossil, receiver->receiveHeaper());
}


void parseInto_Matcher (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) Matcher (rcvr, tcsj);
}

