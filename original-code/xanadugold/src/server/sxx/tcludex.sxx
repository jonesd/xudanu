#define STUBRCPX_HXX
#endif /* STUBRCPX_HXX */

RPTR(Heaper) parseStub_Matcher (APTR(Rcvr) /*rcvr*/, UInt32 hash) {
	RETURN_CONSTRUCT(MatcherStub, (shepFlag, hash, NULL));
}

extern Recipe * DiskCuisine;
