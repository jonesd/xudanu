DEFINE_MAY_BECOME(TrailBlazerStub,TrailBlazer)


BooleanVar TrailBlazer::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 TrailBlazer::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of TrailBlazer ====== */

void TrailBlazer::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((TrailBlazer*)origin)->myTrail,
				       (Heaper**)&myTrail);
		Heaplet::forwardToOld ((Heaper**)&((TrailBlazer*)origin)->myRecorded,
				       (Heaper**)&myRecorded);
	} else {
		myTrail.forwardTo (Heaplet::forward (myTrail));
		myRecorded.forwardTo (Heaplet::forward (myRecorded));
	}
}

/*----------------------- END TrailBlazer -----------------------*/

