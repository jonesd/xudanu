/* ===== mayBecome support between stub and concrete Shepherd Prototype ===== */

DEFINE_MAY_BECOME(Matcher,MatcherStub)
DEFINE_MAY_BECOME(MatcherStub,Matcher)

/* ====== Object Migrator for Scavenging of Matcher ====== */

void Matcher::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->AgendaItem::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Matcher*)origin)->myOrglRoot,
				       (Heaper**)&myOrglRoot);
		Heaplet::forwardToOld ((Heaper**)&((Matcher*)origin)->myFinder,
				       (Heaper**)&myFinder);
		Heaplet::forwardToOld ((Heaper**)&((Matcher*)origin)->myFossil,
				       (Heaper**)&myFossil);
	} else {
		myOrglRoot.forwardTo (Heaplet::forward (myOrglRoot));
		myFinder.forwardTo (Heaplet::forward (myFinder));
		myFossil.forwardTo (Heaplet::forward (myFossil));
	}
}

/*----------------------- END Matcher -----------------------*/


