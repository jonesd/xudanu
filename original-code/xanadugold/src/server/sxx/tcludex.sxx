#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void RecorderFossil::sendSelfTo (APTR(Xmtr) xmtr)
{
    Abraham::sendSelfTo (xmtr);
    xmtr->sendHeaper(myLoginAuthority);
    xmtr->sendHeaper(myTrailBlazer);
    xmtr->sendIntegerVar(myAgendaCount);
}

RecorderFossil::RecorderFossil (APTR(Rcvr) receiver, TCSJ)
  : Abraham (receiver, tcsj) {
    myLoginAuthority = CAST(IDRegion, receiver->receiveHeaper());
    myTrailBlazer = CAST(TrailBlazer, receiver->receiveHeaper());
    myAgendaCount = receiver->receiveIntegerVar();
    this->restartRecorderFossil(receiver);
}


/* #endif */ /* WITH_RPC */


