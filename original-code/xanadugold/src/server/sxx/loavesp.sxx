#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void DspLoaf::sendSelfTo (APTR(Xmtr) xmtr)
{
    InnerLoaf::sendSelfTo (xmtr);
    xmtr->sendHeaper(myDsp);
    xmtr->sendHeaper(myO);
}

DspLoaf::DspLoaf (APTR(Rcvr) receiver, TCSJ)
  : InnerLoaf (receiver, tcsj) {
    myDsp = CAST(Dsp, receiver->receiveHeaper());
    myO = CAST(Loaf, receiver->receiveHeaper());
}


void parseInto_DspLoaf (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) DspLoaf (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe DspLoaf_recipe(cat_DspLoaf, &DiskCuisine, parseInto_DspLoaf);


