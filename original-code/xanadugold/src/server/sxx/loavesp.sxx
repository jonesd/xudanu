/* ===== mayBecome support between stub and concrete Shepherd ===== */

extern Category * cat_LoafStub;
DEFINE_MAY_BECOME(DspLoaf,LoafStub)
DEFINE_MAY_BECOME(LoafStub,DspLoaf)

/* ====== Object Migrator for Scavenging of DspLoaf ====== */

void DspLoaf::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->InnerLoaf::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((DspLoaf*)origin)->myDsp,
				       (Heaper**)&myDsp);
		Heaplet::forwardToOld ((Heaper**)&((DspLoaf*)origin)->myO,
				       (Heaper**)&myO);
	} else {
		myDsp.forwardTo (Heaplet::forward (myDsp));
		myO.forwardTo (Heaplet::forward (myO));
	}
}

/*----------------------- END DspLoaf -----------------------*/


