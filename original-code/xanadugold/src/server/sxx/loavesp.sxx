/* ====== Shepherd Patriarch Class "SharedData" ======= */

#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Shepherd Stub Class "SharedDataStub" ======= */


#ifndef DISKMANX_HXX
#include "diskmanx.hxx" 
#define DISKMANX_HXX
#endif /* DISKMANX_HXX */

extern Category * cat_SharedDataStub;

CLASS(SharedDataStub,SharedData) {
	CONCRETE(SharedDataStub)
	MANUAL_GC(SharedDataStub)
	NOT_A_TYPE(SharedDataStub)
  public:
	inline SharedDataStub(ShepFlag, UInt32 aHash, APTR(FlockInfo) info) 
          :  SharedData(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

    UInt32 contentsHash() {
    return (this)->getReal()->contentsHash();
    }

    RSP2_Heaper fetch(WSP2_Position arg1) {
    return (this)->getReal()->fetch(arg1);
    }

    void fill(WSP2_XnRegion arg1, WSP2_Arrangement arg2, WSP2_PrimArray arg3, WSP2_Dsp arg4) {
    (this)->getReal()->fill(arg1, arg2, arg3, arg4);
    }

    RSP2_PrimSpec spec() {
    return (this)->getReal()->spec();
    }

    void dismantle() {
    ((this)->getReal());
    this->dismantle();
    }

    void diskUpdate() {
    ((this)->getReal());
    this->diskUpdate();
    }

    void destroy() {
    (this)->getReal()->destroy();
    }

    BooleanVar isPurgeable() {
    return (this)->getReal()->isPurgeable();
    }

    BooleanVar isUnlocked() {
    return (this)->getReal()->isUnlocked();
    }

    void restartAbraham(WSP2_Rcvr arg1) {
    (this)->getReal()->restartAbraham(arg1);
    }

    UInt32 hashForEqual() {
    return (this)->getReal()->hashForEqual();
    }

    void printContentsOn(ostream& arg1) {
    (this)->getReal()->printContentsOn(arg1);
    }

    void changeClassToThatOf(WSP2_Heaper arg1) {
    (this)->getReal()->changeClassToThatOf(arg1);
    }

    void sendSelfTo(WSP2_Xmtr arg1) {
    (this)->getReal()->sendSelfTo(arg1);
    }


    private:
      SharedData *	getReal();  // just * in case not a type

	// Stripped-down COPY(SharedDataStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * SharedData::getShepherdStubCategory () CONST
{
        return cat_SharedDataStub;
}

void SharedData::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) SharedDataStub (shepFlag, hash, info);
}

/* ===== SharedDataStub Implementations ==== */

void SharedDataStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

SharedData * SharedDataStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar SharedDataStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_SharedDataStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_SharedData)) {
		return ((SharedDataStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(SharedDataStub,SharedData)

void SharedDataStub::deferredHack () { /* intentionally blank */ }

/* #ifdef WITH_RPC */
/* ====== Stub Recipe for SharedData ====== */

#ifndef STUBRCPX_HXX
#include "stubrcpx.hxx"
#define STUBRCPX_HXX
#endif /* STUBRCPX_HXX */

RPTR(Heaper) parseStub_SharedData (APTR(Rcvr) /*rcvr*/, UInt32 hash) {
	RETURN_CONSTRUCT(SharedDataStub, (shepFlag, hash, NULL));
}

extern Recipe * DiskCuisine;
ActualStubRecipe SharedDataStub_recipe(cat_SharedDataStub, &DiskCuisine, parseStub_SharedData);

/* #endif */ /* WITH_RPC */

/* ===== mayBecome support between stub and concrete Shepherd Prototype ===== */

DEFINE_MAY_BECOME(SharedData,SharedDataStub)
DEFINE_MAY_BECOME(SharedDataStub,SharedData)

/* ====== Object Migrator for Scavenging of SharedData ====== */

void SharedData::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SharedData*)origin)->myArrangement,
				       (Heaper**)&myArrangement);
		Heaplet::forwardToOld ((Heaper**)&((SharedData*)origin)->myData,
				       (Heaper**)&myData);
	} else {
		myArrangement.forwardTo (Heaplet::forward (myArrangement));
		myData.forwardTo (Heaplet::forward (myData));
	}
}

/*----------------------- END SharedData -----------------------*/


