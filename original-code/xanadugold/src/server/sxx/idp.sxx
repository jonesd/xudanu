/*----------------------- BEGIN IDUpOrder -----------------------*/
DEFINE_CLASS_CATEGORY(IDUpOrder,OrderSpec)

void IDUpOrder::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "IDUpOrder" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void IDUpOrder::sendSelfTo (APTR(Xmtr) xmtr)
{
    OrderSpec::sendSelfTo (xmtr);
    xmtr->sendHeaper(myIDSpace);
}

IDUpOrder::IDUpOrder (APTR(Rcvr) receiver, TCSJ)
  : OrderSpec (receiver, tcsj) {
    myIDSpace = CAST(IDSpace, receiver->receiveHeaper());
}


void parseInto_IDUpOrder (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) IDUpOrder (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe IDUpOrder_recipe(cat_IDUpOrder, &DiskCuisine, parseInto_IDUpOrder);


/* #endif */ /* WITH_RPC */


