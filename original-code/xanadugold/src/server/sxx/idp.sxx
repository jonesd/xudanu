/*----------------------- BEGIN IDSimpleStepper -----------------------*/
DEFINE_CLASS_CATEGORY(IDSimpleStepper,Stepper)

void IDSimpleStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "IDSimpleStepper" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of IDSimpleStepper ====== */

void IDSimpleStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((IDSimpleStepper*)origin)->myRegion,
				       (Heaper**)&myRegion);
		Heaplet::forwardToOld ((Heaper**)&((IDSimpleStepper*)origin)->myBackends,
				       (Heaper**)&myBackends);
		Heaplet::forwardToOld ((Heaper**)&((IDSimpleStepper*)origin)->myIDs,
				       (Heaper**)&myIDs);
		Heaplet::forwardToOld ((Heaper**)&((IDSimpleStepper*)origin)->myValue,
				       (Heaper**)&myValue);
		Heaplet::forwardToOld ((Heaper**)&((IDSimpleStepper*)origin)->myInexplicit,
				       (Heaper**)&myInexplicit);
	} else {
		myRegion.forwardTo (Heaplet::forward (myRegion));
		myBackends.forwardTo (Heaplet::forward (myBackends));
		myIDs.forwardTo (Heaplet::forward (myIDs));
		myValue.forwardTo (Heaplet::forward (myValue));
		myInexplicit.forwardTo (Heaplet::forward (myInexplicit));
	}
}

/*----------------------- END IDSimpleStepper -----------------------*/


