/* ====== Object Migrator for Scavenging of IDUpOrder ====== */

void IDUpOrder::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((IDUpOrder*)origin)->myIDSpace,
				       (Heaper**)&myIDSpace);
	} else {
		myIDSpace.forwardTo (Heaplet::forward (myIDSpace));
	}
}

/*----------------------- END IDUpOrder -----------------------*/

