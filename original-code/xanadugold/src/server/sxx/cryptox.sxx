BooleanVar Encrypter::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 Encrypter::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of Encrypter ====== */

void Encrypter::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Encrypter*)origin)->myPublicKey,
				       (Heaper**)&myPublicKey);
		Heaplet::forwardToOld ((Heaper**)&((Encrypter*)origin)->myPrivateKey,
				       (Heaper**)&myPrivateKey);
	} else {
		myPublicKey.forwardTo (Heaplet::forward (myPublicKey));
		myPrivateKey.forwardTo (Heaplet::forward (myPrivateKey));
	}
}

/*----------------------- END Encrypter -----------------------*/


