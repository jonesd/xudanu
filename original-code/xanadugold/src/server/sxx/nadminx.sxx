/*----------------------- BEGIN ChallengeLock -----------------------*/
DEFINE_CLASS_CATEGORY(ChallengeLock,Lock)
DEFINE_OPAQUE_TYPE(ChallengeLock);

void ChallengeLock::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "ChallengeLock" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of ChallengeLock ====== */

void ChallengeLock::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Lock::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ChallengeLock*)origin)->myChallenge,
				       (Heaper**)&myChallenge);
		Heaplet::forwardToOld ((Heaper**)&((ChallengeLock*)origin)->myResponse,
				       (Heaper**)&myResponse);
	} else {
		myChallenge.forwardTo (Heaplet::forward (myChallenge));
		myResponse.forwardTo (Heaplet::forward (myResponse));
	}
}

/*----------------------- END ChallengeLock -----------------------*/


