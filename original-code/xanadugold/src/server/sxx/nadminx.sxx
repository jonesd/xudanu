/*----------------------- BEGIN FeSession -----------------------*/
DEFINE_CLASS_CATEGORY(FeSession,Heaper)
DEFINE_OPAQUE_TYPE(FeSession);

void FeSession::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "FeSession" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of FeSession ====== */

void FeSession::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FeSession*)origin)->myInitialLogin,
				       (Heaper**)&myInitialLogin);
	} else {
		myInitialLogin.forwardTo (Heaplet::forward (myInitialLogin));
	}
}

/*----------------------- END FeSession -----------------------*/


/*----------------------- BEGIN Lock -----------------------*/
DEFINE_CLASS_CATEGORY(Lock,Heaper)
DEFINE_OPAQUE_TYPE(Lock);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "Lock" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */


BooleanVar Lock::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 Lock::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of Lock ====== */

void Lock::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Lock*)origin)->myLoginClubID,
				       (Heaper**)&myLoginClubID);
		Heaplet::forwardToOld ((Heaper**)&((Lock*)origin)->myLockSmith,
				       (Heaper**)&myLockSmith);
	} else {
		myLoginClubID.forwardTo (Heaplet::forward (myLoginClubID));
		myLockSmith.forwardTo (Heaplet::forward (myLockSmith));
	}
}

/*----------------------- END Lock -----------------------*/


