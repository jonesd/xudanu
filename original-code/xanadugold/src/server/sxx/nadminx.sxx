/* ====== Object Migrator for Scavenging of MultiLock ====== */

void MultiLock::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Lock::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((MultiLock*)origin)->myLocks,
				       (Heaper**)&myLocks);
	} else {
		myLocks.forwardTo (Heaplet::forward (myLocks));
	}
}

