/* ====== Object Migrator for Scavenging of WorksTester ====== */

void WorksTester::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((WorksTester*)origin)->myConnection,
				       (Heaper**)&myConnection);
		Heaplet::forwardToOld ((Heaper**)&((WorksTester*)origin)->myTestID,
				       (Heaper**)&myTestID);
	} else {
		myConnection.forwardTo (Heaplet::forward (myConnection));
		myTestID.forwardTo (Heaplet::forward (myTestID));
	}
}

/*----------------------- END WorksTester -----------------------*/


