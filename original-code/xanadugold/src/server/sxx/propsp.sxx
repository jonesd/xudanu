/*----------------------- BEGIN BackfollowFinder -----------------------*/
DEFINE_CLASS_CATEGORY(BackfollowFinder,BertPropFinder)

void BackfollowFinder::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "BackfollowFinder" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void BackfollowFinder::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myPermissionsFilter);
    xmtr->sendHeaper(myEndorsementsFilter);
}

BackfollowFinder::BackfollowFinder (APTR(Rcvr) receiver, TCSJ)
{
    myPermissionsFilter = CAST(Filter, receiver->receiveHeaper());
    myEndorsementsFilter = CAST(Filter, receiver->receiveHeaper());
}


void parseInto_BackfollowFinder (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) BackfollowFinder (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe BackfollowFinder_recipe(cat_BackfollowFinder, &DiskCuisine, parseInto_BackfollowFinder);


/* #endif */ /* WITH_RPC */


#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "BackfollowFinder" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of BackfollowFinder ====== */

void BackfollowFinder::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BackfollowFinder*)origin)->myPermissionsFilter,
				       (Heaper**)&myPermissionsFilter);
		Heaplet::forwardToOld ((Heaper**)&((BackfollowFinder*)origin)->myEndorsementsFilter,
				       (Heaper**)&myEndorsementsFilter);
	} else {
		myPermissionsFilter.forwardTo (Heaplet::forward (myPermissionsFilter));
		myEndorsementsFilter.forwardTo (Heaplet::forward (myEndorsementsFilter));
	}
}

/*----------------------- END BackfollowFinder -----------------------*/


