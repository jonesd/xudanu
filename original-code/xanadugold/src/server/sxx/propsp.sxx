/* ====== Copy Class "BackfollowPFinder" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of BackfollowPFinder ====== */

void BackfollowPFinder::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BackfollowPFinder*)origin)->myPermissionsFilter,
				       (Heaper**)&myPermissionsFilter);
	} else {
		myPermissionsFilter.forwardTo (Heaplet::forward (myPermissionsFilter));
	}
}

