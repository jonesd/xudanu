void CanopyCrum::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) CanopyCrumStub (shepFlag, hash, info);
}

/* ===== CanopyCrumStub Implementations ==== */

void CanopyCrumStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

CanopyCrum * CanopyCrumStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar CanopyCrumStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_CanopyCrumStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_CanopyCrum)) {
		return ((CanopyCrumStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

