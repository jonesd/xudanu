/* ====== Object Migrator for Scavenging of CanopyCrum ====== */

void CanopyCrum::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((CanopyCrum*)origin)->child1,
				       (Heaper**)&child1);
		Heaplet::forwardToOld ((Heaper**)&((CanopyCrum*)origin)->child2,
				       (Heaper**)&child2);
		Heaplet::forwardToOld ((Heaper**)&((CanopyCrum*)origin)->parent,
				       (Heaper**)&parent);
	} else {
		child1.forwardTo (Heaplet::forward (child1));
		child2.forwardTo (Heaplet::forward (child2));
		parent.forwardTo (Heaplet::forward (parent));
	}
}

