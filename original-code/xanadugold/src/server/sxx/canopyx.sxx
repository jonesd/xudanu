Category * SensorCrum::getShepherdStubCategory () CONST
{
        return cat_SensorCrumStub;
}

void SensorCrum::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) SensorCrumStub (shepFlag, hash, info);
}

/* ===== SensorCrumStub Implementations ==== */

void SensorCrumStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

SensorCrum * SensorCrumStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar SensorCrumStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_SensorCrumStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_SensorCrum)) {
		return ((SensorCrumStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(SensorCrumStub,SensorCrum)

void SensorCrumStub::deferredHack () { /* intentionally blank */ }

