/* ====== Object Migrator for Scavenging of SensorCrum ====== */

void SensorCrum::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->CanopyCrum::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SensorCrum*)origin)->myBackfollowRecorders,
				       (Heaper**)&myBackfollowRecorders);
	} else {
		myBackfollowRecorders.forwardTo (Heaplet::forward (myBackfollowRecorders));
	}
}

