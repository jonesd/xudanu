/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of FeBundle ====== */

void FeBundle::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FeBundle*)origin)->myRegion,
				       (Heaper**)&myRegion);
	} else {
		myRegion.forwardTo (Heaplet::forward (myRegion));
	}
}

/*----------------------- END FeBundle -----------------------*/


/*----------------------- BEGIN FeArrayBundle -----------------------*/
DEFINE_CLASS_CATEGORY(FeArrayBundle,FeBundle)
DEFINE_OPAQUE_TYPE(FeArrayBundle);

void FeArrayBundle::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
