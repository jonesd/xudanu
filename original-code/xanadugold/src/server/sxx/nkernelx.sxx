DEFINE_CLASS_CATEGORY(FeKeyMaster,Heaper)
DEFINE_OPAQUE_TYPE(FeKeyMaster);

void FeKeyMaster::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "FeKeyMaster" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */


BooleanVar FeKeyMaster::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 FeKeyMaster::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of FeKeyMaster ====== */

void FeKeyMaster::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FeKeyMaster*)origin)->myLoginAuthority,
				       (Heaper**)&myLoginAuthority);
		Heaplet::forwardToOld ((Heaper**)&((FeKeyMaster*)origin)->myActualAuthority,
				       (Heaper**)&myActualAuthority);
		Heaplet::forwardToOld ((Heaper**)&((FeKeyMaster*)origin)->myRegisteredWorks,
				       (Heaper**)&myRegisteredWorks);
	} else {
		myLoginAuthority.forwardTo (Heaplet::forward (myLoginAuthority));
		myActualAuthority.forwardTo (Heaplet::forward (myActualAuthority));
		myRegisteredWorks.forwardTo (Heaplet::forward (myRegisteredWorks));
	}
}

/*----------------------- END FeKeyMaster -----------------------*/


