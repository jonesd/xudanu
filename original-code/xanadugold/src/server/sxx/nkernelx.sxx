BooleanVar FeServer::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 FeServer::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of FeServer ====== */

void FeServer::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FeServer*)origin)->myEncrypterName,
				       (Heaper**)&myEncrypterName);
		Heaplet::forwardToOld ((Heaper**)&((FeServer*)origin)->myEncrypter,
				       (Heaper**)&myEncrypter);
	} else {
		myEncrypterName.forwardTo (Heaplet::forward (myEncrypterName));
		myEncrypter.forwardTo (Heaplet::forward (myEncrypter));
	}
}

/*----------------------- END FeServer -----------------------*/

