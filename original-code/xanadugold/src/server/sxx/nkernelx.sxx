/* ====== Object Migrator for Scavenging of FeEdition ====== */

void FeEdition::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FeEdition*)origin)->myBeEdition,
				       (Heaper**)&myBeEdition);
		Heaplet::forwardToOld ((Heaper**)&((FeEdition*)origin)->myLabel,
				       (Heaper**)&myLabel);
	} else {
		myBeEdition.forwardTo (Heaplet::forward (myBeEdition));
		myLabel.forwardTo (Heaplet::forward (myLabel));
	}
}

/*----------------------- END FeEdition -----------------------*/


