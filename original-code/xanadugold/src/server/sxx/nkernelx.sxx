#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "FeArrayBundle" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of FeArrayBundle ====== */

void FeArrayBundle::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->FeBundle::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FeArrayBundle*)origin)->myArray,
				       (Heaper**)&myArray);
		Heaplet::forwardToOld ((Heaper**)&((FeArrayBundle*)origin)->myOrder,
				       (Heaper**)&myOrder);
	} else {
		myArray.forwardTo (Heaplet::forward (myArray));
		myOrder.forwardTo (Heaplet::forward (myOrder));
	}
}

/*----------------------- END FeArrayBundle -----------------------*/


