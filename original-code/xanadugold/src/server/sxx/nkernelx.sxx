DEFINE_CLASS_CATEGORY(FeWork,FeRangeElement)
DEFINE_OPAQUE_TYPE(FeWork);

void FeWork::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "FeWork" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of FeWork ====== */

void FeWork::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FeWork*)origin)->myKeyMaster,
				       (Heaper**)&myKeyMaster);
		Heaplet::forwardToOld ((Heaper**)&((FeWork*)origin)->myAuthor,
				       (Heaper**)&myAuthor);
		Heaplet::forwardToOld ((Heaper**)&((FeWork*)origin)->myBeWork,
				       (Heaper**)&myBeWork);
		Heaplet::forwardToOld ((Heaper**)&((FeWork*)origin)->myStatusDetectors,
				       (Heaper**)&myStatusDetectors);
		Heaplet::forwardToOld ((Heaper**)&((FeWork*)origin)->myRevisionDetectors,
				       (Heaper**)&myRevisionDetectors);
	} else {
		myKeyMaster.forwardTo (Heaplet::forward (myKeyMaster));
		myAuthor.forwardTo (Heaplet::forward (myAuthor));
		myBeWork.forwardTo (Heaplet::forward (myBeWork));
		myStatusDetectors.forwardTo (Heaplet::forward (myStatusDetectors));
		myRevisionDetectors.forwardTo (Heaplet::forward (myRevisionDetectors));
	}
}

/*----------------------- END FeWork -----------------------*/


