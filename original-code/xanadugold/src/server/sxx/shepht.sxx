/* ====== Shepherd Stub Class "ShepherdLockedStub" ======= */


#ifndef DISKMANX_HXX
#include "diskmanx.hxx" 
#define DISKMANX_HXX
#endif /* DISKMANX_HXX */

extern Category * cat_ShepherdLockedStub;

CLASS(ShepherdLockedStub,ShepherdLocked) {
	CONCRETE(ShepherdLockedStub)
	MANUAL_GC(ShepherdLockedStub)
	NOT_A_TYPE(ShepherdLockedStub)
  public:
	inline ShepherdLockedStub(ShepFlag, UInt32 aHash, APTR(FlockInfo) info) 
          :  ShepherdLocked(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

    BooleanVar isReallyUnlocked() {
    return (this)->getReal()->isReallyUnlocked();
    }

    void publicUnlock() {
    (this)->getReal()->publicUnlock();
    }

    void dismantle() {
    ((this)->getReal());
    this->dismantle();
    }

    void diskUpdate() {
    ((this)->getReal());
    this->diskUpdate();
    }

    void destroy() {
    (this)->getReal()->destroy();
    }

    UInt32 contentsHash() {
    return (this)->getReal()->contentsHash();
    }

    BooleanVar isPurgeable() {
    return (this)->getReal()->isPurgeable();
    }

    BooleanVar isUnlocked() {
    return (this)->getReal()->isUnlocked();
    }

    void restartAbraham(WSP2_Rcvr arg1) {
    (this)->getReal()->restartAbraham(arg1);
    }

    UInt32 hashForEqual() {
    return (this)->getReal()->hashForEqual();
    }

    void printContentsOn(ostream& arg1) {
    (this)->getReal()->printContentsOn(arg1);
    }

    void changeClassToThatOf(WSP2_Heaper arg1) {
    (this)->getReal()->changeClassToThatOf(arg1);
    }

    void sendSelfTo(WSP2_Xmtr arg1) {
    (this)->getReal()->sendSelfTo(arg1);
    }


    private:
      ShepherdLocked *	getReal();  // just * in case not a type

	// Stripped-down COPY(ShepherdLockedStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * ShepherdLocked::getShepherdStubCategory () CONST
{
        return cat_ShepherdLockedStub;
}

void ShepherdLocked::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) ShepherdLockedStub (shepFlag, hash, info);
}

/* ===== ShepherdLockedStub Implementations ==== */

void ShepherdLockedStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

ShepherdLocked * ShepherdLockedStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar ShepherdLockedStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_ShepherdLockedStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_ShepherdLocked)) {
		return ((ShepherdLockedStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(ShepherdLockedStub,ShepherdLocked)

void ShepherdLockedStub::deferredHack () { /* intentionally blank */ }

/* #ifdef WITH_RPC */
/* ====== Stub Recipe for ShepherdLocked ====== */

#ifndef STUBRCPX_HXX
#include "stubrcpx.hxx"
#define STUBRCPX_HXX
#endif /* STUBRCPX_HXX */

RPTR(Heaper) parseStub_ShepherdLocked (APTR(Rcvr) /*rcvr*/, UInt32 hash) {
	RETURN_CONSTRUCT(ShepherdLockedStub, (shepFlag, hash, NULL));
}

extern Recipe * DiskCuisine;
ActualStubRecipe ShepherdLockedStub_recipe(cat_ShepherdLockedStub, &DiskCuisine, parseStub_ShepherdLocked);

/* #endif */ /* WITH_RPC */

/* ===== mayBecome support between stub and concrete Shepherd Prototype ===== */

DEFINE_MAY_BECOME(ShepherdLocked,ShepherdLockedStub)
DEFINE_MAY_BECOME(ShepherdLockedStub,ShepherdLocked)



