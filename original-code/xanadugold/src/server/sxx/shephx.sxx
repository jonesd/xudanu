/* ====== Object Migrator for Scavenging of Abraham ====== */

void Abraham::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Abraham*)origin)->myInfo,
				       (Heaper**)&myInfo);
	} else {
		myInfo.forwardTo (Heaplet::forward (myInfo));
	}
}

/*----------------------- END Abraham -----------------------*/

