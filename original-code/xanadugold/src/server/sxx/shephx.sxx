/*----------------------- BEGIN Abraham -----------------------*/
DEFINE_CLASS_CATEGORY(Abraham,Heaper)
DEFINE_OPAQUE_TYPE(Abraham);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "Abraham" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void Abraham::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendUInt32(myHash);
}

Abraham::Abraham (APTR(Rcvr) receiver, TCSJ)
{
    myHash = receiver->receiveUInt32();
    this->restartAbraham(receiver);
}


/* #endif */ /* WITH_RPC */


