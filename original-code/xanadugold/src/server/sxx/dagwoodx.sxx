#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void DagWood::sendSelfTo (APTR(Xmtr) xmtr)
{
    Abraham::sendSelfTo (xmtr);
    xmtr->sendHeaper(myRoot);
    xmtr->sendHeaper(myTrunk);
}

DagWood::DagWood (APTR(Rcvr) receiver, TCSJ)
  : Abraham (receiver, tcsj) {
    myRoot = CAST(TracePosition, receiver->receiveHeaper());
    myTrunk = CAST(MuTable, receiver->receiveHeaper());
    this->restartDagWood(receiver);
}


void parseInto_DagWood (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) DagWood (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe DagWood_recipe(cat_DagWood, &DiskCuisine, parseInto_DagWood);


