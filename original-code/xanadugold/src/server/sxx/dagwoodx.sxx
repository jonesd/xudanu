#endif /* STUBRCPX_HXX */

RPTR(Heaper) parseStub_DagWood (APTR(Rcvr) /*rcvr*/, UInt32 hash) {
	RETURN_CONSTRUCT(DagWoodStub, (shepFlag, hash, NULL));
}

extern Recipe * DiskCuisine;
ActualStubRecipe DagWoodStub_recipe(cat_DagWoodStub, &DiskCuisine, parseStub_DagWood);

