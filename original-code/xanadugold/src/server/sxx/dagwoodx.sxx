/* ===== mayBecome support between stub and concrete Shepherd Prototype ===== */

DEFINE_MAY_BECOME(DagWood,DagWoodStub)
DEFINE_MAY_BECOME(DagWoodStub,DagWood)

/* ====== Object Migrator for Scavenging of DagWood ====== */

void DagWood::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((DagWood*)origin)->myRoot,
				       (Heaper**)&myRoot);
		Heaplet::forwardToOld ((Heaper**)&((DagWood*)origin)->myTrunk,
				       (Heaper**)&myTrunk);
		Heaplet::forwardToOld ((Heaper**)&((DagWood*)origin)->myCachedPosition,
				       (Heaper**)&myCachedPosition);
		Heaplet::forwardToOld ((Heaper**)&((DagWood*)origin)->myNavCache,
				       (Heaper**)&myNavCache);
	} else {
		myRoot.forwardTo (Heaplet::forward (myRoot));
		myTrunk.forwardTo (Heaplet::forward (myTrunk));
		myCachedPosition.forwardTo (Heaplet::forward (myCachedPosition));
		myNavCache.forwardTo (Heaplet::forward (myNavCache));
	}
}

/*----------------------- END DagWood -----------------------*/

