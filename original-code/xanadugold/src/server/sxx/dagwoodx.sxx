/* ====== Shepherd Stub Class "DagWoodStub" ======= */


#ifndef DISKMANX_HXX
#include "diskmanx.hxx" 
#define DISKMANX_HXX
#endif /* DISKMANX_HXX */

extern Category * cat_DagWoodStub;

CLASS(DagWoodStub,DagWood) {
	CONCRETE(DagWoodStub)
	MANUAL_GC(DagWoodStub)
	NOT_A_TYPE(DagWoodStub)
  public:
	inline DagWoodStub(ShepFlag, UInt32 aHash, APTR(FlockInfo) info) 
          :  DagWood(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

    RSP2_TracePosition root() {
    return (this)->getReal()->root();
    }

    RSP2_BranchDescription successorBranchOfPosition(WSP2_BranchDescription arg1, UInt32 arg2) {
    return (this)->getReal()->successorBranchOfPosition(arg1, arg2);
    }

    RSP2_MuSet successorsOf(WSP2_TracePosition arg1) {
    return (this)->getReal()->successorsOf(arg1);
    }

    void installBranchAfter(WSP2_BranchDescription arg1, WSP2_TracePosition arg2) {
    (this)->getReal()->installBranchAfter(arg1, arg2);
    }

    RSP2_TracePosition newPosition() {
    return (this)->getReal()->newPosition();
    }

    RSP2_PrimIndexTable cacheTracePos(WSP2_TracePosition arg1) {
    return (this)->getReal()->cacheTracePos(arg1);
    }

    void restartDagWood(WSP2_Rcvr arg1) {
    (this)->getReal()->restartDagWood(arg1);
    }

    UInt32 contentsHash() {
    return (this)->getReal()->contentsHash();
    }

    void dismantle() {
    ((this)->getReal());
    this->dismantle();
    }

    void diskUpdate() {
    ((this)->getReal());
    this->diskUpdate();
    }

    void destroy() {
    (this)->getReal()->destroy();
    }

    BooleanVar isPurgeable() {
    return (this)->getReal()->isPurgeable();
    }

    BooleanVar isUnlocked() {
    return (this)->getReal()->isUnlocked();
    }

    void restartAbraham(WSP2_Rcvr arg1) {
    (this)->getReal()->restartAbraham(arg1);
    }

    UInt32 hashForEqual() {
    return (this)->getReal()->hashForEqual();
    }

    void printContentsOn(ostream& arg1) {
    (this)->getReal()->printContentsOn(arg1);
    }

    void changeClassToThatOf(WSP2_Heaper arg1) {
    (this)->getReal()->changeClassToThatOf(arg1);
    }

    void sendSelfTo(WSP2_Xmtr arg1) {
    (this)->getReal()->sendSelfTo(arg1);
    }


    private:
      DagWood *	getReal();  // just * in case not a type

	// Stripped-down COPY(DagWoodStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * DagWood::getShepherdStubCategory () CONST
{
        return cat_DagWoodStub;
}

void DagWood::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) DagWoodStub (shepFlag, hash, info);
}

/* ===== DagWoodStub Implementations ==== */

void DagWoodStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

DagWood * DagWoodStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar DagWoodStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_DagWoodStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_DagWood)) {
		return ((DagWoodStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(DagWoodStub,DagWood)

void DagWoodStub::deferredHack () { /* intentionally blank */ }

