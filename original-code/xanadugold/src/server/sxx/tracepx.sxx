DEFINE_CLASS_CATEGORY(BoundedTrace,TracePosition)
DEFINE_OPAQUE_TYPE(BoundedTrace);

void BoundedTrace::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "BoundedTrace" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void BoundedTrace::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myBranch);
    xmtr->sendUInt32(myPosition);
}

BoundedTrace::BoundedTrace (APTR(Rcvr) receiver, TCSJ)
{
    myBranch = CAST(BranchDescription, receiver->receiveHeaper());
    myPosition = receiver->receiveUInt32();
}


void parseInto_BoundedTrace (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) BoundedTrace (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe BoundedTrace_recipe(cat_BoundedTrace, &DiskCuisine, parseInto_BoundedTrace);


/* #endif */ /* WITH_RPC */


