/* ====== Object Migrator for Scavenging of BoundedTrace ====== */

void BoundedTrace::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BoundedTrace*)origin)->myBranch,
				       (Heaper**)&myBranch);
	} else {
		myBranch.forwardTo (Heaplet::forward (myBranch));
	}
}

/*----------------------- END BoundedTrace -----------------------*/

