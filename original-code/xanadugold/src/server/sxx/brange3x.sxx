void BeEdition::sendSelfTo (APTR(Xmtr) xmtr)
{
    BeRangeElement::sendSelfTo (xmtr);
    xmtr->sendHeaper(myOrglRoot);
    xmtr->sendHeaper(myWorks);
    xmtr->sendHeaper(myOwnProp);
    xmtr->sendHeaper(myProp);
}

BeEdition::BeEdition (APTR(Rcvr) receiver, TCSJ)
  : BeRangeElement (receiver, tcsj) {
    myOrglRoot = CAST(OrglRoot, receiver->receiveHeaper());
    myWorks = CAST(MuSet, receiver->receiveHeaper());
    myOwnProp = CAST(BertProp, receiver->receiveHeaper());
    myProp = CAST(BertProp, receiver->receiveHeaper());
    this->restartE(receiver);
}


void parseInto_BeEdition (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) BeEdition (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe BeEdition_recipe(cat_BeEdition, &DiskCuisine, parseInto_BeEdition);


/* #endif */ /* WITH_RPC */


