Category * BeEdition::getShepherdStubCategory () CONST
{
        return cat_BeEditionStub;
}

void BeEdition::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) BeEditionStub (shepFlag, hash, info);
}

/* ===== BeEditionStub Implementations ==== */

void BeEditionStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

BeEdition * BeEditionStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar BeEditionStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_BeEditionStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_BeEdition)) {
		return ((BeEditionStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(BeEditionStub,BeEdition)

void BeEditionStub::deferredHack () { /* intentionally blank */ }

