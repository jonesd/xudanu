/* ===== mayBecome support between stub and concrete Shepherd Prototype ===== */

DEFINE_MAY_BECOME(BeEdition,BeEditionStub)
DEFINE_MAY_BECOME(BeEditionStub,BeEdition)

/* ====== Object Migrator for Scavenging of BeEdition ====== */

void BeEdition::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->BeRangeElement::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BeEdition*)origin)->myOrglRoot,
				       (Heaper**)&myOrglRoot);
		Heaplet::forwardToOld ((Heaper**)&((BeEdition*)origin)->myWorks,
				       (Heaper**)&myWorks);
		Heaplet::forwardToOld ((Heaper**)&((BeEdition*)origin)->myOwnProp,
				       (Heaper**)&myOwnProp);
		Heaplet::forwardToOld ((Heaper**)&((BeEdition*)origin)->myProp,
				       (Heaper**)&myProp);
		Heaplet::forwardToOld ((Heaper**)&((BeEdition*)origin)->myDetectors,
				       (Heaper**)&myDetectors);
	} else {
		myOrglRoot.forwardTo (Heaplet::forward (myOrglRoot));
		myWorks.forwardTo (Heaplet::forward (myWorks));
		myOwnProp.forwardTo (Heaplet::forward (myOwnProp));
		myProp.forwardTo (Heaplet::forward (myProp));
		myDetectors.forwardTo (Heaplet::forward (myDetectors));
	}
}

