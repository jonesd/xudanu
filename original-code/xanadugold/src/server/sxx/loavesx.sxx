extern Category * cat_LoafStub;

CLASS(LoafStub,Loaf) {
	CONCRETE(LoafStub)
	MANUAL_GC(LoafStub)
	NOT_A_TYPE(LoafStub)
  public:
	inline LoafStub(ShepFlag, UInt32 aHash, APTR(FlockInfo) info) 
          :  Loaf(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

    RSP2_Mapping compare(WSP2_TracePosition arg1, WSP2_XnRegion arg2) {
    return (this)->getReal()->compare(arg1, arg2);
    }

    IntegerVar count() {
    return (this)->getReal()->count();
    }

    RSP2_XnRegion domain() {
    return (this)->getReal()->domain();
    }

    RSP2_FeRangeElement fetch(WSP2_Position arg1, WSP2_BeEdition arg2, WSP2_Position arg3) {
    return (this)->getReal()->fetch(arg1, arg2, arg3);
    }

    RSP2_OExpandingLoaf fetchBottomAt(WSP2_Position arg1) {
    return (this)->getReal()->fetchBottomAt(arg1);
    }

    void fill(WSP2_XnRegion arg1, WSP2_Arrangement arg2, WSP2_PrimArray arg3, WSP2_Dsp arg4, WSP2_BeEdition arg5) {
    (this)->getReal()->fill(arg1, arg2, arg3, arg4, arg5);
    }

    RSP2_BeRangeElement getBe(WSP2_Position arg1) {
    return (this)->getReal()->getBe(arg1);
    }

    RSP2_XnRegion rangeOwners(WSP2_XnRegion arg1) {
    return (this)->getReal()->rangeOwners(arg1);
    }

    RSP2_OrglRoot setAllOwners(WSP2_ID arg1) {
    return (this)->getReal()->setAllOwners(arg1);
    }

    RSP2_XnRegion usedDomain() {
    return (this)->getReal()->usedDomain();
    }

    RSP2_Stepper bundleStepper(WSP2_XnRegion arg1, WSP2_OrderSpec arg2, WSP2_Dsp arg3) {
    return (this)->getReal()->bundleStepper(arg1, arg2, arg3);
    }

    RSP2_OrglRoot combine(WSP2_ActualOrglRoot arg1, WSP2_XnRegion arg2, WSP2_Dsp arg3) {
    return (this)->getReal()->combine(arg1, arg2, arg3);
    }

    RSP2_XnRegion keysLabelled(WSP2_BeLabel arg1) {
    return (this)->getReal()->keysLabelled(arg1);
    }

    RSP2_XnRegion sharedRegion(WSP2_TracePosition arg1, WSP2_XnRegion arg2) {
    return (this)->getReal()->sharedRegion(arg1, arg2);
    }

    RSP2_Loaf transformedBy(WSP2_Dsp arg1) {
    return (this)->getReal()->transformedBy(arg1);
    }

    RSP2_Loaf unTransformedBy(WSP2_Dsp arg1) {
    return (this)->getReal()->unTransformedBy(arg1);
    }

    UInt8 splay(WSP2_XnRegion arg1, WSP2_XnRegion arg2) {
    return (this)->getReal()->splay(arg1, arg2);
    }

    Int8 actualSplay(WSP2_XnRegion arg1, WSP2_XnRegion arg2) {
    ((this)->getReal());
    return this->actualSplay(arg1, arg2);
    }

    void addOParent(WSP2_OPart arg1) {
    (this)->getReal()->addOParent(arg1);
    }

    RSP2_XnRegion attachTrailBlazer(WSP2_TrailBlazer arg1) {
    return (this)->getReal()->attachTrailBlazer(arg1);
    }

    void checkChildRecorders(WSP2_PropFinder arg1) {
    (this)->getReal()->checkChildRecorders(arg1);
    }

    void checkRecorders(WSP2_PropFinder arg1, WSP2_SensorCrum arg2) {
    (this)->getReal()->checkRecorders(arg1, arg2);
    }

    void checkTrailBlazer(WSP2_TrailBlazer arg1) {
    (this)->getReal()->checkTrailBlazer(arg1);
    }

    void delayedStoreMatching(WSP2_PropFinder arg1, WSP2_RecorderFossil arg2, WSP2_ResultRecorder arg3, WSP2_HashSetCache arg4) {
    (this)->getReal()->delayedStoreMatching(arg1, arg2, arg3, arg4);
    }

    RSP2_TrailBlazer fetchTrailBlazer() {
    return (this)->getReal()->fetchTrailBlazer();
    }

    RSP2_HistoryCrum hCrum() {
    return (this)->getReal()->hCrum();
    }

    void removeOParent(WSP2_OPart arg1) {
    (this)->getReal()->removeOParent(arg1);
    }

    void storeRecordingAgents(WSP2_RecorderFossil arg1, WSP2_Agenda arg2) {
    (this)->getReal()->storeRecordingAgents(arg1, arg2);
    }

    void triggerDetector(WSP2_FeFillRangeDetector arg1) {
    (this)->getReal()->triggerDetector(arg1);
    }

    BooleanVar updateBCrumTo(WSP2_BertCrum arg1) {
    return (this)->getReal()->updateBCrumTo(arg1);
    }

    RSP2_FeEdition asFeEdition() {
    ((this)->getReal());
    return this->asFeEdition();
    }

    void dismantle() {
    ((this)->getReal());
    this->dismantle();
    }

    UInt32 contentsHash() {
    return (this)->getReal()->contentsHash();
    }

    RSP2_Mapping mappingTo(WSP2_TracePosition arg1, WSP2_Mapping arg2) {
    return (this)->getReal()->mappingTo(arg1, arg2);
    }

    RSP2_SensorCrum sensorCrum() {
    return (this)->getReal()->sensorCrum();
    }

    void diskUpdate() {
    ((this)->getReal());
    this->diskUpdate();
    }

    void destroy() {
    (this)->getReal()->destroy();
    }

    BooleanVar isPurgeable() {
    return (this)->getReal()->isPurgeable();
    }

    BooleanVar isUnlocked() {
    return (this)->getReal()->isUnlocked();
    }

    void restartAbraham(WSP2_Rcvr arg1) {
    (this)->getReal()->restartAbraham(arg1);
    }

    UInt32 hashForEqual() {
    return (this)->getReal()->hashForEqual();
    }

    void printContentsOn(ostream& arg1) {
    (this)->getReal()->printContentsOn(arg1);
    }

    void changeClassToThatOf(WSP2_Heaper arg1) {
    (this)->getReal()->changeClassToThatOf(arg1);
    }

    void sendSelfTo(WSP2_Xmtr arg1) {
    (this)->getReal()->sendSelfTo(arg1);
    }


    private:
      Loaf *	getReal();  // just * in case not a type

	// Stripped-down COPY(LoafStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * Loaf::getShepherdStubCategory () CONST
{
        return cat_LoafStub;
}

void Loaf::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) LoafStub (shepFlag, hash, info);
}

/* ===== LoafStub Implementations ==== */

void LoafStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

Loaf * LoafStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar LoafStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_LoafStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_Loaf)) {
		return ((LoafStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(LoafStub,Loaf)

void LoafStub::deferredHack () { /* intentionally blank */ }

/* #ifdef WITH_RPC */
/* ====== Stub Recipe for Loaf ====== */

#ifndef STUBRCPX_HXX
#include "stubrcpx.hxx"
#define STUBRCPX_HXX
#endif /* STUBRCPX_HXX */

RPTR(Heaper) parseStub_Loaf (APTR(Rcvr) /*rcvr*/, UInt32 hash) {
	RETURN_CONSTRUCT(LoafStub, (shepFlag, hash, NULL));
}

extern Recipe * DiskCuisine;
ActualStubRecipe LoafStub_recipe(cat_LoafStub, &DiskCuisine, parseStub_Loaf);

/* #endif */ /* WITH_RPC */

/* ====== Object Migrator for Scavenging of Loaf ====== */

void Loaf::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->OPart::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Loaf*)origin)->myHCrum,
				       (Heaper**)&myHCrum);
	} else {
		myHCrum.forwardTo (Heaplet::forward (myHCrum));
	}
}

/*----------------------- END Loaf -----------------------*/


