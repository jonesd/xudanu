void Loaf::sendSelfTo (APTR(Xmtr) xmtr)
{
    OPart::sendSelfTo (xmtr);
    xmtr->sendHeaper(myHCrum);
}

Loaf::Loaf (APTR(Rcvr) receiver, TCSJ)
  : OPart (receiver, tcsj) {
    myHCrum = CAST(HUpperCrum, receiver->receiveHeaper());
}


