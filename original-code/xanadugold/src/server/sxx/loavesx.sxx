/* ====== Object Migrator for Scavenging of OExpandingLoaf ====== */

void OExpandingLoaf::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Loaf::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((OExpandingLoaf*)origin)->myRegion,
				       (Heaper**)&myRegion);
	} else {
		myRegion.forwardTo (Heaplet::forward (myRegion));
	}
}

