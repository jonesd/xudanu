BooleanVar IndirectWorkRecorderFossilStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_IndirectWorkRecorderFossilStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_IndirectWorkRecorderFossil)) {
		return ((IndirectWorkRecorderFossilStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

