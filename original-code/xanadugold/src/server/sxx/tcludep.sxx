          :  EditionRecorderFossil(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

    RSP2_ResultRecorder actualRecorder() {
    ((this)->getReal());
    return this->actualRecorder();
    }

    RSP2_Filter directFilter() {
    ((this)->getReal());
    return this->directFilter();
    }

    RSP2_Filter indirectFilter() {
    ((this)->getReal());
    return this->indirectFilter();
    }

    void addItem(WSP2_AgendaItem arg1) {
    (this)->getReal()->addItem(arg1);
    }

    void extinguish(WSP2_TrailBlazer arg1) {
    (this)->getReal()->extinguish(arg1);
    }

    void releaseRecorder() {
    (this)->getReal()->releaseRecorder();
    }

    void removeItem(WSP2_AgendaItem arg1) {
    (this)->getReal()->removeItem(arg1);
    }

    RSP2_ResultRecorder secretRecorder() {
    return (this)->getReal()->secretRecorder();
    }

    BooleanVar isExtinct() {
    return (this)->getReal()->isExtinct();
    }

    BooleanVar isPurgeable() {
    return (this)->getReal()->isPurgeable();
    }

    void restartRecorderFossil(WSP2_Rcvr arg1) {
    (this)->getReal()->restartRecorderFossil(arg1);
    }

    void dismantle() {
    ((this)->getReal());
    this->dismantle();
    }

    void memoryCheck() {
    ((this)->getReal());
    this->memoryCheck();
    }

    RSP2_TrailBlazer trailBlazer() {
    ((this)->getReal());
    return this->trailBlazer();
    }

    void storeDataRecordingAgents(WSP2_SensorCrum arg1, WSP2_Agenda arg2) {
    (this)->getReal()->storeDataRecordingAgents(arg1, arg2);
    }

    void storePartialityRecordingAgents(WSP2_SensorCrum arg1, WSP2_Agenda arg2) {
    (this)->getReal()->storePartialityRecordingAgents(arg1, arg2);
    }

    void storeRangeElementRecordingAgents(WSP2_BeRangeElement arg1, WSP2_SensorCrum arg2, WSP2_Agenda arg3) {
    (this)->getReal()->storeRangeElementRecordingAgents(arg1, arg2, arg3);
    }

    void diskUpdate() {
    ((this)->getReal());
    this->diskUpdate();
    }

    void destroy() {
    (this)->getReal()->destroy();
    }

    UInt32 contentsHash() {
    return (this)->getReal()->contentsHash();
    }

    BooleanVar isUnlocked() {
    return (this)->getReal()->isUnlocked();
    }

    void restartAbraham(WSP2_Rcvr arg1) {
    (this)->getReal()->restartAbraham(arg1);
    }

    UInt32 hashForEqual() {
    return (this)->getReal()->hashForEqual();
    }

    void printContentsOn(ostream& arg1) {
    (this)->getReal()->printContentsOn(arg1);
    }

    void changeClassToThatOf(WSP2_Heaper arg1) {
    (this)->getReal()->changeClassToThatOf(arg1);
    }

    void sendSelfTo(WSP2_Xmtr arg1) {
    (this)->getReal()->sendSelfTo(arg1);
    }


    private:
      EditionRecorderFossil *	getReal();  // just * in case not a type

	// Stripped-down COPY(EditionRecorderFossilStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * EditionRecorderFossil::getShepherdStubCategory () CONST
{
        return cat_EditionRecorderFossilStub;
}

void EditionRecorderFossil::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) EditionRecorderFossilStub (shepFlag, hash, info);
}

/* ===== EditionRecorderFossilStub Implementations ==== */

void EditionRecorderFossilStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

EditionRecorderFossil * EditionRecorderFossilStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar EditionRecorderFossilStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_EditionRecorderFossilStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_EditionRecorderFossil)) {
		return ((EditionRecorderFossilStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(EditionRecorderFossilStub,EditionRecorderFossil)

void EditionRecorderFossilStub::deferredHack () { /* intentionally blank */ }

