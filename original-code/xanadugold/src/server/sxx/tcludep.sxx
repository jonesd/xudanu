#ifndef STUBRCPX_HXX
#include "stubrcpx.hxx"
#define STUBRCPX_HXX
#endif /* STUBRCPX_HXX */

RPTR(Heaper) parseStub_EditionRecorderFossil (APTR(Rcvr) /*rcvr*/, UInt32 hash) {
	RETURN_CONSTRUCT(EditionRecorderFossilStub, (shepFlag, hash, NULL));
}

extern Recipe * DiskCuisine;
ActualStubRecipe EditionRecorderFossilStub_recipe(cat_EditionRecorderFossilStub, &DiskCuisine, parseStub_EditionRecorderFossil);

/* #endif */ /* WITH_RPC */

/* ====== Object Migrator for Scavenging of EditionRecorderFossil ====== */

void EditionRecorderFossil::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->RecorderFossil::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((EditionRecorderFossil*)origin)->myDirectFilter,
				       (Heaper**)&myDirectFilter);
		Heaplet::forwardToOld ((Heaper**)&((EditionRecorderFossil*)origin)->myIndirectFilter,
				       (Heaper**)&myIndirectFilter);
	} else {
		myDirectFilter.forwardTo (Heaplet::forward (myDirectFilter));
		myIndirectFilter.forwardTo (Heaplet::forward (myIndirectFilter));
	}
}

/*----------------------- END EditionRecorderFossil -----------------------*/


