/* ====== Object Migrator for Scavenging of WorkRecorderFossil ====== */

void WorkRecorderFossil::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->RecorderFossil::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((WorkRecorderFossil*)origin)->myEndorsementsFilter,
				       (Heaper**)&myEndorsementsFilter);
	} else {
		myEndorsementsFilter.forwardTo (Heaplet::forward (myEndorsementsFilter));
	}
}

