/* ====== Object Migrator for Scavenging of GrandHashSet ====== */

void GrandHashSet::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((GrandHashSet*)origin)->grandNodes,
				       (Heaper**)&grandNodes);
		Heaplet::forwardToOld ((Heaper**)&((GrandHashSet*)origin)->myTally,
				       (Heaper**)&myTally);
		Heaplet::forwardToOld ((Heaper**)&((GrandHashSet*)origin)->myDoublingFrontIndex,
				       (Heaper**)&myDoublingFrontIndex);
		Heaplet::forwardToOld ((Heaper**)&((GrandHashSet*)origin)->myDoublingPasses,
				       (Heaper**)&myDoublingPasses);
	} else {
		grandNodes.forwardTo (Heaplet::forward (grandNodes));
		myTally.forwardTo (Heaplet::forward (myTally));
		myDoublingFrontIndex.forwardTo (Heaplet::forward (myDoublingFrontIndex));
		myDoublingPasses.forwardTo (Heaplet::forward (myDoublingPasses));
	}
}

/*----------------------- END GrandHashSet -----------------------*/


/*----------------------- BEGIN GrandHashTable -----------------------*/
DEFINE_CLASS_CATEGORY(GrandHashTable,MuTable)
DEFINE_OPAQUE_TYPE(GrandHashTable);

void GrandHashTable::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "GrandHashTable" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void GrandHashTable::sendSelfTo (APTR(Xmtr) xmtr)
{
    MuTable::sendSelfTo (xmtr);
    xmtr->sendHeaper(grandNodes);
    xmtr->sendInt32(numNodes);
    xmtr->sendInt32(nodeIndexShift);
    xmtr->sendHeaper(myTally);
    xmtr->sendHeaper(myDoublingFrontIndex);
    xmtr->sendHeaper(myDoublingPasses);
    xmtr->sendHeaper(myCs);
}

GrandHashTable::GrandHashTable (APTR(Rcvr) receiver, TCSJ)
  : MuTable (receiver, tcsj) {
    grandNodes = CAST(PtrArray, receiver->receiveHeaper());
    numNodes = receiver->receiveInt32();
    nodeIndexShift = receiver->receiveInt32();
    myTally = CAST(Counter, receiver->receiveHeaper());
    myDoublingFrontIndex = CAST(Counter, receiver->receiveHeaper());
    myDoublingPasses = CAST(Counter, receiver->receiveHeaper());
    myCs = CAST(CoordinateSpace, receiver->receiveHeaper());
    this->restartGrandHashTable(receiver);
}


void parseInto_GrandHashTable (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) GrandHashTable (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe GrandHashTable_recipe(cat_GrandHashTable, &DiskCuisine, parseInto_GrandHashTable);


/* #endif */ /* WITH_RPC */


