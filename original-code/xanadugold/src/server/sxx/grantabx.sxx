/*----------------------- BEGIN GrandHashSet -----------------------*/
DEFINE_CLASS_CATEGORY(GrandHashSet,MuSet)
DEFINE_OPAQUE_TYPE(GrandHashSet);

void GrandHashSet::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "GrandHashSet" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void GrandHashSet::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(grandNodes);
    xmtr->sendInt32(numNodes);
    xmtr->sendInt32(nodeIndexShift);
    xmtr->sendHeaper(myTally);
    xmtr->sendHeaper(myDoublingFrontIndex);
    xmtr->sendHeaper(myDoublingPasses);
}

GrandHashSet::GrandHashSet (APTR(Rcvr) receiver, TCSJ)
{
    grandNodes = CAST(PtrArray, receiver->receiveHeaper());
    numNodes = receiver->receiveInt32();
    nodeIndexShift = receiver->receiveInt32();
    myTally = CAST(Counter, receiver->receiveHeaper());
    myDoublingFrontIndex = CAST(Counter, receiver->receiveHeaper());
    myDoublingPasses = CAST(Counter, receiver->receiveHeaper());
    this->restartGrandHashSet(receiver);
}


void parseInto_GrandHashSet (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) GrandHashSet (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe GrandHashSet_recipe(cat_GrandHashSet, &DiskCuisine, parseInto_GrandHashSet);


/* #endif */ /* WITH_RPC */


