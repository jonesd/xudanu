/* ====== Object Migrator for Scavenging of GrandHashTable ====== */

void GrandHashTable::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((GrandHashTable*)origin)->grandNodes,
				       (Heaper**)&grandNodes);
		Heaplet::forwardToOld ((Heaper**)&((GrandHashTable*)origin)->myTally,
				       (Heaper**)&myTally);
		Heaplet::forwardToOld ((Heaper**)&((GrandHashTable*)origin)->myDoublingFrontIndex,
				       (Heaper**)&myDoublingFrontIndex);
		Heaplet::forwardToOld ((Heaper**)&((GrandHashTable*)origin)->myDoublingPasses,
				       (Heaper**)&myDoublingPasses);
		Heaplet::forwardToOld ((Heaper**)&((GrandHashTable*)origin)->myCs,
				       (Heaper**)&myCs);
	} else {
		grandNodes.forwardTo (Heaplet::forward (grandNodes));
		myTally.forwardTo (Heaplet::forward (myTally));
		myDoublingFrontIndex.forwardTo (Heaplet::forward (myDoublingFrontIndex));
		myDoublingPasses.forwardTo (Heaplet::forward (myDoublingPasses));
		myCs.forwardTo (Heaplet::forward (myCs));
	}
}

