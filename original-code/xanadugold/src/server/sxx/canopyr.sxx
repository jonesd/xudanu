/* ====== Shepherd Stub Class "PropChangerStub" ======= */


#ifndef DISKMANX_HXX
#include "diskmanx.hxx" 
#define DISKMANX_HXX
#endif /* DISKMANX_HXX */

extern Category * cat_PropChangerStub;

CLASS(PropChangerStub,PropChanger) {
	CONCRETE(PropChangerStub)
	MANUAL_GC(PropChangerStub)
	NOT_A_TYPE(PropChangerStub)
  public:
	inline PropChangerStub(ShepFlag, UInt32 aHash, APTR(FlockInfo) info) 
          :  PropChanger(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

    RSP2_CanopyCrum fetchCrum() {
    ((this)->getReal());
    return this->fetchCrum();
    }

    void setCrum(WSP2_CanopyCrum arg1) {
    ((this)->getReal());
    this->setCrum(arg1);
    }

    BooleanVar step() {
    return (this)->getReal()->step();
    }

    void dismantle() {
    (this)->getReal()->dismantle();
    }

    void forgetYourself() {
    (this)->getReal()->forgetYourself();
    }

    void rememberYourself() {
    (this)->getReal()->rememberYourself();
    }

    void schedule() {
    (this)->getReal()->schedule();
    }

    void unschedule() {
    (this)->getReal()->unschedule();
    }

    void newShepherd() {
    ((this)->getReal());
    this->newShepherd();
    }

    void diskUpdate() {
    ((this)->getReal());
    this->diskUpdate();
    }

    void destroy() {
    (this)->getReal()->destroy();
    }

    UInt32 contentsHash() {
    return (this)->getReal()->contentsHash();
    }

    BooleanVar isPurgeable() {
    return (this)->getReal()->isPurgeable();
    }

    BooleanVar isUnlocked() {
    return (this)->getReal()->isUnlocked();
    }

    void restartAbraham(WSP2_Rcvr arg1) {
    (this)->getReal()->restartAbraham(arg1);
    }

    UInt32 hashForEqual() {
    return (this)->getReal()->hashForEqual();
    }

    void printContentsOn(ostream& arg1) {
    (this)->getReal()->printContentsOn(arg1);
    }

    void changeClassToThatOf(WSP2_Heaper arg1) {
    (this)->getReal()->changeClassToThatOf(arg1);
    }

    void sendSelfTo(WSP2_Xmtr arg1) {
    (this)->getReal()->sendSelfTo(arg1);
    }


    private:
      PropChanger *	getReal();  // just * in case not a type

	// Stripped-down COPY(PropChangerStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * PropChanger::getShepherdStubCategory () CONST
{
        return cat_PropChangerStub;
}

void PropChanger::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) PropChangerStub (shepFlag, hash, info);
}

/* ===== PropChangerStub Implementations ==== */

void PropChangerStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

PropChanger * PropChangerStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar PropChangerStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_PropChangerStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_PropChanger)) {
		return ((PropChangerStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(PropChangerStub,PropChanger)

void PropChangerStub::deferredHack () { /* intentionally blank */ }

/* #ifdef WITH_RPC */
/* ====== Stub Recipe for PropChanger ====== */

#ifndef STUBRCPX_HXX
#include "stubrcpx.hxx"
#define STUBRCPX_HXX
#endif /* STUBRCPX_HXX */

RPTR(Heaper) parseStub_PropChanger (APTR(Rcvr) /*rcvr*/, UInt32 hash) {
	RETURN_CONSTRUCT(PropChangerStub, (shepFlag, hash, NULL));
}

extern Recipe * DiskCuisine;
ActualStubRecipe PropChangerStub_recipe(cat_PropChangerStub, &DiskCuisine, parseStub_PropChanger);

/* #endif */ /* WITH_RPC */

/* ====== Object Migrator for Scavenging of PropChanger ====== */

void PropChanger::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->AgendaItem::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((PropChanger*)origin)->myCrum,
				       (Heaper**)&myCrum);
	} else {
		myCrum.forwardTo (Heaplet::forward (myCrum));
	}
}

/*----------------------- END PropChanger -----------------------*/


