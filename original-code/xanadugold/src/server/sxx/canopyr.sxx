#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void PropChanger::sendSelfTo (APTR(Xmtr) xmtr)
{
    AgendaItem::sendSelfTo (xmtr);
    xmtr->sendHeaper(myCrum);
}

PropChanger::PropChanger (APTR(Rcvr) receiver, TCSJ)
  : AgendaItem (receiver, tcsj) {
    myCrum = CAST(CanopyCrum, receiver->receiveHeaper());
}


