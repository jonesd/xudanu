/* ====== Object Migrator for Scavenging of ExponentialHashMap ====== */

void ExponentialHashMap::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ExponentialHashMap*)origin)->rBottoms,
				       (Heaper**)&rBottoms);
		Heaplet::forwardToOld ((Heaper**)&((ExponentialHashMap*)origin)->rSizes,
				       (Heaper**)&rSizes);
		Heaplet::forwardToOld ((Heaper**)&((ExponentialHashMap*)origin)->dBottoms,
				       (Heaper**)&dBottoms);
	} else {
		rBottoms.forwardTo (Heaplet::forward (rBottoms));
		rSizes.forwardTo (Heaplet::forward (rSizes));
		dBottoms.forwardTo (Heaplet::forward (dBottoms));
	}
}

/*----------------------- END ExponentialHashMap -----------------------*/


