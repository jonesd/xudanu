/* ====== Object Migrator for Scavenging of GrandDataPage ====== */

void GrandDataPage::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((GrandDataPage*)origin)->entries,
				       (Heaper**)&entries);
		Heaplet::forwardToOld ((Heaper**)&((GrandDataPage*)origin)->overflow,
				       (Heaper**)&overflow);
		Heaplet::forwardToOld ((Heaper**)&((GrandDataPage*)origin)->myGroup,
				       (Heaper**)&myGroup);
	} else {
		entries.forwardTo (Heaplet::forward (entries));
		overflow.forwardTo (Heaplet::forward (overflow));
		myGroup.forwardTo (Heaplet::forward (myGroup));
	}
}

