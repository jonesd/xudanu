/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void GrandDataPage::sendSelfTo (APTR(Xmtr) xmtr)
{
    Abraham::sendSelfTo (xmtr);
    xmtr->sendUInt32(myLowHashBits);
    xmtr->sendInt32(numEntries);
    xmtr->sendHeaper(entries);
    xmtr->sendHeaper(overflow);
    xmtr->sendHeaper(myGroup);
}

GrandDataPage::GrandDataPage (APTR(Rcvr) receiver, TCSJ)
  : Abraham (receiver, tcsj) {
    myLowHashBits = receiver->receiveUInt32();
    numEntries = receiver->receiveInt32();
    entries = CAST(PtrArray, receiver->receiveHeaper());
    overflow = CAST(GrandOverflow, receiver->receiveHeaper());
    myGroup = CAST(GrandNode, receiver->receiveHeaper());
}


void parseInto_GrandDataPage (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) GrandDataPage (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe GrandDataPage_recipe(cat_GrandDataPage, &DiskCuisine, parseInto_GrandDataPage);


/* #endif */ /* WITH_RPC */


