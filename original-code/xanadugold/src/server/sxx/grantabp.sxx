DEFINE_MAY_BECOME(GrandOverflow,GrandOverflowStub)
DEFINE_MAY_BECOME(GrandOverflowStub,GrandOverflow)

/* ====== Object Migrator for Scavenging of GrandOverflow ====== */

void GrandOverflow::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((GrandOverflow*)origin)->entries,
				       (Heaper**)&entries);
		Heaplet::forwardToOld ((Heaper**)&((GrandOverflow*)origin)->children,
				       (Heaper**)&children);
	} else {
		entries.forwardTo (Heaplet::forward (entries));
		children.forwardTo (Heaplet::forward (children));
	}
}

