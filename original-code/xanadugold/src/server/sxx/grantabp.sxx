Category * GrandDataPage::getShepherdStubCategory () CONST
{
        return cat_GrandDataPageStub;
}

void GrandDataPage::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) GrandDataPageStub (shepFlag, hash, info);
}

/* ===== GrandDataPageStub Implementations ==== */

void GrandDataPageStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

GrandDataPage * GrandDataPageStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar GrandDataPageStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_GrandDataPageStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_GrandDataPage)) {
		return ((GrandDataPageStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

