void GrandNode::sendSelfTo (APTR(Xmtr) xmtr)
{
    Abraham::sendSelfTo (xmtr);
    xmtr->sendHeaper(primaryPages);
    xmtr->sendInt32(numPrimaries);
    xmtr->sendHeaper(overflowRoot);
    xmtr->sendHeaper(oldOverflowRoot);
    xmtr->sendInt32(numReinserters);
}

GrandNode::GrandNode (APTR(Rcvr) receiver, TCSJ)
  : Abraham (receiver, tcsj) {
    primaryPages = CAST(PtrArray, receiver->receiveHeaper());
    numPrimaries = receiver->receiveInt32();
    overflowRoot = CAST(GrandOverflow, receiver->receiveHeaper());
    oldOverflowRoot = CAST(GrandOverflow, receiver->receiveHeaper());
    numReinserters = receiver->receiveInt32();
}


void parseInto_GrandNode (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) GrandNode (rcvr, tcsj);
}

