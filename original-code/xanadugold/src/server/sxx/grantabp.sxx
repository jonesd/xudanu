		Heaplet::forwardToOld ((Heaper**)&((GrandNodeStepper*)origin)->pageStepper,
				       (Heaper**)&pageStepper);
		Heaplet::forwardToOld ((Heaper**)&((GrandNodeStepper*)origin)->overflowStepper,
				       (Heaper**)&overflowStepper);
	} else {
		node.forwardTo (Heaplet::forward (node));
		pageStepper.forwardTo (Heaplet::forward (pageStepper));
		overflowStepper.forwardTo (Heaplet::forward (overflowStepper));
	}
}

/*----------------------- END GrandNodeStepper -----------------------*/


