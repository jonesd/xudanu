/* ====== Object Migrator for Scavenging of GrandOverflowStepper ====== */

void GrandOverflowStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((GrandOverflowStepper*)origin)->overflow,
				       (Heaper**)&overflow);
		Heaplet::forwardToOld ((Heaper**)&((GrandOverflowStepper*)origin)->childStepper,
				       (Heaper**)&childStepper);
	} else {
		overflow.forwardTo (Heaplet::forward (overflow));
		childStepper.forwardTo (Heaplet::forward (childStepper));
	}
}

