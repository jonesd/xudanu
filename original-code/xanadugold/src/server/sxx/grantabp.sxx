				       (Heaper**)&nodeStepper);
	} else {
		table.forwardTo (Heaplet::forward (table));
		nodeStepper.forwardTo (Heaplet::forward (nodeStepper));
	}
}

/*----------------------- END GrandHashTableStepper -----------------------*/


