extern Category * cat_GrandOverflowStub;

CLASS(GrandOverflowStub,GrandOverflow) {
	CONCRETE(GrandOverflowStub)
	MANUAL_GC(GrandOverflowStub)
	NOT_A_TYPE(GrandOverflowStub)
  public:
	inline GrandOverflowStub(ShepFlag, UInt32 aHash, APTR(FlockInfo) info) 
          :  GrandOverflow(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

    RSP2_Heaper fetch(WSP2_Heaper arg1, UInt32 arg2) {
    return (this)->getReal()->fetch(arg1, arg2);
    }

    RSP2_GrandOverflow store(WSP2_GrandEntry arg1) {
    return (this)->getReal()->store(arg1);
    }

    void wipe(WSP2_Heaper arg1, UInt32 arg2) {
    (this)->getReal()->wipe(arg1, arg2);
    }

    void repack() {
    ((this)->getReal());
    this->repack();
    }

    void reinsertEntries(WSP2_GrandNode arg1) {
    (this)->getReal()->reinsertEntries(arg1);
    }

    IntegerVar reinsertEntriesConsistency() {
    return (this)->getReal()->reinsertEntriesConsistency();
    }

    void dismantle() {
    ((this)->getReal());
    this->dismantle();
    }

    RSP2_GrandOverflow childAt(IntegerVar arg1) {
    ((this)->getReal());
    return this->childAt(arg1);
    }

    IntegerVar childCount() {
    ((this)->getReal());
    return this->childCount();
    }

    RSP2_GrandEntry entryAt(IntegerVar arg1) {
    ((this)->getReal());
    return this->entryAt(arg1);
    }

    IntegerVar entryCount() {
    ((this)->getReal());
    return this->entryCount();
    }

    UInt32 contentsHash() {
    return (this)->getReal()->contentsHash();
    }

    void diskUpdate() {
    ((this)->getReal());
    this->diskUpdate();
    }

    void destroy() {
    (this)->getReal()->destroy();
    }

    BooleanVar isPurgeable() {
    return (this)->getReal()->isPurgeable();
    }

    BooleanVar isUnlocked() {
    return (this)->getReal()->isUnlocked();
    }

    void restartAbraham(WSP2_Rcvr arg1) {
    (this)->getReal()->restartAbraham(arg1);
    }

    UInt32 hashForEqual() {
    return (this)->getReal()->hashForEqual();
    }

    void printContentsOn(ostream& arg1) {
    (this)->getReal()->printContentsOn(arg1);
    }

    void changeClassToThatOf(WSP2_Heaper arg1) {
    (this)->getReal()->changeClassToThatOf(arg1);
    }

    void sendSelfTo(WSP2_Xmtr arg1) {
    (this)->getReal()->sendSelfTo(arg1);
    }


    private:
      GrandOverflow *	getReal();  // just * in case not a type

	// Stripped-down COPY(GrandOverflowStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * GrandOverflow::getShepherdStubCategory () CONST
{
        return cat_GrandOverflowStub;
}

void GrandOverflow::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) GrandOverflowStub (shepFlag, hash, info);
}

/* ===== GrandOverflowStub Implementations ==== */

void GrandOverflowStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

GrandOverflow * GrandOverflowStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar GrandOverflowStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_GrandOverflowStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_GrandOverflow)) {
		return ((GrandOverflowStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(GrandOverflowStub,GrandOverflow)

void GrandOverflowStub::deferredHack () { /* intentionally blank */ }

