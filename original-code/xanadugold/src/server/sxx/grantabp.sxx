#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void GrandOverflow::sendSelfTo (APTR(Xmtr) xmtr)
{
    Abraham::sendSelfTo (xmtr);
    xmtr->sendInt32(numEntries);
    xmtr->sendHeaper(entries);
    xmtr->sendHeaper(children);
    xmtr->sendInt32(depth);
}

GrandOverflow::GrandOverflow (APTR(Rcvr) receiver, TCSJ)
  : Abraham (receiver, tcsj) {
    numEntries = receiver->receiveInt32();
    entries = CAST(PtrArray, receiver->receiveHeaper());
    children = CAST(PtrArray, receiver->receiveHeaper());
    depth = receiver->receiveInt32();
}


void parseInto_GrandOverflow (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) GrandOverflow (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe GrandOverflow_recipe(cat_GrandOverflow, &DiskCuisine, parseInto_GrandOverflow);


