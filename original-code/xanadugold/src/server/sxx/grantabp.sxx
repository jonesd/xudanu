void GrandNode::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((GrandNode*)origin)->primaryPages,
				       (Heaper**)&primaryPages);
		Heaplet::forwardToOld ((Heaper**)&((GrandNode*)origin)->overflowRoot,
				       (Heaper**)&overflowRoot);
		Heaplet::forwardToOld ((Heaper**)&((GrandNode*)origin)->oldOverflowRoot,
				       (Heaper**)&oldOverflowRoot);
	} else {
		primaryPages.forwardTo (Heaplet::forward (primaryPages));
		overflowRoot.forwardTo (Heaplet::forward (overflowRoot));
		oldOverflowRoot.forwardTo (Heaplet::forward (oldOverflowRoot));
	}
}

