#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void HistoryCrum::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendUInt32(myHash);
}

HistoryCrum::HistoryCrum (APTR(Rcvr) receiver, TCSJ)
{
    myHash = receiver->receiveUInt32();
}


