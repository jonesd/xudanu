/* ====== Copy Class "HUpperCrum" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of HUpperCrum ====== */

void HUpperCrum::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((HUpperCrum*)origin)->hcut,
				       (Heaper**)&hcut);
		Heaplet::forwardToOld ((Heaper**)&((HUpperCrum*)origin)->hcrums,
				       (Heaper**)&hcrums);
		Heaplet::forwardToOld ((Heaper**)&((HUpperCrum*)origin)->myBertCrum,
				       (Heaper**)&myBertCrum);
	} else {
		hcut.forwardTo (Heaplet::forward (hcut));
		hcrums.forwardTo (Heaplet::forward (hcrums));
		myBertCrum.forwardTo (Heaplet::forward (myBertCrum));
	}
}

/*----------------------- END HUpperCrum -----------------------*/

