/*----------------------- BEGIN HUpperCrum -----------------------*/
DEFINE_CLASS_CATEGORY(HUpperCrum,HistoryCrum)
DEFINE_OPAQUE_TYPE(HUpperCrum);

void HUpperCrum::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "HUpperCrum" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void HUpperCrum::sendSelfTo (APTR(Xmtr) xmtr)
{
    HistoryCrum::sendSelfTo (xmtr);
    xmtr->sendHeaper(hcut);
    xmtr->sendHeaper(hcrums);
    xmtr->sendHeaper(myBertCrum);
}

HUpperCrum::HUpperCrum (APTR(Rcvr) receiver, TCSJ)
  : HistoryCrum (receiver, tcsj) {
    hcut = CAST(TracePosition, receiver->receiveHeaper());
    hcrums = CAST(MuSet, receiver->receiveHeaper());
    myBertCrum = CAST(BertCrum, receiver->receiveHeaper());
}


void parseInto_HUpperCrum (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) HUpperCrum (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe HUpperCrum_recipe(cat_HUpperCrum, &DiskCuisine, parseInto_HUpperCrum);


/* #endif */ /* WITH_RPC */


