/* ===== BeDataHolderStub Implementations ==== */

void BeDataHolderStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

BeDataHolder * BeDataHolderStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar BeDataHolderStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_BeDataHolderStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_BeDataHolder)) {
		return ((BeDataHolderStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

