/* ====== Object Migrator for Scavenging of BePlaceHolder ====== */

void BePlaceHolder::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->BeRangeElement::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BePlaceHolder*)origin)->myTrailBlazer,
				       (Heaper**)&myTrailBlazer);
		Heaplet::forwardToOld ((Heaper**)&((BePlaceHolder*)origin)->myDetectors,
				       (Heaper**)&myDetectors);
	} else {
		myTrailBlazer.forwardTo (Heaplet::forward (myTrailBlazer));
		myDetectors.forwardTo (Heaplet::forward (myDetectors));
	}
}

/*----------------------- END BePlaceHolder -----------------------*/

