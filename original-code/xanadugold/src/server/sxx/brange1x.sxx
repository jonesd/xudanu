/* ====== Copy Class "BePlaceHolder" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void BePlaceHolder::sendSelfTo (APTR(Xmtr) xmtr)
{
    BeRangeElement::sendSelfTo (xmtr);
    xmtr->sendHeaper(myTrailBlazer);
}

BePlaceHolder::BePlaceHolder (APTR(Rcvr) receiver, TCSJ)
  : BeRangeElement (receiver, tcsj) {
    myTrailBlazer = CAST(TrailBlazer, receiver->receiveHeaper());
    this->restartP(receiver);
}


void parseInto_BePlaceHolder (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) BePlaceHolder (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe BePlaceHolder_recipe(cat_BePlaceHolder, &DiskCuisine, parseInto_BePlaceHolder);


/* #endif */ /* WITH_RPC */


