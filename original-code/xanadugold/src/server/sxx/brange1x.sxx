Category * BeLabel::getShepherdStubCategory () CONST
{
        return cat_BeLabelStub;
}

void BeLabel::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) BeLabelStub (shepFlag, hash, info);
}

/* ===== BeLabelStub Implementations ==== */

void BeLabelStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

BeLabel * BeLabelStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar BeLabelStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_BeLabelStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_BeLabel)) {
		return ((BeLabelStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(BeLabelStub,BeLabel)

void BeLabelStub::deferredHack () { /* intentionally blank */ }

