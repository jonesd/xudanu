/* ====== Object Migrator for Scavenging of BeCarrier ====== */

void BeCarrier::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BeCarrier*)origin)->myLabel,
				       (Heaper**)&myLabel);
		Heaplet::forwardToOld ((Heaper**)&((BeCarrier*)origin)->myRangeElement,
				       (Heaper**)&myRangeElement);
	} else {
		myLabel.forwardTo (Heaplet::forward (myLabel));
		myRangeElement.forwardTo (Heaplet::forward (myRangeElement));
	}
}

/*----------------------- END BeCarrier -----------------------*/


/*----------------------- BEGIN BeRangeElement -----------------------*/
DEFINE_CLASS_CATEGORY(BeRangeElement,Abraham)
DEFINE_OPAQUE_TYPE(BeRangeElement);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "BeRangeElement" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void BeRangeElement::sendSelfTo (APTR(Xmtr) xmtr)
{
    Abraham::sendSelfTo (xmtr);
    xmtr->sendHeaper(myHCrum);
    xmtr->sendHeaper(mySensorCrum);
    xmtr->sendHeaper(myOwner);
}

BeRangeElement::BeRangeElement (APTR(Rcvr) receiver, TCSJ)
  : Abraham (receiver, tcsj) {
    myHCrum = CAST(HUpperCrum, receiver->receiveHeaper());
    mySensorCrum = CAST(SensorCrum, receiver->receiveHeaper());
    myOwner = CAST(ID, receiver->receiveHeaper());
    this->restartRE(receiver);
}


/* #endif */ /* WITH_RPC */


#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Shepherd Ancestor Class "BeRangeElement" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of BeRangeElement ====== */

void BeRangeElement::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BeRangeElement*)origin)->myHCrum,
				       (Heaper**)&myHCrum);
		Heaplet::forwardToOld ((Heaper**)&((BeRangeElement*)origin)->mySensorCrum,
				       (Heaper**)&mySensorCrum);
		Heaplet::forwardToOld ((Heaper**)&((BeRangeElement*)origin)->myOwner,
				       (Heaper**)&myOwner);
		Heaplet::forwardToOld ((Heaper**)&((BeRangeElement*)origin)->myFeRangeElements,
				       (Heaper**)&myFeRangeElements);
	} else {
		myHCrum.forwardTo (Heaplet::forward (myHCrum));
		mySensorCrum.forwardTo (Heaplet::forward (mySensorCrum));
		myOwner.forwardTo (Heaplet::forward (myOwner));
		myFeRangeElements.forwardTo (Heaplet::forward (myFeRangeElements));
	}
}

/*----------------------- END BeRangeElement -----------------------*/


