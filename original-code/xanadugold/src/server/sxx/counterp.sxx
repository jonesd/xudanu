#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void SingleCounter::sendSelfTo (APTR(Xmtr) xmtr)
{
    Counter::sendSelfTo (xmtr);
    xmtr->sendIntegerVar(myCount);
}

SingleCounter::SingleCounter (APTR(Rcvr) receiver, TCSJ)
  : Counter (receiver, tcsj) {
    myCount = receiver->receiveIntegerVar();
    this->restartSingleCounter(receiver);
}


void parseInto_SingleCounter (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) SingleCounter (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe SingleCounter_recipe(cat_SingleCounter, &DiskCuisine, parseInto_SingleCounter);


/* #endif */ /* WITH_RPC */


