/* ====== Object Migrator for Scavenging of SingleCounter ====== */

void SingleCounter::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Counter::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SingleCounter*)origin)->myMutex,
				       (Heaper**)&myMutex);
	} else {
		myMutex.forwardTo (Heaplet::forward (myMutex));
	}
}

