#define COUNTERP_SXX

/*----------------------- BEGIN BatchCounter -----------------------*/
DEFINE_CLASS_CATEGORY(BatchCounter,Counter)

void BatchCounter::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "BatchCounter" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void BatchCounter::sendSelfTo (APTR(Xmtr) xmtr)
{
    Counter::sendSelfTo (xmtr);
    xmtr->sendIntegerVar(myPersistentCount);
    xmtr->sendIntegerVar(myBatchCount);
}

BatchCounter::BatchCounter (APTR(Rcvr) receiver, TCSJ)
  : Counter (receiver, tcsj) {
    myPersistentCount = receiver->receiveIntegerVar();
    myBatchCount = receiver->receiveIntegerVar();
    this->restartBatchCounter(receiver);
}


void parseInto_BatchCounter (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) BatchCounter (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe BatchCounter_recipe(cat_BatchCounter, &DiskCuisine, parseInto_BatchCounter);


/* #endif */ /* WITH_RPC */


#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "BatchCounter" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ===== mayBecome support between stub and concrete Shepherd ===== */

extern Category * cat_CounterStub;
DEFINE_MAY_BECOME(BatchCounter,CounterStub)
DEFINE_MAY_BECOME(CounterStub,BatchCounter)

/* ====== Object Migrator for Scavenging of BatchCounter ====== */

void BatchCounter::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Counter::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BatchCounter*)origin)->myMutex,
				       (Heaper**)&myMutex);
	} else {
		myMutex.forwardTo (Heaplet::forward (myMutex));
	}
}

/*----------------------- END BatchCounter -----------------------*/


/*----------------------- BEGIN SingleCounter -----------------------*/
DEFINE_CLASS_CATEGORY(SingleCounter,Counter)

void SingleCounter::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "SingleCounter" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
