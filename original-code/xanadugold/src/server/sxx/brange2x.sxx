void BeWork::sendSelfTo (APTR(Xmtr) xmtr)
{
    BeRangeElement::sendSelfTo (xmtr);
    xmtr->sendHeaper(myEdition);
    xmtr->sendHeaper(myEditionLabel);
    xmtr->sendHeaper(myReadClub);
    xmtr->sendHeaper(myEditClub);
    xmtr->sendHeaper(myOwnProp);
    xmtr->sendHeaper(myHistory);
    xmtr->sendHeaper(myHistoryClub);
    xmtr->sendIntegerVar(myRevisionCount);
    xmtr->sendIntegerVar(myRevisionTime);
    xmtr->sendHeaper(myReviser);
    xmtr->sendHeaper(mySponsors);
}

BeWork::BeWork (APTR(Rcvr) receiver, TCSJ)
  : BeRangeElement (receiver, tcsj) {
    myEdition = CAST(BeEdition, receiver->receiveHeaper());
    myEditionLabel = CAST(BeLabel, receiver->receiveHeaper());
    myReadClub = CAST(ID, receiver->receiveHeaper());
    myEditClub = CAST(ID, receiver->receiveHeaper());
    myOwnProp = CAST(BertProp, receiver->receiveHeaper());
    myHistory = CAST(BeEdition, receiver->receiveHeaper());
    myHistoryClub = CAST(ID, receiver->receiveHeaper());
    myRevisionCount = receiver->receiveIntegerVar();
    myRevisionTime = receiver->receiveIntegerVar();
    myReviser = CAST(ID, receiver->receiveHeaper());
    mySponsors = CAST(IDRegion, receiver->receiveHeaper());
    this->restartWork(receiver);
}


void parseInto_BeWork (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) BeWork (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe BeWork_recipe(cat_BeWork, &DiskCuisine, parseInto_BeWork);


/* #endif */ /* WITH_RPC */


