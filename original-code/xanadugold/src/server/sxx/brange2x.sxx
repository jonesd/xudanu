/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void BeClub::sendSelfTo (APTR(Xmtr) xmtr)
{
    BeWork::sendSelfTo (xmtr);
    xmtr->sendHeaper(mySignatureClub);
    xmtr->sendHeaper(myMembers);
    xmtr->sendHeaper(myImmediateSuperClubs);
    xmtr->sendHeaper(mySponsored);
    xmtr->sendBooleanVar(myWallFlag);
    xmtr->sendHeaper(myTransitiveSuperClubIDs);
    xmtr->sendHeaper(myTransitiveMemberIDs);
}

BeClub::BeClub (APTR(Rcvr) receiver, TCSJ)
  : BeWork (receiver, tcsj) {
    mySignatureClub = CAST(ID, receiver->receiveHeaper());
    myMembers = CAST(MuSet, receiver->receiveHeaper());
    myImmediateSuperClubs = CAST(MuSet, receiver->receiveHeaper());
    mySponsored = CAST(MuSet, receiver->receiveHeaper());
    myWallFlag = receiver->receiveBooleanVar();
    myTransitiveSuperClubIDs = CAST(IDRegion, receiver->receiveHeaper());
    myTransitiveMemberIDs = CAST(IDRegion, receiver->receiveHeaper());
    this->restartClub(receiver);
}


void parseInto_BeClub (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) BeClub (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe BeClub_recipe(cat_BeClub, &DiskCuisine, parseInto_BeClub);


