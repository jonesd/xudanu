/* ===== mayBecome support between stub and concrete Shepherd Prototype ===== */

DEFINE_MAY_BECOME(BeWork,BeWorkStub)
DEFINE_MAY_BECOME(BeWorkStub,BeWork)

/* ====== Object Migrator for Scavenging of BeWork ====== */

void BeWork::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->BeRangeElement::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BeWork*)origin)->myEdition,
				       (Heaper**)&myEdition);
		Heaplet::forwardToOld ((Heaper**)&((BeWork*)origin)->myEditionLabel,
				       (Heaper**)&myEditionLabel);
		Heaplet::forwardToOld ((Heaper**)&((BeWork*)origin)->myReadClub,
				       (Heaper**)&myReadClub);
		Heaplet::forwardToOld ((Heaper**)&((BeWork*)origin)->myEditClub,
				       (Heaper**)&myEditClub);
		Heaplet::forwardToOld ((Heaper**)&((BeWork*)origin)->myOwnProp,
				       (Heaper**)&myOwnProp);
		Heaplet::forwardToOld ((Heaper**)&((BeWork*)origin)->myHistory,
				       (Heaper**)&myHistory);
		Heaplet::forwardToOld ((Heaper**)&((BeWork*)origin)->myHistoryClub,
				       (Heaper**)&myHistoryClub);
		Heaplet::forwardToOld ((Heaper**)&((BeWork*)origin)->myReviser,
				       (Heaper**)&myReviser);
		Heaplet::forwardToOld ((Heaper**)&((BeWork*)origin)->mySponsors,
				       (Heaper**)&mySponsors);
		Heaplet::forwardToOld ((Heaper**)&((BeWork*)origin)->myLockingWork,
				       (Heaper**)&myLockingWork);
		Heaplet::forwardToOld ((Heaper**)&((BeWork*)origin)->myRevisionWatchers,
				       (Heaper**)&myRevisionWatchers);
	} else {
		myEdition.forwardTo (Heaplet::forward (myEdition));
		myEditionLabel.forwardTo (Heaplet::forward (myEditionLabel));
		myReadClub.forwardTo (Heaplet::forward (myReadClub));
		myEditClub.forwardTo (Heaplet::forward (myEditClub));
		myOwnProp.forwardTo (Heaplet::forward (myOwnProp));
		myHistory.forwardTo (Heaplet::forward (myHistory));
		myHistoryClub.forwardTo (Heaplet::forward (myHistoryClub));
		myReviser.forwardTo (Heaplet::forward (myReviser));
		mySponsors.forwardTo (Heaplet::forward (mySponsors));
		myLockingWork.forwardTo (Heaplet::forward (myLockingWork));
		myRevisionWatchers.forwardTo (Heaplet::forward (myRevisionWatchers));
	}
}

