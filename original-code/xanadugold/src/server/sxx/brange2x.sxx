      BeClub *	getReal();  // just * in case not a type

	// Stripped-down COPY(BeClubStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * BeClub::getShepherdStubCategory () CONST
{
        return cat_BeClubStub;
}

void BeClub::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) BeClubStub (shepFlag, hash, info);
}

/* ===== BeClubStub Implementations ==== */

void BeClubStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

BeClub * BeClubStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar BeClubStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_BeClubStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_BeClub)) {
		return ((BeClubStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(BeClubStub,BeClub)

void BeClubStub::deferredHack () { /* intentionally blank */ }

