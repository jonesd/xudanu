/* ===== mayBecome support between stub and concrete Shepherd Prototype ===== */

DEFINE_MAY_BECOME(BeClub,BeClubStub)
DEFINE_MAY_BECOME(BeClubStub,BeClub)

/* ====== Object Migrator for Scavenging of BeClub ====== */

void BeClub::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->BeWork::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BeClub*)origin)->mySignatureClub,
				       (Heaper**)&mySignatureClub);
		Heaplet::forwardToOld ((Heaper**)&((BeClub*)origin)->myMembers,
				       (Heaper**)&myMembers);
		Heaplet::forwardToOld ((Heaper**)&((BeClub*)origin)->myImmediateSuperClubs,
				       (Heaper**)&myImmediateSuperClubs);
		Heaplet::forwardToOld ((Heaper**)&((BeClub*)origin)->mySponsored,
				       (Heaper**)&mySponsored);
		Heaplet::forwardToOld ((Heaper**)&((BeClub*)origin)->myTransitiveSuperClubIDs,
				       (Heaper**)&myTransitiveSuperClubIDs);
		Heaplet::forwardToOld ((Heaper**)&((BeClub*)origin)->myTransitiveMemberIDs,
				       (Heaper**)&myTransitiveMemberIDs);
		Heaplet::forwardToOld ((Heaper**)&((BeClub*)origin)->myKeyMasters,
				       (Heaper**)&myKeyMasters);
	} else {
		mySignatureClub.forwardTo (Heaplet::forward (mySignatureClub));
		myMembers.forwardTo (Heaplet::forward (myMembers));
		myImmediateSuperClubs.forwardTo (Heaplet::forward (myImmediateSuperClubs));
		mySponsored.forwardTo (Heaplet::forward (mySponsored));
		myTransitiveSuperClubIDs.forwardTo (Heaplet::forward (myTransitiveSuperClubIDs));
		myTransitiveMemberIDs.forwardTo (Heaplet::forward (myTransitiveMemberIDs));
		myKeyMasters.forwardTo (Heaplet::forward (myKeyMasters));
	}
}

