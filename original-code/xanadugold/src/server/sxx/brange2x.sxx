Category * BeWork::getShepherdStubCategory () CONST
{
        return cat_BeWorkStub;
}

void BeWork::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) BeWorkStub (shepFlag, hash, info);
}

/* ===== BeWorkStub Implementations ==== */

void BeWorkStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

BeWork * BeWorkStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar BeWorkStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_BeWorkStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_BeWork)) {
		return ((BeWorkStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

