RPTR(Heaper) parseStub_BeClub (APTR(Rcvr) /*rcvr*/, UInt32 hash) {
	RETURN_CONSTRUCT(BeClubStub, (shepFlag, hash, NULL));
}

extern Recipe * DiskCuisine;
ActualStubRecipe BeClubStub_recipe(cat_BeClubStub, &DiskCuisine, parseStub_BeClub);

