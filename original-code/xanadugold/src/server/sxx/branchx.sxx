#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void DagBranch::sendSelfTo (APTR(Xmtr) xmtr)
{
    BranchDescription::sendSelfTo (xmtr);
    xmtr->sendHeaper(parent1);
    xmtr->sendHeaper(parent2);
}

DagBranch::DagBranch (APTR(Rcvr) receiver, TCSJ)
  : BranchDescription (receiver, tcsj) {
    parent1 = CAST(TracePosition, receiver->receiveHeaper());
    parent2 = CAST(TracePosition, receiver->receiveHeaper());
}


void parseInto_DagBranch (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) DagBranch (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe DagBranch_recipe(cat_DagBranch, &DiskCuisine, parseInto_DagBranch);


