/*----------------------- BEGIN BranchDescription -----------------------*/
DEFINE_CLASS_CATEGORY(BranchDescription,Abraham)
DEFINE_OPAQUE_TYPE(BranchDescription);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "BranchDescription" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void BranchDescription::sendSelfTo (APTR(Xmtr) xmtr)
{
    Abraham::sendSelfTo (xmtr);
    xmtr->sendUInt32(lastPosition);
    xmtr->sendHeaper(myLeft);
    xmtr->sendHeaper(myRight);
    xmtr->sendHeaper(fulltrace);
}

BranchDescription::BranchDescription (APTR(Rcvr) receiver, TCSJ)
  : Abraham (receiver, tcsj) {
    lastPosition = receiver->receiveUInt32();
    myLeft = CAST(BranchDescription, receiver->receiveHeaper());
    myRight = CAST(BranchDescription, receiver->receiveHeaper());
    fulltrace = CAST(DagWood, receiver->receiveHeaper());
}


/* #endif */ /* WITH_RPC */


