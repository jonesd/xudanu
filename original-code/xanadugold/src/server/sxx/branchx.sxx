void TreeBranch::sendSelfTo (APTR(Xmtr) xmtr)
{
    BranchDescription::sendSelfTo (xmtr);
    xmtr->sendHeaper(parent);
}

TreeBranch::TreeBranch (APTR(Rcvr) receiver, TCSJ)
  : BranchDescription (receiver, tcsj) {
    parent = CAST(TracePosition, receiver->receiveHeaper());
}


