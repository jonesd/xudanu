/* ===== mayBecome support between stub and concrete Shepherd ===== */

extern Category * cat_BranchDescriptionStub;
DEFINE_MAY_BECOME(DagBranch,BranchDescriptionStub)
DEFINE_MAY_BECOME(BranchDescriptionStub,DagBranch)

/* ====== Object Migrator for Scavenging of DagBranch ====== */

void DagBranch::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->BranchDescription::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((DagBranch*)origin)->parent1,
				       (Heaper**)&parent1);
		Heaplet::forwardToOld ((Heaper**)&((DagBranch*)origin)->parent2,
				       (Heaper**)&parent2);
	} else {
		parent1.forwardTo (Heaplet::forward (parent1));
		parent2.forwardTo (Heaplet::forward (parent2));
	}
}

/*----------------------- END DagBranch -----------------------*/


