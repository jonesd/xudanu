DEFINE_MAY_BECOME(BranchDescriptionStub,TreeBranch)

/* ====== Object Migrator for Scavenging of TreeBranch ====== */

void TreeBranch::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->BranchDescription::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((TreeBranch*)origin)->parent,
				       (Heaper**)&parent);
	} else {
		parent.forwardTo (Heaplet::forward (parent));
	}
}

