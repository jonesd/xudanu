/* ====== Shepherd Stub Class "BranchDescriptionStub" ======= */


#ifndef DISKMANX_HXX
#include "diskmanx.hxx" 
#define DISKMANX_HXX
#endif /* DISKMANX_HXX */

extern Category * cat_BranchDescriptionStub;

CLASS(BranchDescriptionStub,BranchDescription) {
	CONCRETE(BranchDescriptionStub)
	MANUAL_GC(BranchDescriptionStub)
	NOT_A_TYPE(BranchDescriptionStub)
  public:
	inline BranchDescriptionStub(ShepFlag, UInt32 aHash, APTR(FlockInfo) info) 
          :  BranchDescription(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

    UInt32 contentsHash() {
    return (this)->getReal()->contentsHash();
    }

    BooleanVar doesInclude(UInt32 arg1, WSP2_TracePosition arg2) {
    return (this)->getReal()->doesInclude(arg1, arg2);
    }

    void cacheRecur(WSP2_PrimIndexTable arg1) {
    (this)->getReal()->cacheRecur(arg1);
    }

    void addSuccessorsTo(WSP2_MuSet arg1) {
    (this)->getReal()->addSuccessorsTo(arg1);
    }

    RSP2_ImmuSet successorsOf(WSP2_BoundedTrace arg1) {
    return (this)->getReal()->successorsOf(arg1);
    }

    RSP2_TracePosition createAfter(WSP2_BoundedTrace arg1) {
    return (this)->getReal()->createAfter(arg1);
    }

    void installBranch(WSP2_BranchDescription arg1) {
    (this)->getReal()->installBranch(arg1);
    }

    void walkBranch() {
    (this)->getReal()->walkBranch();
    }

    void installBranchAfter(WSP2_BranchDescription arg1, WSP2_TracePosition arg2) {
    (this)->getReal()->installBranchAfter(arg1, arg2);
    }

    RSP2_BranchDescription makeBranch(WSP2_TracePosition arg1, WSP2_TracePosition arg2) {
    return (this)->getReal()->makeBranch(arg1, arg2);
    }

    RSP2_TracePosition nextPosition() {
    return (this)->getReal()->nextPosition();
    }

    void dismantle() {
    ((this)->getReal());
    this->dismantle();
    }

    void diskUpdate() {
    ((this)->getReal());
    this->diskUpdate();
    }

    void destroy() {
    (this)->getReal()->destroy();
    }

    BooleanVar isPurgeable() {
    return (this)->getReal()->isPurgeable();
    }

    BooleanVar isUnlocked() {
    return (this)->getReal()->isUnlocked();
    }

    void restartAbraham(WSP2_Rcvr arg1) {
    (this)->getReal()->restartAbraham(arg1);
    }

    UInt32 hashForEqual() {
    return (this)->getReal()->hashForEqual();
    }

    void printContentsOn(ostream& arg1) {
    (this)->getReal()->printContentsOn(arg1);
    }

    void changeClassToThatOf(WSP2_Heaper arg1) {
    (this)->getReal()->changeClassToThatOf(arg1);
    }

    void sendSelfTo(WSP2_Xmtr arg1) {
    (this)->getReal()->sendSelfTo(arg1);
    }


    private:
      BranchDescription *	getReal();  // just * in case not a type

	// Stripped-down COPY(BranchDescriptionStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * BranchDescription::getShepherdStubCategory () CONST
{
        return cat_BranchDescriptionStub;
}

void BranchDescription::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) BranchDescriptionStub (shepFlag, hash, info);
}

/* ===== BranchDescriptionStub Implementations ==== */

void BranchDescriptionStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

BranchDescription * BranchDescriptionStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar BranchDescriptionStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_BranchDescriptionStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_BranchDescription)) {
		return ((BranchDescriptionStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(BranchDescriptionStub,BranchDescription)

void BranchDescriptionStub::deferredHack () { /* intentionally blank */ }

/* #ifdef WITH_RPC */
/* ====== Stub Recipe for BranchDescription ====== */

#ifndef STUBRCPX_HXX
#include "stubrcpx.hxx"
#define STUBRCPX_HXX
#endif /* STUBRCPX_HXX */

RPTR(Heaper) parseStub_BranchDescription (APTR(Rcvr) /*rcvr*/, UInt32 hash) {
	RETURN_CONSTRUCT(BranchDescriptionStub, (shepFlag, hash, NULL));
}

extern Recipe * DiskCuisine;
ActualStubRecipe BranchDescriptionStub_recipe(cat_BranchDescriptionStub, &DiskCuisine, parseStub_BranchDescription);

/* #endif */ /* WITH_RPC */

/* ====== Object Migrator for Scavenging of BranchDescription ====== */

void BranchDescription::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BranchDescription*)origin)->myLeft,
				       (Heaper**)&myLeft);
		Heaplet::forwardToOld ((Heaper**)&((BranchDescription*)origin)->myRight,
				       (Heaper**)&myRight);
		Heaplet::forwardToOld ((Heaper**)&((BranchDescription*)origin)->fulltrace,
				       (Heaper**)&fulltrace);
	} else {
		myLeft.forwardTo (Heaplet::forward (myLeft));
		myRight.forwardTo (Heaplet::forward (myRight));
		fulltrace.forwardTo (Heaplet::forward (fulltrace));
	}
}

/*----------------------- END BranchDescription -----------------------*/


