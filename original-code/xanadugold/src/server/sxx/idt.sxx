/* ====== Object Migrator for Scavenging of IDTester ====== */

void IDTester::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->RegionTester::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((IDTester*)origin)->myConnection,
				       (Heaper**)&myConnection);
	} else {
		myConnection.forwardTo (Heaplet::forward (myConnection));
	}
}

