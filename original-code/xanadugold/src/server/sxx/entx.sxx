void Ent::sendSelfTo (APTR(Xmtr) xmtr)
{
    Abraham::sendSelfTo (xmtr);
    xmtr->sendHeaper(fulltrace);
}

Ent::Ent (APTR(Rcvr) receiver, TCSJ)
  : Abraham (receiver, tcsj) {
    fulltrace = CAST(DagWood, receiver->receiveHeaper());
}


void parseInto_Ent (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) Ent (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe Ent_recipe(cat_Ent, &DiskCuisine, parseInto_Ent);


