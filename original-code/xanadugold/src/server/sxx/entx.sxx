/* ====== Shepherd Stub Class "EntStub" ======= */


#ifndef DISKMANX_HXX
#include "diskmanx.hxx" 
#define DISKMANX_HXX
#endif /* DISKMANX_HXX */

extern Category * cat_EntStub;

CLASS(EntStub,Ent) {
	CONCRETE(EntStub)
	MANUAL_GC(EntStub)
	NOT_A_TYPE(EntStub)
  public:
	inline EntStub(ShepFlag, UInt32 aHash, APTR(FlockInfo) info) 
          :  Ent(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

    RSP2_TracePosition newTrace() {
    return (this)->getReal()->newTrace();
    }

    UInt32 contentsHash() {
    return (this)->getReal()->contentsHash();
    }

    void dismantle() {
    ((this)->getReal());
    this->dismantle();
    }

    void diskUpdate() {
    ((this)->getReal());
    this->diskUpdate();
    }

    void destroy() {
    (this)->getReal()->destroy();
    }

    BooleanVar isPurgeable() {
    return (this)->getReal()->isPurgeable();
    }

    BooleanVar isUnlocked() {
    return (this)->getReal()->isUnlocked();
    }

    void restartAbraham(WSP2_Rcvr arg1) {
    (this)->getReal()->restartAbraham(arg1);
    }

    UInt32 hashForEqual() {
    return (this)->getReal()->hashForEqual();
    }

    void printContentsOn(ostream& arg1) {
    (this)->getReal()->printContentsOn(arg1);
    }

    void changeClassToThatOf(WSP2_Heaper arg1) {
    (this)->getReal()->changeClassToThatOf(arg1);
    }

    void sendSelfTo(WSP2_Xmtr arg1) {
    (this)->getReal()->sendSelfTo(arg1);
    }


    private:
      Ent *	getReal();  // just * in case not a type

	// Stripped-down COPY(EntStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * Ent::getShepherdStubCategory () CONST
{
        return cat_EntStub;
}

void Ent::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) EntStub (shepFlag, hash, info);
}

/* ===== EntStub Implementations ==== */

void EntStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

Ent * EntStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar EntStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_EntStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_Ent)) {
		return ((EntStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(EntStub,Ent)

void EntStub::deferredHack () { /* intentionally blank */ }

/* #ifdef WITH_RPC */
/* ====== Stub Recipe for Ent ====== */

#ifndef STUBRCPX_HXX
#include "stubrcpx.hxx"
#define STUBRCPX_HXX
#endif /* STUBRCPX_HXX */

RPTR(Heaper) parseStub_Ent (APTR(Rcvr) /*rcvr*/, UInt32 hash) {
	RETURN_CONSTRUCT(EntStub, (shepFlag, hash, NULL));
}

extern Recipe * DiskCuisine;
ActualStubRecipe EntStub_recipe(cat_EntStub, &DiskCuisine, parseStub_Ent);

/* #endif */ /* WITH_RPC */

/* ===== mayBecome support between stub and concrete Shepherd Prototype ===== */

DEFINE_MAY_BECOME(Ent,EntStub)
DEFINE_MAY_BECOME(EntStub,Ent)

/* ====== Object Migrator for Scavenging of Ent ====== */

void Ent::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Ent*)origin)->fulltrace,
				       (Heaper**)&fulltrace);
	} else {
		fulltrace.forwardTo (Heaplet::forward (fulltrace));
	}
}

/*----------------------- END Ent -----------------------*/

