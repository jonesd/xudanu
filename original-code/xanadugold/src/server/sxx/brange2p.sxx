extern Category * cat_UpdateTransitiveMemberIDsStub;

CLASS(UpdateTransitiveMemberIDsStub,UpdateTransitiveMemberIDs) {
	CONCRETE(UpdateTransitiveMemberIDsStub)
	MANUAL_GC(UpdateTransitiveMemberIDsStub)
	NOT_A_TYPE(UpdateTransitiveMemberIDsStub)
  public:
	inline UpdateTransitiveMemberIDsStub(ShepFlag, UInt32 aHash, APTR(FlockInfo) info) 
          :  UpdateTransitiveMemberIDs(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

    BooleanVar step() {
    return (this)->getReal()->step();
    }

    void forgetYourself() {
    (this)->getReal()->forgetYourself();
    }

    void rememberYourself() {
    (this)->getReal()->rememberYourself();
    }

    void schedule() {
    (this)->getReal()->schedule();
    }

    void unschedule() {
    (this)->getReal()->unschedule();
    }

    void dismantle() {
    ((this)->getReal());
    this->dismantle();
    }

    void newShepherd() {
    ((this)->getReal());
    this->newShepherd();
    }

    void diskUpdate() {
    ((this)->getReal());
    this->diskUpdate();
    }

    void destroy() {
    (this)->getReal()->destroy();
    }

    UInt32 contentsHash() {
    return (this)->getReal()->contentsHash();
    }

    BooleanVar isPurgeable() {
    return (this)->getReal()->isPurgeable();
    }

    BooleanVar isUnlocked() {
    return (this)->getReal()->isUnlocked();
    }

    void restartAbraham(WSP2_Rcvr arg1) {
    (this)->getReal()->restartAbraham(arg1);
    }

    UInt32 hashForEqual() {
    return (this)->getReal()->hashForEqual();
    }

    void printContentsOn(ostream& arg1) {
    (this)->getReal()->printContentsOn(arg1);
    }

    void changeClassToThatOf(WSP2_Heaper arg1) {
    (this)->getReal()->changeClassToThatOf(arg1);
    }

    void sendSelfTo(WSP2_Xmtr arg1) {
    (this)->getReal()->sendSelfTo(arg1);
    }


    private:
      UpdateTransitiveMemberIDs *	getReal();  // just * in case not a type

	// Stripped-down COPY(UpdateTransitiveMemberIDsStub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(void * origin, BooleanVar destinationIsOld) {
		this->Abraham::migrate(origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * UpdateTransitiveMemberIDs::getShepherdStubCategory () CONST
{
        return cat_UpdateTransitiveMemberIDsStub;
}

void UpdateTransitiveMemberIDs::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) UpdateTransitiveMemberIDsStub (shepFlag, hash, info);
}

/* ===== UpdateTransitiveMemberIDsStub Implementations ==== */

void UpdateTransitiveMemberIDsStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

UpdateTransitiveMemberIDs * UpdateTransitiveMemberIDsStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar UpdateTransitiveMemberIDsStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_UpdateTransitiveMemberIDsStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_UpdateTransitiveMemberIDs)) {
		return ((UpdateTransitiveMemberIDsStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

