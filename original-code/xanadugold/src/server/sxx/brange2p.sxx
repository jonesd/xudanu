/* ====== Object Migrator for Scavenging of BeWorkLockExecutor ====== */

void BeWorkLockExecutor::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BeWorkLockExecutor*)origin)->myWork,
				       (Heaper**)&myWork);
	} else {
		myWork.forwardTo (Heaplet::forward (myWork));
	}
}

/*----------------------- END BeWorkLockExecutor -----------------------*/


