/* ====== Object Migrator for Scavenging of UpdateTransitiveMemberIDs ====== */

void UpdateTransitiveMemberIDs::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->AgendaItem::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((UpdateTransitiveMemberIDs*)origin)->myClubs,
				       (Heaper**)&myClubs);
	} else {
		myClubs.forwardTo (Heaplet::forward (myClubs));
	}
}

