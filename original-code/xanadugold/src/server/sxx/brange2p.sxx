/* ====== Object Migrator for Scavenging of UpdateTransitiveSuperClubIDs ====== */

void UpdateTransitiveSuperClubIDs::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->AgendaItem::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((UpdateTransitiveSuperClubIDs*)origin)->myClubs,
				       (Heaper**)&myClubs);
		Heaplet::forwardToOld ((Heaper**)&((UpdateTransitiveSuperClubIDs*)origin)->myGrandMap,
				       (Heaper**)&myGrandMap);
	} else {
		myClubs.forwardTo (Heaplet::forward (myClubs));
		myGrandMap.forwardTo (Heaplet::forward (myGrandMap));
	}
}

