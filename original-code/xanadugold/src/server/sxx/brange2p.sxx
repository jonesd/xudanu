/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void UpdateTransitiveMemberIDs::sendSelfTo (APTR(Xmtr) xmtr)
{
    AgendaItem::sendSelfTo (xmtr);
    xmtr->sendHeaper(myClubs);
}

UpdateTransitiveMemberIDs::UpdateTransitiveMemberIDs (APTR(Rcvr) receiver, TCSJ)
  : AgendaItem (receiver, tcsj) {
    myClubs = CAST(MuSet, receiver->receiveHeaper());
}


void parseInto_UpdateTransitiveMemberIDs (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) UpdateTransitiveMemberIDs (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe UpdateTransitiveMemberIDs_recipe(cat_UpdateTransitiveMemberIDs, &DiskCuisine, parseInto_UpdateTransitiveMemberIDs);


/* #endif */ /* WITH_RPC */


