/* ====== Object Migrator for Scavenging of FeIndirectWrapperSpec ====== */

void FeIndirectWrapperSpec::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->FeConcreteWrapperSpec::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FeIndirectWrapperSpec*)origin)->myInner,
				       (Heaper**)&myInner);
	} else {
		myInner.forwardTo (Heaplet::forward (myInner));
	}
}

