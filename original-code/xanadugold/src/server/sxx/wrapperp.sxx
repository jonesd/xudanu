/* ====== Object Migrator for Scavenging of FeAbstractWrapperSpec ====== */

void FeAbstractWrapperSpec::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->FeWrapperSpec::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FeAbstractWrapperSpec*)origin)->myConcreteSpecs,
				       (Heaper**)&myConcreteSpecs);
	} else {
		myConcreteSpecs.forwardTo (Heaplet::forward (myConcreteSpecs));
	}
}

/*----------------------- END FeAbstractWrapperSpec -----------------------*/


