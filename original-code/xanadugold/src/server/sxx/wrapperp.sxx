/*----------------------- BEGIN FeWrapperDef -----------------------*/
DEFINE_CLASS_CATEGORY(FeWrapperDef,Heaper)
DEFINE_OPAQUE_TYPE(FeWrapperDef);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "FeWrapperDef" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */


BooleanVar FeWrapperDef::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 FeWrapperDef::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of FeWrapperDef ====== */

void FeWrapperDef::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FeWrapperDef*)origin)->myName,
				       (Heaper**)&myName);
		Heaplet::forwardToOld ((Heaper**)&((FeWrapperDef*)origin)->mySuperDefName,
				       (Heaper**)&mySuperDefName);
	} else {
		myName.forwardTo (Heaplet::forward (myName));
		mySuperDefName.forwardTo (Heaplet::forward (mySuperDefName));
	}
}

/*----------------------- END FeWrapperDef -----------------------*/


