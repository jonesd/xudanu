/* ====== Object Migrator for Scavenging of GrantStepper ====== */

void GrantStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((GrantStepper*)origin)->myBundles,
				       (Heaper**)&myBundles);
		Heaplet::forwardToOld ((Heaper**)&((GrantStepper*)origin)->myClubIDs,
				       (Heaper**)&myClubIDs);
	} else {
		myBundles.forwardTo (Heaplet::forward (myBundles));
		myClubIDs.forwardTo (Heaplet::forward (myClubIDs));
	}
}

/*----------------------- END GrantStepper -----------------------*/

