/* ===== mayBecome support between stub and concrete Shepherd Prototype ===== */

DEFINE_MAY_BECOME(BeGrandMap,BeGrandMapStub)
DEFINE_MAY_BECOME(BeGrandMapStub,BeGrandMap)

/* ====== Object Migrator for Scavenging of BeGrandMap ====== */

void BeGrandMap::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myIdentifier,
				       (Heaper**)&myIdentifier);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myGlobalIDSpace,
				       (Heaper**)&myGlobalIDSpace);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myLocalIDSpaceCounter,
				       (Heaper**)&myLocalIDSpaceCounter);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myGlobalIDFilterSpace,
				       (Heaper**)&myGlobalIDFilterSpace);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myEndorsementSpace,
				       (Heaper**)&myEndorsementSpace);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myEndorsementFilterSpace,
				       (Heaper**)&myEndorsementFilterSpace);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myIDHolders,
				       (Heaper**)&myIDHolders);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myIDCounters,
				       (Heaper**)&myIDCounters);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myRangeElements,
				       (Heaper**)&myRangeElements);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myRangeElementIDs,
				       (Heaper**)&myRangeElementIDs);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myEnt,
				       (Heaper**)&myEnt);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myEmptyClubID,
				       (Heaper**)&myEmptyClubID);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myPublicClubID,
				       (Heaper**)&myPublicClubID);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myAdminClubID,
				       (Heaper**)&myAdminClubID);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myArchiveClubID,
				       (Heaper**)&myArchiveClubID);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myAccessClubID,
				       (Heaper**)&myAccessClubID);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myClubDirectoryID,
				       (Heaper**)&myClubDirectoryID);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myGateLockSmithEdition,
				       (Heaper**)&myGateLockSmithEdition);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myWrapperEndorsements,
				       (Heaper**)&myWrapperEndorsements);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myEndorsementFlags,
				       (Heaper**)&myEndorsementFlags);
		Heaplet::forwardToOld ((Heaper**)&((BeGrandMap*)origin)->myGrants,
				       (Heaper**)&myGrants);
	} else {
		myIdentifier.forwardTo (Heaplet::forward (myIdentifier));
		myGlobalIDSpace.forwardTo (Heaplet::forward (myGlobalIDSpace));
		myLocalIDSpaceCounter.forwardTo (Heaplet::forward (myLocalIDSpaceCounter));
		myGlobalIDFilterSpace.forwardTo (Heaplet::forward (myGlobalIDFilterSpace));
		myEndorsementSpace.forwardTo (Heaplet::forward (myEndorsementSpace));
		myEndorsementFilterSpace.forwardTo (Heaplet::forward (myEndorsementFilterSpace));
		myIDHolders.forwardTo (Heaplet::forward (myIDHolders));
		myIDCounters.forwardTo (Heaplet::forward (myIDCounters));
		myRangeElements.forwardTo (Heaplet::forward (myRangeElements));
		myRangeElementIDs.forwardTo (Heaplet::forward (myRangeElementIDs));
		myEnt.forwardTo (Heaplet::forward (myEnt));
		myEmptyClubID.forwardTo (Heaplet::forward (myEmptyClubID));
		myPublicClubID.forwardTo (Heaplet::forward (myPublicClubID));
		myAdminClubID.forwardTo (Heaplet::forward (myAdminClubID));
		myArchiveClubID.forwardTo (Heaplet::forward (myArchiveClubID));
		myAccessClubID.forwardTo (Heaplet::forward (myAccessClubID));
		myClubDirectoryID.forwardTo (Heaplet::forward (myClubDirectoryID));
		myGateLockSmithEdition.forwardTo (Heaplet::forward (myGateLockSmithEdition));
		myWrapperEndorsements.forwardTo (Heaplet::forward (myWrapperEndorsements));
		myEndorsementFlags.forwardTo (Heaplet::forward (myEndorsementFlags));
		myGrants.forwardTo (Heaplet::forward (myGrants));
	}
}

