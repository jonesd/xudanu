void BeGrandMap::sendSelfTo (APTR(Xmtr) xmtr)
{
    Abraham::sendSelfTo (xmtr);
    xmtr->sendHeaper(myIdentifier);
    xmtr->sendHeaper(myGlobalIDSpace);
    xmtr->sendHeaper(myLocalIDSpaceCounter);
    xmtr->sendHeaper(myGlobalIDFilterSpace);
    xmtr->sendHeaper(myEndorsementSpace);
    xmtr->sendHeaper(myEndorsementFilterSpace);
    xmtr->sendHeaper(myIDHolders);
    xmtr->sendHeaper(myIDCounters);
    xmtr->sendHeaper(myRangeElements);
    xmtr->sendHeaper(myRangeElementIDs);
    xmtr->sendHeaper(myEnt);
    xmtr->sendHeaper(myEmptyClubID);
    xmtr->sendHeaper(myPublicClubID);
    xmtr->sendHeaper(myAdminClubID);
    xmtr->sendHeaper(myArchiveClubID);
    xmtr->sendHeaper(myAccessClubID);
    xmtr->sendHeaper(myClubDirectoryID);
    xmtr->sendHeaper(myGateLockSmithEdition);
    xmtr->sendHeaper(myWrapperEndorsements);
    xmtr->sendHeaper(myEndorsementFlags);
    xmtr->sendHeaper(myGrants);
}

BeGrandMap::BeGrandMap (APTR(Rcvr) receiver, TCSJ)
  : Abraham (receiver, tcsj) {
    myIdentifier = CAST(Sequence, receiver->receiveHeaper());
    myGlobalIDSpace = CAST(IDSpace, receiver->receiveHeaper());
    myLocalIDSpaceCounter = CAST(Counter, receiver->receiveHeaper());
    myGlobalIDFilterSpace = CAST(FilterSpace, receiver->receiveHeaper());
    myEndorsementSpace = CAST(CrossSpace, receiver->receiveHeaper());
    myEndorsementFilterSpace = CAST(FilterSpace, receiver->receiveHeaper());
    myIDHolders = CAST(MuTable, receiver->receiveHeaper());
    myIDCounters = CAST(MuTable, receiver->receiveHeaper());
    myRangeElements = CAST(MuTable, receiver->receiveHeaper());
    myRangeElementIDs = CAST(MuTable, receiver->receiveHeaper());
    myEnt = CAST(Ent, receiver->receiveHeaper());
    myEmptyClubID = CAST(ID, receiver->receiveHeaper());
    myPublicClubID = CAST(ID, receiver->receiveHeaper());
    myAdminClubID = CAST(ID, receiver->receiveHeaper());
    myArchiveClubID = CAST(ID, receiver->receiveHeaper());
    myAccessClubID = CAST(ID, receiver->receiveHeaper());
    myClubDirectoryID = CAST(ID, receiver->receiveHeaper());
    myGateLockSmithEdition = CAST(BeEdition, receiver->receiveHeaper());
    myWrapperEndorsements = CAST(ImmuTable, receiver->receiveHeaper());
    myEndorsementFlags = CAST(PtrArray, receiver->receiveHeaper());
    myGrants = CAST(BeEdition, receiver->receiveHeaper());
    this->restartBeGrandMap(receiver);
}


void parseInto_BeGrandMap (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) BeGrandMap (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe BeGrandMap_recipe(cat_BeGrandMap, &DiskCuisine, parseInto_BeGrandMap);


