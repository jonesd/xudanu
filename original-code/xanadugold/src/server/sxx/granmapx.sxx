Category * BeGrandMap::getShepherdStubCategory () CONST
{
        return cat_BeGrandMapStub;
}

void BeGrandMap::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) BeGrandMapStub (shepFlag, hash, info);
}

/* ===== BeGrandMapStub Implementations ==== */

void BeGrandMapStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

BeGrandMap * BeGrandMapStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar BeGrandMapStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_BeGrandMapStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_BeGrandMap)) {
		return ((BeGrandMapStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

DEFINE_CLASS_CATEGORY(BeGrandMapStub,BeGrandMap)

