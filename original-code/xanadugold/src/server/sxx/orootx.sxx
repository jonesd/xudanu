void EmptyOrglRoot::sendSelfTo (APTR(Xmtr) xmtr)
{
    OrglRoot::sendSelfTo (xmtr);
    xmtr->sendHeaper(myCS);
}

EmptyOrglRoot::EmptyOrglRoot (APTR(Rcvr) receiver, TCSJ)
  : OrglRoot (receiver, tcsj) {
    myCS = CAST(CoordinateSpace, receiver->receiveHeaper());
}


void parseInto_EmptyOrglRoot (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) EmptyOrglRoot (rcvr, tcsj);
}

