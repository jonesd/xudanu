/* ====== Object Migrator for Scavenging of OPart ====== */

void OPart::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->Abraham::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((OPart*)origin)->mySensorCrum,
				       (Heaper**)&mySensorCrum);
	} else {
		mySensorCrum.forwardTo (Heaplet::forward (mySensorCrum));
	}
}

/*----------------------- END OPart -----------------------*/


