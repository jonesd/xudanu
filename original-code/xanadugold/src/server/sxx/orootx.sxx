Category * EmptyOrglRoot::getShepherdStubCategory () CONST
{
        return cat_EmptyOrglRootStub;
}

void EmptyOrglRoot::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) EmptyOrglRootStub (shepFlag, hash, info);
}

/* ===== EmptyOrglRootStub Implementations ==== */

void EmptyOrglRootStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

EmptyOrglRoot * EmptyOrglRootStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar EmptyOrglRootStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_EmptyOrglRootStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_EmptyOrglRoot)) {
		return ((EmptyOrglRootStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

