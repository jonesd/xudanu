/* ====== Copy Class "OPart" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void OPart::sendSelfTo (APTR(Xmtr) xmtr)
{
    Abraham::sendSelfTo (xmtr);
    xmtr->sendHeaper(mySensorCrum);
}

OPart::OPart (APTR(Rcvr) receiver, TCSJ)
  : Abraham (receiver, tcsj) {
    mySensorCrum = CAST(SensorCrum, receiver->receiveHeaper());
}


/* #endif */ /* WITH_RPC */


