/* ===== OrglRootStub Implementations ==== */

void OrglRootStub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

OrglRoot * OrglRootStub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar OrglRootStub::
isKindOf(Category * aCategory) CONST
{
	if (cat_OrglRootStub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_OrglRoot)) {
		return ((OrglRootStub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

