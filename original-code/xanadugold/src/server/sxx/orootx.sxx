void ActualOrglRoot::sendSelfTo (APTR(Xmtr) xmtr)
{
    OrglRoot::sendSelfTo (xmtr);
    xmtr->sendHeaper(myO);
    xmtr->sendHeaper(myRegion);
}

ActualOrglRoot::ActualOrglRoot (APTR(Rcvr) receiver, TCSJ)
  : OrglRoot (receiver, tcsj) {
    myO = CAST(Loaf, receiver->receiveHeaper());
    myRegion = CAST(XnRegion, receiver->receiveHeaper());
}


void parseInto_ActualOrglRoot (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) ActualOrglRoot (rcvr, tcsj);
}

