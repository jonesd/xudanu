DEFINE_MAY_BECOME(ActualOrglRoot,ActualOrglRootStub)
DEFINE_MAY_BECOME(ActualOrglRootStub,ActualOrglRoot)

/* ====== Object Migrator for Scavenging of ActualOrglRoot ====== */

void ActualOrglRoot::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->OrglRoot::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ActualOrglRoot*)origin)->myO,
				       (Heaper**)&myO);
		Heaplet::forwardToOld ((Heaper**)&((ActualOrglRoot*)origin)->myRegion,
				       (Heaper**)&myRegion);
	} else {
		myO.forwardTo (Heaplet::forward (myO));
		myRegion.forwardTo (Heaplet::forward (myRegion));
	}
}

/*----------------------- END ActualOrglRoot -----------------------*/


