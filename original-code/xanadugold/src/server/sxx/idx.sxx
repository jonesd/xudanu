/*----------------------- BEGIN IDRegion -----------------------*/
DEFINE_CLASS_CATEGORY(IDRegion,XnRegion)
DEFINE_OPAQUE_TYPE(IDRegion);

void IDRegion::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "IDRegion" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void IDRegion::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(mySpace);
    xmtr->sendHeaper(myLocalIDs);
    xmtr->sendHeaper(myImportedIDs);
    xmtr->sendBooleanVar(myIncludesRest);
}

IDRegion::IDRegion (APTR(Rcvr) receiver, TCSJ)
{
    mySpace = CAST(IDSpace, receiver->receiveHeaper());
    myLocalIDs = CAST(IntegerRegion, receiver->receiveHeaper());
    myImportedIDs = CAST(ImmuTable, receiver->receiveHeaper());
    myIncludesRest = receiver->receiveBooleanVar();
}


void parseInto_IDRegion (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) IDRegion (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe IDRegion_recipe(cat_IDRegion, &DiskCuisine, parseInto_IDRegion);


/* #endif */ /* WITH_RPC */


#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "IDRegion" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of IDRegion ====== */

void IDRegion::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((IDRegion*)origin)->mySpace,
				       (Heaper**)&mySpace);
		Heaplet::forwardToOld ((Heaper**)&((IDRegion*)origin)->myLocalIDs,
				       (Heaper**)&myLocalIDs);
		Heaplet::forwardToOld ((Heaper**)&((IDRegion*)origin)->myImportedIDs,
				       (Heaper**)&myImportedIDs);
	} else {
		mySpace.forwardTo (Heaplet::forward (mySpace));
		myLocalIDs.forwardTo (Heaplet::forward (myLocalIDs));
		myImportedIDs.forwardTo (Heaplet::forward (myImportedIDs));
	}
}

/*----------------------- END IDRegion -----------------------*/


/*----------------------- BEGIN IDSpace -----------------------*/
DEFINE_CLASS_CATEGORY(IDSpace,CoordinateSpace)
DEFINE_OPAQUE_TYPE(IDSpace);

void IDSpace::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "IDSpace" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
