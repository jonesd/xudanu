extern Recipe * DiskCuisine;
PseudoCopyRecipe IDSpace_recipe(cat_IDSpace, &DiskCuisine, IDSpace::make);


#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "IDSpace" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of IDSpace ====== */

void IDSpace::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->CoordinateSpace::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((IDSpace*)origin)->myBackend,
				       (Heaper**)&myBackend);
		Heaplet::forwardToOld ((Heaper**)&((IDSpace*)origin)->myNewIDCounter,
				       (Heaper**)&myNewIDCounter);
	} else {
		myBackend.forwardTo (Heaplet::forward (myBackend));
		myNewIDCounter.forwardTo (Heaplet::forward (myNewIDCounter));
	}
}

/*----------------------- END IDSpace -----------------------*/

