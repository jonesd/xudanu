/*----------------------- BEGIN ID -----------------------*/
DEFINE_CLASS_CATEGORY(ID,Position)
DEFINE_OPAQUE_TYPE(ID);

void ID::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "ID" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void ID::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(mySpace);
    xmtr->sendHeaper(myBackend);
    xmtr->sendIntegerVar(myNumber);
}

ID::ID (APTR(Rcvr) receiver, TCSJ)
{
    mySpace = CAST(IDSpace, receiver->receiveHeaper());
    myBackend = CAST(Sequence, receiver->receiveHeaper());
    myNumber = receiver->receiveIntegerVar();
}


void parseInto_ID (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) ID (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe ID_recipe(cat_ID, &DiskCuisine, parseInto_ID);


/* #endif */ /* WITH_RPC */


#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "ID" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of ID ====== */

void ID::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ID*)origin)->mySpace,
				       (Heaper**)&mySpace);
		Heaplet::forwardToOld ((Heaper**)&((ID*)origin)->myBackend,
				       (Heaper**)&myBackend);
	} else {
		mySpace.forwardTo (Heaplet::forward (mySpace));
		myBackend.forwardTo (Heaplet::forward (myBackend));
	}
}

/*----------------------- END ID -----------------------*/


