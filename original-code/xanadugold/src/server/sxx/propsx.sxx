/* ====== Copy Class "SensorProp" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of SensorProp ====== */

void SensorProp::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SensorProp*)origin)->myRelevantPermissions,
				       (Heaper**)&myRelevantPermissions);
		Heaplet::forwardToOld ((Heaper**)&((SensorProp*)origin)->myRelevantEndorsements,
				       (Heaper**)&myRelevantEndorsements);
	} else {
		myRelevantPermissions.forwardTo (Heaplet::forward (myRelevantPermissions));
		myRelevantEndorsements.forwardTo (Heaplet::forward (myRelevantEndorsements));
	}
}

/*----------------------- END SensorProp -----------------------*/


