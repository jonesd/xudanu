/*----------------------- BEGIN BertProp -----------------------*/
DEFINE_CLASS_CATEGORY(BertProp,Prop)
DEFINE_OPAQUE_TYPE(BertProp);

void BertProp::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "BertProp" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void BertProp::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myPermissions);
    xmtr->sendHeaper(myEndorsements);
    xmtr->sendBooleanVar(mySensorWaitingFlag);
    xmtr->sendBooleanVar(myCannotPartializeFlag);
}

BertProp::BertProp (APTR(Rcvr) receiver, TCSJ)
{
    myPermissions = CAST(XnRegion, receiver->receiveHeaper());
    myEndorsements = CAST(XnRegion, receiver->receiveHeaper());
    mySensorWaitingFlag = receiver->receiveBooleanVar();
    myCannotPartializeFlag = receiver->receiveBooleanVar();
}


void parseInto_BertProp (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) BertProp (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe BertProp_recipe(cat_BertProp, &DiskCuisine, parseInto_BertProp);


/* #endif */ /* WITH_RPC */


#ifndef BACKEND1_HF_IDENT
/* $Id: backend1.hf,v 2.5 1992/11/25 23:18:22 eric Exp $ */
#define BACKEND1_HF_IDENT
#endif /* BACKEND1_HF_IDENT */
/* ====== Copy Class "BertProp" ======= */
 
#ifndef BACKEND2_HF_IDENT
/* $Id: backend2.hf,v 2.14 1992/11/25 23:18:23 eric Exp $ */
#define BACKEND2_HF_IDENT
#endif /* BACKEND2_HF_IDENT */

/* ====== Object Migrator for Scavenging of BertProp ====== */

void BertProp::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((BertProp*)origin)->myPermissions,
				       (Heaper**)&myPermissions);
		Heaplet::forwardToOld ((Heaper**)&((BertProp*)origin)->myEndorsements,
				       (Heaper**)&myEndorsements);
	} else {
		myPermissions.forwardTo (Heaplet::forward (myPermissions));
		myEndorsements.forwardTo (Heaplet::forward (myEndorsements));
	}
}

/*----------------------- END BertProp -----------------------*/


/*----------------------- BEGIN SensorProp -----------------------*/
DEFINE_CLASS_CATEGORY(SensorProp,Prop)
DEFINE_OPAQUE_TYPE(SensorProp);

void SensorProp::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "SensorProp" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void SensorProp::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myRelevantPermissions);
    xmtr->sendHeaper(myRelevantEndorsements);
    xmtr->sendBooleanVar(myPartialFlag);
}

SensorProp::SensorProp (APTR(Rcvr) receiver, TCSJ)
{
    myRelevantPermissions = CAST(IDRegion, receiver->receiveHeaper());
    myRelevantEndorsements = CAST(CrossRegion, receiver->receiveHeaper());
    myPartialFlag = receiver->receiveBooleanVar();
}


void parseInto_SensorProp (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) SensorProp (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe SensorProp_recipe(cat_SensorProp, &DiskCuisine, parseInto_SensorProp);


/* #endif */ /* WITH_RPC */


