DEFINE_CLASS_CATEGORY(MergeBundlesStepper,Stepper)

void MergeBundlesStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "MergeBundlesStepper" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void MergeBundlesStepper::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myA);
    xmtr->sendHeaper(myB);
    xmtr->sendHeaper(myOrder);
    xmtr->sendHeaper(myValue);
}

MergeBundlesStepper::MergeBundlesStepper (APTR(Rcvr) receiver, TCSJ)
{
    myA = CAST(Stepper, receiver->receiveHeaper());
    myB = CAST(Stepper, receiver->receiveHeaper());
    myOrder = CAST(OrderSpec, receiver->receiveHeaper());
    myValue = CAST(FeBundle, receiver->receiveHeaper());
}


void parseInto_MergeBundlesStepper (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) MergeBundlesStepper (rcvr, tcsj);
}

extern Recipe * DiskCuisine;
ActualCopyRecipe MergeBundlesStepper_recipe(cat_MergeBundlesStepper, &DiskCuisine, parseInto_MergeBundlesStepper);


/* #endif */ /* WITH_RPC */


