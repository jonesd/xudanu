/* ====== Object Migrator for Scavenging of MergeBundlesStepper ====== */

void MergeBundlesStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((MergeBundlesStepper*)origin)->myA,
				       (Heaper**)&myA);
		Heaplet::forwardToOld ((Heaper**)&((MergeBundlesStepper*)origin)->myB,
				       (Heaper**)&myB);
		Heaplet::forwardToOld ((Heaper**)&((MergeBundlesStepper*)origin)->myOrder,
				       (Heaper**)&myOrder);
		Heaplet::forwardToOld ((Heaper**)&((MergeBundlesStepper*)origin)->myValue,
				       (Heaper**)&myValue);
	} else {
		myA.forwardTo (Heaplet::forward (myA));
		myB.forwardTo (Heaplet::forward (myB));
		myOrder.forwardTo (Heaplet::forward (myOrder));
		myValue.forwardTo (Heaplet::forward (myValue));
	}
}

/*----------------------- END MergeBundlesStepper -----------------------*/

