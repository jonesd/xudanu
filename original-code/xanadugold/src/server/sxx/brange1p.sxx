/* ====== Object Migrator for Scavenging of FillDetectorExecutor ====== */

void FillDetectorExecutor::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FillDetectorExecutor*)origin)->myPlaceHolder,
				       (Heaper**)&myPlaceHolder);
	} else {
		myPlaceHolder.forwardTo (Heaplet::forward (myPlaceHolder));
	}
}

/*----------------------- END FillDetectorExecutor -----------------------*/

