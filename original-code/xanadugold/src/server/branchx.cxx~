/* caching */


void DagBranch::cacheRecur (APTR(PrimIndexTable) navCache){
	parent1->cacheIn(navCache);
	parent2->cacheIn(navCache);
}
/* create */


DagBranch::DagBranch (
		APTR(DagWood) ft, 
		APTR(TracePosition) p1, 
		APTR(TracePosition) p2) 

	: BranchDescription(ft, tcsj) {
	parent1 = p1;
	parent2 = p2;
	this->newShepherd();
	this->remember();
}
/* testing */


UInt32 DagBranch::contentsHash (){
	return this->BranchDescription::contentsHash() ^ parent1->hashForEqual() ^ parent2->hashForEqual();
}



