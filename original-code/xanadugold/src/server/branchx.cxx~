void BranchDescription::walkBranch (){
	if(myLeft != NULL){
		myLeft->walkBranch();
	}
	if(myRight != NULL){
		myRight->walkBranch();
	}

}
void BranchDescription::installBranchAfter (APTR(BranchDescription) branch, APTR(TracePosition) trace){
	fulltrace->installBranchAfter(branch, trace);
}


RPTR(BranchDescription) BranchDescription::makeBranch (APTR(TracePosition) trace1, APTR(TracePosition) trace2){
	/* Create a dag branch that succeeds both trace1 and trace2. */
	
	WPTR(BranchDescription) 	returnValue;
	returnValue = BranchDescription::make (fulltrace, trace1, trace2);
	return returnValue;
}


RPTR(TracePosition) BranchDescription::nextPosition (){
	/* Return the first available tracePosition on this branch. */
	
	lastPosition += 1;
	this->diskUpdate();
	WPTR(TracePosition) 	returnValue;
	returnValue = TracePosition::make (this, lastPosition);
	return returnValue;
}
/* protected: protected create */


BranchDescription::BranchDescription (APTR(DagWood) ft, TCSJ) {
	fulltrace = ft;
	myLeft = NULL;
	myRight = NULL;
	lastPosition = 2;
}
