/* accessing */


void BranchDescription::addSuccessorsTo (APTR(MuSet) set){
	/* Add the first useable positions for all successor branches 
	to the set. */
	
	set->store(TracePosition::make (this, 3));
	if (myLeft != NULL) {
		myLeft->addSuccessorsTo(set);
	}
	if (myRight != NULL) {
		myRight->addSuccessorsTo(set);
	}
}


RPTR(ImmuSet) BranchDescription::successorsOf (APTR(BoundedTrace) trace){
	SPTR(MuSet) set;
	
	set = fulltrace->successorsOf(trace);
	if (trace->position() != lastPosition) {
		set->store(TracePosition::make (this, trace->position() + 1));
	}
	WPTR(ImmuSet) 	returnValue;
	returnValue = set->asImmuSet();
	return returnValue;
}
/* position making */

static BranchDescription * Checkbranch = 0;
RPTR(TracePosition) BranchDescription::createAfter (APTR(BoundedTrace) trace){
	/* Return a new successor to the receiver. The first 
	successor is on the 
		same branch with a higher position. Further successors are allocated 
		in a binary-tree fashion along a new branch. */
    if(!Checkbranch) {
	Checkbranch = this;
    }
	if (lastPosition == trace->position()) {
		WPTR(TracePosition) 	returnValue;
		returnValue = this->nextPosition();
		return returnValue;
	} else {
		SPTR(BranchDescription) branch;
		
		branch = BranchDescription::make (fulltrace, trace);
		fulltrace->installBranchAfter(branch, trace);

		WPTR(TracePosition) 	returnValue;
		returnValue = branch->nextPosition();
		return returnValue;
	}
}


void BranchDescription::installBranch (APTR(BranchDescription) branch){
	/* Install branch as a descendant branch of myself. Walk down 
	the binary tree of 
		branches to find a place to lodge it. This gets called if 
	there was already a 
		branch existing off my root. */
    if(!Checkbranch) {
	Checkbranch = this;
    }
	if (branch->isEqual(this)) {
		return;
		
	}
	this->diskUpdate();
this->walkBranch();	
	if (myLeft == NULL) {
		myLeft = branch;
	} else {
		SPTR(BranchDescription) tmpBr;
		
		myLeft->installBranch(branch);
		tmpBr = myLeft;
		myLeft = myRight;
		myRight = tmpBr;
	}
}


