RPTR(BeRangeElement) OR(NULL) BeGrandMap::fetch (APTR(ID) iD){
	/* The actual BeRangeElement at that ID, or NULL if there is none */
	
	return CAST(BeRangeElement,myRangeElements->fetch(iD));
}


RPTR(BeClub) OR(NULL) BeGrandMap::fetchClub (APTR(ID) OR(NULL) iD){
	/* If there is a club at the given ID, return it. */
	
	if (iD == NULL) {
		return NULL;
	}
	BEGIN_CHOOSE(this->get(iD)) {
		BEGIN_KIND(BeClub,club) {
			WPTR(BeClub) OR(NULL) 	returnValue;
			returnValue = club;
			return returnValue;
		} END_KIND;
		BEGIN_OTHERS {
			
		} END_OTHERS;
	} END_CHOOSE;
	return NULL;
}


