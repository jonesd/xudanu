	/* Ravi -- Thing to do !!!! */
	
	/* Figure out if there is a better way to do this */
	return (ImmuTable*) myWrapperEndorsements;
}
/* making editions */


RPTR(BeEdition) BeGrandMap::newDataEdition (
		APTR(PrimDataArray) values, 
		APTR(XnRegion) keys, 
		APTR(OrderSpec) ordering)
{
	/* Creates an Edition mapping from a Region of keys to the 
	values in an array. The ordering specifies the correspondance 
	between the keys and the indices in the array.
		The Region must have the same count as the array.
		You must give an owner for the newly created DataHolders. */
	
	SPTR(OrglRoot) result;
	IntegerVar offset;
	SPTR(XnRegion) remainder;
	
	if (keys->isEmpty()) {
		WPTR(BeEdition) 	returnValue;
		returnValue = this->newEmptyEdition(keys->coordinateSpace());
		return returnValue;
	}
	{	FLUID_BIND(CurrentTrace,myEnt->newTrace()) {
			{	FLUID_BIND(CurrentBertCrum,BertCrum::make ()) {
					if (values->count() <= Ent::tableSegmentMaxSize().asLong()) {
						WPTR(BeEdition) 	returnValue;
						returnValue = BeEdition::make (
							OrglRoot::makeData(keys, ordering, values));
						return returnValue;
					}
					result = OrglRoot::make (ordering->coordinateSpace());
					offset = Int32Zero;
					remainder = keys;
					while (offset < values->count()) {
						Int32 count;
						SPTR(OrglRoot) oroot;
						SPTR(PrimDataArray) array;
						SPTR(XnRegion) region;
						
						count = min(Ent::tableSegmentMaxSize().asLong(), values->count() - offset.asLong());
						array = CAST(PrimDataArray,values->copy(count, offset.asLong()));
						region = remainder->chooseMany(count, ordering);
						oroot = 
								OrglRoot::makeData(IntegerMapping::make (-offset)->ofAll(region), ordering, array);
						result = result->combine(oroot->transformedBy(IntegerMapping::make (offset)));
						remainder = remainder->minus(region);
						offset += count;
					}
					WPTR(BeEdition) 	returnValue;
					returnValue = BeEdition::make (result);
					return returnValue;
				}
			}
		}
	}
}


RPTR(BeEdition) BeGrandMap::newEditionWith (APTR(Position) key, APTR(BeCarrier) value){
	/* A single key-value mapping */
	
	
	/* Hack !!!! */
	
	/* What should the bertCrum be? */
	{	FLUID_BIND(CurrentTrace,value->rangeElement()->hCrum()->hCut()->newSuccessor()) {
			{	FLUID_BIND(CurrentBertCrum,value->rangeElement()->bertCrum()) {
					SPTR(XnRegion) region;
					
					region = key->asRegion();
					WPTR(BeEdition) 	returnValue;
					returnValue = BeEdition::make (ActualOrglRoot::make (Loaf::make (region, value), region));
					return returnValue;
				}
			}
		}
	}
}


RPTR(BeEdition) BeGrandMap::newEditionWithAll (APTR(XnRegion) keys, APTR(BeCarrier) value){
	/* A single key-value mapping */
	
	/* Hack !!!! */
	
	/* What should the bertCrum be? */
	if (keys->isEmpty()) {
		WPTR(BeEdition) 	returnValue;
		returnValue = this->newEmptyEdition(keys->coordinateSpace());
		return returnValue;
	}
	{	FLUID_BIND(CurrentTrace,value->rangeElement()->hCrum()->hCut()->newSuccessor()) {
			{	FLUID_BIND(CurrentBertCrum,value->rangeElement()->bertCrum()) {
					WPTR(BeEdition) 	returnValue;
					returnValue = BeEdition::make (ActualOrglRoot::make (Loaf::make (keys, value), keys));
					return returnValue;
				}
			}
		}
	}
}


RPTR(BeEdition) BeGrandMap::newEmptyEdition (APTR(CoordinateSpace) cs){
	/* Create an empty Edition.  This should really be canonicalized. */
	
	{	FLUID_BIND(CurrentTrace,myEnt->newTrace()) {
			{	FLUID_BIND(CurrentBertCrum,BertCrum::make ()) {
					BEGIN_CONSISTENT(4) {
						WPTR(BeEdition) 	returnValue;
						returnValue = BeEdition::make (OrglRoot::make (cs));
						return returnValue;
					} END_CONSISTENT;
				}
			}
		}
	}
}


RPTR(BeEdition) BeGrandMap::newPlaceHolders (APTR(XnRegion) region){
	/* Make an Edition with a region full of unique PlaceHolders */
	
	/* Ravi -- Thing to do !!!! */
	
	/* rename to newPlaceHolders */
	if (region->isEmpty()) {
		WPTR(BeEdition) 	returnValue;
		returnValue = this->newEmptyEdition(region->coordinateSpace());
		return returnValue;
	}
	{	FLUID_BIND(CurrentTrace,myEnt->newTrace()) {
			{	FLUID_BIND(CurrentBertCrum,BertCrum::make ()) {
					WPTR(BeEdition) 	returnValue;
					returnValue = BeEdition::make (OrglRoot::make (region));
					return returnValue;
				}
			}
		}
	}
}


RPTR(BeEdition) BeGrandMap::newValueEdition (
		APTR(PtrArray) OF1(FeRangeElement) values, 
		APTR(XnRegion) keys, 
		APTR(OrderSpec) ordering)
{
	/* Creates an Edition mapping from a Region of keys to the 
	values in an array. The ordering specifies the correspondance 
	between the keys and the indices in the array.
		The Region must have the same count as the array. */
	/* compute the join of the existing traces and bert crums in 
	the table */
	/* make new ones if there are none */
	
	SPTR(TracePosition) trace;
	SPTR(CanopyCrum) crum;
	SPTR(BeRangeElement) rangeElement;
	
	if (keys->count() != values->count()) {
		BLAST(CountMismatch);
	}
	if (keys->isEmpty()) {
		WPTR(BeEdition) 	returnValue;
		returnValue = this->newEmptyEdition(keys->coordinateSpace());
		return returnValue;
	}
	BEGIN_CHOOSE(values->fetch(Int32Zero)){
		BEGIN_KIND(FeRangeElement,fe){
			rangeElement = fe->getOrMakeBe();
		} END_KIND;
		BEGIN_ISNULL {
			{
				BLAST(MustNotHaveNullElements);
			}
		}END_ISNULL
		
	} END_CHOOSE;
	trace = rangeElement->hCrum()->hCut();
	crum = rangeElement->bertCrum();
	{
		Int32 LoopFinal = values->count();
		Int32 i = 1;
		for (;;) {
			if (i >= LoopFinal){
				break;
			}
			{
				BEGIN_CHOOSE(values->fetch(i)){
					BEGIN_KIND(FeRangeElement,fe){
						rangeElement = fe->getOrMakeBe();
					} END_KIND;
					BEGIN_ISNULL {
						{
							BLAST(MustNotHaveNullElements);
						}
					}END_ISNULL
					
				} END_CHOOSE;
				/* Neither of these should need a 
					consistent block. */
				trace = trace->newSuccessorAfter(rangeElement->hCrum()->hCut());
				crum = crum->computeJoin(rangeElement->bertCrum());
			}
			i += 1;
		}
	}
	{	FLUID_BIND(CurrentTrace,trace) {
			{	FLUID_BIND(CurrentBertCrum,CAST(BertCrum,crum)) {
					WPTR(BeEdition) 	returnValue;
					returnValue = BeEdition::make (
						OrglRoot::make (keys, ordering, values));
					return returnValue;
				}
			}
		}
	}
}
/* making other things */


RPTR(BeCarrier) BeGrandMap::carrier (APTR(BeRangeElement) element){
	/* Return a carrier that has the rangeElement with a new 
	Label if appropriate. */
	
	if (element->isKindOf(cat_BeEdition)) {
		WPTR(BeCarrier) 	returnValue;
		returnValue = BeCarrier::make (this->newLabel(), element);
		return returnValue;
	} else {
		WPTR(BeCarrier) 	returnValue;
		returnValue = BeCarrier::make (element);
		return returnValue;
	}
}


RPTR(BeClub) BeGrandMap::newClub (APTR(FeEdition) desc, APTR(ID) iD/* = NULL*/){
	/* Make a new Club assigned to either iD or a generated ID id 
	iD is NULL. */
	
	SPTR(BeClub) result;
	
	{	FLUID_BIND(CurrentTrace,myEnt->newTrace()) {
			{	FLUID_BIND(CurrentBertCrum,BertCrum::make ()) {
					result = BeClub::make (desc);
				}
			}
		}
	}
	BEGIN_CONSISTENT(-1) {
		if (iD == NULL) {
			this->assignID(result);
		} else {
			if (!this->tryIntroduce(iD, result)) {
				BLAST(IllegalID);
			}
		}
		/* If we allow multiple IDs for clubs, we'll have to 
			do this in the grandMap. */
		result->updateTransitiveMemberIDs();
		result->updateTransitiveSuperClubIDs();
	} END_CONSISTENT;
	WPTR(BeClub) 	returnValue;
	returnValue = result;
	return returnValue;
}


RPTR(BeDataHolder) BeGrandMap::newDataHolder (APTR(PrimValue) value){
	/* Make a new DataHolder with the given contents. */
	
	{	FLUID_BIND(CurrentTrace,myEnt->newTrace()) {
			{	FLUID_BIND(CurrentBertCrum,BertCrum::make ()) {
					BEGIN_CONSISTENT(1) {
						RETURN_CONSTRUCT(BeDataHolder,(value, tcsj));
					} END_CONSISTENT;
				}
			}
		}
	}
}


RPTR(BeIDHolder) BeGrandMap::newIDHolder (APTR(ID) iD){
	/* Make a new IDHolder for the given ID. Uses an existing one 
	if it exists. */
	
	SPTR(BeIDHolder) result;
	
	result = CAST(BeIDHolder,myIDHolders->fetch(iD));
	if (result == NULL) {
		BEGIN_CONSISTENT(-1) {
			{	FLUID_BIND(CurrentTrace,myEnt->newTrace()) {
					{	FLUID_BIND(CurrentBertCrum,BertCrum::make ()) {
							result = BeIDHolder::make (iD);
							myIDHolders->introduce(iD, result);
						}
					}
				}
			}
		} END_CONSISTENT;
	}
	WPTR(BeIDHolder) 	returnValue;
	returnValue = result;
	return returnValue;
}


RPTR(BeLabel) BeGrandMap::newLabel (){
	/* Make a new label. */
	
	{	FLUID_BIND(CurrentTrace,myEnt->newTrace()) {
			{	FLUID_BIND(CurrentBertCrum,BertCrum::make ()) {
					BEGIN_CONSISTENT(1) {
						RETURN_CONSTRUCT(BeLabel,());
					} END_CONSISTENT;
				}
			}
		}
	}
}


RPTR(BePlaceHolder) BeGrandMap::newPlaceHolder (){
	/* Make a new PlaceHolder. */
	
	{	FLUID_BIND(CurrentTrace,myEnt->newTrace()) {
			{	FLUID_BIND(CurrentBertCrum,BertCrum::make ()) {
					BEGIN_CONSISTENT(3) {
						RETURN_CONSTRUCT(BePlaceHolder,());
					} END_CONSISTENT;
				}
			}
		}
	}
}


RPTR(BeWork) BeGrandMap::newWork (APTR(FeEdition) contents){
	/* Make a new Work (without an ID) with the given contents.  
	Everything 
		 else comes from the fluid environment. */
	
	{	FLUID_BIND(CurrentTrace,myEnt->newTrace()) {
			{	FLUID_BIND(CurrentBertCrum,BertCrum::make ()) {
					WPTR(BeWork) 	returnValue;
					returnValue = BeWork::make (contents);
					return returnValue;
				}
			}
		}
	}
}
