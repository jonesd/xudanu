void BeGrandMap::coldBoot (){
	SPTR(FeEdition) emptyDesc;
	SPTR(BeClub) emptyClub;
	SPTR(FeEdition) publicDesc;
	SPTR(BeClub) publicClub;
	SPTR(BeClub) adminClub;
	SPTR(BeClub) archiveClub;
	SPTR(BeEdition) clubNames;
	SPTR(MuTable) OF2(Sequence,CrossRegion) endorsements;
	IntegerVar number;
	SPTR(IDSpace) iDSpace;
	SPTR(BeEdition) endorseTokenWorks;
	
	/* set up the initial set of Clubs */
	myEmptyClubID = 
			ID::make (NULL, NULL, -1);
	myPublicClubID = 
			ID::make (NULL, NULL, -2);
	/* Thing to do !!!! */
	
	/* ensure that the following IDs are deterministic */
	myAdminClubID = myGlobalIDSpace->newID();
	myArchiveClubID = myGlobalIDSpace->newID();
	myAccessClubID = myGlobalIDSpace->newID();
	/* figure out the IDs of the Wrapper endorsement Works */
	endorsements = MuTable::make (SequenceSpace::make ());
	number = -3;
	BEGIN_FOR_EACH(Sequence,name,(FeWrapperSpec::knownWrappers()->stepper())) {
		SPTR(ID) iD;
		
		/* Ravi -- Thing to do !!!! */
		
		/* put something more descriptive here */
		iD = 
				ID::make (NULL, NULL, number);
		number -= 1;
		endorsements->introduce(name, myEndorsementSpace->crossOfRegions(CAST(PtrArray,PrimSpec::pointer()->arrayWithTwo(myArchiveClubID->asRegion(), iD->asRegion()))));
	} END_FOR_EACH;
	myWrapperEndorsements = endorsements->asImmuTable();
	/* set up the special flag bits used by the canopy */
	myEndorsementFlags = PtrArray::nulls(5 + 10);
	myEndorsementFlags->store(UInt32Zero, CAST(XnRegion,endorsements->get(Sequence::string("Text")))->theOne());
	myEndorsementFlags->store(1, CAST(XnRegion,endorsements->get(Sequence::string("HyperLink")))->theOne());
	myEndorsementFlags->store(2, CAST(XnRegion,endorsements->get(Sequence::string("HyperRef")))->theOne());
	myEndorsementFlags->store(3, CAST(XnRegion,endorsements->get(Sequence::string("SingleRef")))->theOne());
	myEndorsementFlags->store(4, CAST(XnRegion,endorsements->get(Sequence::string("MultiRef")))->theOne());
	/* generate some IDs to use as endorsement tokens */
	{
		Int32 LoopFinal = myEndorsementFlags->count();
		Int32 i = 5;
		for (;;) {
			if (i >= LoopFinal){
				break;
			}
			{
				myEndorsementFlags->store(i, myEndorsementSpace->crossOfRegions(CAST(PtrArray,PrimSpec::pointer()->arrayWithTwo(myGlobalIDSpace->fullRegion(), myGlobalIDSpace->newID()->asRegion()))));
			}
			i += 1;
		}
	}
	CanopyCrum::useEndorsementFlags(myEndorsementFlags);
	CurrentAuthor.fluidSet(myEmptyClubID);
	InitialReadClub.fluidSet(myPublicClubID);
	InitialEditClub.fluidSet(myEmptyClubID);
	InitialOwner.fluidSet(myEmptyClubID);
	InitialSponsor.fluidSet(myEmptyClubID);
	/* Known bug !!!! */
	
	/* Who sponsors clubs? */
	emptyDesc = CAST(FeEdition,this->carrier(this->newEmptyEdition(SequenceSpace::make ()))->makeFe());
	emptyClub = this->newClub(emptyDesc, myEmptyClubID);
	emptyClub->setEditClub(NULL);
	publicDesc = CAST(FeEdition,this->carrier(this->newEditionWith(Sequence::string("ClubDescription:LockSmith"), this->carrier(
										this->newDataEdition(UInt8Array::string("boo"), IntegerRegion::make (IntegerVarZero, 3), IntegerSpace::make ()->getAscending()))))->makeFe());
	publicClub = this->newClub(publicDesc, myPublicClubID);
	publicClub->setEditClub(NULL);
	emptyClub->sponsor(CAST(IDRegion,myPublicClubID->asRegion()));
	publicClub->sponsor(CAST(IDRegion,myPublicClubID->asRegion()));
	InitialSponsor.fluidSet(myPublicClubID);
	InitialReadClub.fluidSet(myAdminClubID);
	InitialEditClub.fluidSet(myAdminClubID);
	InitialOwner.fluidSet(myAdminClubID);
	/* Thing to do !!!! */
	
	/* This should probably still be the Null Club. */
	adminClub = this->newClub(publicDesc, myAdminClubID);
	InitialReadClub.fluidSet(myArchiveClubID);
	InitialEditClub.fluidSet(myArchiveClubID);
	InitialOwner.fluidSet(myArchiveClubID);
	archiveClub = this->newClub(publicDesc, myArchiveClubID);
	CurrentKeyMaster.fluidSet(FeKeyMaster::make (this->publicClubID()));
	InitialReadClub.fluidSet(myAdminClubID);
	InitialEditClub.fluidSet(myAdminClubID);
	iDSpace = IDSpace::unique();
	this->newClub(CAST(FeEdition,this->carrier(this->newEditionWith(Sequence::string("ClubDescription:Membership"), this->carrier(this->newEditionWith(iDSpace->newID(), this->carrier(publicClub))->with(iDSpace->newID(), this->carrier(adminClub))->with(iDSpace->newID(), this->carrier(archiveClub)))))->makeFe()), myAccessClubID);
	InitialReadClub.fluidSet(myPublicClubID);
	InitialSponsor.fluidSet(myAdminClubID);
	InitialEditClub.fluidSet(myAdminClubID);
	clubNames = this->newEditionWith(Sequence::string("System Admin"), this->carrier(adminClub))->combine(this->newEditionWith(Sequence::string("System Archive"), this->carrier(archiveClub)))->combine(this->newEditionWith(Sequence::string("Universal Null"), this->carrier(emptyClub)))->combine(this->newEditionWith(Sequence::string("Universal Public"), this->carrier(publicClub)));
	myClubDirectoryID = this->assignID(this->newWork(FeEdition::on(clubNames)));
	/* actually create the Wrapper description Works */
	BEGIN_FOR_POSITIONS(Sequence,name,CrossRegion,end,(endorsements->stepper())) {
		/* Ravi -- Thing to do !!!! */
		
		/* put something more descriptive in the Work */
		this->tryIntroduce(CAST(ID,CAST(Tuple,end->theOne())->coordinate(1)), this->newWork(FeEdition::on(
								this->newDataEdition(name->integers(), IntegerRegion::make (IntegerVarZero, name->integers()->count()), IntegerSpace::make ()->ascending()))));
	} END_FOR_POSITIONS;
	/* actually create the endorsement token Works */
	iDSpace = IDSpace::unique();
	endorseTokenWorks = this->newEmptyEdition(iDSpace);
	{
		Int32 LoopFinal = myEndorsementFlags->count();
		Int32 i = 5;
		for (;;) {
			if (i >= LoopFinal){
				break;
			}
			{
				SPTR(BeWork) work;
				
				work = this->newWork(emptyDesc);
				/* contents don't matter */
				this->tryIntroduce(CAST(ID,CAST(IDRegion,CAST(CrossRegion,myEndorsementFlags->get(i))->projection(1))->theOne()), work);
				endorseTokenWorks = endorseTokenWorks->with(iDSpace->newID(), this->carrier(work));
			}
			i += 1;
		}
	}
	/* attach & endorse them so they can be found */
	{	FLUID_BIND(InitialReadClub,myAdminClubID) {
			{	FLUID_BIND(InitialEditClub,NULL) {
					SPTR(BeEdition) edition;
					
					edition = this->newEditionWith(Sequence::string("Universal Public"), this->carrier(publicClub))->with(Sequence::string("Fast Tokens"), this->carrier(endorseTokenWorks));
					this->newWork(FeEdition::on(edition));
					edition->endorse(myEndorsementSpace->crossOfRegions(CAST(PtrArray,PrimSpec::pointer()->arrayWithTwo(myEmptyClubID->asRegion(), myEmptyClubID->asRegion()))));
				}
			}
		}
	}
	myGateLockSmithEdition = 
			this->newDataEdition(UInt8Array::string("wall"), IntegerRegion::make (IntegerVarZero, 4), IntegerSpace::make ()->ascending());
	myGrants = this->newEditionWithAll(myGlobalIDSpace->fullRegion(), this->carrier(adminClub));
	InitialOwner.fluidSet((ID * ) NULL);
	InitialSponsor.fluidSet((ID * ) NULL);
	InitialReadClub.fluidSet(myEmptyClubID);
	//InitialEditClub.fluidSet((ID * ) NULL);
	InitialEditClub.fluidSet((ID *) NULL);/*zzz*/
	CurrentAuthor.fluidSet((ID * ) NULL);
	CurrentKeyMaster.fluidSet((FeKeyMaster * ) NULL);
}
/* private: create */


BeGrandMap::BeGrandMap (APTR(Sequence) identifier, TCSJ) {
	BEGIN_CONSISTENT(-1) {
		SPTR(Counter) counter;
		
		this->newShepherd();
		/* newShepherd must be first in GrandMap so that it 
			is the boot object. */
		myPurgeable = FALSE;
		/* The GrandMap cannot be purged until it is 
			explicitly allowed. */
		myEnt = Ent::make ();
		myIdentifier = identifier;
		/* The counters table must be setup before we try to 
			make any IDSpaces */
		myIDCounters = MuTable::make (CrossSpace::make (SequenceSpace::make (), IntegerSpace::make ()));
		counter = Counter::make (1, 20);
		myGlobalIDSpace = 
				IDSpace::make (NULL, -1, counter);
		myIDCounters->introduce(Tuple::two(Sequence::zero(), IntegerPos::make (-1)), counter);
		myLocalIDSpaceCounter = Counter::make (1, 256);
		myGlobalIDFilterSpace = FilterSpace::make ((CoordinateSpace*)myGlobalIDSpace);
		myEndorsementSpace = CrossSpace::make (CAST(PtrArray,PrimSpec::pointer()->arrayWithTwo(myGlobalIDSpace, myGlobalIDSpace)));
		myEndorsementFilterSpace = FilterSpace::make ((CoordinateSpace*)myEndorsementSpace);/*zzz*/
		//myEndorsementFilterSpace = FilterSpace::make ((CoordinateSpace*)myEndorsementSpace);/*zzz*/
		myRangeElements = GrandHashTable::make (myGlobalIDSpace);
		myIDHolders = GrandHashTable::make (myGlobalIDSpace);
		myRangeElementIDs = GrandHashTable::make (HeaperSpace::make ());
		/* Hack !!!! */
		
		/* how does this connect */
		{	FLUID_BIND(CurrentGrandMap,this) {
				this->coldBoot();
			}
		}
		this->remember();
	} END_CONSISTENT;
	{	FLUID_BIND(CurrentGrandMap,this) {
			this->clubConsistencyCheck();
		}
	}
	myPurgeable = FALSE;
	myAcceptingConnectionsFlag = TRUE;
}
/* hooks: */


void BeGrandMap::restartBeGrandMap (APTR(Rcvr) /* rcvr */){
	myPurgeable = FALSE;
	myAcceptingConnectionsFlag = TRUE;
	CanopyCrum::useEndorsementFlags(myEndorsementFlags);
}
/* purging */


void BeGrandMap::bePurgeable (){
	/* Allow the GrandMap to be purged.  The GrandMap should NOT 
	be used after this is called. */
	
	myPurgeable = TRUE;
}


BooleanVar BeGrandMap::isPurgeable (){
	/* The Grandmap never gets purged unless explicitly allowed 
	by calling bePurgeable. */
	
	return myPurgeable;
}
/* testing */


UInt32 BeGrandMap::contentsHash (){
	return this->Abraham::contentsHash() ^ myIdentifier->hashForEqual() ^ myLocalIDSpaceCounter->hashForEqual() ^ myEnt->hashForEqual() ^ myEmptyClubID->hashForEqual() ^ myPublicClubID->hashForEqual() ^ myAdminClubID->hashForEqual();
}
/* accessing */


void BeGrandMap::acceptConnections (BooleanVar open){
	/* See FeAdminer */
	
	myAcceptingConnectionsFlag = open;
}


RPTR(ID) BeGrandMap::assignID (APTR(BeRangeElement) value){
	/* Remember the two way association between value and its new ID. */
	
	SPTR(ID) iD;
	
	/* Known bug !!!! */
	
	/* what if the ID has already been assigned by the grantee? */
	iD = this->newID();
	if (!this->tryIntroduce(iD, value)) {
		BLAST(IDAlreadyUsed);
	}
	WPTR(ID) 	returnValue;
	returnValue = iD;
	return returnValue;
}


BooleanVar BeGrandMap::tryIntroduce (APTR(ID) iD, APTR(BeRangeElement) value){
	/* Remember the two way association between value and the 
	supplied ID. */
	
	if (myRangeElements->includesKey(iD)) {
		return FALSE;
	}
	/* Hack !!!! */
	
	/* The number below comes frojm my memory of how big a 
		GrandMap assign can be. */
	BEGIN_CONSISTENT(6) {
		SPTR(HeaperAsPosition) hap;
		SPTR(IDRegion) OR(NULL) already;
		
		/* Thing to do !!!! */
		
		/* Decide about multiple IDs */
		hap = HeaperAsPosition::make (value);
		already = CAST(IDRegion,myRangeElementIDs->fetch(hap));
		if (already == NULL) {
			myRangeElementIDs->introduce(hap, iD->asRegion());
		} else {
			if (value->isKindOf(cat_BeClub)) {
				BLAST(ClubMustHaveUniqueID);
			}
			myRangeElementIDs->replace(hap, already->with(iD));
		}
		myRangeElements->introduce(iD, value);
	} END_CONSISTENT;
	return TRUE;
}


