/* ************************************************************************ *
 * 
 *                    Class GrantStepper 
 *
 * ************************************************************************ */


/* create */


RPTR(TableStepper) GrantStepper::make (APTR(BeEdition) grants, APTR(IDRegion) OR(NULL) clubIDs){
	RETURN_CONSTRUCT(GrantStepper,(grants->retrieve(), clubIDs));
}
/* Has a Bundle Stepper on a piece of the Edition defining the grants 
for this Server, and views it as a sequence of associations from 
ClubIDs to IDRegions (which is the inverse of its actual format) */


/* special */


RPTR(Position) GrantStepper::position (){
	/* Ravi -- Thing to do !!!! */
	
	/* in future implementations this might also get back an ArrayBundle */
	WPTR(Position) 	returnValue;
	returnValue = CurrentGrandMap.fluidGet()->iDOf(CAST(FeElementBundle,myBundles->get())->element()->getOrMakeBe());
	return returnValue;
}
/* operations */


WPTR(Heaper) GrantStepper::fetch (){
	SPTR(FeBundle) bundle;
	
	bundle = CAST(FeBundle,myBundles->fetch());
	if (bundle == NULL) {
		return NULL;
	}
	WPTR(Heaper) 	returnValue;
	returnValue = bundle->region();
	return returnValue;
}


BooleanVar GrantStepper::hasValue (){
	return myBundles->hasValue();
}


void GrantStepper::step (){
	while (myBundles->hasValue()) {
		myBundles->step();
		{	BooleanVar crutch_Flag;
			/* myClubIDs == NULL || myClubIDs->hasMember(this->position()) */
			
			crutch_Flag = myClubIDs == NULL;
			if(!crutch_Flag) {
				crutch_Flag = myClubIDs->hasMember(this->position());
			}
			if (crutch_Flag) {
				return;
				
			}
		}
	}
}
/* create */


RPTR(Stepper) GrantStepper::copy (){
	RETURN_CONSTRUCT(GrantStepper,(myBundles->copy(), myClubIDs));
}


GrantStepper::GrantStepper (APTR(Stepper) OF1(FeBundle) bundles, APTR(IDRegion) OR(NULL) clubIDs) {
	myBundles = bundles;
	myClubIDs = clubIDs;
}

