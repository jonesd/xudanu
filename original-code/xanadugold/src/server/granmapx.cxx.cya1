}


RPTR(FeRangeElement) BeGrandMap::getFe (APTR(ID) iD){
	/* Get what is at the the given ID as a front end object; 
	blast if there is nothing there */
	
	/* Known bug !!!! */
	
	/* This doesn't supply a label for Editions. */
	WPTR(FeRangeElement) 	returnValue;
	returnValue = this->get(iD)->makeFe(NULL);
	return returnValue;
}


RPTR(Counter) BeGrandMap::getOrMakeIDCounter (APTR(Sequence) OR(NULL) backend, IntegerVar number){
	/* Get a canonical Counter for an IDSpace, or make a new one */
	
	SPTR(Counter) result;
	SPTR(Sequence) theBackend;
	
	if (backend != NULL) {
		theBackend = backend;
	} else {
		if (number < IntegerVarZero) {
			theBackend = Sequence::zero();
		} else {
			theBackend = this->identifier();
		}
	}
	result = CAST(Counter,myIDCounters->fetch(Tuple::two(theBackend, IntegerPos::make (number))));
	if (result == NULL) {
		/* Thing to do !!!! */
		
		/* figure out good batching */
		result = Counter::make (1, 20);
		myIDCounters->introduce(Tuple::two(theBackend, IntegerPos::make (number)), result);
	}
	WPTR(Counter) 	returnValue;
	returnValue = result;
	return returnValue;
}


RPTR(BeIDHolder) BeGrandMap::getOrMakeIDHolder (APTR(ID) iD){
	/* If there is already an IDHolder for the ID then return it, 
	otherwise make one */
	
	SPTR(BeIDHolder) result;
	
	result = CAST(BeIDHolder,myIDHolders->fetch(iD));
	/* Make one and remember it for canonicalization */
	if (result == NULL) {
		BEGIN_CONSISTENT(666) {
			result = BeIDHolder::make (iD);
			myIDHolders->introduce(iD, result);
		} END_CONSISTENT;
	}
	WPTR(BeIDHolder) 	returnValue;
	returnValue = result;
	return returnValue;
}


RPTR(FilterSpace) BeGrandMap::globalIDFilterSpace (){
	/* The FilterSpace on global IDSpace */
	
	return (FilterSpace*) myGlobalIDFilterSpace;
}


RPTR(IDSpace) BeGrandMap::globalIDSpace (){
	/* The global IDSpace */
	
	return (IDSpace*) myGlobalIDSpace;
}


void BeGrandMap::grant (APTR(ID) clubID, APTR(IDRegion) globalIDs){
	/* See FeAdminer */
	
	SPTR(BeEdition) newGrants;
	
	newGrants = myGrants->replace(this->newEditionWithAll(globalIDs, this->carrier(this->getClub(clubID))));
	BEGIN_CONSISTENT(1) {
		myGrants = newGrants;
		this->diskUpdate();
	} END_CONSISTENT;
}


RPTR(ID) BeGrandMap::grantAt (APTR(ID) iD){
	/* Who has been granted authority to assign that ID */
	
	WPTR(ID) 	returnValue;
	returnValue = this->iDOf(myGrants->get(iD)->getOrMakeBe());
	return returnValue;
}


RPTR(TableStepper) OF2(ID,IDRegion) BeGrandMap::grants (APTR(IDRegion) OR(NULL) clubIDs, APTR(IDRegion) OR(NULL) globalIDs){
	/* See FeAdminer */
	
	SPTR(BeEdition) theEdition;
	
	if (globalIDs == NULL) {
		theEdition = myGrants;
	} else {
		theEdition = myGrants->copy(globalIDs);
	}
	WPTR(TableStepper) OF2(ID,IDRegion) 	returnValue;
	returnValue = GrantStepper::make (theEdition, clubIDs);
	return returnValue;
}


RPTR(Sequence) BeGrandMap::identifier (){
	return (Sequence*) myIdentifier;
}


RPTR(ID) BeGrandMap::iDOf (APTR(BeRangeElement) value){
	/* Find the ID of a BeRangeElement. Blast if there is no ID 
	or if there is more than one */
	
	SPTR(IDRegion) OR(NULL) result;
	
	result = CAST(IDRegion,myRangeElementIDs->fetch(HeaperAsPosition::make (value)));
	if (result == NULL) {
		BLAST(DoesNotHaveAnID);
	}
	if (!(result->count() == 1)) {
		BLAST(HasMultipleIDs);
	}
	return CAST(ID,result->theOne());
}


RPTR(IDRegion) BeGrandMap::iDsOf (APTR(BeRangeElement) value){
	/* Find the IDs of a BeRangeElement, whether there are none, 
	one, or several */
	
	SPTR(IDRegion) OR(NULL) result;
	
	result = CAST(IDRegion,myRangeElementIDs->fetch(HeaperAsPosition::make (value)));
	if (result == NULL) {
		return CAST(IDRegion,myGlobalIDSpace->emptyRegion());
	}
	WPTR(IDRegion) 	returnValue;
	returnValue = result;
	return returnValue;
}


BooleanVar BeGrandMap::isAcceptingConnections (){
	/* See FeAdminer */
	
	return myAcceptingConnectionsFlag;
}


RPTR(ID) BeGrandMap::newID (){
	WPTR(ID) 	returnValue;
	returnValue = myGlobalIDSpace->newID();
	return returnValue;
}


RPTR(IDSpace) BeGrandMap::newIDSpace (){
	/* Make a new globally unique IDSpace */
	
	WPTR(IDSpace) 	returnValue;
	returnValue = IDSpace::make (this->identifier(), myLocalIDSpaceCounter->increment());
	return returnValue;
}


RPTR(ID) BeGrandMap::placeOwnerID (APTR(ID) iD){
	/* The ID of the Club which owns whatever is at the given ID */
	
	SPTR(BeRangeElement) value;
	
	value = this->fetch(iD);
	if (value != NULL) {
		WPTR(ID) 	returnValue;
		returnValue = value->owner();
		return returnValue;
	}
	/* Figure out who owns PlaceHolders */
	BLAST(NOT_YET_IMPLEMENTED);
	/* fodder */
	return NULL;
}


void BeGrandMap::setGateLockSmithEdition (APTR(FeEdition) edition){
	if (!FeLockSmith::spec()->certify(edition)) {
		BLAST(MustBeValidLockSmith);
	}
	myGateLockSmithEdition = edition->beEdition();
}


RPTR(ScruTable) OF2(Sequence,CrossRegion) BeGrandMap::wrapperEndorsements (){
