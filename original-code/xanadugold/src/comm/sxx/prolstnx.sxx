/*----------------------- BEGIN IPPromiseListener -----------------------*/
DEFINE_CLASS_CATEGORY(IPPromiseListener,FDListener)
DEFINE_OPAQUE_TYPE(IPPromiseListener);

void IPPromiseListener::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of IPPromiseListener ====== */

void IPPromiseListener::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->FDListener::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((IPPromiseListener*)origin)->myManager,
				       (Heaper**)&myManager);
		Heaplet::forwardToOld ((Heaper**)&((IPPromiseListener*)origin)->mySession,
				       (Heaper**)&mySession);
		Heaplet::forwardToOld ((Heaper**)&((IPPromiseListener*)origin)->myPortal,
				       (Heaper**)&myPortal);
	} else {
		myManager.forwardTo (Heaplet::forward (myManager));
		mySession.forwardTo (Heaplet::forward (mySession));
		myPortal.forwardTo (Heaplet::forward (myPortal));
	}
}

/*----------------------- END IPPromiseListener -----------------------*/

