#define NSCOTTYP_SXX

/*----------------------- BEGIN ReadArrayStream -----------------------*/
DEFINE_CLASS_CATEGORY(ReadArrayStream,XnReadStream)

void ReadArrayStream::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar ReadArrayStream::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 ReadArrayStream::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of ReadArrayStream ====== */

void ReadArrayStream::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ReadArrayStream*)origin)->myBuffer,
				       (Heaper**)&myBuffer);
	} else {
		myBuffer.forwardTo (Heaplet::forward (myBuffer));
	}
}

/*----------------------- END ReadArrayStream -----------------------*/


