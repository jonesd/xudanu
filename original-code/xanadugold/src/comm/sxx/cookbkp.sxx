#define COOKBKP_SXX

/*----------------------- BEGIN ActualCookbook -----------------------*/
DEFINE_CLASS_CATEGORY(ActualCookbook,Cookbook)

void ActualCookbook::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of ActualCookbook ====== */

void ActualCookbook::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ActualCookbook*)origin)->myNext,
				       (Heaper**)&myNext);
		Heaplet::forwardToOld ((Heaper**)&((ActualCookbook*)origin)->myRecipes,
				       (Heaper**)&myRecipes);
		Heaplet::forwardToOld ((Heaper**)&((ActualCookbook*)origin)->myDecoding,
				       (Heaper**)&myDecoding);
		Heaplet::forwardToOld ((Heaper**)&((ActualCookbook*)origin)->myEncoding,
				       (Heaper**)&myEncoding);
	} else {
		myNext.forwardTo (Heaplet::forward (myNext));
		myRecipes.forwardTo (Heaplet::forward (myRecipes));
		myDecoding.forwardTo (Heaplet::forward (myDecoding));
		myEncoding.forwardTo (Heaplet::forward (myEncoding));
	}
}

/*----------------------- END ActualCookbook -----------------------*/

