#define SCHUNKX_SXX

/*----------------------- BEGIN ChunkCleaner -----------------------*/
DEFINE_CLASS_CATEGORY(ChunkCleaner,Heaper)
DEFINE_OPAQUE_TYPE(ChunkCleaner);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar ChunkCleaner::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 ChunkCleaner::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of ChunkCleaner ====== */

void ChunkCleaner::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ChunkCleaner*)origin)->myNext,
				       (Heaper**)&myNext);
	} else {
		myNext.forwardTo (Heaplet::forward (myNext));
	}
}

/*----------------------- END ChunkCleaner -----------------------*/


