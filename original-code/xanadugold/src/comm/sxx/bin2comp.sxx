#define BIN2COMP_SXX

/*----------------------- BEGIN Binary2Rcvr -----------------------*/
DEFINE_CLASS_CATEGORY(Binary2Rcvr,SpecialistRcvr)

void Binary2Rcvr::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of Binary2Rcvr ====== */

void Binary2Rcvr::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->SpecialistRcvr::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Binary2Rcvr*)origin)->myStream,
				       (Heaper**)&myStream);
	} else {
		myStream.forwardTo (Heaplet::forward (myStream));
	}
}

/*----------------------- END Binary2Rcvr -----------------------*/


