/* ====== Object Migrator for Scavenging of Binary2Xmtr ====== */

void Binary2Xmtr::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->SpecialistXmtr::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((Binary2Xmtr*)origin)->myStream,
				       (Heaper**)&myStream);
	} else {
