void ClearPlan::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myCategory);
}

ClearPlan::ClearPlan (APTR(Rcvr) receiver, TCSJ)
{
    myCategory = CAST(Category, receiver->receiveHeaper());
}


void parseInto_ClearPlan (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) ClearPlan (rcvr, tcsj);
}

extern Recipe * BootCuisine;
ActualCopyRecipe ClearPlan_recipe(cat_ClearPlan, &BootCuisine, parseInto_ClearPlan);


