/*----------------------- BEGIN DirectConnection -----------------------*/
DEFINE_CLASS_CATEGORY(DirectConnection,Connection)

void DirectConnection::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of DirectConnection ====== */

void DirectConnection::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((DirectConnection*)origin)->myHeaper,
				       (Heaper**)&myHeaper);
	} else {
		myHeaper.forwardTo (Heaplet::forward (myHeaper));
	}
}

/*----------------------- END DirectConnection -----------------------*/

