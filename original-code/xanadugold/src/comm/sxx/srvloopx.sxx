/*----------------------- BEGIN ServerLoop -----------------------*/
DEFINE_CLASS_CATEGORY(ServerLoop,Thunk)
DEFINE_OPAQUE_TYPE(ServerLoop);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "ServerLoop" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void ServerLoop::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendHeaper(myCategory);
}

ServerLoop::ServerLoop (APTR(Rcvr) receiver, TCSJ)
{
    myCategory = CAST(Category, receiver->receiveHeaper());
    this->restartServerLoop(receiver);
}


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of ServerLoop ====== */

void ServerLoop::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ServerLoop*)origin)->myActiveChunks,
				       (Heaper**)&myActiveChunks);
		Heaplet::forwardToOld ((Heaper**)&((ServerLoop*)origin)->myStepper,
				       (Heaper**)&myStepper);
	} else {
		myActiveChunks.forwardTo (Heaplet::forward (myActiveChunks));
		myStepper.forwardTo (Heaplet::forward (myStepper));
	}
}

/*----------------------- END ServerLoop -----------------------*/

