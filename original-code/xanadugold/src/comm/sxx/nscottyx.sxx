/*----------------------- BEGIN WriteVariableArrayStream -----------------------*/
DEFINE_CLASS_CATEGORY(WriteVariableArrayStream,XnWriteStream)
DEFINE_OPAQUE_TYPE(WriteVariableArrayStream);

void WriteVariableArrayStream::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar WriteVariableArrayStream::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 WriteVariableArrayStream::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of WriteVariableArrayStream ====== */

void WriteVariableArrayStream::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((WriteVariableArrayStream*)origin)->myCollection,
				       (Heaper**)&myCollection);
	} else {
		myCollection.forwardTo (Heaplet::forward (myCollection));
	}
}

/*----------------------- END WriteVariableArrayStream -----------------------*/

