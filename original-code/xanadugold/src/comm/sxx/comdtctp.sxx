/*----------------------- BEGIN DoneEvent -----------------------*/
DEFINE_CLASS_CATEGORY(DoneEvent,DetectorEvent)

void DoneEvent::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */



/*----------------------- END DoneEvent -----------------------*/


/*----------------------- BEGIN FilledEvent -----------------------*/
DEFINE_CLASS_CATEGORY(FilledEvent,DetectorEvent)

void FilledEvent::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of FilledEvent ====== */

void FilledEvent::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->DetectorEvent::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FilledEvent*)origin)->myFilling,
				       (Heaper**)&myFilling);
	} else {
		myFilling.forwardTo (Heaplet::forward (myFilling));
	}
}

/*----------------------- END FilledEvent -----------------------*/


/*----------------------- BEGIN GrabbedEvent -----------------------*/
DEFINE_CLASS_CATEGORY(GrabbedEvent,DetectorEvent)

void GrabbedEvent::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of GrabbedEvent ====== */

void GrabbedEvent::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->DetectorEvent::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((GrabbedEvent*)origin)->myWork,
				       (Heaper**)&myWork);
		Heaplet::forwardToOld ((Heaper**)&((GrabbedEvent*)origin)->myAuthor,
				       (Heaper**)&myAuthor);
	} else {
		myWork.forwardTo (Heaplet::forward (myWork));
		myAuthor.forwardTo (Heaplet::forward (myAuthor));
	}
}

/*----------------------- END GrabbedEvent -----------------------*/


