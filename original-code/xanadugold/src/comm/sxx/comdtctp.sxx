/*----------------------- BEGIN RevisedEvent -----------------------*/
DEFINE_CLASS_CATEGORY(RevisedEvent,DetectorEvent)

void RevisedEvent::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of RevisedEvent ====== */

void RevisedEvent::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->DetectorEvent::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((RevisedEvent*)origin)->myWork,
				       (Heaper**)&myWork);
		Heaplet::forwardToOld ((Heaper**)&((RevisedEvent*)origin)->myContents,
				       (Heaper**)&myContents);
		Heaplet::forwardToOld ((Heaper**)&((RevisedEvent*)origin)->myAuthor,
				       (Heaper**)&myAuthor);
	} else {
		myWork.forwardTo (Heaplet::forward (myWork));
		myContents.forwardTo (Heaplet::forward (myContents));
		myAuthor.forwardTo (Heaplet::forward (myAuthor));
	}
}

/*----------------------- END RevisedEvent -----------------------*/

