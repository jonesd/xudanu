/*----------------------- BEGIN PromiseManager -----------------------*/
DEFINE_CLASS_CATEGORY(PromiseManager,Heaper)
DEFINE_OPAQUE_TYPE(PromiseManager);

void PromiseManager::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of PromiseManager ====== */

void PromiseManager::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((PromiseManager*)origin)->myPortal,
				       (Heaper**)&myPortal);
		Heaplet::forwardToOld ((Heaper**)&((PromiseManager*)origin)->myReadStream,
				       (Heaper**)&myReadStream);
		Heaplet::forwardToOld ((Heaper**)&((PromiseManager*)origin)->myWriteStream,
				       (Heaper**)&myWriteStream);
		Heaplet::forwardToOld ((Heaper**)&((PromiseManager*)origin)->myActuals,
				       (Heaper**)&myActuals);
		Heaplet::forwardToOld ((Heaper**)&((PromiseManager*)origin)->myRefCounts,
				       (Heaper**)&myRefCounts);
		Heaplet::forwardToOld ((Heaper**)&((PromiseManager*)origin)->myDetectorEvents,
				       (Heaper**)&myDetectorEvents);
		Heaplet::forwardToOld ((Heaper**)&((PromiseManager*)origin)->myHandlers,
				       (Heaper**)&myHandlers);
		Heaplet::forwardToOld ((Heaper**)&((PromiseManager*)origin)->myError,
				       (Heaper**)&myError);
		Heaplet::forwardToOld ((Heaper**)&((PromiseManager*)origin)->myShuffler,
				       (Heaper**)&myShuffler);
	} else {
		myPortal.forwardTo (Heaplet::forward (myPortal));
		myReadStream.forwardTo (Heaplet::forward (myReadStream));
		myWriteStream.forwardTo (Heaplet::forward (myWriteStream));
		myActuals.forwardTo (Heaplet::forward (myActuals));
		myRefCounts.forwardTo (Heaplet::forward (myRefCounts));
		myDetectorEvents.forwardTo (Heaplet::forward (myDetectorEvents));
		myHandlers.forwardTo (Heaplet::forward (myHandlers));
		myError.forwardTo (Heaplet::forward (myError));
		myShuffler.forwardTo (Heaplet::forward (myShuffler));
	}
}

/*----------------------- END PromiseManager -----------------------*/

