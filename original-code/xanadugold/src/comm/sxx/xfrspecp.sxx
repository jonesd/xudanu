/* ====== Copy Class "CommIbid" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void CommIbid::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendIntegerVar(myNumber);
}

CommIbid::CommIbid (APTR(Rcvr) receiver, TCSJ)
{
    myNumber = receiver->receiveIntegerVar();
}


void parseInto_CommIbid (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) CommIbid (rcvr, tcsj);
}

extern Recipe * XppCuisine;
ActualCopyRecipe CommIbid_recipe(cat_CommIbid, &XppCuisine, parseInto_CommIbid);


/* #endif */ /* WITH_RPC */




/*----------------------- END CommIbid -----------------------*/


