/*----------------------- BEGIN IPRendezvousListener -----------------------*/
DEFINE_CLASS_CATEGORY(IPRendezvousListener,FDListener)

void IPRendezvousListener::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "IPRendezvousListener" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void IPRendezvousListener::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendUInt32(myAddress);
}

IPRendezvousListener::IPRendezvousListener (APTR(Rcvr) receiver, TCSJ)
{
    myAddress = receiver->receiveUInt32();
    this->restartIPRendezvous(receiver);
}


void parseInto_IPRendezvousListener (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) IPRendezvousListener (rcvr, tcsj);
}

extern Recipe * BootCuisine;
ActualCopyRecipe IPRendezvousListener_recipe(cat_IPRendezvousListener, &BootCuisine, parseInto_IPRendezvousListener);


/* #endif */ /* WITH_RPC */




/*----------------------- END IPRendezvousListener -----------------------*/


