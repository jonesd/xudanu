/*----------------------- BEGIN ExecutePromiseFile -----------------------*/
DEFINE_CLASS_CATEGORY(ExecutePromiseFile,ServerChunk)
DEFINE_OPAQUE_TYPE(ExecutePromiseFile);

void ExecutePromiseFile::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "ExecutePromiseFile" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void ExecutePromiseFile::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendString(myReadName);
    xmtr->sendString(myWriteName);
}

ExecutePromiseFile::ExecutePromiseFile (APTR(Rcvr) receiver, TCSJ)
{
    myReadName = receiver->receiveString();
    myWriteName = receiver->receiveString();
    this->restartPromises(receiver);
}


void parseInto_ExecutePromiseFile (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) ExecutePromiseFile (rcvr, tcsj);
}

extern Recipe * BootCuisine;
ActualCopyRecipe ExecutePromiseFile_recipe(cat_ExecutePromiseFile, &BootCuisine, parseInto_ExecutePromiseFile);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of ExecutePromiseFile ====== */

void ExecutePromiseFile::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->ServerChunk::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ExecutePromiseFile*)origin)->myManager,
				       (Heaper**)&myManager);
		Heaplet::forwardToOld ((Heaper**)&((ExecutePromiseFile*)origin)->myConnection,
				       (Heaper**)&myConnection);
	} else {
		myManager.forwardTo (Heaplet::forward (myManager));
		myConnection.forwardTo (Heaplet::forward (myConnection));
	}
}

/*----------------------- END ExecutePromiseFile -----------------------*/

