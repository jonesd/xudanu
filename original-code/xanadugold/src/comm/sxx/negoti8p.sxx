/*----------------------- BEGIN ProtocolItem -----------------------*/
DEFINE_CLASS_CATEGORY(ProtocolItem,Heaper)
DEFINE_OPAQUE_TYPE(ProtocolItem);

void ProtocolItem::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of ProtocolItem ====== */

void ProtocolItem::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ProtocolItem*)origin)->myNext,
				       (Heaper**)&myNext);
		Heaplet::forwardToOld ((Heaper**)&((ProtocolItem*)origin)->myItem,
				       (Heaper**)&myItem);
	} else {
		myNext.forwardTo (Heaplet::forward (myNext));
		myItem.forwardTo (Heaplet::forward (myItem));
	}
}

/*----------------------- END ProtocolItem -----------------------*/


/*----------------------- BEGIN SetCommProtocol -----------------------*/
DEFINE_CLASS_CATEGORY(SetCommProtocol,Thunk)

void SetCommProtocol::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "SetCommProtocol" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void SetCommProtocol::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendString(myName);
}

SetCommProtocol::SetCommProtocol (APTR(Rcvr) receiver, TCSJ)
{
    myName = receiver->receiveString();
}


void parseInto_SetCommProtocol (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) SetCommProtocol (rcvr, tcsj);
}

extern Recipe * BootCuisine;
ActualCopyRecipe SetCommProtocol_recipe(cat_SetCommProtocol, &BootCuisine, parseInto_SetCommProtocol);


/* #endif */ /* WITH_RPC */


/* ====== Object Migrator for Scavenging of SetCommProtocol ====== */

void SetCommProtocol::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
	} else {
	}
}

/*----------------------- END SetCommProtocol -----------------------*/


