/*----------------------- BEGIN FePromiseSession -----------------------*/
DEFINE_CLASS_CATEGORY(FePromiseSession,FeSession)
DEFINE_OPAQUE_TYPE(FePromiseSession);

void FePromiseSession::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of FePromiseSession ====== */

void FePromiseSession::
migrate (void * origin, BooleanVar destinationIsOld) {
	this->FeSession::migrate(origin, destinationIsOld);
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((FePromiseSession*)origin)->myPort,
				       (Heaper**)&myPort);
		Heaplet::forwardToOld ((Heaper**)&((FePromiseSession*)origin)->myManager,
				       (Heaper**)&myManager);
		Heaplet::forwardToOld ((Heaper**)&((FePromiseSession*)origin)->myListener,
				       (Heaper**)&myListener);
		Heaplet::forwardToOld ((Heaper**)&((FePromiseSession*)origin)->myNext,
				       (Heaper**)&myNext);
	} else {
		myPort.forwardTo (Heaplet::forward (myPort));
		myManager.forwardTo (Heaplet::forward (myManager));
		myListener.forwardTo (Heaplet::forward (myListener));
		myNext.forwardTo (Heaplet::forward (myNext));
	}
}

/*----------------------- END FePromiseSession -----------------------*/

