#define COMDTCTR_SXX

/*----------------------- BEGIN CommFillDetector -----------------------*/
DEFINE_CLASS_CATEGORY(CommFillDetector,FeFillDetector)
DEFINE_OPAQUE_TYPE(CommFillDetector);

void CommFillDetector::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of CommFillDetector ====== */

void CommFillDetector::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((CommFillDetector*)origin)->myManager,
				       (Heaper**)&myManager);
		Heaplet::forwardToOld ((Heaper**)&((CommFillDetector*)origin)->myTarget,
				       (Heaper**)&myTarget);
	} else {
		myManager.forwardTo (Heaplet::forward (myManager));
		myTarget.forwardTo (Heaplet::forward (myTarget));
	}
}

/*----------------------- END CommFillDetector -----------------------*/


