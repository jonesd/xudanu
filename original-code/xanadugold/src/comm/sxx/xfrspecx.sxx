}

/*----------------------- END SpecialistXmtr -----------------------*/


/*----------------------- BEGIN TransferSpecialist -----------------------*/
DEFINE_CLASS_CATEGORY(TransferSpecialist,Heaper)
DEFINE_OPAQUE_TYPE(TransferSpecialist);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar TransferSpecialist::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 TransferSpecialist::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of TransferSpecialist ====== */

void TransferSpecialist::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((TransferSpecialist*)origin)->myCookbook,
				       (Heaper**)&myCookbook);
	} else {
		myCookbook.forwardTo (Heaplet::forward (myCookbook));
	}
}

/*----------------------- END TransferSpecialist -----------------------*/


