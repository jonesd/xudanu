#define XFRSPECX_SXX

/*----------------------- BEGIN SpecialistRcvr -----------------------*/
DEFINE_CLASS_CATEGORY(SpecialistRcvr,Rcvr)
DEFINE_OPAQUE_TYPE(SpecialistRcvr);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of SpecialistRcvr ====== */

void SpecialistRcvr::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((SpecialistRcvr*)origin)->mySpecialist,
				       (Heaper**)&mySpecialist);
		Heaplet::forwardToOld ((Heaper**)&((SpecialistRcvr*)origin)->myIbids,
				       (Heaper**)&myIbids);
	} else {
		mySpecialist.forwardTo (Heaplet::forward (mySpecialist));
		myIbids.forwardTo (Heaplet::forward (myIbids));
	}
}

/*----------------------- END SpecialistRcvr -----------------------*/


