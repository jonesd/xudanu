#define PORTALR_SXX

/*----------------------- BEGIN PacketPortal -----------------------*/
DEFINE_CLASS_CATEGORY(PacketPortal,Portal)
DEFINE_OPAQUE_TYPE(PacketPortal);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of PacketPortal ====== */

void PacketPortal::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((PacketPortal*)origin)->myReadStream,
				       (Heaper**)&myReadStream);
		Heaplet::forwardToOld ((Heaper**)&((PacketPortal*)origin)->myWriteStream,
				       (Heaper**)&myWriteStream);
	} else {
		myReadStream.forwardTo (Heaplet::forward (myReadStream));
		myWriteStream.forwardTo (Heaplet::forward (myWriteStream));
	}
}

/*----------------------- END PacketPortal -----------------------*/


/*----------------------- BEGIN PairPortal -----------------------*/
