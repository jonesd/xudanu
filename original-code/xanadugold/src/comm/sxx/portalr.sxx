}

/*----------------------- END PairPortal -----------------------*/


/*----------------------- BEGIN XnBufferedReadStream -----------------------*/
DEFINE_CLASS_CATEGORY(XnBufferedReadStream,XnReadStream)

void XnBufferedReadStream::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar XnBufferedReadStream::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 XnBufferedReadStream::actualHashForEqual ()
{
    return Heaper::takeOop ();
}

/* ====== Object Migrator for Scavenging of XnBufferedReadStream ====== */

void XnBufferedReadStream::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((XnBufferedReadStream*)origin)->myPortal,
				       (Heaper**)&myPortal);
		Heaplet::forwardToOld ((Heaper**)&((XnBufferedReadStream*)origin)->myBuffer,
				       (Heaper**)&myBuffer);
	} else {
		myPortal.forwardTo (Heaplet::forward (myPortal));
		myBuffer.forwardTo (Heaplet::forward (myBuffer));
	}
}

/*----------------------- END XnBufferedReadStream -----------------------*/

