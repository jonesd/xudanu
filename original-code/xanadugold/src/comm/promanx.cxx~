void PromiseManager::flushAcks (){
	/* If any acks have accumulated, flush them. */
	
	if (myAcks > IntegerVarZero) {
		this->sendResponse(PromiseManager::ackResponse());
		this->sendIntegerVar(myAcks);
		myAcks = IntegerVarZero;
	}
}


