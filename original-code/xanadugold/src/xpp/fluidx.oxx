#ifndef FLUIDX_OXX
#define FLUIDX_OXX

class FluidVarDescription;
extern class Category * cat_FluidVarDescription;
class Emulsion;
extern class Category * cat_Emulsion;

#ifndef FLUIDX_HXX
/* I know this looks weird, but the smalltalk translator puts includes of
   fluidx.oxx into the hxx files of modules that export fluid variables.
   Michael and I settled on this method of narrowing the dependencies on
   fluidx.hxx down from all users of tofu, without introducing fluid as
   a special case for the translator to include an hxx instead of an oxx.
	- ech 3-11-92
*/
#include "fluidx.hxx"
#endif /* FLUIDX_HXX */

VERSION_ID(fluidx_oxx,
	"$Id: fluidx.oxx,v 2.5 1992/08/14 22:08:08 shap Exp $")


#endif /* FLUIDX_OXX */
