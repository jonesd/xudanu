/*----------------------- BEGIN TConsCell -----------------------*/
DEFINE_CLASS_CATEGORY(TConsCell,Heaper)
DEFINE_OPAQUE_TYPE(TConsCell);

void TConsCell::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of TConsCell ====== */

void TConsCell::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((TConsCell*)origin)->myCar,
				       (Heaper**)&myCar);
		Heaplet::forwardToOld ((Heaper**)&((TConsCell*)origin)->myCdr,
				       (Heaper**)&myCdr);
	} else {
		myCar.forwardTo (Heaplet::forward (myCar));
		myCdr.forwardTo (Heaplet::forward (myCdr));
	}
}

/*----------------------- END TConsCell -----------------------*/


