DEFINE_CLASS_CATEGORY(XnExecutor,Heaper)
DEFINE_OPAQUE_TYPE(XnExecutor);

void XnExecutor::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar XnExecutor::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 XnExecutor::actualHashForEqual ()
{
    return Heaper::takeOop ();
}



