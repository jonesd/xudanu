DEFINE_CLASS_CATEGORY(GCMaxInterval,Thunk)

void GCMaxInterval::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "GCMaxInterval" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void GCMaxInterval::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendInt32(interval);
}

GCMaxInterval::GCMaxInterval (APTR(Rcvr) receiver, TCSJ)
{
    interval = receiver->receiveInt32();
}


void parseInto_GCMaxInterval (APTR(Rcvr) rcvr, OUT void * storage) {
  new (storage) GCMaxInterval (rcvr, tcsj);
}

extern Recipe * BootCuisine;
ActualCopyRecipe GCMaxInterval_recipe(cat_GCMaxInterval, &BootCuisine, parseInto_GCMaxInterval);


/* #endif */ /* WITH_RPC */




/*----------------------- END GCMaxInterval -----------------------*/


