/*----------------------- BEGIN ConsCell -----------------------*/
DEFINE_CLASS_CATEGORY(ConsCell,Heaper)
DEFINE_OPAQUE_TYPE(ConsCell);

void ConsCell::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of ConsCell ====== */

void ConsCell::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((ConsCell*)origin)->myCar,
				       (Heaper**)&myCar);
		Heaplet::forwardToOld ((Heaper**)&((ConsCell*)origin)->myCdr,
				       (Heaper**)&myCdr);
	} else {
		myCar.forwardTo (Heaplet::forward (myCar));
		myCdr.forwardTo (Heaplet::forward (myCdr));
	}
}

/*----------------------- END ConsCell -----------------------*/


