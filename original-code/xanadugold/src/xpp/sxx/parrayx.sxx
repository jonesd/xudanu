/*----------------------- BEGIN PrimArray -----------------------*/
DEFINE_CLASS_CATEGORY(PrimArray,Heaper)
DEFINE_OPAQUE_TYPE(PrimArray);
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Copy Class "PrimArray" ======= */


/* #ifdef WITH_RPC */

#ifndef COPYRCPX_HXX
#include "copyrcpx.hxx"
#define COPYRCPX_HXX
#endif /* COPYRCPX_HXX */

#ifndef NXCVRX_HXX
#include "nxcvrx.hxx"
#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void PrimArray::sendSelfTo (APTR(Xmtr) xmtr)
{
    xmtr->sendInt32(myCount);
    xmtr->sendInt32(mySize);
}

PrimArray::PrimArray (APTR(Rcvr) receiver, TCSJ)
{
    myCount = receiver->receiveInt32();
    mySize = receiver->receiveInt32();
    this->receivePrimArray(receiver);
}


/* #endif */ /* WITH_RPC */



BooleanVar PrimArray::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 PrimArray::actualHashForEqual ()
{
    return Heaper::takeOop ();
}



/*----------------------- END PrimArray -----------------------*/


