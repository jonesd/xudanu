#define NXCVRX_HXX
#endif /* NXCVRX_HXX */

void SharedPtrArray::sendSelfTo (APTR(Xmtr) xmtr)
{
    PtrArray::sendSelfTo (xmtr);
    xmtr->sendInt32(myShareCount);
}

SharedPtrArray::SharedPtrArray (APTR(Rcvr) receiver, TCSJ)
  : PtrArray (receiver, tcsj) {
    myShareCount = receiver->receiveInt32();
}


