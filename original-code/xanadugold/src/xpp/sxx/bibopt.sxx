#define BIBOPT_SXX

/*----------------------- BEGIN Live -----------------------*/
DEFINE_CLASS_CATEGORY(Live,Heaper)
DEFINE_OPAQUE_TYPE(Live);

void Live::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar Live::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 Live::actualHashForEqual ()
{
    return Heaper::takeOop ();
}



/*----------------------- END Live -----------------------*/


