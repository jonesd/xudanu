#define OPAQUET_SXX

/*----------------------- BEGIN Foo -----------------------*/
DEFINE_CLASS_CATEGORY(Foo,Heaper)
DEFINE_OPAQUE_TYPE(Foo);

void Foo::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */


BooleanVar Foo::isEqual (Heaper * other)
{
    return this == other;
}

UInt32 Foo::actualHashForEqual ()
{
    return Heaper::takeOop ();
}



/*----------------------- END Foo -----------------------*/


