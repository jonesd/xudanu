#define PSRANDX_SXX

/*----------------------- BEGIN RandomStepper -----------------------*/
DEFINE_CLASS_CATEGORY(RandomStepper,Heaper)
DEFINE_OPAQUE_TYPE(RandomStepper);

void RandomStepper::deferredHack () { /* intentionally blank */ }
/* $Id: copy.hf,v 2.11 1992/11/25 23:18:25 eric Exp $ */

/* ====== Object Migrator for Scavenging of RandomStepper ====== */

void RandomStepper::
migrate (void * origin, BooleanVar destinationIsOld) {
	if (destinationIsOld) {
		Heaplet::forwardToOld ((Heaper**)&((RandomStepper*)origin)->seeds,
				       (Heaper**)&seeds);
	} else {
		seeds.forwardTo (Heaplet::forward (seeds));
	}
}

/*----------------------- END RandomStepper -----------------------*/

