	XuPromise inDelayBlock ifFalse:
		[XuPromise force.
		retVal isBroken ifTrue: [retVal explode]].
	^retVal! !

!XuMapping methodsFor: #accessing!
{XuIntValue} isIdentity

	"Essential. True if this is the identify mapping on the entire space."
	
	| retVal {XuIntValue} |
