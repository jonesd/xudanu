!IDSpace methodsFor: #testing!
{UInt32} actualHashForEqual

	myBackend == NULL
		ifTrue: [^mySpaceNumber DOThashForEqual
			bitXor: self getCategory hashForEqual]
		ifFalse: [^(myBackend hashForEqual
			bitXor: mySpaceNumber DOThashForEqual)
			bitXor: self getCategory hashForEqual]! !

