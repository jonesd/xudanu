		(hack printHack:args:)
		(handleDo printException:args:)
		(ifdef printIfdef:args:)
		(ifdefElse printIfdef:args:)
		(ifFalse printIfNot:args:)
		(ifFalseIfTrue printIfNot:args:)
		(ifndef printIfndef:args:)
		(ifndefElse printIfndef:args:)
		(ifTrue printIf:args:)
		(ifTrueIfFalse printIf:args:)
		(initTimeInherited printIgnore:args:)
 		(insistent printInsistent:args:)
		(invokeFunction printInvoke:args:)
		(knownBug printKnownBug:args:)
		(linkTimeInherited printIgnore:args:)
		(LOG printLOG:args:)
		(log printFunction:args:)
		(loop printFor:args:)
		(loopAlmost printForAlmost:args:)
		(loopDown printForDown:args:)
		(make printPseudoconstructor:args:)
		(max printFunction:args:)
		(mightNotImplement printMightNotImplement:args:)
		(min printFunction:args:)
		(namedBlock printBlock:args:)
		(namedBlockWith printBlock:args:)
		(namedBlockWithWith printBlock:args:)
		(namedBlockWithWithWith printBlock:args:)
		(namedBlockWithWithWithWith printBlock:args:)
		(negated printNegated:args:)
		(notNULL printNotNULL:args:)
		(notNULLElse printNotNULL:args:)
		(obsolete printObsolete:args:)
