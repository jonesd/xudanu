!SnarfInfoHandler methodsFor: #'protected: destruct'!
{void} destruct
	"Release all my handles before going away."
	myCurrentHandle _ NULL.
	mySnarfs getCategory ~= Heaper ifTrue:
		[mySnarfs stepper forEach:
			 [:handle {SnarfHandle} |
			 handle destroy]].
	mySnarfs _ NULL.
	super destruct! !

