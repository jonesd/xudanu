!PrimArray methodsFor: 'testing'!

{BooleanVar} contentsEqual: other {PrimArray}
	"Whether the two ranges contain semantically the same values. Two non-NULL pointers match iff the Heapers they point to are isEqual. Two integers match iff they have the same value, even though they may be represented as different sizes. Two floats likewise."
	
	self subclassResponsibility!

{UInt32} contentsHash
	"A hash of the entire contents of the array. If two arrays are contentsEqual, they will have the same contentsHash."

	^self elementsHash! !

!PrimArray methodsFor: 'bulk accessing'!

{void CLIENT login} at: to {Int32}
	storeMany: source {PrimArray}
	with: count {Int32 default: -1}
	with: from {Int32 default: Int32Zero}
	"Copy n elements from the source array into this one. The source array must be of a compatible type."

	|  delta {Int32} stop |
	delta _ to - from.
	count == -1 ifTrue: [stop _ source count] ifFalse: [stop _ from + count].
	(stop > source count or: [stop + delta > self count]) 
		ifTrue: [Heaper BLAST: #IndexOutOfBounds].
	(self == source and: [from < to])
		ifTrue: [stop to: from+1 by: -1 do: [ :i | self basicAt: i + delta put: (source basicAt: i)]]
		ifFalse: [from+1 to: stop do: [ :i | self basicAt: i + delta put: (source basicAt: i)]]!

{PrimArray CLIENT login} copy: count {Int32 default: -1}
	with: start {Int32 default: Int32Zero}
	with: before {Int32 default: Int32Zero}
	with: after {Int32 default: Int32Zero}
	"Make a copy of a piece of this array.  'Count' defaults to the count of the array minus 'start'.  'start' defaults to the beginning of the array, so with arguments, copy just copies the entire array.  'Before' and 'after' both default to 0.  They describe the count of nulls/0s to be added in the result array before the copied elements or after the copied elements.  For example, to copy everything after 10 into a new array leaving room for 20 elements, the incantation would be:
		array->copy(-1,10,20)"
	
	| copyCount {Int32} |
	count < Int32Zero
		ifTrue: [copyCount _ self count - start]
		ifFalse:
			[copyCount _ count.
			start + copyCount > self count
				ifTrue: [Heaper BLAST: #IndexOutOfBounds]].
	^self class create: copyCount + before + after with: self with: start with: copyCount with: before!

{void CLIENT} copyFromBuffer: buffer {void star}
	with: start {Int32 default: Int32Zero}
	with: count {Int32 default: -1}

	[self knownBug. "doesn't check size and does the wrong thing in some cases for defautl count"
	self at: start storeElements: buffer with: Int32Zero with: count] smalltalkOnly.
	[Eric shouldImplement] translateOnly!

{PrimArray} copyGrow: after {Int32}
	"Make a copy of the array into a larger array.  The array has 'after' slots after the copied elements."
	
	^self copy: self count with: Int32Zero with: Int32Zero with: after!

{void} copyToBuffer: buffer {void star} with: size {Int32} with: count {Int32 default: -1} with: start {Int32 default: Int32Zero}

	[self knownBug. "doesn't check size"
	buffer at: Int32Zero storeMany: self with: count with: start] smalltalkOnly.
	[Eric shouldImplement] translateOnly!

{Int32} indexOf: value {Heaper}
	with: start {Int32 default: Int32Zero}
	with: n {Int32 default: 1}
	"The index of the nth occurrence of the given value at or after (before if n is negative) the given index, or -1 if there is none."

	self subclassResponsibility!

{Int32} indexOfElements: other {PrimArray}
	with: valueCount {Int32 default: -1}
	with: valueStart {Int32 default: Int32Zero}
	with: start {Int32 default: Int32Zero}
	with: nth {Int32 default: 1}
	"The index of the nth occurrence of the given sequence of values at or after (before if n is negative) the given starting index, or -1 if there is none. Negative numbers for start are relative to the end of the array."
	
	| valueN result n forward |
	valueCount < 0
		ifTrue: [valueN := other basicSize]
		ifFalse: [valueCount > other basicSize
				ifTrue: [Heaper BLAST: #IndexOutOfBounds].
			valueN := valueCount].
	start >= 0
		ifTrue: [result := start]
		ifFalse: [result := self basicSize + start].
	n := nth abs.
	forward := nth > 0.
		[(forward ifTrue: [result > self basicSize - valueN] ifFalse: [result < 0]) ifTrue:
			[^-1].
		(self elementsEqual: result with: other with: valueStart with: valueN) ifTrue:
			[n := n - 1.
			n = 0 ifTrue:
				[^result]].
		forward
			ifTrue: [result := result + 1]
			ifFalse: [result := result - 1]] repeat!

{Int32} indexPast: value {Heaper}
	with: start {Int32 default: Int32Zero}
	with: n {Int32 default: 1}
	"The index of the nth occurrence of anything but the given value at or after (before if n is negative) the given index, or -1 if there is none."

	self unimplemented!

