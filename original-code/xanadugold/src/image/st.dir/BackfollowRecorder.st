BackfollowRecorder class
	instanceVariableNames: ''!

(BackfollowRecorder getOrMakeCxxClassDescription)
	attributes: ((Set new) add: #CONCRETE; add: #OBSOLETE; yourself)!

!BackfollowRecorder class methodsFor: 'pseudo constructors'!

make: gk {ActualGateKeeper} 
	with: permissions {Filter of: ID} 
	with: endorsements {Filter of: ID} 
	"Return a BackfollowRecorder onto a Foot onto a new partial stamp"
	| aFoot {Foot} result {BackfollowRecorder} |
	aFoot _ Foot grabNewWithFoot: gk with: IDRegion allIDs.
	result _ (XuServer currentServer
		wrap: (Sequence string: 'BackfollowRecorder') with: aFoot) cast: BackfollowRecorder.
	result filter: permissions with: endorsements.
	^result! !