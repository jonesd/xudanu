XuIDSpace class
	instanceVariableNames: ''!

(XuIDSpace getOrMakeCxxClassDescription)
	attributes: ((Set new) add: #CONCRETE; yourself)!

!XuIDSpace class methodsFor: 'pseudo-constructors'!

make: anIDSpace {IDSpace}
	^self create: anIDSpace!

{XuIDSpace} makeBroken: problem {Problem star}
	| broke {XuIDSpace} |
	broke _ self create.Problem: problem.
	XuPromise savePromise: broke.
	^broke!

{XuIDSpace} makeBrokenBy: broken {XuPromise}
	^self create.Promise: broken.! !