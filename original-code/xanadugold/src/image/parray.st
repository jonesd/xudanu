!PrimArray methodsFor: 'printing'!

{void} printOn: oo {ostream reference}

	| before |
	before := '['.
	self count = 0 ifTrue:
		[oo << '[empty']
	ifFalse:
		[1 to: self basicSize do: [ :i {UInt32} |
			oo << before << (self basicAt: i).
			before := ' ']].
	oo << ']'! !

!PrimArray methodsFor: 'smalltalk: protected: implementation'!

{Int32} indexOfObject: value {IntegerVar | IEEE64 | Heaper | NULL}
	with: start {Int32 default: Int32Zero}
	with: nth {Int32 default: 1}
	"The index of the nth occurrence of anything but the given value at or after (before if n is negative) the given index, or -1 if there is none."

	| result n |
	start < 0
		ifTrue: [result := self basicSize + start + 1.
			result < 0
				ifTrue: [Heaper BLAST: #IndexOutOfBounds]]
		ifFalse: [result := start + 1].
	result > self basicSize
		ifTrue: [Heaper BLAST: #IndexOutOfBounds].
	nth >= 0 ifTrue:
		[n := nth.
			[value = (self basicAt: result) ifTrue:
				[n := n - 1.
				n == 0
					ifTrue: [^result - 1]].
			result := result + 1.
		result < self basicSize] whileTrue.
		^-1]
	ifFalse:
		[n := nth.
			[value = (self basicAt: result) ifTrue:
				[n := n + 1.
				n == 0
					ifTrue: [^result]].
			result := result - 1.
		result > 0] whileTrue.
		^-1]!

{Int32} indexPastObject: value {IntegerVar | IEEE64 | Heaper | NULL}
	with: start {Int32 default: Int32Zero}
	with: nth {Int32 default: 1}
	"The index of the nth occurrence of anything but the given value at or after (before if n is negative) the given index, or -1 if there is none."

	| result n |
	(self basicSize = 0 or: [nth = 0]) ifTrue: [^-1].
	start < 0
		ifTrue: [result := self basicSize + start + 1]
		ifFalse: [result := start + 1].
	(result <= 0 or: [result > self basicSize])
		ifTrue: [Heaper BLAST: #IndexOutOfBounds].
	nth > 0 ifTrue:
		[n := nth.
			[value = (self basicAt: result) ifFalse:
				[n := n - 1.
				n == 0
					ifTrue: [^result - 1]].
			result := result + 1.
		result <= self basicSize] whileTrue.
		^-1]
	ifFalse:
		[n := nth.
			[value = (self basicAt: result) ifFalse:
				[n := n + 1.
				n == 0
					ifTrue: [^result - 1]].
			result := result - 1.
		result > 0] whileTrue.
		^-1]! !

!PrimArray methodsFor: 'create'!

create: count {Int32} with: buffer {void star}
	"The buffer had better just behave like a Smalltalk array"

	super create.
	(buffer class == self class or: [buffer isKindOf: ByteString]) assert: 'Mismatched buffer types'.
	self at: Int32Zero storeMany: buffer! !

!PrimArray methodsFor: 'smalltalk: c arrays'!

at: i
	"act like a C array"
	
	^self basicAt: i + 1!

at: i put: value
	"act like a C array"
	
	self basicAt: i + 1 put: value.
	^value!

basicAt: index 
	"Answer the value of an indexable field in the receiver. Fail if the 
	argument index is not an Integer or is out of bounds. Essential. See 
	documentation in Object metaclass.  Do not override this message in any 
	subclass."

	<primitive: 60>
	index isInteger ifTrue: [^Heaper BLAST: #NotInTable].
	index respondsToArithmetic
		ifTrue: [^self basicAt: index asSmallInteger]
		ifFalse: [^self nonIntegerIndexError: index]!

basicAt: index put: value 
	"Store the second argument value in the indexable field of the receiver 
	indicated by index. Fail if the index is not an Integer or is out of bounds. Or 
	fail if the value is not of the right type for this kind of collection. Answer 
	the value that was stored. Essential. See documentation in Object 
	metaclass. Do not override in a subclass."

	<primitive: 61>
	index isInteger
		ifTrue: [(index >= 1 and: [index <= self basicSize])
					ifTrue: [^self improperStoreError]
					ifFalse: [^Heaper BLAST: #NotInTable]].
	index respondsToArithmetic
		ifTrue: [^self basicAt: index asSmallInteger put: value]
		ifFalse: [^self nonIntegerIndexError: index]! !

