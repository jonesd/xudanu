{Int32} indexOf: value {Heaper}
	with: start {Int32 default: Int32Zero}
	with: n {Int32 default: 1}
	"The index of the nth occurrence of the given value at or after (before if n is negative) the given index, or -1 if there is none."

	self subclassResponsibility!

{Int32} indexOfElements: other {PrimArray}
	with: valueCount {Int32 default: -1}
	with: valueStart {Int32 default: Int32Zero}
	with: start {Int32 default: Int32Zero}
	with: nth {Int32 default: 1}
	"The index of the nth occurrence of the given sequence of values at or after (before if n is negative) the given starting index, or -1 if there is none. Negative numbers for start are relative to the end of the array."
	
	| valueN result n forward |
	valueCount < 0
		ifTrue: [valueN := other basicSize]
		ifFalse: [valueCount > other basicSize
				ifTrue: [Heaper BLAST: #IndexOutOfBounds].
			valueN := valueCount].
	start >= 0
		ifTrue: [result := start]
		ifFalse: [result := self basicSize + start].
	n := nth abs.
	forward := nth > 0.
		[(forward ifTrue: [result > self basicSize - valueN] ifFalse: [result < 0]) ifTrue:
			[^-1].
		(self elementsEqual: result with: other with: valueStart with: valueN) ifTrue:
			[n := n - 1.
			n = 0 ifTrue:
				[^result]].
		forward
			ifTrue: [result := result + 1]
			ifFalse: [result := result - 1]] repeat!

{Int32} indexPast: value {Heaper}
	with: start {Int32 default: Int32Zero}
	with: n {Int32 default: 1}
	"The index of the nth occurrence of anything but the given value at or after (before if n is negative) the given index, or -1 if there is none."

	self unimplemented!

