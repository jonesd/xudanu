!HUpperCrum methodsFor: #create!
create: first {OPart} with: second {OPart} with: trace {TracePosition} 
	| set {MuSet} |
	super create.
	hcut _ trace.
	"self halt."
	set _ MuSet make: 2.
	set introduce: first.
	set introduce: second.
	hcrums _ set.
	self computeMarks.
	self computeLookingNorth.! !

