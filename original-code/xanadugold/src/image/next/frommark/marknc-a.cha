GenerateMethods subclass: #SourceMethods
	instanceVariableNames: ''
	classVariableNames: 'TheSourceOnlyFlag {Boolean | MethodFilter} '
	poolDictionaries: ''
	category: 'Tools-Browser-Methods'!

SourceMethods getOrMakeCxxClassDescription attributes: nil!

!SourceMethods class methodsFor: #preferences!
{BooleanVar} isSourceOnly

	TheSourceOnlyFlag == nil ifTrue:
		[TheSourceOnlyFlag := true].

	^TheSourceOnlyFlag == true! !

!SourceMethods class methodsFor: #preferences!
{BooleanVar} isAllMethods

	TheSourceOnlyFlag == nil ifTrue:
		[TheSourceOnlyFlag := true].

	^TheSourceOnlyFlag == false! !

!SourceMethods class methodsFor: #preferences!
sourceOnly: flag {Boolean | MethodFilter}

	TheSourceOnlyFlag := flag! !

!PopUpMenu class methodsFor: #preferences!
{Collection of: Symbol} tags
	"PopUpMenu flushMenus"
	
	^#(all), 
	(PopUpMenu shortForm ifTrue: [#(short)] ifFalse: [#(long)]),
	(PopUpMenu liveMenus ifTrue: [#(live)] ifFalse: [#(dead)]),
	(SourceMethods isSourceOnly ifTrue: [#()] ifFalse: [#(notSourceOnly)]),
	(SourceMethods isAllMethods ifTrue: [#()] ifFalse: [#(notAllMethods)]),
	(Cursor usingBigCursor ifTrue: [#(bigCursor)] ifFalse: [#(normalCursor)]),
	(IOAccessor defaultClass = UnixIOAccessor ifTrue: 
		[#(unix)] 
	ifFalse: [IOAccessor defaultClass = MacIOAccessor ifTrue:
		[#(macOS)]
	ifFalse: [IOAccessor defaultClass = DosIOAccessor ifTrue:
		[#(dos)]
	ifFalse: 
		[#()]]])! !

!ScreenController methodsFor: #'menu messages'!
{void} setSourceFilterTo
	
	| filter {MethodFilter | nil} |
	filter := MethodFilter fetchFromMenu.
	filter == nil ifTrue: [^VOID].
	SourceMethods sourceOnly: filter! !

!SourceMethods class methodsFor: #creation!
make

	TheSourceOnlyFlag == nil ifTrue:
		[TheSourceOnlyFlag := true].
		
	TheSourceOnlyFlag 
		cast: Boolean into: [:flag |
			flag ifTrue:
				[^self create]
			ifFalse:
				[^AllMethods make]]
		cast: GenerateMethods into: [:gm |
			^gm]
		cast: MethodFilter into: [:mf |
			^AllMethods make filteredBy: mf]! !

!GenerateMethods methodsFor: #accessing!
{GenerateMethods} filteredBy: filter {MethodFilter}
	
	^GenerateAndTest create: self with: filter! !

!GenerateAndTest methodsFor: #creation!
create: gen {GenerateMethods} with: filter {MethodFilter}
	
	super create.
	myGen _ gen.
	myFilter _ filter! !

!GenerateAndTest methodsFor: #accessing!
{GenerateMethods} filteredBy: filter {MethodFilter}
	
	^GenerateAndTest create: myGen with: (myFilter intersect: filter)! !

!GenerateMethods methodsFor: #accessing!
{MethodFilter} intersect: other {MethodFilter}

	^self filteredBy: other! !

!ScreenController class methodsFor: #menus!
screenMenu
	"Background menu"
	
	"ScreenController screenMenu startUp"

	^PopUpMenu fromPrefixedArray: #(
		(all		'find window'					findWindow				'Xu: Prompt with a list of all the window labels, in order of increasing depth.  Bring the chosen window to the top.')
		(all		'spawn' (
			(all		'system browser'		openBrowser				'St: Bring up a System Browser')
			(all		'cxx browser'				openCxxBrowser			'Xu: Bring up a CxxBrowser.')
			(all		'find methods'			findMethods				'Xu: Apply criteria from a FindMenu to all the methods in the image, and bring up a method set browser on the result.') ))
		(all		'workspace'					openWorkspace			'')
		(all		'file list'						openFileList				'')
		-
		(short	'long menus'					setLongMenus			'Xu: Switch to displaying long menus.  In long menu form, other preferences are hidden under here')
		(long	'preferences' (
			(long	'short menus'				setShortMenus			'Xu: Switch to displaying short menus.')
			(dead	'live menus'				liveMenusOn				'Xu: Have menus popup under the cursor.')
			(live	'dead menus'		liveMenusOff				'Xu: Have menus popup immediately to the right of the cursor (so you have to slide right to select).')
			(long	'menu help timeout'		setMenuHelpTimeout		'Xu: Prompt for a number to determine how long to wait before printing out the menu help string')
			(long	'implicit filter' (
				(notAllMethods	'all methods'		setSourceFilterOff	'Xu: Put the find system in a global mode where all methods are canidates even if they aren''t source methods')
				(notSourceOnly	'sources only'		setSourceFilterOn		'Xu: Put the find system in a mode where the only candidates are source methods')
				(long			'specify'			setSourceFilterTo		'Xu: Apply criteria from a FindMenu as an implicit "and" to filter further finds') ))
			-
			(long	'gridding' (
				(long	'off'					turnGriddingOff			'Xu: Windows can be put anywhere.')
				(long	'8@8'					setGriddingTo8			'Xu: Windows snap to 8-pixel boundaries.')
				(long	'16@16'				setGriddingTo16			'Xu: Windows snap to 16-pixel boundaries.')
				(long	'32@32'				setGriddingTo32			'Xu: Windows snap to 32-pixel boundaries.') ))
			(bigCursor	'normal cursor'		setNormalCursor		'Xu: restore normal arrow cursor')
			(normalCursor		'big cursor'			setBigCursor			'Xu: use big arrow cursor')
			(bogus	'toggle busy-methods'	toggleBusyMethodSetBrowser	'Xu: toggle whether the MethodSetBrowser (the kind returned from "find" requests) is simple or busy')
			(long	'method pane:' (
				(long	'history'				showMethodHistory	'Xu: show history of methods when none selected')
				(long	'template'				showMethodTemplate	'Xu: show method template when none selected') ))
			(long	'translation path prefix'	setTranslationPathPrefix	'Xu: prompt for a file path prefix.  Set it so translation will go there (and to its subdirectories)') ))
		(all		'other' (
			(all		'file editor'				openFileEditor			'')
			(all		'terminal'				openTerminal			'')
			(all		'desktop'				openDeskTop			'')
			(all		'system transcript'	openTranscript			'')
			(all		'system workspace'	openSystemWorkspace	'') ))
		(all		'changes' (
			(all		'set user '				setUserName			'Xu: Prompt for a user identifier.  Used to identify author of editing changes and name file outs (until next time it''s changed).')
			(all		'set baseline'			fastbaseline				'Xu: Prompt with a menu of significant events in the change history.  Changes baseline to chosen event. Limited to last 10 significant events.')
			(all		'set baseline(long)'			baseline				'Xu: Prompt with a menu of significant events in the change history.  Changes baseline to chosen event. Limited to 150 items unless shift key held down, then all items are presented.')
			(all		'version fork'			fork						'Xu: Prompt for a name.  Use it and the time to label the current state as a significant event.')
			(all		'change annotation'	note					'Xu: Label significant events, as with version fork, but in a way that files in and out with nearby changes.  Initially intended to record which bug is addressed by a set of changes.')
			-
			(all		'browse conflicts (slow)' conflicts				'Xu: Browse all conflicts since the baseline.  A conflict is when two or more users have made changes to the same entity.')
			(all		'browse Overrides (slow)'	browseOverrides	'Xu: Browse all conflicts between any code since the baseline and other peoples code from there back to a divergence point chosen from a menu')
			(all		'file out mine'			fileOutMyChanges		'Xu: Prompt for a name (default generated from user''s name).  File out all changes made by the current user since the baseline.')
			(all		'file out all'			fileOutAllChanges		'Xu: Prompt for a name (default generated from user''s name).  File out all changes made since the baseline.') ))
		(all		'system' (
			(all		'restore display'		restoreDisplay			'')
			(all		'close inspectors'		closeInspectors			'Xu: Close all inspector windows.')
			(all		'close notifiers'		closeNotifiers				'Xu: Close all notifier windows.')
			(all		'garbage collect'		garbageCollect			'')
			-
			(all		'save'					save					'')
			(all		'save then quit'		saveThenQuit			'')
			(all		'quit' (
				(all		'confirm'				quitSmalltalk			'') ))) ))! !

!MethodFilter class methodsFor: #'creation menu messages'!
{MethodFilter} fetchAllMethods

	^AllMethods make! !

!MethodFilter class methodsFor: #'creation menu messages'!
{MethodFilter} fetchSourceMethods

	^SourceMethods create! !

!FromCategory methodsFor: #accessing!
{BooleanVar} passes: cls {Behavior}
	
	^(myOrg listAtCategoryNamed: myCat) includes: cls nonMeta name! !

!MethodFilter class methodsFor: #'menu creation'!
{Array} menuMatching: tags {Collection of: Symbol}
	"Menu for find (from a browser)"
	
	^PopUpMenu matching: tags fromPrefixedArray: #(
		(all		'string'						fetchStringFilter			'Xu: Prompt for a pattern, then find any method that contains a matching substring.')
		(all		'token'						fetchTokenFilter			'Xu: Prompt for a pattern, then find any method that contains a matching token.')
		-
		(all		'senders'						fetchSendersFilter		'Xu: Prompt for a selector, then find any method that sends it (or has it as a literal, which may result in it being sent via perform:).')
		(all		'implementors'				fetchImplementorsFilter	'Xu: Prompt for a pattern, then find all methods whose selector matches.')
		(find	'protocol'						fetchProtocolFilter		'Xu: Prompt for a pattern, then find all methods whose protocol matches.')
		(find	'changed'						fetchChangedFilter		'Xu: Find all methods which have been changed since the baseline')
		-
		(all		'class refs'					fetchClassRefsFilter			'Xu: Prompt for a class name, then find all methods with an explicit reference to that class.')
		(all		'opaque class refs'			fetchOpaqueRefsFilter		'Xu: Prompt for a class name, then find all methods according to the current opaque scan info which use that class''s name as a token.')
		(all		'global var refs'				fetchGlobalVarRefsFilter		'Xu: Prompt for a global variable name, then find all methods which refer to that variable')
		-
		(find	'not found by ...'				fetchNegativeMethodFilter	'Xu: Bring up another find menu, but find the things that DON''T match.')
		(find	'and ... ...'						fetchAndMethodFilter		'Xu: Bring up two more find menus.  Find those things which match both.')
		(find	'or ... ...'						fetchOrMethodFilter			'Xu: Bring up two more find menus.  Find those things which match either.')
		(find	'... and replace' 				fetchWithReplacer			'Xu: Bring up another find menu, and then prompt for a corresponding pattern or string to replace matches with.')
		-
		(all		'problems' (
			(find	'unknowns'						fetchUnknownFilter			'Xu: Find those methods with a missing type declaration needed for C++ translation.')
			(all		'protection violations'			fetchProtectedIVFilter		'Xu: Find those methods that access an instance variable declared in a superclass.')
			(find	'construction problem'			fetchConstructionProblemFilter		'Xu: Find those constructors/destructor etc.. that send to self a message whose selector is overridden in a subclass of the class containing the constructor (or destructor, etc..).  Such methods are highly likely to operate differently in XTalk vs X++.')
			(bogus	'magic numbers'					fetchMagicNumberFilter		'Xu: Find those methods that use a number literally other than -1, 0 and 1')
			-
			(all		'Undeclared'						fetchUndeclaredFilter		'Xu: Find all methods that have an undeclared symbol.')
			(all		'probably unused methods'		fetchStaleUnusedFilter		'Xu: Find all methods that were not sent by anybody the last time you selected "truly something".') 
			(all		'truly unused methods (slow)'	fetchTrulyUnusedFilter		'Xu: Find all methods that are not sent by any methods.  (Beware of comments that are used with doit.)')
			(all		'probably unimplemented'		fetchStaleUnimplementedFilter	'Xu: Find all methods that send a message that is was not implemented the last time you selected "truly something".')
			(all		'truly unimplemented (slow)'		fetchTrulyUnimplementedFilter	'Xu: Find all methods that send a message that is not implemented')
			-
			(all 	'smalltalk V problems'			fetchSmalltalkVProblems		'Xu: Find all methods which can''t be filed out for Smalltalk V')
			(all		'untested contract'				fetchUntested				'Xu: Find all contract methods which aren''t directly sent by their module''s testers.
A contract method is a public method of a public class which is either a root polymorph or contains a client comment')
			(all		'undocumented'					fetchUndocumented			'Xu: Find all public root polymorphs of public classes which don''t have a client comment')
			(all		'too documented'				fetchTooDocumented		'Xu: Find all non-root polymorphs whose client comment is redundant with a parent''s client comment')
			-
			(all		'should be inline'					fetchShouldBeInline			'Xu: Methods which are inline candidates, are strong candidates, and aren''t already declared inline')
			(all		'should not be inline'				fetchShouldNotBeInline		'Xu: Methods which are declared inline but are not considered candidates')
			(all		'inline candidates'				fetchInlineCandidateFilter	'Xu: All methods which should plausibly be given the X++ INLINE attribute')
			-
			(all		'needs work'						fetchNeedsWork				'Xu: Find all methods which send any of the special selectors (like "thingToDo" or "shouldImplement") which indicate that more work is needed here.')
			(all		'non ascii characters'			fetchNonAsciiFilter			'Xu: Find all methods whose source contains non-ascii characters') ))
		(all	'other' (
			(all		'poly-roots'						fetchPolyRootFilter			'Xu: Find all methods which are roots of their polymorph tree.  Class methods are always considered roots (in XTalk)')
			(all		'client comments'					fetchClientCommentFilter	'Xu: Find all methods which contain a client comment')
			(all		'public methods' 					fetchPublicMethods			'Xu: Find all methods of public visibility')
			(all		'contract methods'				fetchContractMethods		'Xu: Find all public methods of public classes which are either root polymorphs or contain a client comment')
			(all		'visible classes'					fetchVisibleClasses			'Xu: Prompt for a visibility group.  Find all methods of classes in that visibility group.')
			(all		'class attribute'					fetchFromClassAttribute		'Xu: Prompt for a class attribute.  Find all methods of classes with that attribute.')
			-
			(all		'class var refs'					fetchClassVarRefs			'Xu: Prompt for a class, and then for one of its class variable.  Find all methods which refer to that var.')
			(all		'inst var refs'					fetchInstVarRefs				'Xu: Prompt for a class, and then for one of its instance variable.  Find all methods which refer to that var.')
			(all		'inst var assignments'			fetchInstVarAssignments	'Xu: Prompt for a class, and then for one of its instance variable.  Find all methods which set that var.')
			-
			(all		'source methods'					fetchSourceMethods			'Xu: Find all source methods')
			(all		'all methods in system'			fetchAllMethods				'Xu: Find all methods in the entire system')
			(all		'labelled'							fetchLabelled				'Xu: Bring up another find menu. prompt for a string and label the finder with it')
			-
			(all		'in class'							fetchFromClass				'Xu: Prompt for a class.  Find all its methods')
			(all		'in family'							fetchFromFamily				'Xu: Prompt for a class.  Find all methods of its family (that class and its subs and supers)')
			(all		'in category'						fetchFromCategory			'Xu: Prompt for a class category.  Find all methods in that category.')
			(all		'in module'						fetchFromCxxModule			'Xu: Prompt for a Cxx Module.  Find all methods in that Module.') ))
		(group	'group' (
			(all		'overloads within'	browseOverloadsIn:with:with:	'Xu: Create a browser on all methods in this group for which there is an overload within the group')
			(all		'mono-polymorphs'	browseMonoPolyMorphs:with:with:		'')
			(all		'multi-polymorphs'	browseMultiPolyMorphs:with:with:		'')
			-
			(all		'senders to all'		browseSendersTo:with:with:		'Xu: Create a browser on all methods which send any of the messages implemented by methods in this group')
			(all		'replacing with'		browseReplacing:with:with:		'Xu: Prompt for a replacement string, then create a browser like me for replacing my selections with the replacement string'))))! !

GenerateMethods subclass: #GeneratorLabeller
	instanceVariableNames: '
		myFilter {MethodFilter}
		myLabel {String}'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Tools-Browser-Methods'!

GeneratorLabeller getOrMakeCxxClassDescription attributes: nil!

!GeneratorLabeller methodsFor: #protected:!
{void} behaviorsDo: aBlock {BlockClosure of: Behavior} 
	"Enumerate exactly those classes for which self passes:"
	"Like subclassResponsibility, but subclasses are only obligated to override this if 
	they don't override the default methodReps:, which uses it."

	self hack.
	self subclassResponsibility! !

!GeneratorLabeller methodsFor: #creation!
create: filter {MethodFilter} with: label {String}

	super create.
	myFilter _ filter.
	myLabel _ label! !

!GeneratorLabeller methodsFor: #accessing!
{MethodAction | nil} fetchAction

	^myFilter fetchAction! !

!GeneratorLabeller methodsFor: #accessing!
{String} label
	
	^myLabel! !

!GeneratorLabeller methodsFor: #accessing!
{BooleanVar} passes: cls {Behavior} 

	^myFilter passes: cls! !

!GeneratorLabeller methodsFor: #accessing!
{BooleanVar} passes: cls {Behavior} with: sel {Symbol} with: code {CompiledMethod}
	
	
	^myFilter passes: cls with: sel with: code! !

!GeneratorLabeller methodsFor: #accessing!
{Collection of: MethodRep} methodReps: filter {MethodFilter}

	^myFilter methodReps: filter! !

GeneratorLabeller class removeSelector: #make:with:!

GeneratorLabeller class organization removeCategory: #creation!

!MethodFilter class methodsFor: #'creation menu messages'!
{MethodFilter} fetchContractMethods

	^(((ClassVisibilityFilter make: #public)
			intersect: (PolyRootFilter make unionWith: ClientComment make))
	 		intersect: self fetchPublicMethods)
	 	labelled: 'Contract Methods'! !

!MethodFilter class methodsFor: #'creation menu messages'!
{MethodFilter} fetchNeedsWork

	^(MultiSendersFilter make: 
			#(shouldImplement unimplemented notYetImplemented knownBug thingToDo hack mightNotImplement))
	 	labelled: 'Needs Work'! !

!MethodFilter class methodsFor: #'creation menu messages'!
{MethodFilter} fetchPublicMethods

	^((((ProtocolMatchFilter make: 'private*') 
	 		unionWith: (ProtocolMatchFilter make: 'protected*'))
	 		unionWith: (ProtocolMatchFilter make: 'generated*'))
	 		unionWith: (ProtocolMatchFilter make: 'smalltalk*')) not
	 	labelled: 'Public Methods'! !

!MethodFilter class methodsFor: #'creation menu messages'!
{MethodFilter} fetchUndocumented

	^(((((ClassVisibilityFilter make: #public) unionWith: (ClassVisibilityFilter make: #unclassified))
	 		intersect: PolyRootFilter make)
			 intersect: self fetchPublicMethods)
			 intersect: ClientComment make not)
		labelled: 'Undocumented Contract Methods'! !

FilterLabeller class removeSelector: #make:with:!

FilterLabeller class organization removeCategory: #creation!

!GenerateMethods methodsFor: #accessing!
{GenerateMethods} labelled: label {String}
	^GeneratorLabeller create: self with: label! !

!MethodFilter methodsFor: #accessing!
{MethodFilter} labelled: label {String}
	^FilterLabeller create: self with: label! !

!MethodFilter class methodsFor: #'creation menu messages'!
{MethodFilter | nil} fetchLabelled

	| label {String | nil} a {MethodFilter} |
	a := self fetchFromMenu.
	a == nil ifTrue: [^nil].
	label := self requestString: 'label for ', a label, '?'.
	label == nil ifTrue: [^nil].
	^a labelled: label! !

!Loaf methodsFor: #backfollow!
{void} removeOParent: oparent {OPart}
	"remove oparent from the set of upward pointers."

	myHCrum removeOParent: oparent.
	myHCrum isEmpty 
		ifTrue:
			["Now we get into the risky part of deletion.  There are
			 no more upward pointers, so destroy the receiver."
			self destroy]
		ifFalse: [self diskUpdate]! !

