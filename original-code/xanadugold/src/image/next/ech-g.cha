!FMListDirector methodsFor: #'private: updating'!
{void} updateAll
 
	| stomp {TableStepper} mcTable {IntegerTable} |
	Scaffold fluidBind: self scaffold during: [
		myViewList wipe: myViewList domain.
		mcTable _ myController controllers cast: IntegerTable.
		mcTable wipeAll: myController controllers domain.
		stomp _ myModelList asTable stepper.
		stomp forEach: [:elem {Heaper} | | newBuilding
{FMBuilding} |
			newBuilding _ Scaffold fluidGet build: elem.
			myViewList insert: stomp index with: newBuilding view.
			newBuilding controller ~~ NULL ifTrue: 
				[mcTable at: stomp position introduce: newBuilding
controller]]]! !

!ActualCompositeRegion methodsFor: #accessing!
{XnRegion} asSimpleRegion

	| subs {TableStepper} result {MuTable} |
	result _ MuTable make: self subRegions coordinateSpace.
	(subs _ self subRegions stepper) forEach: [ :sub {XnRegion} |
		result at: subs position store: sub asSimpleRegion].
	^CompositeRegion make: self coordinateSpace with: result asImmuTable! !

!ActualCompositeRegion methodsFor: #operations!
{XnRegion} complement

	| subs {TableStepper} result {MuTable} |
	result _ MuTable make: self subRegions coordinateSpace.
	(subs _ self subRegions stepper) forEach: [ :sub {XnRegion} |
		result at: subs position store: sub complement].
	^CompositeRegion make: self coordinateSpace with: result asImmuTable! !

!ActualCompositeRegion methodsFor: #operations!
{XnRegion} intersect: other {XnRegion}
	| subs {TableStepper} result {MuTable} |
	((other isKindOf: EmptyCompositeRegion)
			or: [(other isKindOf: FullCompositeRegion)
			or: [(other isKindOf: CompositeSliceRegion)]])
		ifTrue: [^other intersect: self].
	(other isKindOf: CompositeGapRegion) ifTrue:
		[ | slice {CompositeGapRegion} |
		slice _ other basicCast: CompositeGapRegion.
		result _ self subRegions asMuTable.
		result at: slice key replace: (slice region intersect: (self subRegion: slice key))]
	ifFalse:
		[result _ MuTable make: self subRegions coordinateSpace.
		(subs _ (other cast: ActualCompositeRegion) subRegions stepper) forEach: [ :sub {XnRegion} |
			result at: subs position store: ((self subRegion: subs position) intersect: sub)]].
	^CompositeRegion make: self coordinateSpace with: result asImmuTable! !

!ActualCompositeRegion methodsFor: #testing!
{BooleanVar} intersects: other {XnRegion}
	"tell whether it has any points in common"
	| subs {TableStepper} |
	(other isKindOf: CompositeGapRegion) ifTrue:
		[ | gap {CompositeGapRegion} |
		gap _ other basicCast: CompositeGapRegion.
		self subRegions domain stepper forEach: [ :key {Position} |
			(key isEqual: gap key)
				ifTrue: [((self subRegion: key) intersects: gap region)
					ifTrue: [^true]]
				ifFalse: [(self subRegion: key) isEmpty
					ifFalse:	 [^true]]].
		^false].
	(other isKindOf: ActualCompositeRegion) ifFalse:
		[^(other cast: CompositeRegion) intersects: self].
	(subs _ (other basicCast: ActualCompositeRegion) subRegions stepper) forEach: [ :sub {XnRegion} |
		((self subRegion: subs position) intersects: sub)
			ifTrue: [^true]].
	^false! !

!ActualCompositeRegion methodsFor: #testing!
{BooleanVar} isFinite
	| subs {TableStepper} |
	(subs _ self subRegions stepper) forEach: [ :sub {XnRegion} |
		((self subRegion: subs position) isFinite)
			ifFalse: [^false]].
	^true! !

!ActualCompositeRegion methodsFor: #testing!
{BooleanVar} isSimple
	| subs {TableStepper} |
	(subs _ self subRegions stepper) forEach: [ :sub {XnRegion} |
		((self subRegion: subs position) isSimple)
			ifFalse: [^false]].
	^true! !

!ActualCompositeRegion methodsFor: #testing!
{BooleanVar} isSubsetOf: other {XnRegion}
	| subs {TableStepper} |
	((other isKindOf: EmptyCompositeRegion) or: [other isKindOf: CompositeSliceRegion])
		ifTrue: [^false].
	(other isKindOf: FullCompositeRegion) ifTrue: [^true].
	(other isKindOf: CompositeGapRegion) ifTrue:
		[ | gap {CompositeGapRegion} |
		gap _ other basicCast: CompositeGapRegion.
		^(self subRegion: gap key) isSubsetOf: gap region].
	(subs _ (other cast: ActualCompositeRegion) subRegions stepper) forEach: [ :sub {XnRegion} |
		((self subRegion: subs position) isSubsetOf: sub)
			ifFalse: [^false]].
	^true! !

!ActualCompositeRegion methodsFor: #operations!
{XnRegion} minus: other {XnRegion}
	| subs {TableStepper} result {MuTable} |
	((other isKindOf: EmptyCompositeRegion)
			or: [(other isKindOf: FullCompositeRegion)
			or: [other isKindOf: CompositeGapRegion]])
		ifTrue: [^(other basicCast: CompositeRegion) subtractedFrom: self].
	(other isKindOf: CompositeSliceRegion) ifTrue:
		[ | slice {CompositeSliceRegion} |
		slice _ other basicCast: CompositeSliceRegion.
		result _ self subRegions asMuTable.
		result at: slice key replace: ((self subRegion: slice key) minus: slice region)]
	ifFalse:
		[result _ MuTable make: self subRegions coordinateSpace.
		(subs _ (other cast: ActualCompositeRegion) subRegions stepper) forEach: [ :sub {XnRegion} |
			result at: subs position store: ((self subRegion: subs position) minus: sub)]].
	^CompositeRegion make: self coordinateSpace with: result asImmuTable! !

!ActualCompositeRegion methodsFor: #operations!
{XnRegion} simpleUnion: other {XnRegion}
	| subs {TableStepper} result {MuTable} |
	((other isKindOf: EmptyCompositeRegion)
			or: [(other isKindOf: FullCompositeRegion)
			or: [(other isKindOf: CompositeGapRegion)]])
		ifTrue: [^other simpleUnion: self].
	result _ MuTable make: self subRegions coordinateSpace.
	(other isKindOf: CompositeSliceRegion) ifTrue:
		[ | slice {CompositeSliceRegion} |
		slice _ other basicCast: CompositeSliceRegion.
		(subs _ (other cast: ActualCompositeRegion) subRegions stepper) forEach: [ :sub {XnRegion} |
			(subs position isEqual: slice key) ifFalse:
				[result at: slice key introduce: sub asSimpleRegion]].
		result at: slice key introduce: (slice region simpleUnion: (self subRegion: slice key)).]
	ifFalse:
		[(subs _ (other cast: ActualCompositeRegion) subRegions stepper) forEach: [ :sub {XnRegion} |
			result at: subs position store: ((self subRegion: subs position) simpleUnion: sub)]].
	^CompositeRegion make: self coordinateSpace with: result asImmuTable! !

!ActualCompositeRegion methodsFor: #operations!
{XnRegion} subtractedFrom: other {CompositeRegion}
	"other minus: self -- arranged this way for modularity"
	| result {MuTable of: XnRegion} subs {TableStepper} |
	"minus should only pass this an ActualCompositeRegion or a CompositeGapRegion"
	result _ MuTable make: self subRegions coordinateSpace.
	(other isKindOf: CompositeGapRegion) ifTrue:
		[ | gap {CompositeGapRegion} |
		gap _ other basicCast: CompositeGapRegion.
		(subs _ self subRegions stepper) forEach: [ :sub {XnRegion} |
			(subs position isEqual: gap key)
				ifTrue: [result at: gap key
					introduce: (gap region minus: sub)]
				ifFalse: [result at: subs position
					introduce: sub complement]]]
	ifFalse:
		[(subs _ (other cast: ActualCompositeRegion) subRegions stepper) forEach: [ :sub {XnRegion} |
			result at: subs position introduce: (sub minus: (self subRegion: subs position))]].
	^CompositeRegion make: self coordinateSpace with: result asImmuTable! !

!ActualCompositeRegion methodsFor: #operations!
{XnRegion} unionWith: other {XnRegion}
	| subs {TableStepper} result {MuTable} |
	((other isKindOf: EmptyCompositeRegion)
			or: [(other isKindOf: FullCompositeRegion)
			or: [(other isKindOf: CompositeGapRegion)]])
		ifTrue: [^other unionWith: self].
	(other isKindOf: CompositeSliceRegion) ifTrue:
		[ | slice {CompositeSliceRegion} |
		slice _ other basicCast: CompositeSliceRegion.
		result _ self subRegions asMuTable.
		result at: slice key replace: (slice region unionWith: (self subRegion: slice key)).]
	ifFalse:
		[result _ MuTable make: self subRegions coordinateSpace.
		(subs _ (other cast: ActualCompositeRegion) subRegions stepper) forEach: [ :sub {XnRegion} |
			result at: subs position introduce: ((self subRegion: subs position) simpleUnion: sub)]].
	^CompositeRegion make: self coordinateSpace with: result asImmuTable! !

!PathRegion methodsFor: #accessing!
{XnRegion} keysTransformedBy: dsp {Dsp}
	"transform the keys by the dsp"
	| result {MuTable of: XnRegion} loop {TableStepper} |
	result _ MuTable make: myPath coordinateSpace.
	(loop _ myPath stepper) forEach: [ :sub {XnRegion} |
		result at: (dsp of: loop position) introduce: sub].
	^PathRegion make: result asImmuTable! !

!PathRegion methodsFor: #operations!
{XnRegion} minus: region {XnRegion}
	| other {PathRegion} result {MuTable of: XnRegion} loop {TableStepper} |
	other _ region cast: PathRegion.
	result _ MuTable make: myPath coordinateSpace.
	(loop _ myPath stepper) forEach: [ :mySub {XnRegion} | | sub {XnRegion} |
		sub _ other fetchSubRegion: loop position.
		sub == NULL
			ifTrue: [sub _ mySub]
			ifFalse: [sub _ mySub minus: sub].
		sub isEmpty ifFalse:
			[result at: loop position store: sub]].
	^PathRegion make: result asImmuTable! !

TableStepper organization classify: #key under: #'smalltalk: operations'!

!TableStepper methodsFor: #'smalltalk: operations'!
{void} forPositions: fn {BlockClosure of: Position with: Heaper} 
	[| result {Heaper} |
	[(result _ self fetch) ~~ NULL]
		whileTrue:
			[fn of: self position and: result.
			self step]]
		valueNowOrOnUnwindDo: [self destroy]! !

!MessageNode class methodsFor: #'class initialization'!
initialize
	"MessageNode initialize. "
	| mac |
	mac _ IdentityDictionary new: 32.
		#(	ifTrue: ifFalse:
			ifTrue:ifFalse: ifFalse:ifTrue:
			and: or:
			whileFalse: whileTrue:
			whileFalse whileTrue
			repeat
			to:do: to:by:do: almostTo:do: almostTo:by:do: timesRepeat:
			downTo:do:
			forEach: forKeyValues: forPositions:)
	with:
		#(	transformIfTrue transformIfFalse
			transformIfTrueIfFalse transformIfFalseIfTrue
			transformAnd transformOr
			transformWhileFalseDo transformWhileTrueDo
			transformWhileFalse transformWhileTrue
			transformRepeat
			transformToDo transformToByDo transformAlmostToDo transformAlmostToByDo transformTimesRepeat
			transformDownToDo
			transformForEach transformForKeyValues transformForKeyValues)
	do:
		[:selector :message | mac at: selector put: message].
	MacroSelectors _ mac! !

!HxxPrintStream methodsFor: #'message translations'!
printForKeyValues: stepper args: args
"       Stepper forKeyValues: [:Key {Type1} Value {Type2} | Body] translates to
        FOR_POSITIONS(Type1,Key,Type2,Value,(Stepper),{Body});
"
        | block arg |
        args size = 1 assert: 'bad collect: expression'.
        (args first isBlockNode) 
                ifFalse: ["Fallback in case a block is passed in as an argument."
                        ^self printRealMessage: #forKeyValues rec: stepper args: args].
        block _ args first.
        self asExpression: 
                [self << 'BEGIN_FOR_POSITIONS('.
                arg _ block arguments first.
                (self extractType: arg type) makeCast printTypeOn: self.
                self << ','; emphasis: 2; << arg name; emphasis: 1; << $,.
                arg _ block arguments last.
                (self extractType: arg type) makeCast printTypeOn: self.
                self << ','; emphasis: 2; << arg name; emphasis: 1.
                self << ',('.
                stepper prettyPrintOn: self.
                self << ')) '; startBlock.
                self asStatement: [block body prettyPrintOn: self].
                self stopBlock; << ' END_FOR_POSITIONS;'].! !

!HxxPrintStream methodsFor: #'message translations'!
printForPositions: stepper args: args
"       Stepper forKeyValues: [:Key {Type1} Value {Type2} | Body] translates to
        FOR_POSITIONS(Type1,Key,Type2,Value,(Stepper),{Body});
"
        | block arg |
        args size = 1 assert: 'bad collect: expression'.
        (args first isBlockNode) 
                ifFalse: ["Fallback in case a block is passed in as an argument."
                        ^self printRealMessage: #forKeyValues rec: stepper args: args].
        block _ args first.
        self asExpression: 
                [self << 'BEGIN_FOR_POSITIONS('.
                arg _ block arguments first.
                (self extractType: arg type) makeCast printTypeOn: self.
                self << ','; emphasis: 2; << arg name; emphasis: 1; << $,.
                arg _ block arguments last.
                (self extractType: arg type) makeCast printTypeOn: self.
                self << ','; emphasis: 2; << arg name; emphasis: 1.
                self << ',('.
                stepper prettyPrintOn: self.
                self << ')) '; startBlock.
                self asStatement: [block body prettyPrintOn: self].
                self stopBlock; << ' END_FOR_POSITIONS;'].! !

!HxxPrintStream methodsFor: #'message translations'!
printForIndices: stepper args: args
"       Stepper forIndices: [:Key {IntegerVar} Value {Type2} | Body] translates to
        FOR_INDICES(Key,Type2,Value,(Stepper),{Body});
"
        | block arg |
        args size = 1 assert: 'bad collect: expression'.
        (args first isBlockNode) 
                ifFalse: ["Fallback in case a block is passed in as an argument."
                        ^self printRealMessage: #forIndices rec: stepper args: args].
        block _ args first.
        self asExpression: 
                [self << 'BEGIN_FOR_INDICES('.
                arg _ block arguments first.
                self emphasis: 2; << arg name; emphasis: 1; << $,.
                arg _ block arguments last.
                (self extractType: arg type) makeCast printTypeOn: self.
                self << ','; emphasis: 2; << arg name; emphasis: 1.
                self << ',('.
                stepper prettyPrintOn: self.
                self << ')) '; startBlock.
                self asStatement: [block body prettyPrintOn: self].
                self stopBlock; << ' END_FOR_INDICES;'].! !

!TableStepper methodsFor: #'smalltalk: operations'!
{void} forIndices: fn {BlockClosure of: IntegerVar with: Heaper} 
	[| result {Heaper} |
	[(result _ self fetch) ~~ NULL]
		whileTrue:
			[fn of: self index and: result.
			self step]]
		valueNowOrOnUnwindDo: [self destroy]! !

