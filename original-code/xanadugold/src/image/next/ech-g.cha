		(reanimate printReanimate:args:)
		(refAssign printRefAssign:args:)
		(refValue printRefValue:args:)
		(repeat printRepeat:args:)
		(REQUIRES printRequires:args:)
		(rounded printFunction:args:)
		(sin printFunction:args:)
		(shouldImplement printShouldImplement:args:)
		(shouldNotImplement printShouldNotImplement:args:)
		(showWhile printShowCursor:args:)
		(smalltalkOnly printIgnore:args:)
		(pointerToStaticMember printStaticMemberPointer:args:)
		(tan printFunction:args:)
		(thingToDo printThingToDo:args:)
		(timesRepeat printTimesRepeat:args:)
		(toByDo printFor:args:)
		(toDo printFor:args:)
		(translateOnly printTranslateOnly:args:)
		(uint8 printFunction:args:)
		(unaryFn printBlockMsg:args:)
