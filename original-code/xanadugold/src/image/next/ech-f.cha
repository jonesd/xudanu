		(whileFalse printNotWhile:args:)
		(whileTrue printWhile:args:)
		(willNotImplement printWillNotImplement:args:)
		(xuInteger printIntegerFunction:args:)
	).
	array ~~ CxxOverrideArray ifTrue: 
		[CxxOverrideArray _ array.
		CxxOverrideMap _ IdentityDictionary fromPairs: array].
	override _ CxxOverrideMap at: sel ifAbsent: [nil].
	override == #intercept ifTrue: [self warn: 'Selector ''', sel, ''' not allowed.'].
	^override! !

!RegionTester methodsFor: #testing!
{void} testUnaryRegionOpsOn: oo {ostream reference}
	myExampleRegions stepper forEach: [:one {XnRegion} |
		Heaper problems.AllBlasts
			handle: [ :ex |
				| prob {Problem} |
				'prob = &PROBLEM(ex);' translateOnly.
				[prob _ Problem create: ex PROBLEM with: ex parameter
							with: ex initialContext sender printString with: 0] smalltalkOnly.
				cerr << prob << '
'.
				oo << 'problem checking unary ops of ' << one << '
'.
				ex return]
			do: [self unaryCheck: one]].
	oo << 'unary regions tests succeeded
'! !

!RegionTester methodsFor: #testing!
{void} testBinaryRegionOpsOn: oo {ostream reference}
	myExampleRegions stepper forEach: [:one {XnRegion} |
		myExampleRegions stepper forEach: [:two {XnRegion} |
			one asOop <= two asOop ifTrue: [
				Heaper problems.AllBlasts
					handle: [ :ex |
						| prob {Problem} |
						'prob = &PROBLEM(ex);' translateOnly.
						[prob _ Problem create: ex PROBLEM with: ex parameter
									with: ex initialContext sender printString with: 0] smalltalkOnly.
						cerr << prob << '
'.
						oo << 'problem checking binary ops of ' << one << ' and ' << two << '
'.
						ex return]
					do: [self binaryCheck: one with: two]]]].
	oo << 'binary regions tests succeeded
'! !

!EdgeAccumulator methodsFor: #'protected: create'!
create: manager {EdgeManager} with: startsInside {BooleanVar}
	
	super create.
	myManager := manager.
	myStartsInside := startsInside.
	myEdges := PtrArray nulls: 4.
	myIndex := -1.
	myPending := NULL.
	myResultGiven := false! !

Stepper subclass: #SetTableStepper
	instanceVariableNames: '
		myPtrs {PtrArray}
		myIndex {Int32}'
	classVariableNames: '
		AnArray {PtrArray} 
		AStepper {SetTableStepper} '
	poolDictionaries: ''
	category: 'Xanadu-settab'!

SetTableStepper getOrMakeCxxClassDescription attributes: #(CONCRETE EQ )!

((Smalltalk includesKey: #CxxSystemOrganization) ifTrue: [(CxxSystemOrganization getOrMakeFileNamed: 'settab')  addClass: SetTableStepper getOrMakeCxxClassDescription in: #private])!

SetTableStepper organization addCategory: #'protected: create' before: nil!

!SetTableStepper methodsFor: #'protected: create'!
create: array {PtrArray}
	super create.
	myPtrs := array.
	myIndex := Int32Zero.! !

!SetTableStepper methodsFor: #'protected: create'!
create: array {PtrArray} with: index {Int32}
	super create.
	myPtrs := array.
	myIndex := index.! !

SetTableStepper organization addCategory: #copy before: #'protected: create'!

SetTableStepper organization renameCategory: #copy to: #create!

SetTableStepper organization addCategory: #accessing before: #create!

!SetTableStepper methodsFor: #accessing!
{Heaper} fetch
	myIndex < myPtrs count
		ifTrue: [^ myPtrs fetch: myIndex]
		ifFalse: [^ NULL]! !

!SetTableStepper methodsFor: #accessing!
{BooleanVar} hasValue
	^ myIndex < myPtrs count! !

!SetTableStepper methodsFor: #accessing!
{void} step
	myIndex := myIndex + 1! !

!SetTableStepper methodsFor: #create!
{void} destroy
	AStepper == NULL
		ifTrue: [
			myPtrs storeAll.
			AnArray := myPtrs.
			AStepper := self.
			self destruct]
		ifFalse: [
			super destroy].! !

SetTableStepper class organization addCategory: #accessing before: nil!

SetTableStepper class organization addCategory: #'smalltalk: init' before: #accessing!

!SetTableStepper class methodsFor: #'smalltalk: init'!
linkTimeNonInherited
	AnArray := NULL.
	AStepper := NULL.! !

!SetTableStepper class methodsFor: #accessing!
{PtrArray} array
	AnArray ~~ NULL
		ifTrue: [
			| result {PtrArray} |
			result := AnArray.
			AnArray := NULL.
			^ result]
		ifFalse: [
			^ PtrArray nulls: 16]! !

SetTableStepper class organization addCategory: #create before: #accessing!

!SetTableStepper class methodsFor: #create!
make: array {PtrArray}
	AStepper ~~ NULL
		ifTrue: [
			| result {SetTableStepper} |
			result := (SetTableStepper new.Become: AStepper) create: array.
			AStepper := NULL.
			^ result]
		ifFalse: [
			^ SetTableStepper create: array]! !

!SetTable methodsFor: #enumerating!
{Stepper} stepperAtInt: index {IntegerVar}

	| offset {Int32 register} elements {PtrArray} entry {TableEntry wimpy} i {Int32} |
	offset _ (IntegerPos integerHash: index) \\ myHashEntries count.
	elements _ SetTableStepper array.
	i _ Int32Zero.
	entry _ (myHashEntries fetch: offset) cast: TableEntry.
	[entry ~~ NULL] whileTrue:
		[(entry matchInt: index) 
			ifTrue: [
				i >= elements count ifTrue: [elements _ (elements copyGrow: 4) cast: PtrArray].
				elements at: i store: entry value.
				i := i + 1].
		entry _ entry fetchNext].
	^SetTableStepper make: elements.! !

!SetTableStepper methodsFor: #create!
{Stepper} copy
	^ SetTableStepper create: (myPtrs copy cast: PtrArray) with: myIndex! !

!PrimArray methodsFor: #'bulk accessing'!
{Int32} indexPast: value {Heaper}
	with: start {Int32 default: Int32Zero}
	"The index of the nth occurrence of anything but the given value at or after (before if n is negative) the given index, or -1 if there is none."

	^ self indexPast: value with: start with: 1! !

PrimArray organization classify: #indexPast:with: under: #'smalltalk: defaults'!

!HashSetStepper methodsFor: #private:!
{void} verifyEntry
	myCurrent < myElements count ifTrue: [
		myCurrent := myElements indexPast: NULL with: myCurrent.
		myCurrent == -1 ifTrue: [myCurrent := myElements count]]! !

