!PointRegion class methodsFor: #'pseudo constructors'!
make.IntegerRegion: xRegion {IntegerRegion} with: yRegion {IntegerRegion}
	"Create the cross product of the two regions"
	| odd {IntegerRegion} even {IntegerRegion} slices {PtrArray of: IntegerRegion} result {SlicePointRegion} |
	(xRegion isEmpty or: [yRegion isEmpty]) ifTrue:
		[^PointRegion make].
	yRegion isFull ifTrue:
		[^(SlicePointRegion make.IntegerRegion: xRegion) canonicalForm].
	(xRegion isFinite and: [xRegion isSimple and: [yRegion isFinite and: [yRegion isSimple]]])
		ifTrue: [^ PointRegion 
					make: xRegion start 
					with: yRegion start 
					with: xRegion stop 
					with: yRegion stop].
	yRegion isBoundedBelow
		ifTrue: [odd _ IntegerRegion make. even _ xRegion]
		ifFalse: [even _ IntegerRegion make. odd _ xRegion].
	slices _ PtrArray nulls: yRegion transitionCount.
	Int32Zero almostTo: yRegion transitionCount do: [ :i {Int32} |
		(i bitAnd: 1) == Int32Zero
			ifTrue: [slices at: i store: even]
			ifFalse: [slices at: i store: odd]].
	result _ SlicePointRegion
		create: odd 
		with: yRegion transitionCount 
		with: (IntegerRegion badlyViolatePrivacyOfIntegerRegionTransitions: yRegion)
		with: slices.
	^ result canonicalForm! !

!ArrayAccumulator methodsFor: #operations!
{void} step: obj {Heaper} 
	arrayInternal isEmpty
		ifTrue: [arrayInternal atInt: IntegerVar0 store: obj]
		ifFalse: [arrayInternal atInt: (arrayInternal domain quickCast: IntegerRegion) stop introduce: obj]! !

!EventQueue methodsFor: #accessing!
{void} queue: anEvent {Event}
	"Transcript print: anEvent; cr; endEntry."

	firstEvent == NULL
		ifTrue: [firstEvent _ anEvent]
		ifFalse: [moreEvents == NULL
				ifTrue: [moreEvents _ IntegerTable make.
					moreEvents atInt: 0 introduce: anEvent]
				ifFalse: [moreEvents atInt: moreEvents domain stop introduce: anEvent]]! !

!EventQueue methodsFor: #accessing!
{void} queue: anEvent {Event} for: aController {FMController} 
	"Transcript print: anEvent; cr; endEntry."

	| pair {Pair} |
	pair _ Pair make: anEvent with: aController.
	firstEvent == NULL
		ifTrue: [firstEvent _ pair]
		ifFalse: [moreEvents == NULL
				ifTrue: [moreEvents _ IntegerTable make.
					moreEvents atInt: 0 introduce: pair]
				ifFalse: [moreEvents atInt: moreEvents domain stop introduce: pair]]! !

!FMTextEditor methodsFor: #'private: private text actions'!
{IntegerVar} selectionStop
	mySelection selectionRange isEmpty
		ifTrue: [^mySelection selectionPosition]
		ifFalse: [^(mySelection selectionRange quickCast: IntegerRegion) stop]! !

!FMSplitTextModel methodsFor: #'split accessing'!
{void} append: newModel {FMTextModel}

	myKids isEmpty
		ifTrue: [myKids atInt: IntegerVar0 introduce: newModel.
			myMaxes at: IntegerVar0 DOTasInt storeIntegerVar: IntegerVar0.
			myOriginCache at: IntegerVar0 DOTasInt storeIntegerVar: IntegerVar0.
			newModel setIndex: IntegerVar0 DOTasInt]
		ifFalse: [ | nextSpot {IntegerVar} |
			self checkSize: (nextSpot _ (myKids domain cast: IntegerRegion) stop).
			myKids atInt: nextSpot introduce: newModel.
			myMaxes at: nextSpot DOTasInt storeIntegerVar: IntegerVar0.
			myOriginCache at: nextSpot DOTasInt storeIntegerVar: (self calcOriginOf: nextSpot).
			newModel setIndex: nextSpot]! !

!FMTextRunModel methodsFor: #accessing!
{IntegerVar} charLimit

	^ (self parent runAt: IntegerVar0 with: self index) stop! !

!Portion methodsFor: #accessing!
{IntegerVar} maxEnclosure
	myBounds isBoundedAbove
		ifFalse: [Heaper BLAST: #InvalidRequest].
	^ myBounds stop! !

!ScreenPlay methodsFor: #rehearsal!
{NO_RETURN} cue: performer {Performer} 
	ok ifFalse: [self abort].
	selector == NULL
		ifTrue: [self recordTest: performer]
		ifFalse: [
			arguments isEmpty
				ifTrue: [arguments atInt: IntegerVar0 introduce: performer]
				ifFalse: [arguments at: arguments domain stop integer introduce: performer].
			self evalIfReady]! !

!ActualIntegerTable methodsFor: #private:!
{IntegerRegion} generateDomain
	| begin {UInt32} resReg {IntegerRegion} nextReg {IntegerRegion} |
	resReg _ IntegerRegion make.
	tally == UInt32Zero ifTrue: [^resReg].
	begin _ firstElem.
	[begin <= lastElem]
		whileTrue: 
			[nextReg _ self contigDomainStarting: begin.
			nextReg isEmpty
				ifTrue: [nextReg _ self nullDomainStarting: begin]
				ifFalse: [resReg _ (resReg unionWith: nextReg)
								cast: IntegerRegion].
			begin _ (nextReg stop - start) DOTasLong].
	^resReg! !

!SelectedTextModel methodsFor: #manipulating!
{void} deflate: region {XnRegion} 
	"remove the specified region. 
	heh 7 October 1990 
	Note that the selection region is updated first. This is due to a 
	requirement of the recomposition code. The deflate: region message 
	here causes an update to occur, which is passed by this model onto 
	its dependents. i.e. the recomposition objects. Since the message 
	causes recomposition to occur, the selection must match the text at 
	the time of the recomposition for it to be correct. Therefore, the 
	selection is updated first (also possibly causing a recomposition) so 
	that it will be in synch with the altered text when the 
	recomposition actually happens. The possible recomposition caused 
	by the changing of the selection is not as much of a problem, 
	because it is essentially the removal of the selected attributes from 
	the model. This has little effect, where recomposing the text with 
	an incorrect selection has a large effect."

	| span {IntegerRegion} |
	span _ region quickCast: IntegerRegion.
	span isBoundedAbove
		ifTrue: [mySelection setSelectionPosition: (((span complement quickCast: IntegerRegion) compactor ofInt: span stop)
					min: myText count - region count)]
		ifFalse: [mySelection setSelectionPosition: myText count - region count].
	myText deflate: region! !

!WaldoTextModel methodsFor: #manipulating!
{void} deflate: reg {XnRegion} 
	"remove the specified region"
	| lReg {IntegerRegion} |
	
	lReg _ reg cast: IntegerRegion.
	(newTyping ~~ NULL and: [lReg stop == typingNext])
		ifTrue: [typingNext _ typingNext - 1.
			typingNext > typingStart
				ifTrue: [newTyping _ (newTyping subTableBetween: IntegerVar0 with: newTyping count - 1) cast: MuWordArray]
				ifFalse: [newTyping _ NULL]]
		ifFalse: 
			[self commitInserts.
			wrappedText deflate: lReg].
	charCache == NULL
		ifFalse: 
			[cacheWaldo == NULL ifTrue: 
				[cacheWaldo _ WordArrayWaldo make: charCache].
			cacheWaldo deflate: lReg.
			charCache _ cacheWaldo table cast: MuWordArray].
	self changed: (DeletionUR make: lReg)! !

!AITWaldo methodsFor: #manipulating!
{void} deflate: reg {XnRegion}
	| regKill {IntegerRegion} stomper {Stepper} |
	regKill _ (myIT domain intersect: reg) cast: IntegerRegion.
	regKill isEmpty ifTrue: [^VOID].
	stomper _ regKill stepper: (IntegerSpace make getDescending).
	stomper forEach: [ :idx {IntegerPos} | | next {IntegerVar} |
			myIT intWipe: idx asIntegerVar.
			myIT isEmpty not ifTrue: [
				next _ idx asIntegerVar + 1.
				next < (myIT domain cast: IntegerRegion) stop
					ifTrue: [self translateKeysFrom: next by: -1]]].
	self hasDependents ifTrue: [self changed: (DeletionUR make: reg)]! !

!AITWaldo methodsFor: #'private: private manipulating'!
{void} translateKeysFrom: start {IntegerVar} by: distance {IntegerVar} 
	| top {IntegerVar} bottom {IntegerVar} |
	distance = IntegerVar0 ifTrue: [^VOID].
	myIT isEmpty ifTrue: [^ VOID].
	top _ (myIT domain cast: IntegerRegion) stop - 1.
	bottom _ start.
	self translateKeysFrom: bottom to: top byInt: distance! !

!ArrayMakerWaldo methodsFor: #'private: private'!
{void} translateKeysFrom: start {IntegerVar} by: distance {IntegerVar} 
	| top {IntegerVar} bottom {IntegerVar} |
	distance = IntegerVar0 ifTrue: [^VOID].
	myIT isEmpty ifTrue: [^ VOID].
	top _ (myIT domain cast: IntegerRegion) stop - 1.
	bottom _ start.
	self translateKeysFrom: bottom to: top byInt: distance! !

!ActualArrayWaldo methodsFor: #manipulating!
{void} copyKeysFrom: start {UInt32} by: distance {UInt32} 
	| top {UInt32} bottom {UInt32} |
	distance == UInt32Zero ifTrue: [^VOID].
	myArray isEmpty ifTrue: [^ VOID].
	top _ ((myArray domain cast: IntegerRegion) stop) DOTasLong - 1.
	bottom _ start.
	self copyKeysFrom: bottom to: top by: distance! !

!ActualArrayWaldo methodsFor: #manipulating!
{void} deflate: reg {XnRegion} 

	| regKill {IntegerRegion} dom {IntegerRegion} upper {IntegerVar} |
	regKill _ ((dom _ myArray domain cast: IntegerRegion) intersect: reg)
				cast: IntegerRegion.
	regKill isEmpty ifTrue: [^VOID].
	regKill stop < (upper _ dom stop) 
		ifTrue: [self copyKeysFrom: regKill stop DOTasLong by: regKill count DOTasLong negated].
	upper > (upper - regKill count) ifTrue: [
	(upper - 1) to: upper - regKill count by: -1 do: [:i {IntegerVar} |
		myArray intWipe: i]]! !

!SlicePointRegion methodsFor: #'display accessing'!
{IntegerVar} right
	| slice {IntegerRegion} |
	myFirstSlice isEmpty not ifTrue: [Heaper BLAST: #NotEnumerable].
	self sliceCount ~~ 2 ifTrue: [Heaper BLAST: #NotSimple].
	slice _ self sliceAtIndex: Int32Zero.
	slice isBoundedAbove ifFalse: [Heaper BLAST: #NotEnumerable].
	^ slice stop! !

!IntegerRegion methodsFor: #accessing!
{XnRegion} beforeLast
	"the region before the last element of the set.  
	What on earth is this for? (Yes, I've looked at senders)"

	myTransitionCount == Int32Zero ifTrue:
		[^self].
	self isBoundedAbove
		ifTrue: [^IntegerRegion before: self stop]
		ifFalse: [^IntegerRegion allIntegers]! !

!IntegerRegion methodsFor: #'breaking up'!
{ScruSet of: XnRegion} distinctions

	| intReg {IntegerRegion} |
	self isSimple ifFalse:
		[Heaper BLAST: #InvalidRequest].
	self isFull ifTrue:
		[^ImmuSet make].
	(self isEmpty or: [myTransitionCount = 1]) ifTrue:
		[^ImmuSet make with: self].
	intReg _ IntegerRegion create: myStartsInside with: 1 with: myTransitions.
	^(ImmuSet make with: intReg)
		with: (IntegerRegion before: self stop)! !

!IntegerRegion methodsFor: #operations!
{XnRegion} withInt: pos {IntegerVar}

	| mine {IntegerEdgeStepper} me {IntegerVar} result {IntegerEdgeAccumulator} resultReg {XnRegion} |
	self isEmpty ifTrue: [^IntegerRegion make: pos].
	(self isBoundedAbove and: [pos == self stop])
		ifTrue: [
			| newTransitions {IntegerVarArray} |
			newTransitions := myTransitions copy cast: IntegerVarArray.
			newTransitions at: myTransitionCount -1 storeIntegerVar: pos + 1.
			^ IntegerRegion create: myStartsInside with: myTransitionCount with: newTransitions].
	mine _ self edgeStepper.
	result _ IntegerEdgeAccumulator
		make: myStartsInside
		with: myTransitionCount + 2.
	[mine hasValue and: [(me _ mine edge) < pos]] whileTrue:
		[result edge: me.
		mine step].
	mine isEntering 
		ifTrue: 
			[result edge: pos.
			me == pos 
				ifTrue: [mine step]
				ifFalse: [result edge: pos+1]]
		ifFalse:
			[me == pos ifTrue: 
				[mine step.
				result edge: pos+1]].
	mine hasValue ifTrue: [result edges: mine].
	mine destroy.
	resultReg _ result region.
	result destroy.
	^ resultReg! !

!XuRealRegion methodsFor: #accessing!
{XuReal} upperBound

	"The smallest real number such that all the positions in the region are <= it.  Does not necessarily lie in the region.  For example, the region of all numbers < 2 has an upperBound of 2."
	
	| retVal {XuReal} |
	(self isBroken) ifTrue:
		[^XuReal makeBrokenBy: self].

	Heaper problems.AllBlasts 
		handle: [:ex | retVal _ XuReal makeBroken: ex asProblem. ex return]
		do: 	[retVal _ XuReal make: (self getActualRealRegion stop)].
	XuPromise inDelayBlock ifFalse:
		[XuPromise force.
		retVal isBroken ifTrue: [retVal explode]].
	^retVal! !

!IntegerTableInspector methodsFor: #'menu commands'!
addField
	field == nil
		ifTrue: [object atInt: (object domain stop) introduce: #nothing]	"nothing selected"
		ifFalse: [self fieldIndex isNil
				ifTrue: [object addFirst: nil]	"self selected"
				ifFalse: [object add: nil beforeIndex: self fieldIndex]].
	self changed: #field! !

!HopRecorder methodsFor: #recording!
{void} record: hop {ActualHopRecord}
	| table {MuTable} used {IntegerRegion} |
	used _ self foot orgl usedDomain cast: IntegerRegion.
	used isEmpty ifFalse:
		[lastStampID == NULL ifTrue:
			[ | orgl {ActualOrgl} |
			orgl _ (self foot orgl fetch: (used stop - 1) integer) cast: ActualOrgl.
			(orgl ~~ NULL) assert.
			lastStampID _ ((XuServer currentServer
					wrap: (Sequence string: 'HopRecord')
					with: (Hand
						make.KeyMaster: self keyMaster
						with.Orgl: orgl))
				cast: ActualHopRecord) whatHand editionID].
		(lastStampID isEqual: hop whatHand editionID) ifTrue:
			[^VOID]].
	lastStampID _ hop whatHand editionID.
	table _ MuTable make: IntegerSpace make.
	used isEmpty
		ifTrue: [table atInt: IntegerVar0 store: hop editionID]
		ifFalse: [table atInt: used stop store: hop editionID].
	self foot inform: table! !

IntegerRegion removeSelector: #upperBound!

!MoveInOperation class methodsFor: #pseudoConstructors!
{MoveInOperation} make.IntegerTable: ops {IntegerTable of: EditOperation} with: from {IntegerVar}
	| start {IntegerRegion} final {IntegerRegion} stepper {Stepper} |
	stepper _ ops domain stepper.
	start _ ((ops fetch: (stepper fetch cast: IntegerPos)) cast: EditOperation) startLocations.
	final _ ((ops fetch: (stepper fetch cast: IntegerPos)) cast: EditOperation) finalLocations.
	stepper forEach: [:index {IntegerPos} |
		start _ (start unionWith: ((ops fetch: index) cast: EditOperation) startLocations) cast: IntegerRegion.
		final _ (final unionWith: ((ops fetch: index) cast: EditOperation) finalLocations) cast: IntegerRegion].
	^MoveInOperation create: start start with: final start with: ops with: from! !

!MoveOutOperation class methodsFor: #pseudoConstructors!
{MoveOutOperation} make.IntegerTable: ops {IntegerTable of: EditOperations} with: to {IntegerVar}
	| start {IntegerRegion} final {IntegerRegion} stepper {Stepper} |
	stepper _ ops domain stepper.
	start _ ((ops fetch: (stepper fetch cast: IntegerPos) asIntegerVar) cast: EditOperation) startLocations.
	final _ ((ops fetch: (stepper fetch cast: IntegerPos) asIntegerVar) cast: EditOperation) finalLocations.
	stepper forEach: [:index {IntegerPos} |
		start _ (start unionWith: ((ops fetch: index) cast: EditOperation) startLocations) cast: IntegerRegion.
		final _ (final unionWith: ((ops fetch: index) cast: EditOperation) finalLocations) cast: IntegerRegion].
	^MoveOutOperation create: start start with: final start with: ops with: to! !

!IntegerTable class methodsFor: #pseudoConstructors!
{IntegerTable} make.Region: reg {IntegerRegion} 
	"Hint that the domain of the new table will eventually be (or at least resemble) 
	'reg'."

	^ActualIntegerTable create: reg start with: reg stop! !

!CompareFragment methodsFor: #obsolete!
{BooleanVar} contiguousInFinal: aFragment {CompareFragment}
	|myFinal {IntegerRegion} otherFinal {IntegerRegion} |
	myFinal _ self finalLocations.
	otherFinal _ aFragment finalLocations.
	((myFinal isEmpty) or: [otherFinal isEmpty]) 
		ifTrue: [^true].  "deletions can be included in a composite"
	(myFinal start == otherFinal stop)
		ifTrue: [^true].
	(myFinal stop == otherFinal start)
		ifTrue: [^true].
	^false! !

!EditOperation methodsFor: #obsolete!
{BooleanVar} contiguousInFinal: anOp {EditOperation}
	"Am I adjacent to anOp in the final doc if we're both present there?"
	|myFinal {IntegerRegion} otherFinal {IntegerRegion} |
	myFinal _ self finalLocations.
	otherFinal _ anOp finalLocations.
	((myFinal isEmpty) or: [otherFinal isEmpty]) 
		ifTrue: [^true].  "deletions can be included in a composite"
	(myFinal start == otherFinal stop)
		ifTrue: [^true].
	(myFinal stop == otherFinal start)
		ifTrue: [^true].
	^false! !

!EditSequence methodsFor: #accessing!
{IntegerTable of: EditOperation} contiguousInserts: index {IntegerVar} with: deleteOps {IntegerTable of: EditOperation}
	| contig {IntegerTable of: EditOperation} lowerBound {IntegerVar} upperBound {IntegerVar} deleteStarts {IntegerTable} nextOp {EditOperation} op {EditOperation} deleteLoc {IntegerVar} | 
	contig _ IntegerTable make.
	contig at: index store: (self fetchOperation: index).
	deleteStarts _ IntegerTable make.
	deleteOps domain stepper forEach: [:del {IntegerPos} |
		op _ (deleteOps fetch: del) cast: EditOperation.
		deleteStarts at: op startLocations start store: op].

	lowerBound _ index.
	[((nextOp _ self fetchOperation: lowerBound - 1) ~= NULL)
		and: [(nextOp isInsertMove)
		 and: [(deleteStarts fetch: (deleteLoc _ nextOp startLocations start)) ~= NULL]]]
	whileTrue:
		[contig at: lowerBound - 1 store: nextOp.
		deleteStarts intRemove: deleteLoc.
		lowerBound _ lowerBound - 1].

	upperBound _ index.
	[((nextOp _ self fetchOperation: upperBound + 1) ~= NULL)
		and: [(nextOp isInsertMove)
		 and: [(deleteStarts fetch: (deleteLoc _ nextOp startLocations start)) ~= NULL]]]
	whileTrue:
		[contig at: upperBound + 1 store: nextOp.
		deleteStarts intRemove: deleteLoc.
		upperBound _ upperBound + 1].
	^contig! !

!EditSequence methodsFor: #moves!
{void} rearrange: range {IntegerRegion} with: move {MoveOperation}
	range stepper forEach: [:r {IntegerPos} | myOperations wipe: r].
	myOperations at: range start introduce: move.
	^VOID! !

!EventQueue methodsFor: #accessing!
{FMEvent} nextEvent
	"Return the currently available event or NULL if there is none."

	| next {FMEvent} |
	firstEvent == NULL ifTrue: [^NULL].
	next _ firstEvent.
	moreEvents == NULL
		ifTrue: [firstEvent _ NULL]
		ifFalse: 
			[| index {IntegerVar} |
			index _ moreEvents domain start.
			firstEvent _ (moreEvents intGet: index) cast: FMEvent.
			moreEvents intWipe: index.
			moreEvents isEmpty ifTrue: [moreEvents _ NULL]].
	^next! !

!FeText methodsFor: #'text manipulation'!
{FeText CLIENT} replace: dest {IntegerRegion} with: other {FeText}
	"Replaces a region of text with a virtual copy of text from another document.
	If the destination region lies to the left of the domain, inserts before the beginning; if it intersects the domain, insert at the first common position; if it lies after the end, insert after the end. Fails with
		BLAST(AmbiguousReplacement) if the region is empty.
	May be used to copy information within a single document.
	This operation may not be particularly useful with non-simple destination regions."	
	
	| to {IntegerVar} |
	((IntegerRegion before: IntegerVar0) intersects: dest) ifTrue:
		[to := IntegerVar0]
	ifFalse: [(dest intersects: self edition domain) ifTrue:
		[to := ((dest intersect: self edition domain) cast: IntegerRegion) start]
	ifFalse: [((IntegerRegion after: self count) intersects: dest) ifTrue:
		[to := self count]
	ifFalse:
		[Heaper BLAST: #AmbiguousReplacement]]].
	
	self thingToDo. "Do this all in one step"
	^(self extract: (dest complement cast: IntegerRegion)) insert: to with: other! !

!FMTextEditor methodsFor: #'private: private text actions'!
{IntegerVar} selectionStart
	mySelection selectionRange isEmpty
		ifTrue: [^mySelection selectionPosition]
		ifFalse: [^(mySelection selectionRange quickCast: IntegerRegion) start]! !

!FMSplitTextModel methodsFor: #'subclass accessing'!
{IntegerRegion} runAt: pos {IntegerVar} with: index {IntegerVar}

	"This method returns the domain of the attribute run containing the position pos"
	
	| reg {IntegerRegion} org {IntegerVar} |
	reg _ self parent runAt: (pos + (org _ self originOf: index)) with: self index.
	reg isEmpty 
		ifTrue: [^ reg]
		ifFalse: [reg isSimple not
			ifTrue: [Heaper BLAST: #AttributesRegionTooComplex]].
	^ IntegerRegion make: (reg start - org) with: (reg stop - org).
	"^ ((self dspAt: index) inverse of: reg) intersect: (IntegerRegion after: IntegerVar0)"! !

!LCSFinder methodsFor: #'computing commonSequence'!
{void} advanceLowerBound
	| curValue {IntegerVar} |
	curValue _ (myNextDiagonals domain cast: IntegerRegion) start.
	((myNextDiagonals intFetch: curValue) cast: MuSet) stepper forEach: 
		[:each {Pair of: IntegerPos} | | l {IntegerVar} r {IntegerVar} |
		l _ (each left cast: IntegerPos) asIntegerVar.
		r _ (each right cast: IntegerPos) asIntegerVar.
		(((myDiagonals fetch: l) entryAt: r) == curValue)
			ifTrue: [self propogate: l with: r]].
	myNextDiagonals intWipe: curValue.! !

!LCSFinder methodsFor: #'computing commonSequence'!
{EditSequence} fillInTable
	| finalDiagonal {LCSDiagonal} finalIndex {IntegerVar} |
	finalDiagonal _ myDiagonals fetch: (myStartOrder count - myEndOrder count).
	finalIndex _ myStartOrder count min: myEndOrder count.
	[(myNextDiagonals domain isEmpty) not
		and: [((finalDiagonal entryAt: finalIndex) == NULL) 
		or: [(myNextDiagonals domain cast: IntegerRegion) start <= (finalDiagonal entryAt: finalIndex)]]]
	whileTrue:
		[self advanceLowerBound].
	^(finalDiagonal scriptFor: finalIndex) cast: EditSequence! !

!FirstFitMaker methodsFor: #'arranging Sequences'!
{EditSequence} arrange: aSeq {EditSequence}
	"rearrange the operations in aSeq (by turning some inserts and deletes into moves)"
	| inserts {IntegerTable of: IntegerPos} deletes {IntegerTable of: IntegerPos} editStart {IntegerVar} ops {MuTable of: editOperations} |
	inserts _ IntegerTable make.
	deletes _ IntegerTable make.
	ops _ aSeq operations.
	IntegerVar0 to: aSeq count do: [:index {IntegerVar} | | edit {EditOperation} |
		edit _ (ops intFetch: index) cast: EditOperation.
		(edit == NULL) ifFalse: 
		  [((edit isKindOf: DeleteOperation)
		    and: [edit isPureDelete not]) ifTrue:
			[editStart _ edit startLocations start.
		  	(inserts intFetch: editStart) == NULL
				ifTrue: [deletes at: editStart store: index integer]
				ifFalse: [self arrangeMove: aSeq with: index with: ((inserts intFetch: editStart) cast: IntegerPos) asIntegerVar]].
		  ((edit isKindOf: InsertOperation)
		    and: [edit isPureInsert not]) ifTrue:
			[editStart _ edit startLocations start.
		  	(deletes intFetch: editStart) == NULL
				ifTrue: [inserts at: editStart store: index integer]
				ifFalse: [self arrangeMove: aSeq with: ((deletes intFetch: editStart) cast: IntegerPos) asIntegerVar with: index]].
		 (edit isKindOf: MoveOperation) ifTrue:
			["deal with moves later"]]].
	^aSeq! !

!FirstFitMaker methodsFor: #scoring!
{MuSet of: EditSequences} lowestMoveCount: set {MuSet of: EditSequences}
	| scoreTable {IntegerTable of: (MuSet of: EditSequences)} score {IntegerVar} |
	scoreTable _ IntegerTable make.
	set stepper forEach: [:eachSeq {EditSequence} |
		score _ eachSeq countMoves.
		(scoreTable fetch: score) == NULL
			ifTrue: [scoreTable at: score introduce: (MuSet muSetWith: eachSeq)]
			ifFalse: [((scoreTable fetch: score) cast: MuSet) store: eachSeq]].
	^(scoreTable fetch: (scoreTable domain cast: IntegerRegion) start) cast: MuSet! !

!FirstFitMaker methodsFor: #scoring!
{MuSet of: EditSequences} shortestMoves: set {MuSet of: EditSequences}
	| scoreTable {IntegerTable of: (MuSet of: EditSequences)} score {IntegerVar} |
	scoreTable _ IntegerTable make.
	set stepper forEach: [:eachSeq {EditSequence} |
		score _ eachSeq totalMoveDistances.
		(scoreTable intFetch: score) == NULL
			ifTrue: [scoreTable atInt: score introduce: (MuSet muSetWith: eachSeq)]
			ifFalse: [((scoreTable intFetch: score) cast: MuSet) store: eachSeq]].
	^(scoreTable intFetch: (scoreTable domain cast: IntegerRegion) start) cast: MuSet! !

!FirstFitMaker methodsFor: #scoring!
{MuSet of: EditSequences} smallShortMoves: set {MuSet of: EditSequences}
	| scoreTable {IntegerTable of: (MuSet of: EditSequences)} score {IntegerVar} |
	scoreTable _ IntegerTable make.
	set stepper forEach: [:eachSeq {EditSequence} |
		score _ eachSeq moveSizeXDist.
		(scoreTable fetch: score) == NULL
			ifTrue: [scoreTable at: score introduce: (MuSet muSetWith: eachSeq)]
			ifFalse: [((scoreTable fetch: score) cast: MuSet) store: eachSeq]].
	^(scoreTable fetch: (scoreTable domain cast: IntegerRegion) start) cast: MuSet! !

!IDUpOrder methodsFor: #accessing!
{BooleanVar} preceeds: before {XnRegion} with: after {XnRegion}
	"Return true if some position in before is less than or equal to all positions in after."
	
	| beforeB {SequenceRegion} afterB {SequenceRegion} bound {Sequence} |
	before cast: IDRegion into: [ :beforeIDs |
	after cast: IDRegion into: [ :afterIDs |
		beforeB := beforeIDs backends.
		afterB := afterIDs backends.
		(SequenceSpace make ascending preceeds: beforeB with: afterB) ifFalse:
			[^false].
		beforeB isBoundedBelow ifFalse:
			[^true].
		bound := beforeB start.
		(bound isEqual: afterB start) ifFalse:
			[^true].
		^IntegerSpace make ascending
			preceeds: (beforeIDs iDNumbersFrom: bound)
			with: (afterIDs iDNumbersFrom: bound)]].
	^false "fodder"! !

!IntegerUpOrder methodsFor: #accessing!
{Position} chooseOne: region {XnRegion}
	"Return the first position in the region according to my ordering."
	
	^IntegerPos make: (region cast: IntegerRegion) start! !

!IntegerUpOrder methodsFor: #accessing!
{BooleanVar} preceeds: before {XnRegion} with: after {XnRegion}
	"Return true if some position in before is less than or equal to all positions in after."
	
	| first {IntegerRegion} second {IntegerRegion} |
	first _ before cast: IntegerRegion.
	second _ after cast: IntegerRegion.
	first isBoundedBelow ifFalse: [^true].
	second isBoundedBelow ifFalse: [^false].
	^first start <= second start! !

!RealUpOrder methodsFor: #accessing!
{BooleanVar} preceeds: before {XnRegion} with: after {XnRegion}

	before cast: RealRegion into: [ :br |
		br isBoundedBelow ifFalse:
			[^true].
		after cast: RealRegion into: [ :ar |
			^ar isBoundedBelow not
				and: [self follows: ar start with: br start]]].
	^false "fodder"! !

!YOrientation methodsFor: #accessing!
{PointRegion} project: region {IntegerRegion}
	"project a region of the primary along the entire secondary axis"
	self hack. "the restricted slice built here should be obtained from some display thing"
	^PointRegion make: -32768 with: region start with: 32768 with: region stop! !

!Portion methodsFor: #accessing!
{IntegerVar} minEnclosure
	^ myBounds start! !

!HopRecorder methodsFor: #'protected: protected accessing'!
{BooleanVar} canCertify

	| used {IntegerRegion} unused {IntegerRegion} |
	used _ self foot orgl usedDomain cast: IntegerRegion.
	unused _ self foot orgl unusedDomain cast: IntegerRegion.
	^super canCertify
		and: [used isSimple
		and: [(used isEmpty or: [used stop = unused start])
		and: [(used unionWith: unused) isEqual: (IntegerRegion after: IntegerVar0)]]]! !

!ScruTable methodsFor: #testing!
{UInt32} contentsHash
	"Has the same relationship to contentsEqual that hashForEqual has to isEqual. 
	I.e., if 'a->contentsEqual (b)', then 'a->contentsHash() == b->contentsHash()'. 
	The same complex caveats apply as to the stability and portability of the 
	hash values as apply for hashForEqual.  See ScruSet contentsHash."

	| dom {XnRegion} |
	dom _ self domain.
	dom isEmpty
		ifTrue: [^self coordinateSpace hashForEqual*17]
		ifFalse: [dom
			cast: IntegerRegion into: [ :ints |
				^ints start DOTasLong
				+ ints stop DOTasLong
				+ self count DOTasLong
				+ self coordinateSpace hashForEqual]
			others:
				[^self count DOTasLong 
				+ self coordinateSpace hashForEqual]].
	^UInt32Zero "fodder"! !

!ActualArray methodsFor: #accessing!
{ScruTable} subTable: reg {XnRegion} 
	
	^self subTableBetween: (reg cast: IntegerRegion) start 
		with: (reg cast: IntegerRegion) stop! !

!MuWordArray methodsFor: #accessing!
{ScruTable} subTable: reg {XnRegion} 

	reg cast: IntegerRegion into:
		[ :ir | ir isSimple
			ifTrue: [^self subTableBetween: ir start with: ir stop]
			ifFalse: [Heaper BLAST: #MustBeContiguousDomain]].
	^NULL "fodder"! !

!ActualWordArray methodsFor: #'bulk operations'!
{void} storeAll: table {ScruTable} 
	with: dsp {Dsp default: NULL} 
	with: region {XnRegion default: NULL} 
	
	| offset {Int32} start {Int32} numToCopy {Int32} |
	dsp ~~ NULL
		ifTrue: [ offset _ (dsp cast: IntegerMapping) translation DOTasLong ]
		ifFalse: [ offset _ Int32Zero ].
	region ~~ NULL
		ifTrue:
			[ | localRegion {IntegerRegion star} |
			localRegion _ region cast: IntegerRegion.
			start _ localRegion start DOTasLong + 1.
			offset _ offset + start - 1.
			numToCopy _ localRegion stop DOTasLong - start + 1]
		ifFalse:
			[start _ 1.
			numToCopy _ table count].
	numToCopy + offset >= self count ifTrue:
		[ self growBy: offset + (numToCopy - self count) DOTasLong].
	(table isKindOf: ActualWordArray) ifFalse:
		[super storeAll: table with: dsp.
		^ VOID].
	myString replaceFrom: offset + 1 to: offset + numToCopy with: table asString startingAt: start! !

!ActualWordArray methodsFor: #accessing!
{ScruTable} subTable: reg {XnRegion} 

	| tReg {XnRegion} |
	(tReg _ reg intersect: self domain) isEmpty ifTrue:
		[^MuWordArray make].
	tReg cast: IntegerRegion into:
		[ :ir | ir isSimple
			ifTrue: [^self offsetSubTableBetween: ir start with: ir stop with: ir start]
			ifFalse: [Heaper BLAST: #MustBeContiguousDomain]]! !

!ActualWordArray methodsFor: #accessing!
{void} wipeAll: region {XnRegion}
	
	| ir {IntegerRegion} |
	(region == NULL or: [region isEmpty]) ifTrue: [^ VOID].
	ir _ region cast: IntegerRegion.
	
	(ir isSimple not or: 
		[ir isBoundedBelow not or: 
			[ir isBoundedAbove and: [ir stop >= myCount]]]) 
		ifTrue: [Heaper BLAST: #InvalidRequest].
	myCount _ ir start! !

!ActualIntegerTable methodsFor: #creation!
{ScruTable} subTable: reg {XnRegion} 

	| subRegion {IntegerRegion} |
	subRegion _ (reg intersect: self domain asSimpleRegion)
				cast: IntegerRegion.
	subRegion isEmpty ifTrue: [^ self emptySize: (self count max: 1)].
	^self subTableBetween: subRegion start with: subRegion stop! !

!OffsetScruArray methodsFor: #accessing!
{ScruTable} subTable: encl {XnRegion}

	| lr {IntegerRegion} |
	lr _ encl cast: IntegerRegion.
	^myArray
		subTableBetween: (myDsp inverseOfInt: lr start)
			with: (myDsp inverseOfInt: lr stop)! !

!TextComparator methodsFor: #initialize!
{IntegerTable of: PrimFragment} fixOverlapsIn: inputMoves {IntegerTable of: PrimFragment}
	"iterate through the table, making sure that none of the PrimFragments overlaps with the next."

	| moves {IntegerTable of: PrimFragment} lowerBound {IntegerVar} curMove {PrimFragment} overlapRegion {IntegerRegion} |
	moves _ inputMoves copy cast: IntegerTable.
	lowerBound _ moves lowestIndex.
	[(moves intFetch: lowerBound) == NULL] whileFalse: 
		[curMove _ (moves intFetch: lowerBound) cast: PrimFragment.
		overlapRegion _ ((IntegerRegion make: lowerBound + 1 with: lowerBound + curMove count)
								intersect: moves domain) cast: IntegerRegion. "use firstElemAfter: if possible"
		overlapRegion isEmpty
			ifFalse: [ | newMoves {Pair of: PrimFragment} |
				newMoves _ curMove breakAt: overlapRegion start - lowerBound.
				moves atInt: lowerBound replace: newMoves left.
				moves _ (newMoves right cast: PrimFragment) mergeInto: moves with: overlapRegion start.
				lowerBound _ overlapRegion start]
			ifTrue: [ | nextRegion { IntegerRegion} |
				nextRegion _ ((IntegerRegion after: lowerBound + curMove count) 
								intersect: moves domain) cast: IntegerRegion.  "use firstElemAfter: if possible"
				nextRegion isEmpty 
					ifTrue: [lowerBound _ lowerBound + curMove count "move past the end"]
					ifFalse: [lowerBound _ nextRegion start]]].
	^moves

	"I'd bet that all of the time in this routine is in the region intersections.  What I really want 
	to know is firstElemAfter:, but it's a private method.    --cth  9/14/90"! !

!TextComparator methodsFor: #initialize!
{void} setDeletionsFrom: dRegion {IntegerRegion} with: size {IntegerVar}
	| deleteRegion {IntegerRegion} |

	deleteRegion _ ((IntegerRegion make: IntegerVar0 with: size) intersect: dRegion) cast: IntegerRegion.
	myDeletions _ IntegerTable make.
	deleteRegion simpleRegions forEach: [:simple {IntegerRegion} |
		myDeletions atInt: simple start introduce: (DeleteFragment make: simple count with: simple)]! !

!TextComparator methodsFor: #initialize!
{void} setInsertionsFrom: iRegion {IntegerRegion} with: size {IntegerVar}
	| insertRegion {IntegerRegion} |

	insertRegion _ ((IntegerRegion make: IntegerVar0 with: size) intersect: iRegion) cast: IntegerRegion.
	myInsertions _ IntegerTable make.
	insertRegion simpleRegions forEach: [:simple {IntegerRegion} |
		myInsertions atInt: simple start introduce: (InsertFragment make: simple count with: simple)]! !

!TextComparator methodsFor: #initialize!
{IntegerTable} setUpSourceMoves:  mappings {ImmuSet of: Mapping} 
	| moves {IntegerTable of: PrimFragment} srcStart {IntegerVar} newMove {PrimFragment} |
	moves _ IntegerTable make.
	mappings stepper forEach: [:each {Mapping} |
		srcStart _ (each domain cast: IntegerRegion) start.
		newMove _ PrimFragment make: (each domain cast: IntegerRegion) count with: srcStart with: (each range cast: IntegerRegion) start.
		moves _ newMove mergeInto: moves with: srcStart].
	^moves! !

!TextComparator methodsFor: #initialize!
{IntegerTable} setUpSourcePrimFragments:  mappings {ImmuSet of: Mapping} 
	| moves {IntegerTable of: PrimFragment} srcStart {IntegerVar} newMove {PrimFragment} |
	moves _ IntegerTable make.
	mappings stepper forEach: [:each {Mapping} |
		srcStart _ (each domain cast: IntegerRegion) start.
		newMove _ PrimFragment make: (each domain cast: IntegerRegion) count
								with: srcStart
								with: (each range cast: IntegerRegion) start.
		moves _ newMove mergeInto: moves with: srcStart].
	^moves! !

!TokenSet methodsFor: #accessing!
{IntegerVar} newToken
	| tok {IntegerVar} |
	tok _ (myAvailable cast: IntegerRegion) start.
	myAvailable _ myAvailable minus: (IntegerRegion make: tok).
	^tok! !

!List2ListLookupSchnert methodsFor: #'private: updating'!
{void} updateReplace: region {XnRegion} 
	"elements have been replaced"

	| fromPos {IntegerVar} |
	(region count = 1 and: [region isKindOf: IntegerRegion])
		ifFalse: [self unimplemented].
	fromPos _ (region basicCast: IntegerRegion) start.
	myToList replace: fromPos with: (myLookup lookup: (myFromList get: fromPos))! !

!ListConverterSchnert methodsFor: #'private: updating'!
{void} updateReplace: reversed {BooleanVar} with: region {XnRegion}
	"elements have been replaced"
	(region count = 1 and: [region isKindOf: IntegerRegion])
		ifFalse: [self unimplemented].
	(self selectFromList: reversed not)
		replace: (region basicCast: IntegerRegion) start
		with: (Converter getConversion: (self selectFromCategory: reversed not)
			with: ((self selectFromList: reversed) get: (region basicCast: IntegerRegion) start))! !

!RangeToItemSchnert methodsFor: #updating!
{void} update: ur {UpdateRecord unused} from: selection
{XnModel} 
	"This is the most brute force routine!! The update will
eventually 
	have delta information in it."

	selection == selectionInternal
		ifTrue: 
			[| range {IntegerRegion} start {IntegerVar} stop
{IntegerVar} i {IntegerVar} |
			range _ selectionInternal selection cast: IntegerRegion.
			start _ range start.
			stop _ range stop.
			i _ 1.
			booleanModelsInternal stepper forEach: [:bm
{BooleanModel} | 
				bm setValue: (start <= i and: [i <= stop]).
				i _ i + 1]]! !

!Viewer methodsFor: #accessing!
{PointPos} offsetFor: region {XnRegion}
	"find the display position for a given model position"
	| span {IntegerRegion} |
	span _ region cast: IntegerRegion.
	(span isEmpty or: [span isBoundedBelow not])
		ifTrue: [^PointPos make].
	^((self regionAt: span start) cast: PointRegion) origin! !

!CollectionViewer methodsFor: #'protected: change'!
{void} update: ur {UpdateRecord} from: sender {XnModel
unused}
	"The theory in this routine is that if there is no edit
record, the viewer has
	not been composed at all yet, therefore ignore the
change, because there
	is no edit record to update yet.  When the first compose
is done, the edit
	record will be created and then this routine will be used
to track the changes."
	
	myEdit == NULL ifTrue: [^ VOID].
	(ur isKindOf: RegionUR)
		ifTrue: [myEdit _ (myEdit unionWith: (ur basicCast:
RegionUR) region) cast: IntegerRegion]
	ifFalse: [(ur isKindOf: InsertionUR) 
		ifTrue: [ | moved {Mapping} pos {IntegerVar} iur
{InsertionUR} cnt {IntegerVar} |
			pos _ (iur _ ur basicCast: InsertionUR) index.
			moved _ (IntegerMapping make: (cnt _ iur count)) restrict:
(IntegerRegion after: pos).
			myEdit _ ((moved ofAll: myEdit) 
							unionWith: (IntegerRegion make: pos with: (pos +
cnt))) cast: IntegerRegion.
			self setEditStart: pos]
	ifFalse: [(ur isKindOf: DeletionUR)
		ifTrue: [(ur basicCast: DeletionUR) region simpleRegions 
			forEach: [:sr {IntegerRegion} | | moved {Mapping} |
				moved _ (IntegerMapping make: (sr count negated))
restrict: (IntegerRegion after: sr stop).
				myEdit _ ((moved ofAll: myEdit) cast:
IntegerRegion).
				self setEditStart: (sr start)]]
	ifFalse: [Heaper BLAST: #UNKNOWN.U.UPDATE.U.RECORD]]]! !

!LocalTextModel methodsFor: #manipulating!
{void} rearrangeRegion: pos {IntegerVar} with: reg {XnRegion} 
	"move the text between cut1 and cut2 to before pos in me. i.e. swap 
	two blocks of text"

	reg 
		cast: IntegerRegion into: [:ir |
			self
				rearrange: pos
				with: ir start
				with: ir stop]
		others: [self unimplemented]! !

!LocalTextModel methodsFor: #manipulating!
{void} replaceWithWordArray: reg {XnRegion} with: string {MuWordArray}
	"equivalent to
	this->deflate (pos, len);
	this->insert (pos, string)"
	| lr {IntegerRegion} |
	lr _ reg cast: IntegerRegion.
	self deflate: reg.
	self insertWordArray: lr start with: string.! !

!WaldoTextModel methodsFor: #manipulating!
{void} rearrangeRegion: pos {IntegerVar} with: reg {XnRegion}
	"move the text between cut1 and cut2 to before pos in me.  i.e. swap two blocks of text"
	
	| lReg {IntegerRegion} |
	self commitInserts.
	lReg _ reg cast: IntegerRegion.
	lReg isSimple ifFalse: [Heaper BLAST: #NotSimpleRegion].
	wrappedText rearrange: pos with: lReg start with: lReg stop.
	charCache _ NULL.
	cacheWaldo _ NULL.
	self changedRegion: ((IntegerRegion make: pos) simpleUnion: reg)! !

!WaldoTextModel methodsFor: #manipulating!
{void} replace: reg {XnRegion} with: other {AttributedTextModel} 
	"replaces a region with the the contents of the other model"

	self commitInserts.
	other 
		cast: WaldoTextModel into: [:wtm |
			wrappedText replace: reg
				with: wtm waldo]
		others: 
			[wrappedText replace: reg
				with: (XuText make: wrappedText keyMaster
					with: (other asDataTable asMuTable cast: MuWordArray))].
	charCache _ NULL.
	cacheWaldo _ NULL.
	self changedRegion: (reg simpleUnion: 
		(IntegerRegion integerExtent: (reg cast: IntegerRegion) start
			with: other count))! !

!WaldoTextModel methodsFor: #manipulating!
{void} replaceWithWordArray: reg {XnRegion} with: string {MuWordArray} 
	"replaces the given region with the contents of the string."

	self commitInserts.
	wrappedText replace: reg with: (XuText make: wrappedText keyMaster with: string).
	charCache _ NULL.
	cacheWaldo _ NULL.
	self changedRegion: (reg simpleUnion: 
		(IntegerRegion integerExtent: (reg cast: IntegerRegion) start
			with: string count))! !

!FMParaDirector methodsFor: #'private: composing'!
{void} recompose: region {IntegerRegion} 
	"This method will recompose the text within the region specified (and 
	a bit more) and then ensure that the region outside the specified 
	region does not need recomposition as a result of the recomposition 
	of the text within the region."
 
	| startPos {IntegerVar} lastPos {IntegerVar} first {IntegerVar} last {IntegerVar}
	 delta {IntegerVar} changeReg {IntegerRegion} tmpWrd {MuWordArray} |
	region isEmpty ifTrue: [^ VOID].
	mySplit splitCount == IntegerVar0 
		ifTrue: [self compose: IntegerVar0 with: mySplit charLimit].
	tmpWrd _ mySplit chars.
	changeReg _ (tmpWrd domain) cast: IntegerRegion.
	changeReg _ ((region intersect: changeReg) asSimpleRegion) quickCast: IntegerRegion.
	(changeReg isEmpty not and: [changeReg isBoundedBelow]) 
		ifTrue: [startPos _ changeReg start] 
		ifFalse: [startPos _ IntegerVar0].
	(changeReg isEmpty not and: [changeReg isBoundedAbove])
		ifTrue: [lastPos _ changeReg stop]
		ifFalse: [lastPos _ mySplit splitCount].
	first _ mySplit splitFor: startPos.
	last _ mySplit splitFor: lastPos. "is this useful?"
	delta _ IntegerVar0.
	first to: last do: [:lineIdx {IntegerVar} | | dLine {FMTextModel} starting {IntegerVar} |
		dLine _ mySplit get: lineIdx.
		starting _ dLine charCount.
		self recomposeLine: lineIdx.
		delta _ delta + (starting - dLine charCount)].
	delta ~~ IntegerVar0 ifTrue: [self compose: lastPos with: delta]! !

!FMParaDirector methodsFor: #'private: updating'!
{void} updateDeletion: deletur {DeletionUR} 
	deletur region isEmpty not assert: 'deleting an empty region!!'.
	deletur region isSimple
		ifTrue: [self compose: (deletur region quickCast: IntegerRegion) start 
				with: deletur region count negated]
		ifFalse: [deletur region simpleRegions 
					forEach: [:simReg {IntegerRegion} | 
						self compose: simReg start with: simReg count negated]]! !

!ListSelection methodsFor: #accessing!
{void} select: region {XnRegion}
	myOldSelection _ mySelection.
	myPoint _ myStart _   IntegerPos make: ((region cast: IntegerRegion) start)   .
	self changeSelection: region! !

!SelectionRange methodsFor: #accessing!
{void} setSelectionRange: aRegion {XnRegion} 
	| oldRange {XnRegion} newRegion {IntegerRegion} |
	oldRange _ myRange.
	newRegion _ aRegion quickCast: IntegerRegion.
	myRange _ newRegion.
	newRegion isEmpty ifTrue:
		[myInsert _ IntegerVar0]
	ifFalse: [newRegion isBoundedBelow ifTrue:
		[myInsert _ newRegion start]
	ifFalse: [newRegion isBoundedAbove ifTrue:
		[myInsert _ newRegion stop]
	ifFalse:
		[myInsert _ IntegerVar0]]].
	"This should include the old region."
	(myRange isEqual: oldRange) 
		ifFalse: [self changed: (RegionUR make: myRange)]! !

!AITWaldo methodsFor: #'private: private manipulating'!
{void} translateKeysByDsp: dsp {Dsp} 
	| top {IntegerVar} bottom {IntegerVar} dom {IntegerRegion} |
	dsp isIdentity ifTrue: [^VOID].
	myIT isEmpty ifTrue: [^ VOID].
	top _ (dom _ myIT domain cast: IntegerRegion) stop - 1.
	bottom _ dom start.
	self translateKeysFrom: bottom to: top byDsp: dsp! !

!AITWaldo methodsFor: #'private: private manipulating'!
{void} translateKeysByInt: distance {IntegerVar} 
	| top {IntegerVar} bottom {IntegerVar} dom {IntegerRegion} |
	distance = IntegerVar0 ifTrue: [^VOID].
	myIT isEmpty ifTrue: [^ VOID].
	top _ (dom _ myIT domain cast: IntegerRegion) stop - 1.
	bottom _ dom start.
	self translateKeysFrom: bottom to: top byInt: distance! !

!ArrayMakerWaldo methodsFor: #manipulating!
{void} arrayForm
	| lb {IntegerVar} |
	(lb _ (myIT domain cast: IntegerRegion) start) ~= IntegerVar0 
		ifTrue: [self translateKeysByInt: lb negated].
	myIT domain isSimple not 
		ifTrue: [self arrayNormalize]! !

!ArrayMakerWaldo methodsFor: #'private: private'!
{void} arrayNormalize
	| top {IntegerVar} bottom {IntegerVar} item {Heaper} dist {IntegerVar} dom {IntegerRegion} |
	myIT isEmpty ifTrue: [^VOID].
	(dom _ myIT domain cast: IntegerRegion) start ~= IntegerVar0 
		ifTrue: [self translateKeysByInt: dom start negated].
	top _ dom stop - 1.
	bottom _ IntegerVar0.
	dist _ IntegerVar0.
	bottom to: top do: [:i {IntegerVar} | 
		item _ myIT intFetch: i.
		item == NULL
			ifTrue: [dist _ dist - 1]
			ifFalse: [dist < IntegerVar0 ifTrue: [myIT atInt: i + dist store: item]]].
	dist < IntegerVar0 ifTrue: [IntegerVar0 to: dist negated - 1 do: [:j {IntegerVar} | myIT intWipe: top - j]]! !

!ArrayMakerWaldo methodsFor: #manipulating!
{void} removeElement.IntegerVar: atKey {IntegerVar}
	| myDom {IntegerRegion} | 
	atKey >= (myDom _ myIT domain cast: IntegerRegion) stop ifTrue: [^VOID].
	atKey < myDom start ifTrue: [^VOID].
	myIT intWipe: atKey.
	atKey < ((myIT domain cast: IntegerRegion) stop) 
		ifTrue: [self translateKeysFrom: atKey + 1 by: -1]! !

!ArrayMakerWaldo methodsFor: #'private: private'!
{void} translateKeysByInt: distance {IntegerVar} 
	| top {IntegerVar} bottom {IntegerVar} dom {IntegerRegion} |
	distance = IntegerVar0 ifTrue: [^VOID].
	myIT isEmpty ifTrue: [^ VOID].
	top _ (dom _ myIT domain cast: IntegerRegion) stop - 1.
	bottom _ dom start.
	self translateKeysFrom: bottom to: top byInt: distance! !

!ActualArrayWaldo methodsFor: #manipulating!
{void} copyKeysBy: distance {UInt32} 
	| top {UInt32} bottom {UInt32} dom {IntegerRegion} |
	distance == UInt32Zero ifTrue: [^VOID].
	myArray isEmpty ifTrue: [^ VOID].
	top _ ((dom _ myArray domain cast: IntegerRegion) stop) DOTasLong - 1.
	bottom _ dom start DOTasLong.
	self copyKeysFrom: bottom to: top by: distance! !

!WordArrayWaldo methodsFor: #operations!
{void} deflate: reg {XnRegion} 

	| ir {IntegerRegion} rest {ScruTable} |
	ir _ reg cast: IntegerRegion.
	rest _ (myWa subTable: (IntegerRegion make: ir stop with: myWa count))
				transformedBy: (IntegerMapping make: ir stop negated).
	myWa wipeAll: (IntegerRegion after: ir start).
	rest isEmpty not ifTrue: [self combine: rest]! !

!TapestryAppModel methodsFor: #'private: private'!
{XuText} computeDescriptor: end {LinkEnd} with: which {ID} with: type {ID}
	"compute a simple descriptor from the contents"
	| result {XuText} context {XuText} typeDoc {LinkTypeDescription} |
	typeDoc _ LinkTypeDescription
		defaultDescription: self user keyMaster
		with: type.
	result _ ((typeDoc labels get: which) cast: Waldo) copy cast: XuText.
	result insert: result count with: (MuWordArray make.charVector: ': ').
	end fetchEndContext == NULL ifTrue:
		[result insert: result count with: (MuWordArray make.charVector: 'EVERYTHING')]
	ifFalse: [(end getEndContext isKindOf: XuText) not ifTrue:
		[result insert: result count with: (MuWordArray make.charVector: 'NON-TEXT')]
	ifFalse: [(context _ end getEndContext quickCast: XuText) usedDomain isEmpty ifTrue:
		[result insert: result count with: (MuWordArray make.charVector: 'NOTHING')]
	ifFalse:
		[result vcopy: result count
			with: context
			with: (IntegerRegion
				integerExtent: (context usedDomain cast: IntegerRegion) start
				with: 20)]]].
	^result! !

!PassageModel methodsFor: #accessing!
{Int32} compare: a {XnRegion} with: b {XnRegion}
	"compare the two regions according to where they are in the document,
	returning -1, 0, or 1 if a < b, a = b, or a > b respectively"
	| x {IntegerRegion} y {IntegerRegion} |
	x _ a quickCast: IntegerRegion.
	y _ b quickCast: IntegerRegion.
	x isEmpty ifTrue:
		[y isEmpty ifTrue: [^ Int0] ifFalse: [^ -1]].
	y isEmpty ifTrue: [^1].
	x isBoundedBelow
		ifTrue: [y isBoundedBelow
			ifTrue: [x start < y start
				ifTrue: [^-1]
				ifFalse: [x start = y start
					ifTrue: [^Int0]
					ifFalse: [^1]]]
			ifFalse: [^1]]
		ifFalse: [y isBoundedBelow
			ifTrue: [^-1]
			ifFalse: [^Int0]]! !

!UDMWindowModel methodsFor: #actions!
{void} rearrangeList: distance {IntegerVar} 
	| ul {ListModel} dSel {XnRegion} cut1 {IntegerVar} cut2 {IntegerVar} cut3 {IntegerVar} |
	ul _ myUDM clubIDs.
	dSel _ mySelection selection.
	dSel simpleRegions forEach: [:sr {IntegerRegion} | 
			cut1 _ sr start.
			cut2 _ sr stop.
			distance > IntegerVar0
				ifTrue: [cut3 _ cut2 + distance]
				ifFalse: 
					[cut3 _ cut2.
					cut2 _ cut1.
					cut1 _ cut1 + distance].
			cut1 < IntegerVar0 ifTrue: [cut1 _ IntegerVar0].
			cut3 > ul count ifTrue: [cut3 _ ul count].
			ul rearrange: cut1 with: cut2 with: cut3]! !

!SlicePointRegion methodsFor: #'display accessing'!
{IntegerVar} left
	| slice {IntegerRegion} |
	myFirstSlice isEmpty not ifTrue: [Heaper BLAST: #NotEnumerable].
	self sliceCount ~~ 2 ifTrue: [Heaper BLAST: #NotSimple].
	slice _ self sliceAtIndex: Int32Zero.
	slice isBoundedBelow ifFalse: [Heaper BLAST: #NotEnumerable].
	^ slice start! !

!IntegerRegion methodsFor: #accessing!
{XnRegion} asSimpleRegion
	"Will always return the smallest simple region which contains all my positions"

	self isSimple ifTrue: [^self].
	self isBoundedBelow
		ifTrue: [self isBoundedAbove
			ifTrue: [^IntegerRegion make: self start with: self stop]
			ifFalse: [^IntegerRegion after: self start]]
		ifFalse: [self isBoundedAbove
			ifTrue: [^IntegerRegion before: self stop]
			ifFalse: [^IntegerRegion allIntegers]]! !

!IntegerRegion methodsFor: #'smalltalk: passe'!
{Position} chooseOne: order {OrderSpec | NULL}

	^((order == NULL or: [order followsInt: 1 with: 0]) ifTrue: [self start]
		ifFalse: [self stop-1]) integer! !

!IntegerRegion methodsFor: #accessing!
{Mapping} compactor
	"A mapping to transform the region into a simple region with left bound 0 (or -inf if unbounded). The domain of the mapping is precisely this region.
	This is primarily used in XuText Waldos, which only deal with contiguous zero-based regions of data."

	"((IntegerRegion make: 3 with: 7) unionWith: (IntegerRegion after: 10)) compactor"
	| result {Mapping} end {IntegerVar} index {UInt32} simple {IntegerRegion} sub {Mapping} |
	myTransitionCount == Int32Zero ifTrue: [^IntegerMapping make restrict: self].
	result _ NULL.
	myStartsInside ifTrue:
		[end _ myTransitions integerVarAt: Int32Zero.
		index _ 1]
	ifFalse:
		[end _ IntegerVar0.
		index _ Int32Zero].
	[index < myTransitionCount] whileTrue:
		[simple _ self simpleRegionAtIndex: index.
		sub _ (IntegerMapping make: end - simple start) restrict: simple.
		result == NULL
			ifTrue: [result _ sub]
			ifFalse: [result _ result combine: sub].
		simple isBoundedAbove ifTrue:
			[end _ end + simple count].
		index _ index + 2].
	result ~~ NULL
		ifTrue: [^result restrict: self]
		ifFalse: [^IntegerMapping make restrict: self]! !

!IntegerRegion methodsFor: #operations!
{XnRegion} simpleUnion: otherRegion {XnRegion}
	"The result is the smallest simple region which satisfies the spec in XuRegion::simpleUnion"
	
	| other {IntegerRegion wimpy} |
	other _ otherRegion cast: IntegerRegion.
	self isEmpty ifTrue: [^other asSimpleRegion].
	other isEmpty ifTrue: [^self asSimpleRegion].
	(self isBoundedBelow and: [other isBoundedBelow])
		ifTrue: [(self isBoundedAbove and: [other isBoundedAbove])
			ifTrue: [^IntegerRegion make: (self start min: other start)
				with: (self stop max: other stop)]
			ifFalse: [^IntegerRegion after: (self start min: other start)]]
		ifFalse: [(self isBoundedAbove and: [other isBoundedAbove])
			ifTrue: [^IntegerRegion before: (self stop max: other stop)]
			ifFalse: [^IntegerRegion make complement]]! !

!XuRealRegion methodsFor: #accessing!
{XuReal} lowerBound

	"The largest real number such that all the positions in the region are >= it.  Does not necessarily lie in the region.  For example, the region of all numbers > 2 has a lowerBound of 2."
	
	| retVal {XuReal} |
	(self isBroken) ifTrue:
		[^XuReal makeBrokenBy: self].

	Heaper problems.AllBlasts 
		handle: [:ex | retVal _ XuReal makeBroken: ex asProblem. ex return]
		do: 	[retVal _ XuReal make: (self getActualRealRegion start)].
	XuPromise inDelayBlock ifFalse:
		[XuPromise force.
		retVal isBroken ifTrue: [retVal explode]].
	^retVal! !

!FirstFitMaker methodsFor: #'arranging Sequences'!
{void} arrangeComplexMove: aSeq {EditSequence} with: deletes {IntegerTable of: EditOperation} with: inserts {IntegerTable of: EditOperation}

	| smallSeq {EditSequence} moveIn {MoveInOperation} moveOut {MoveOutOperation} |
	smallSeq _ aSeq editSequenceForMove: deletes with: inserts.
	self arrange: smallSeq.
	moveIn _ MoveInOperation make.IntegerTable: smallSeq operations with: (deletes domain cast: IntegerRegion) start.
	moveOut _ MoveOutOperation make.IntegerTable: smallSeq operations with: (inserts domain cast: IntegerRegion) start.
	aSeq rearrange: (deletes domain cast: IntegerRegion) with: moveOut.
	aSeq rearrange: (inserts domain cast: IntegerRegion) with: moveIn.
	^VOID! !

IntegerRegion removeSelector: #lowerBound!

IntegerRegion organization removeCategory: #obsolete:!

