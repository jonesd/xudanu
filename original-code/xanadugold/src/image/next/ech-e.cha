		SPTR(TYPE1) KEY;											\
		SPTR(TYPE2) VALUE;										\
		while ( loop_Stepper->hasValue() ) {						\
			KEY = CAST(TYPE1,loop_Stepper->position());				\
			VALUE = CAST(TYPE2,loop_Stepper->fetch());	
			
#define END_FOR_KEY_VALUES				\
			loop_Stepper->step();				\
		}										\
