!Pair methodsFor: #access!
{UInt32} actualHashForEqual
	| result {UInt32} |
	leftPart ~~ NULL
		ifTrue: [result _ leftPart hashForEqual]
		ifFalse: [result _ 37].
	rightPart ~~ NULL
		ifTrue: [^ result + rightPart hashForEqual]
		ifFalse: [^ result + 73]! !

