CLASS($(CLASS)Stub,$(CLASS)) {
	CONCRETE($(CLASS)Stub)
	MANUAL_GC($(CLASS)Stub)
	NOT_A_TYPE($(CLASS)Stub)
  public:
	inline $(CLASS)Stub(ShepFlag, UInt32 aHash, APTR(FlockInfo) info) 
          :  $(CLASS)(shepFlag, aHash, info)  {   }

	virtual void		printOn(ostream&);

$//
$// Generate fault-and-recall overrides for all non-static member functions
$// except anything declared NOFAULT, some hidden functions expanded from
$// macros, and a few functions from Tofu and Heaper (by name, so we don't
$// need to pollute tofux.hxx with shepherd-related stuff).  The hidden
$// functions are:
$//
$//	CONCRETE()/DEFERRED()	- getCategory()	NOFAULT - block def in Tofu()
$//	COPY()		- Class(Xcvr, Entry)	NOFAULT (Suppressed by _ctor)
$//
$// and are hidden from stubble as well.
$//
$( FOR FUNCS_UPWARDS
      ! | mname: __ct__%
        | mname: __dt__%
        | mname: __dl__%
        | mname: __nw__%
        | mname: __as__%
	| name: printOn
	| name: isKindOf
	| name: getCategory
	| name: migrate
	| name: becomeStub
	| name: isStub
	| spec: NOFAULT
	  spec: static
    )$// ** non-special methods **
$(   IF FUNC | spec: const postspec: const)
$// #error Shepherd const member function requires getReal() call.

$(   FI)
    $(FUNC type) $(FUNC)($//
$(        FOR ARGS)
$(ARG type) arg$(N)$(SEP ", ")
$(        ROF)$///
)$(IF FUNC | spec: const postspec: const) const$(FI) {
$//
$// !!!! NOTE:  In four places below, const protection is overridden
$//             with casts, to allow shepherds to swap in when const
$//             member functions are called.  This is an error.
$//
$(   IF FUNC pro: public)
    $(IF FUNC ! type: void)return $(FI)$///
	    ($(IF FUNC | spec: const postspec: const)($(CLASS)Stub *)$(FI)$///
    this)->getReal()->$(FUNC)($//
$(   ELSE)
    (($(IF FUNC | spec: const postspec: const)($(CLASS)Stub *)$(FI)this)->getReal());
    $(IF FUNC ! type: void)return $(FI)this->$(FUNC)($//
$(   FI)
$(   IF ARGS)
$(     FOR ARGS)
arg$(N)$(SEP ", ")
$(     ROF)
$(   FI)
);
    }

$( ROF ** non-special methods **)

    private:
      $(CLASS) *	getReal();  // just * in case not a type

	// Stripped-down COPY($(CLASS)Stub): Just migrate
    public:
	// Suppress migrate, so we don't have to clear the pointers.
	// We need to make sure that any stub-specific state is marked.
	LEAF void migrate(Heaplet * target,
			  void * origin,
			  BooleanVar destinationIsOld) {
		this->Abraham::migrate(target, origin, destinationIsOld);
	}
	LEAF BooleanVar isKindOf(Category * aCategory) CONST;
        LEAF void becomeStub () { }
        LEAF BooleanVar isStub() { return TRUE; }
};

Category * $(CLASS)::getShepherdStubCategory () CONST
{
        return cat_$(CLASS)Stub;
}

void $(CLASS)::becomeStub () 
{
    UInt32 hash = this->hashForEqual();
    WPTR(FlockInfo) info = this->fetchInfo();
    new (this) $(CLASS)Stub (shepFlag, hash, info);
}

/* ===== $(CLASS)Stub Implementations ==== */

void $(CLASS)Stub::
printOn(ostream& oo)
{
	oo << this->getCategory()->name();
	oo << "@";
     /* what are sequenceNumber and SeqNumKludge ? */
//	oo << sequenceNumber((void *)this) - SeqNumKludge;
	oo << "()";
}

$(CLASS) * $(CLASS)Stub::
getReal() {
    CurrentPacker.fluidGet()->makeReal(this->fetchInfo());
    return this;
}

BooleanVar $(CLASS)Stub::
isKindOf(Category * aCategory) CONST
{
	if (cat_$(CLASS)Stub->isEqualOrSubclassOf(aCategory)) {
		return TRUE;
	} else if (aCategory->isEqualOrSubclassOf(cat_$(CLASS))) {
		return (($(CLASS)Stub *)this)->getReal()->isKindOf(aCategory);
	} else {
		return FALSE;
	}
}

